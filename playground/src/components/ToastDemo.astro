---
/**
 * ToastDemo — the live Toast example for the docs. Toast is imperative
 * (`window.apogeeToast(...)`), and MDX can't host an inline <script> with object
 * literals, so the wiring lives here in a real Astro island.
 */
import Toaster from '../../../registry/components/Toast/Toaster.astro'

const btn =
  'rounded-md border border-neutral px-3 py-1.5 text-sm font-medium text-neutral transition-colors hover:bg-neutral-faded-highlighted'
---

<Toaster />
<button type="button" data-toast="primary" class={btn}>Show info</button>
<button type="button" data-toast="positive" class={btn}>Show success</button>
<button type="button" data-toast="warning" class={btn}>Show warning</button>
<button type="button" data-toast="critical" class={btn}>Show danger</button>

<script>
  const messages = {
    primary: { message: 'Changes are saved automatically.', title: 'Heads up' },
    positive: { message: 'Your changes have been saved.', title: 'Saved' },
    warning: { message: 'Your session expires in 5 minutes.', title: 'Heads up' },
    critical: { message: 'Could not save your changes.', title: 'Error' },
  } as const
  for (const el of document.querySelectorAll<HTMLElement>('[data-toast]')) {
    const color = el.dataset.toast as keyof typeof messages
    el.addEventListener('click', () => {
      const { message, title } = messages[color]
      ;(window as any).apogeeToast?.(message, { color, title })
    })
  }
</script>
