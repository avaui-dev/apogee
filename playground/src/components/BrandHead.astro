---
/**
 * BrandHead — the icon links every playground page puts in its <head>: the SVG
 * favicon (it follows the browser's light or dark mode), the .ico fallback, the
 * Apple touch icon and the web manifest. Also the touch listener iOS needs
 * before it fires :active, which the `press` feedback uses.
 */
---

<script is:inline>document.addEventListener('touchstart', () => {}, { passive: true })</script>
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
