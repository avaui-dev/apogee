---
/**
 * DocsIndex — the card grid on a category overview page: every docs page in
 * `group` (except the overview itself), with its sidebar icon, title and a
 * two-line description. Four per row on wide screens.
 */
import { getCollection } from 'astro:content'
import DocsCard from './DocsCard.astro'

interface Props {
  group: string
  /** The overview page's own id, left out of the grid. */
  self: string
}
const { group, self } = Astro.props
const pages = (await getCollection('docs'))
  .filter((d) => d.data.group === group && d.id !== self)
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title))
---

<div class="not-content mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
  {pages.map((d) => <DocsCard id={d.id} title={d.data.title} description={d.data.description} href={d.id === 'index' ? '/docs' : `/docs/${d.id}`} />)}
</div>
