---
/**
 * SiteFooter — the footer on every apogee.avaui.dev page: brand, link columns, copyright and credit.
 * The live site (apogee-site) replaces this file with a copy that adds its Legal column and newsletter.
 */
import FooterSection from '../../../registry/sections/FooterSection/FooterSection.astro'
import Logo from './Logo.astro'
import SiteCredit from './SiteCredit.astro'
import { footerColumns } from './footer-columns'
---

<FooterSection columns={footerColumns} copyright="© 2026 AVA UI. MIT license." class="bg-page-faded">
  <div slot="brand" class="flex flex-col items-start gap-3">
    <Logo />
    <p class="max-w-56 text-sm text-neutral-faded">The AVA design system for Astro.</p>
  </div>
  <SiteCredit slot="social" />
</FooterSection>
