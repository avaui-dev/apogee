---
/**
 * Playground showcase page wrapper. Holds one or more <Showcase> blocks and
 * draws a divider between each component.
 */
import Base from '../layouts/Base.astro'

interface Props {
  title: string
}
const { title } = Astro.props
---

<Base title={`${title} — Apogee playground`}>
  <a href="/" class="text-sm text-neutral-faded underline underline-offset-2">← index</a>
  <div class="mt-6 divide-y divide-neutral">
    <slot />
  </div>
</Base>
