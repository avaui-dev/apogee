---
/**
 * One component's showcase: a heading + its groups. Sits inside <ShowcasePage>,
 * which draws the divider between adjacent components.
 */
interface Props {
  name: string
  summary?: string
}
const { name, summary } = Astro.props
---

<section class="py-10 first:pt-0 last:pb-0">
  <h2 class="text-lg font-semibold tracking-tight">{name}</h2>
  {summary && <p class="mt-1 text-sm text-muted-foreground">{summary}</p>}
  <div class="mt-5 space-y-6">
    <slot />
  </div>
</section>
