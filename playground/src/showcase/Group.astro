---
/**
 * A labeled group of examples (Variants, Sizes, States…). Lays every example
 * out side by side and wraps when the row runs out of width.
 */
interface Props {
  label?: string
  /** Vertical stack instead of a wrapping row (for full-width items). */
  stack?: boolean
}
const { label, stack = false } = Astro.props
---

<div>
  {label && <h3 class="text-xs font-medium uppercase tracking-wide text-muted-foreground">{label}</h3>}
  <div class:list={['mt-3', stack ? 'flex flex-col gap-4' : 'flex flex-wrap items-center gap-3']}>
    <slot />
  </div>
</div>
