---
import '../styles/global.css'
import Breadcrumbs from '../../../registry/components/Breadcrumbs/Breadcrumbs.astro'
import Prose from '../../../registry/components/Prose/Prose.astro'
import Dialog from '../../../registry/components/Dialog/Dialog.astro'
import Button from '../../../registry/components/Button/Button.astro'
import { BookOpenText, ChevronLeft, ChevronRight } from '@lucide/astro'
import DocsCard from '../components/DocsCard.astro'
import DocsNav from '../components/DocsNav.astro'
import BrandHead from '../components/BrandHead.astro'
import SiteHeader from '../components/SiteHeader.astro'
import DocsFooter from '../components/DocsFooter.astro'
import PageActions from '../components/PageActions.astro'
import PageMeta from '../components/PageMeta.astro'
import SiteLayout from '../../../registry/layouts/SiteLayout.astro'
import { ids, author } from '../components/schema'

interface NavGroup {
  group: string
  items: { title: string; href: string; id: string; js?: boolean }[]
}
interface Props {
  title: string
  description?: string | undefined
  headings?: { depth: number; slug: string; text: string }[] | undefined
  nav?: NavGroup[] | undefined
  group?: string | undefined
  related?: { id: string; title: string; description?: string | undefined; href: string }[] | undefined
  /** ISO date of the page's last change in git. */
  modified?: string | undefined
}

const { title, description, headings = [], nav = [], group, related = [], modified } = Astro.props
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3)

// Prev/next across the flattened nav order.
const norm = (p: string) => p.replace(/\/+$/, '') || '/'
const flat = nav.flatMap((g) => g.items)
const idx = flat.findIndex((i) => norm(i.href) === norm(Astro.url.pathname))
const prev = idx > 0 ? flat[idx - 1] : null
const next = idx >= 0 && idx < flat.length - 1 ? flat[idx + 1] : null
// The group's first page is its overview; the breadcrumb links to it.
const groupHref = nav.find((g) => g.group === group)?.items[0]?.href
const crumbs = [{ label: 'Docs', href: '/docs' }, ...(group && group !== title ? [{ label: group, ...(groupHref ? { href: groupHref } : {}) }] : []), { label: title }]

// schema.org: this page as a TechArticle, and its breadcrumb trail.
// No trailing slash, matching the sidebar links, the sitemap and the .md copies.
const url = new URL(Astro.url.pathname.replace(/\/$/, ''), Astro.site ?? Astro.url).href
const graph = [
  { '@type': 'TechArticle', '@id': `${url}#article`, headline: title, description, url, inLanguage: 'en', dateModified: modified,
    isPartOf: { '@id': ids.website }, publisher: { '@id': ids.org }, author },
  { '@type': 'BreadcrumbList', itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label,
    ...('href' in c && c.href ? { item: new URL(c.href, url).href } : i === crumbs.length - 1 ? { item: url } : {}) })) },
]
const updated = modified && new Date(modified).toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric' })
---

<SiteLayout title={`${title} — Apogee`} {...(description ? { description } : {})} socialImage="/og.png" type="article" canonical={url}>
  <Fragment slot="head">
    <BrandHead />
    <PageMeta modified={modified} graph={graph} />
    <script is:inline>
      // Docs code blocks switch on data-theme, so set it before paint: stored choice, else system.
      const t = localStorage.getItem('apogee-theme')
      document.documentElement.dataset.theme = t ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
    </script>
  </Fragment>
    <SiteHeader class="docs-chrome-nav" />
    {/* Phones: the docs menu button, in a bar that sticks under the navbar. */}
    <div class="docs-chrome-bar sticky top-[65px] z-20 border-b border-neutral bg-page px-4 py-2 md:hidden">
      <Button command="show-modal" commandfor="docs-mobile-nav" variant="outline" color="neutral" fullWidth><BookOpenText slot="start" />Docs menu</Button>
    </div>

    <div class="mx-auto flex w-full max-w-7xl gap-8 px-gutter">
      <aside class="hidden w-64 shrink-0 md:block">
        <DocsNav nav={nav} class="sticky top-16 bg-page max-h-[calc(100dvh-4rem)] overflow-y-auto pb-8 pe-2" />
      </aside>

      <main class="min-w-0 flex-1 py-10">
        <Breadcrumbs items={crumbs} />
        <div class="mt-4 flex flex-wrap items-start justify-between gap-x-4 gap-y-3">
          <h1 class="text-3xl font-semibold tracking-tight">{title}</h1>
          <PageActions />
        </div>
        {description && <p class="mt-2 text-lg text-neutral-faded" data-md-skip>{description}</p>}
        {updated && <p class="mt-2 text-sm text-neutral-faded" data-md-skip>Last updated <time datetime={modified}>{updated}</time></p>}
        <Prose class="mt-8">
          <slot />
        </Prose>

        {
          related.length > 0 && (
            <section class="mt-12" aria-labelledby="related-heading">
              <h2 id="related-heading" class="mb-4 text-lg font-semibold text-neutral">Related</h2>
              <div class="grid gap-4 sm:grid-cols-2">
                {related.map((r) => <DocsCard {...r} />)}
              </div>
            </section>
          )
        }

        {
          (prev || next) && (
            <nav data-docs-pagination class="mt-12 flex items-stretch justify-between gap-4 border-t border-neutral pt-6" aria-label="Pagination">
              {prev ? (
                <a
                  href={prev.href}
                  class="flex flex-col gap-0.5 rounded-lg border border-neutral px-4 py-3 transition-colors hover:bg-neutral-faded-highlighted"
                  rel="prev"
                >
                  <span class="text-xs text-neutral-faded">← Previous</span>
                  <span class="text-sm font-medium text-neutral">{prev.title}</span>
                </a>
              ) : (
                <span />
              )}
              {next ? (
                <a
                  href={next.href}
                  class="flex flex-col gap-0.5 rounded-lg border border-neutral px-4 py-3 text-end transition-colors hover:bg-neutral-faded-highlighted"
                  rel="next"
                >
                  <span class="text-xs text-neutral-faded">Next →</span>
                  <span class="text-sm font-medium text-neutral">{next.title}</span>
                </a>
              ) : (
                <span />
              )}
            </nav>
          )
        }
      </main>

      {
        toc.length > 0 && (
          <aside class="hidden w-52 shrink-0 xl:block">
            <nav class="sticky top-16 py-10 text-sm" aria-label="On this page">
              <p class="pb-2 text-xs font-medium tracking-wide text-neutral-faded uppercase">On this page</p>
              <ul class="flex flex-col" data-toc>
                {toc.map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      class:list={[
                        'block border-s border-neutral py-1.5 text-neutral-faded transition-colors hover:text-neutral data-[active=true]:border-primary data-[active=true]:font-medium data-[active=true]:text-primary',
                        h.depth === 3 ? 'ps-6' : 'ps-3',
                      ]}
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )
      }
    </div>

    <DocsFooter />

    <Dialog id="docs-mobile-nav" position="start" title="Docs menu" class="md:hidden">
      <DocsNav nav={nav} class="[--docs-nav-bg:var(--background-elevation-raised)]" />
    </Dialog>

    {/* A small previous/next pill that floats at the bottom once the reader has scrolled, until
        the full pagination at the end of the page comes into view. Hidden without JS. */}
    {
      (prev || next) && (
        <nav data-docs-pager inert aria-label="Previous and next page" class="docs-pager fixed inset-x-0 bottom-6 z-20 mx-auto flex w-fit max-w-[calc(100%-2rem)] items-center gap-0.5 rounded-full bg-page/85 p-1 text-xs text-neutral-faded shadow-raised ring-1 ring-neutral backdrop-blur no-js:hidden">
          {prev && (
            <a href={prev.href} rel="prev" class="flex min-w-0 items-center gap-1 rounded-full py-1.5 ps-2 pe-3 transition-colors hover:bg-neutral-faded-highlighted hover:text-neutral focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">
              <ChevronLeft class="size-3.5 shrink-0 rtl:-scale-x-100" aria-hidden="true" /><span class="sr-only">Previous: </span><span class="max-w-40 truncate">{prev.title}</span>
            </a>
          )}
          {prev && next && <span class="h-4 w-px shrink-0 bg-(--border-neutral)" aria-hidden="true" />}
          {next && (
            <a href={next.href} rel="next" class="flex min-w-0 items-center gap-1 rounded-full py-1.5 ps-3 pe-2 transition-colors hover:bg-neutral-faded-highlighted hover:text-neutral focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">
              <span class="sr-only">Next: </span><span class="max-w-40 truncate">{next.title}</span><ChevronRight class="size-3.5 shrink-0 rtl:-scale-x-100" aria-hidden="true" />
            </a>
          )}
        </nav>
      )
    }

    <script>
  import { copyText } from '../../../registry/components/utils/clipboard.ts'

      // Phones: the navbar and the docs menu bar slide away while the reader scrolls down and come
      // back on the first scroll up (CSS in global.css applies it below md). They stay while the
      // navbar's menu is open or focus is inside them. Without JS both simply stay sticky.
      {
        const root = document.documentElement
        const chrome = document.querySelectorAll<HTMLElement>('.docs-chrome-nav, .docs-chrome-bar')
        let last = scrollY
        let ticking = false
        const update = () => {
          ticking = false
          const y = scrollY
          const held = document.querySelector('.docs-chrome-nav [data-open="true"]') || [...chrome].some((el) => el.contains(document.activeElement))
          if (y < 80 || held) root.removeAttribute('data-docs-chrome-hidden')
          else if (y > last + 6) root.setAttribute('data-docs-chrome-hidden', '')
          else if (y < last - 6) root.removeAttribute('data-docs-chrome-hidden')
          if (Math.abs(y - last) > 6) last = y
        }
        addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update) } }, { passive: true })
        for (const el of chrome) el.addEventListener('focusin', () => root.removeAttribute('data-docs-chrome-hidden'))
      }

      // Floating previous/next pill: shown after 400px of scroll, hidden while the page's own
      // pagination is in view. `inert` keeps it out of the tab order while hidden.
      {
        const pager = document.querySelector<HTMLElement>('[data-docs-pager]')
        const end = document.querySelector('[data-docs-pagination]')
        if (pager) {
          let endInView = false
          const sync = () => {
            const show = scrollY > 400 && !endInView
            pager.toggleAttribute('data-visible', show)
            pager.inert = !show
          }
          if (end) new IntersectionObserver(([e]) => { endInView = e!.isIntersecting; sync() }).observe(end)
          addEventListener('scroll', sync, { passive: true })
          sync()
        }
      }

      // Sidebar groups: a click on a group header saves its new state for every copy of the nav.
      document.addEventListener('click', (e) => {
        const summary = (e.target as Element).closest('[data-docs-group] > summary')
        const group = summary?.parentElement as HTMLDetailsElement | null | undefined
        if (!group) return
        const open = !group.open
        let saved: Record<string, boolean> = {}
        try { saved = JSON.parse(localStorage.getItem('apogee-docs-groups') || '{}') } catch {}
        saved[group.dataset.docsGroup!] = open
        try { localStorage.setItem('apogee-docs-groups', JSON.stringify(saved)) } catch {}
        for (const twin of document.querySelectorAll<HTMLDetailsElement>(`[data-docs-group="${group.dataset.docsGroup}"]`)) {
          if (twin !== group) twin.open = open
        }
      })

      // Sidebar scroll: keep the reader's position across page loads (desktop aside and the
      // mobile menu each keep their own). No saved position: only bring the current link into view.
      const scrollers = [
        { key: 'apogee-docs-scroll', el: document.querySelector<HTMLElement>('aside .docs-nav') },
        { key: 'apogee-docs-scroll-mobile', el: document.querySelector<HTMLElement>('#docs-mobile-nav .docs-nav')?.closest<HTMLElement>('.apogee-dialog-body, dialog') ?? null },
      ]
      for (const { key, el } of scrollers) {
        if (!el) continue
        const restore = () => {
          const saved = sessionStorage.getItem(key)
          if (saved !== null) el.scrollTop = Number(saved)
          // Arriving from a link elsewhere can leave the current page out of view: bring it in,
          // below the sticky search and group heading. Scroll only the sidebar, not the page.
          const link = el.querySelector('[aria-current="page"]')
          if (!link) return
          const l = link.getBoundingClientRect()
          const box = el.getBoundingClientRect()
          const top = box.top + 96
          if (l.top < top || l.bottom > box.bottom) el.scrollTop += l.top - (box.top + box.height / 2)
        }
        // While the menu opens, its focus scroll is not the reader's: don't save it.
        let opening = false
        if (el.matches('dialog, .apogee-dialog-body')) {
          // The menu is closed on load: restore when it opens, after the open's own focus scroll.
          const dialog = el.closest('dialog')!
          new MutationObserver(() => {
            if (!dialog.open) return
            opening = true
            requestAnimationFrame(() => requestAnimationFrame(() => {
              restore()
              opening = false
            }))
          }).observe(dialog, { attributes: true, attributeFilter: ['open'] })
        } else restore()
        const save = () => opening || sessionStorage.setItem(key, String(el.scrollTop))
        el.addEventListener('scroll', save, { passive: true })
        // Scroll events land a moment late; a link click saves the position before the page goes.
        el.addEventListener('click', save)
      }

      // Add a `#` anchor to each prose heading (progressive enhancement).
      for (const h of document.querySelectorAll<HTMLElement>(
        '.apogee-prose h2, .apogee-prose h3, .apogee-prose h4',
      )) {
        // Docs headings only: component previews keep their own markup.
        if (!h.id || h.querySelector('.heading-anchor') || h.closest('[data-preview], [data-page-preview]')) continue
        const a = document.createElement('a')
        a.href = `#${h.id}`
        a.className = 'heading-anchor'
        a.textContent = '#'
        a.setAttribute('aria-hidden', 'true')
        a.tabIndex = -1
        h.prepend(a)
      }

      // Add a copy button to every code block (mirrors the Code component).
      const ICON_COPY =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>'
      const ICON_CHECK =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>'
      for (const pre of document.querySelectorAll<HTMLElement>('pre.astro-code')) {
        // Code components bring their own copy button and frame.
        if (pre.parentElement?.classList.contains('code-block') || pre.closest('.apogee-code, .apogee-code-pre')) continue
        const wrap = document.createElement('div')
        wrap.className = 'code-block'
        pre.parentNode?.insertBefore(wrap, pre)
        wrap.appendChild(pre)

        const btn = document.createElement('button')
        btn.type = 'button'
        btn.className = 'code-copy'
        btn.setAttribute('aria-label', 'Copy code')
        btn.innerHTML = ICON_COPY
        let timer: number | undefined
        btn.addEventListener('click', async () => {
          if (!(await copyText(pre.textContent ?? ''))) return
          btn.innerHTML = ICON_CHECK
          btn.classList.add('copied')
          clearTimeout(timer)
          timer = window.setTimeout(() => {
            btn.innerHTML = ICON_COPY
            btn.classList.remove('copied')
          }, 2000)
        })
        wrap.appendChild(btn)
      }

      // Scroll-spy: highlight the TOC link for the heading currently in view.
      const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc] a')]
      if (tocLinks.length) {
        const byId = new Map(tocLinks.map((l) => [decodeURIComponent(l.hash.slice(1)), l]))
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue
              tocLinks.forEach((l) => l.removeAttribute('data-active'))
              byId.get(e.target.id)?.setAttribute('data-active', 'true')
            }
          },
          { rootMargin: '-80px 0px -70% 0px' },
        )
        for (const id of byId.keys()) {
          const el = document.getElementById(id)
          if (el) io.observe(el)
        }
      }
    </script>
</SiteLayout>
