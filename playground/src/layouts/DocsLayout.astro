---
import '../styles/global.css'
import Navbar from '../../../registry/components/Navbar/Navbar.astro'
import NavLink from '../../../registry/components/NavLink/NavLink.astro'
import Breadcrumbs from '../../../registry/components/Breadcrumbs/Breadcrumbs.astro'
import Prose from '../../../registry/components/Prose/Prose.astro'
import CommandPalette from '../../../registry/components/CommandPalette/CommandPalette.astro'
import Dialog from '../../../registry/components/Dialog/Dialog.astro'
import { Sun, Moon, Search, Menu, Box, Layers } from '@lucide/astro'
import { docsIcons } from '../components/docs-icons'

interface NavGroup {
  group: string
  items: { title: string; href: string; id: string; js?: boolean }[]
}
interface Props {
  title: string
  description?: string | undefined
  headings?: { depth: number; slug: string; text: string }[] | undefined
  nav?: NavGroup[] | undefined
  group?: string | undefined
}

const { title, description, headings = [], nav = [], group } = Astro.props
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3)
const commands = nav.flatMap((g) => g.items.map((i) => ({ label: i.title, href: i.href, group: g.group })))

// Prev/next across the flattened nav order.
const norm = (p: string) => p.replace(/\/+$/, '') || '/'
const flat = nav.flatMap((g) => g.items)
const idx = flat.findIndex((i) => norm(i.href) === norm(Astro.url.pathname))
const prev = idx > 0 ? flat[idx - 1] : null
const next = idx >= 0 && idx < flat.length - 1 ? flat[idx + 1] : null
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Apogee</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js')
      // Set theme before paint (stored choice, else system).
      const s = localStorage.getItem('apogee-skin')
      if (s) document.documentElement.dataset.skin = s
      const t = localStorage.getItem('apogee-theme')
      document.documentElement.dataset.theme =
        t ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
    </script>
  </head>
  <body class="min-h-dvh bg-page text-neutral">
    <Navbar>
      <a slot="brand" href="/docs" class="text-base font-semibold tracking-tight">Apogee</a>
      <NavLink href="/docs">Docs</NavLink>
      <div slot="actions" class="flex items-center gap-1">
        <button
          type="button"
          command="show-modal"
          commandfor="docs-mobile-nav"
          class="grid size-9 place-items-center rounded-md text-neutral-faded transition-colors hover:bg-neutral-faded-highlighted hover:text-neutral md:hidden"
          aria-label="Open navigation"
        >
          <Menu class="size-5" aria-hidden="true" />
        </button>
        <button
          type="button"
          data-command-open="docsearch"
          class="inline-flex h-9 items-center gap-2 rounded-md border border-neutral bg-page px-2.5 text-sm text-neutral-faded transition-colors hover:text-neutral"
          aria-label="Search"
        >
          <Search class="size-4" aria-hidden="true" />
          <kbd class="hidden rounded border border-neutral px-1 text-xs sm:inline">⌘K</kbd>
        </button>
        <a
          href="https://github.com/avaui-dev/apogee"
          class="grid size-9 place-items-center rounded-md text-neutral-faded transition-colors hover:bg-neutral-faded-highlighted hover:text-neutral"
          aria-label="GitHub"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.3-.52-1.47.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.5 3.17-1.18 3.17-1.18.63 1.58.24 2.75.12 3.04.74.82 1.19 1.85 1.19 3.11 0 4.43-2.7 5.4-5.26 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.2.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"/>
          </svg>
        </a>
        <button
          data-skin-toggle
          type="button"
          class="grid size-9 place-items-center rounded-md text-neutral-faded transition-colors hover:bg-neutral-faded-highlighted hover:text-neutral in-data-[skin=skeuomorphic]:text-primary"
          aria-label="Toggle skin"
          title="Skeuomorphic skin"
        >
          <Layers class="size-4" aria-hidden="true" />
        </button>
        <button
          data-theme-toggle
          type="button"
          class="grid size-9 place-items-center rounded-md text-neutral-faded transition-colors hover:bg-neutral-faded-highlighted hover:text-neutral"
          aria-label="Toggle theme"
        >
          <Sun class="size-4 hidden dark:block" aria-hidden="true" />
          <Moon class="size-4 dark:hidden" aria-hidden="true" />
        </button>
      </div>
    </Navbar>

    <div class="mx-auto flex w-full max-w-7xl gap-8 px-4">
      <aside class="hidden w-64 shrink-0 md:block">
        <nav class="sticky top-16 max-h-[calc(100dvh-4rem)] overflow-y-auto py-8 pe-2" aria-label="Docs">
          {
            nav.map((g) => (
              <div class="mb-8 last:mb-0">
                <p class="px-2 pb-2 text-xs font-semibold tracking-wider text-neutral uppercase">{g.group}</p>
                <div class="flex flex-col gap-0.5">
                  {g.items.map((i) => (
                    <NavLink href={i.href} class="px-2! py-1.5!">
                      {(() => { const Icon = docsIcons[i.id] ?? Box; return <Icon slot="start" class="size-4 text-neutral-faded" aria-hidden="true" /> })()}
                      {i.title}
                      {i.js && (
                        <span
                          slot="end"
                          class="rounded bg-neutral-faded px-1.5 py-0.5 text-[10px] font-semibold tracking-wide text-neutral"
                          title="Uses JavaScript"
                        >
                          JS
                        </span>
                      )}
                    </NavLink>
                  ))}
                </div>
              </div>
            ))
          }
        </nav>
      </aside>

      <main class="min-w-0 flex-1 py-10">
        <Breadcrumbs
          items={[{ label: 'Docs', href: '/docs' }, ...(group && group !== title ? [{ label: group }] : []), { label: title }]}
        />
        <h1 class="mt-4 text-3xl font-semibold tracking-tight">{title}</h1>
        {description && <p class="mt-2 text-lg text-neutral-faded">{description}</p>}
        <Prose class="mt-8">
          <slot />
        </Prose>

        {
          (prev || next) && (
            <nav class="mt-12 flex items-stretch justify-between gap-4 border-t border-neutral pt-6" aria-label="Pagination">
              {prev ? (
                <a
                  href={prev.href}
                  class="flex flex-col gap-0.5 rounded-lg border border-neutral px-4 py-3 transition-colors hover:bg-neutral-faded-highlighted"
                  rel="prev"
                >
                  <span class="text-xs text-neutral-faded">← Previous</span>
                  <span class="text-sm font-medium text-neutral">{prev.title}</span>
                </a>
              ) : (
                <span />
              )}
              {next ? (
                <a
                  href={next.href}
                  class="flex flex-col gap-0.5 rounded-lg border border-neutral px-4 py-3 text-end transition-colors hover:bg-neutral-faded-highlighted"
                  rel="next"
                >
                  <span class="text-xs text-neutral-faded">Next →</span>
                  <span class="text-sm font-medium text-neutral">{next.title}</span>
                </a>
              ) : (
                <span />
              )}
            </nav>
          )
        }
      </main>

      {
        toc.length > 0 && (
          <aside class="hidden w-52 shrink-0 xl:block">
            <nav class="sticky top-16 py-10 text-sm" aria-label="On this page">
              <p class="pb-2 text-xs font-medium tracking-wide text-neutral-faded uppercase">On this page</p>
              <ul class="flex flex-col" data-toc>
                {toc.map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      class:list={[
                        'block border-s border-neutral py-1.5 text-neutral-faded transition-colors hover:text-neutral data-[active=true]:border-primary data-[active=true]:font-medium data-[active=true]:text-primary',
                        h.depth === 3 ? 'ps-6' : 'ps-3',
                      ]}
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )
      }
    </div>

    <Dialog id="docs-mobile-nav" position="start" title="Menu" class="md:hidden">
      <nav aria-label="Docs">
        {
          nav.map((g) => (
            <div class="mb-8 last:mb-0">
              <p class="px-2 pb-2 text-xs font-semibold tracking-wider text-neutral uppercase">{g.group}</p>
              <div class="flex flex-col gap-0.5">
                {g.items.map((i) => (
                  <NavLink href={i.href} class="px-2! py-1.5!">
                    {(() => { const Icon = docsIcons[i.id] ?? Box; return <Icon slot="start" class="size-4 text-neutral-faded" aria-hidden="true" /> })()}
                    {i.title}
                    {i.js && (
                      <span
                        slot="end"
                        class="rounded bg-neutral-faded px-1.5 py-0.5 text-[10px] font-semibold tracking-wide text-neutral"
                        title="Uses JavaScript"
                      >
                        JS
                      </span>
                    )}
                  </NavLink>
                ))}
              </div>
            </div>
          ))
        }
      </nav>
    </Dialog>

    <CommandPalette id="docsearch" commands={commands} placeholder="Search components…" />

    <script>
      // Navbar renders its actions slot twice (mobile panel + desktop), so bind every copy.
      const toggleTheme = () => {
        const el = document.documentElement
        const next = el.dataset.theme === 'dark' ? 'light' : 'dark'
        el.classList.add('apogee-no-transitions')
        el.dataset.theme = next
        localStorage.setItem('apogee-theme', next)
        requestAnimationFrame(() => requestAnimationFrame(() => el.classList.remove('apogee-no-transitions')))
      }
      for (const b of document.querySelectorAll('[data-theme-toggle]')) b.addEventListener('click', toggleTheme)
      const toggleSkin = () => {
        const el = document.documentElement
        const on = el.dataset.skin !== 'skeuomorphic'
        if (on) el.dataset.skin = 'skeuomorphic'
        else delete el.dataset.skin
        if (on) localStorage.setItem('apogee-skin', 'skeuomorphic')
        else localStorage.removeItem('apogee-skin')
      }
      for (const b of document.querySelectorAll('[data-skin-toggle]')) b.addEventListener('click', toggleSkin)

      // Keep the current page's link in view inside the scrolling sidebar.
      const sideNav = document.querySelector<HTMLElement>('aside nav[aria-label="Docs"]')
      const current = sideNav?.querySelector<HTMLElement>('[aria-current="page"]')
      if (sideNav && current) sideNav.scrollTop = Math.max(0, current.offsetTop - sideNav.clientHeight / 2)

      // Add a `#` anchor to each prose heading (progressive enhancement).
      for (const h of document.querySelectorAll<HTMLElement>(
        '.apogee-prose h2, .apogee-prose h3, .apogee-prose h4',
      )) {
        if (!h.id || h.querySelector('.heading-anchor')) continue
        const a = document.createElement('a')
        a.href = `#${h.id}`
        a.className = 'heading-anchor'
        a.textContent = '#'
        a.setAttribute('aria-hidden', 'true')
        a.tabIndex = -1
        h.prepend(a)
      }

      // Add a copy button to every code block (mirrors the Code component).
      const ICON_COPY =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>'
      const ICON_CHECK =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>'
      for (const pre of document.querySelectorAll<HTMLElement>('pre.astro-code')) {
        if (pre.parentElement?.classList.contains('code-block')) continue
        const wrap = document.createElement('div')
        wrap.className = 'code-block'
        pre.parentNode?.insertBefore(wrap, pre)
        wrap.appendChild(pre)

        const btn = document.createElement('button')
        btn.type = 'button'
        btn.className = 'code-copy'
        btn.setAttribute('aria-label', 'Copy code')
        btn.innerHTML = ICON_COPY
        let timer: number | undefined
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(pre.textContent ?? '')
          } catch {
            return
          }
          btn.innerHTML = ICON_CHECK
          btn.classList.add('copied')
          clearTimeout(timer)
          timer = window.setTimeout(() => {
            btn.innerHTML = ICON_COPY
            btn.classList.remove('copied')
          }, 2000)
        })
        wrap.appendChild(btn)
      }

      // Scroll-spy: highlight the TOC link for the heading currently in view.
      const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc] a')]
      if (tocLinks.length) {
        const byId = new Map(tocLinks.map((l) => [decodeURIComponent(l.hash.slice(1)), l]))
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue
              tocLinks.forEach((l) => l.removeAttribute('data-active'))
              byId.get(e.target.id)?.setAttribute('data-active', 'true')
            }
          },
          { rootMargin: '-80px 0px -70% 0px' },
        )
        for (const id of byId.keys()) {
          const el = document.getElementById(id)
          if (el) io.observe(el)
        }
      }
    </script>
  </body>
</html>
