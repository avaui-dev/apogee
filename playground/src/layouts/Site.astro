---
// Showcase site chrome: Navbar + FooterSection around real section compositions.
import '../styles/global.css'
import Navbar from '../../../registry/components/Navbar/Navbar.astro'
import NavLink from '../../../registry/components/NavLink/NavLink.astro'
import Button from '../../../registry/components/Button/Button.astro'
import FooterSection from '../../../registry/sections/FooterSection/FooterSection.astro'
import { footerColumns, social } from '../components/demo-data'
import BrandHead from '../components/BrandHead.astro'
import SiteLayout from '../../../registry/layouts/SiteLayout.astro'

interface Props {
  title: string
}
const { title } = Astro.props
const path = Astro.url.pathname
const links = [
  { label: 'Home', href: '/showcase/home' },
  { label: 'About', href: '/showcase/about' },
  { label: 'Pricing', href: '/showcase/pricing' },
  { label: 'Blog', href: '/showcase/blog' },
  { label: 'Contact', href: '/showcase/contact' },
  { label: 'App', href: '/showcase/app' },
]
---

<SiteLayout title={`${title} — Apogee showcase`}>
  <BrandHead slot="head" />
  <Navbar>
    <a slot="brand" href="/showcase/home" class="font-semibold tracking-tight">Example</a>
    {links.map((l) => <NavLink href={l.href} active={path.startsWith(l.href)}>{l.label}</NavLink>)}
    <Button slot="actions" size="small" href="/showcase/pricing">Get started</Button>
  </Navbar>
  <main>
    <slot />
  </main>
  <FooterSection columns={footerColumns} copyright="© 2026 Example, Inc." social={social}>
    <span slot="brand" class="font-semibold tracking-tight">Example</span>
  </FooterSection>
</SiteLayout>
