---
import { getCollection, render } from 'astro:content'
import DocsLayout from '../../layouts/DocsLayout.astro'
import Table from '../../../../registry/components/Table/Table.astro'
import { docsNav } from '../../components/docs-nav.ts'
import { lastUpdated } from '../../components/last-updated.ts'

export async function getStaticPaths() {
  const docs = await getCollection('docs')
  return docs.map((entry) => ({
    params: { slug: entry.id === 'index' ? undefined : entry.id },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)

const all = await getCollection('docs')
const nav = await docsNav()
const related = (entry.data.related ?? []).flatMap((id) => {
  const d = all.find((x) => x.id === id)
  return d ? [{ id, title: d.data.title, description: d.data.description, href: `/docs/${id}` }] : []
})
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  headings={headings}
  nav={nav}
  group={entry.data.group}
  related={related}
  modified={entry.filePath ? lastUpdated(entry.filePath) : undefined}
>
  <Content components={{ table: Table }} />
</DocsLayout>
