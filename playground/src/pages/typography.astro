---
import ShowcasePage from '../showcase/ShowcasePage.astro'
import Showcase from '../showcase/Showcase.astro'
import Group from '../showcase/Group.astro'
import Heading from '../../../registry/components/Heading/Heading.astro'
import Text from '../../../registry/components/Text/Text.astro'
import Eyebrow from '../../../registry/components/Eyebrow/Eyebrow.astro'
import Link from '../../../registry/components/Link/Link.astro'
---

<ShowcasePage title="Typography">
  <Showcase name="Heading" summary="Semantic level via `as`, visual size via `size`. Sizes are fluid.">
    <Group label="Sizes" stack>
      <Heading as="h1" size="display">Display</Heading>
      <Heading as="h1">Heading 1</Heading>
      <Heading as="h2">Heading 2</Heading>
      <Heading as="h3">Heading 3</Heading>
      <Heading as="h4">Heading 4</Heading>
      <Heading as="h5">Heading 5</Heading>
      <Heading as="h6">Heading 6</Heading>
    </Group>
  </Showcase>

  <Showcase name="Text" summary="Body copy.">
    <Group label="Sizes" stack>
      <Text size="lg">Large — the quick brown fox jumps over the lazy dog.</Text>
      <Text>Base — the quick brown fox jumps over the lazy dog.</Text>
      <Text size="sm">Small — the quick brown fox jumps over the lazy dog.</Text>
      <Text muted>Muted — the quick brown fox jumps over the lazy dog.</Text>
    </Group>
  </Showcase>

  <Showcase name="Eyebrow" summary="A small label above a heading.">
    <Group stack>
      <div>
        <Eyebrow>Features</Eyebrow>
        <Heading as="h2" class="mt-1">Everything you need</Heading>
      </div>
    </Group>
  </Showcase>

  <Showcase name="Link" summary="Inline text link.">
    <Group label="Underline">
      <Link href="/">Always</Link>
      <Link href="/" underline="hover">On hover</Link>
      <Link href="/" underline="none">None</Link>
      <Link href="https://astro.build" external>External ↗</Link>
    </Group>
    <Group label="Inline in text" stack>
      <Text muted>Body copy with an <Link href="/">inline link</Link> that flows naturally.</Text>
    </Group>
  </Showcase>
</ShowcasePage>
