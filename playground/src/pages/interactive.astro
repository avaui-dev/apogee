---
import ShowcasePage from '../showcase/ShowcasePage.astro'
import Showcase from '../showcase/Showcase.astro'
import Group from '../showcase/Group.astro'
import Alert from '../../../registry/components/Alert/Alert.astro'
import Accordion from '../../../registry/components/Accordion/Accordion.astro'
import AccordionItem from '../../../registry/components/Accordion/AccordionItem.astro'
import Dialog from '../../../registry/components/Dialog/Dialog.astro'
import Tooltip from '../../../registry/components/Tooltip/Tooltip.astro'
import Tabs from '../../../registry/components/Tabs/Tabs.astro'
import Dropdown from '../../../registry/components/Dropdown/Dropdown.astro'
import DropdownItem from '../../../registry/components/Dropdown/DropdownItem.astro'
import Toaster from '../../../registry/components/Toast/Toaster.astro'
import Button from '../../../registry/components/Button/Button.astro'
import { Settings, User, LogOut } from '@lucide/astro'
---

<ShowcasePage title="Interactive">
  <Showcase name="Alert" summary="Status message with icon. Zero JS.">
    <Group stack>
      <div class="flex max-w-md flex-col gap-3">
        <Alert color="primary" title="Heads up">This is an informational message.</Alert>
        <Alert color="positive" title="Saved">Your changes were saved.</Alert>
        <Alert color="warning" title="Careful">This action can't be undone.</Alert>
        <Alert color="critical" title="Error">Something went wrong.</Alert>
      </div>
    </Group>
  </Showcase>

  <Showcase name="Accordion" summary="Native <details>. Same group = single-open. Zero JS.">
    <Group stack>
      <Accordion class="max-w-md">
        <AccordionItem title="What is Apogee?" group="faq" open>
          The AVA design system for Astro — accessible, native-first components you own.
        </AccordionItem>
        <AccordionItem title="Does it need JavaScript?" group="faq">
          Only when the platform can't do it. This accordion is 100% native.
        </AccordionItem>
        <AccordionItem title="Can I theme it?" group="faq">
          Yes — every value is a token, and dark mode is a token override.
        </AccordionItem>
      </Accordion>
    </Group>
  </Showcase>

  <Showcase name="Dialog" summary="Native <dialog> — modal, edge panel (drawer), or fullscreen.">
    <Group label="Variants">
      <Button command="show-modal" commandfor="dlg-modal">Modal</Button>
      <Button variant="outline" color="neutral" command="show-modal" commandfor="dlg-right">Panel (right)</Button>
      <Button variant="outline" color="neutral" command="show-modal" commandfor="dlg-bottom">Panel (bottom)</Button>
      <Button variant="outline" color="neutral" command="show-modal" commandfor="dlg-full">Fullscreen</Button>
    </Group>

    <Dialog id="dlg-modal" title="Delete project?">
      This permanently deletes the project and everything in it. This can't be undone.
      <Fragment slot="footer">
        <Button variant="outline" color="neutral" command="close" commandfor="dlg-modal">Cancel</Button>
        <Button color="critical" command="close" commandfor="dlg-modal">Delete</Button>
      </Fragment>
    </Dialog>

    <Dialog id="dlg-right" position="end" title="Details">
      A right-edge drawer. Slides in from the right, full height.
    </Dialog>

    <Dialog id="dlg-bottom" position="bottom" title="Share">
      A bottom sheet. Slides up from the bottom edge.
    </Dialog>

    <Dialog id="dlg-full" position="full-screen" title="Fullscreen">
      Fills the viewport. Good for immersive flows or mobile.
    </Dialog>
  </Showcase>

  <Showcase name="Tooltip" summary="Hover / focus hint. Zero JS.">
    <Group>
      <Tooltip text="Copied to clipboard">
        <Button variant="outline" color="neutral">Hover me</Button>
      </Tooltip>
      <Tooltip text="Settings">
        <Button iconOnly variant="ghost" color="neutral" aria-label="Settings">⚙</Button>
      </Tooltip>
    </Group>
  </Showcase>

  <Showcase name="Tabs" summary="Accessible tablist (arrows / Home / End). JS island; panels show stacked without JS.">
    <Group stack>
      <Tabs tabs={['Account', 'Password', 'Team']} class="max-w-md">
        <div slot="panel-0">Manage your account details here.</div>
        <div slot="panel-1">Change your password here.</div>
        <div slot="panel-2">Invite and manage your team here.</div>
      </Tabs>
    </Group>
  </Showcase>

  <Showcase name="Dropdown" summary="Menu on the Popover API; light dismiss is native.">
    <Group>
      <Dropdown label="Options">
        <DropdownItem href="/"><User /> Profile</DropdownItem>
        <DropdownItem href="/"><Settings /> Settings</DropdownItem>
        <DropdownItem><LogOut /> Sign out</DropdownItem>
      </Dropdown>
    </Group>
  </Showcase>

  <Showcase name="Toast" summary="Transient notification via apogeeToast(). Place <Toaster /> once.">
    <Group>
      <Button id="toast-info" variant="outline" color="neutral">Info</Button>
      <Button id="toast-success" variant="outline" color="neutral">Success</Button>
      <Button id="toast-warning" variant="outline" color="neutral">Warning</Button>
      <Button id="toast-danger" variant="outline" color="neutral">Danger</Button>
    </Group>
  </Showcase>
</ShowcasePage>

<Toaster position="bottom-end" />

<script>
  const wire = (id: string, message: string, color: string, title: string) =>
    document.getElementById(id)?.addEventListener('click', () =>
      (window as unknown as { apogeeToast: (m: string, o?: object) => void }).apogeeToast(message, { color, title }),
    )
  wire('toast-info', 'Just so you know.', 'primary', 'Heads up')
  wire('toast-success', 'Your changes were saved.', 'positive', 'Saved')
  wire('toast-warning', "This can't be undone.", 'warning', 'Careful')
  wire('toast-danger', 'Something went wrong.', 'critical', 'Error')
</script>
