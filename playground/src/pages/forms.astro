---
import ShowcasePage from '../showcase/ShowcasePage.astro'
import Showcase from '../showcase/Showcase.astro'
import Group from '../showcase/Group.astro'
import Input from '../../../registry/components/Input/Input.astro'
import Textarea from '../../../registry/components/Textarea/Textarea.astro'
import Select from '../../../registry/components/Select/Select.astro'
import Checkbox from '../../../registry/components/Checkbox/Checkbox.astro'
import Radio from '../../../registry/components/Radio/Radio.astro'
import Switch from '../../../registry/components/Switch/Switch.astro'
import Stack from '../../../registry/components/Stack/Stack.astro'
import CheckboxGroup from '../../../registry/components/CheckboxGroup/CheckboxGroup.astro'
import RadioGroup from '../../../registry/components/RadioGroup/RadioGroup.astro'
---

<ShowcasePage title="Forms">
  <Showcase name="Input" summary="Sizes, states, and a floating-label variant.">
    <Group label="States" stack>
      <Stack gap={4} class="max-w-sm">
        <Input label="Name" placeholder="Ada Lovelace" />
        <Input label="Email" type="email" hint="We'll never share it." placeholder="you@example.com" />
        <Input label="Username" required error="That username is taken." value="ada" />
        <Input label="Disabled" disabled placeholder="Unavailable" />
      </Stack>
    </Group>
    <Group label="Sizes" stack>
      <Stack gap={4} class="max-w-sm">
        <Input size="small" label="Small" placeholder="Small" />
        <Input label="Medium" placeholder="Medium" />
        <Input size="large" label="Large" placeholder="Large" />
      </Stack>
    </Group>
    <Group label="Floating label (click a field)" stack>
      <Stack gap={4} class="max-w-sm">
        <Input labelPosition="floating" label="Full name" />
        <Input labelPosition="floating" type="email" label="Email address" hint="The label floats up on focus / when filled." />
        <Input labelPosition="floating" size="large" label="Large floating" />
      </Stack>
    </Group>
  </Showcase>

  <Showcase name="Textarea" summary="Sizes.">
    <Group label="Sizes" stack>
      <Stack gap={4} class="max-w-sm">
        <Textarea size="small" rows={2} label="Small" placeholder="Small" />
        <Textarea label="Medium" placeholder="Medium" />
        <Textarea size="large" label="Large" placeholder="Large" />
      </Stack>
    </Group>
  </Showcase>

  <Showcase name="Select" summary="Sizes.">
    <Group label="Sizes" stack>
      <Stack gap={4} class="max-w-sm">
        <Select size="small" label="Small">
          <option>Developer</option>
          <option>Designer</option>
        </Select>
        <Select label="Medium">
          <option>Developer</option>
          <option>Designer</option>
        </Select>
        <Select size="large" label="Large">
          <option>Developer</option>
          <option>Designer</option>
        </Select>
      </Stack>
    </Group>
  </Showcase>

  <Showcase name="Checkbox">
    <Group stack>
      <Checkbox label="Subscribe to the newsletter" />
      <Checkbox label="Checked by default" checked />
      <Checkbox label="Disabled" disabled />
    </Group>
  </Showcase>

  <Showcase name="Radio" summary="Give a group the same name.">
    <Group stack>
      <Radio name="plan" value="free" label="Free" checked />
      <Radio name="plan" value="pro" label="Pro" />
      <Radio name="plan" value="team" label="Team" />
    </Group>
  </Showcase>

  <Showcase name="Switch">
    <Group stack>
      <Switch label="Enable notifications" />
      <Switch label="On by default" checked />
      <Switch label="Disabled" disabled />
    </Group>
  </Showcase>
  <Showcase name="CheckboxGroup" summary="A fieldset of checkboxes with one legend, hint and error.">
    <Group stack>
      <CheckboxGroup legend="Notify me about" hint="Pick as many as you like.">
        <Checkbox label="Comments" checked />
        <Checkbox label="Mentions" />
        <Checkbox label="Releases" />
      </CheckboxGroup>
      <CheckboxGroup legend="Row, with error" direction="row" error="Pick at least one.">
        <Checkbox label="A" hasError />
        <Checkbox label="B" hasError />
      </CheckboxGroup>
    </Group>
  </Showcase>

  <Showcase name="RadioGroup" summary="A radiogroup fieldset; give every Radio the same name.">
    <Group stack>
      <RadioGroup legend="Plan" hint="You can change this later.">
        <Radio name="plan-group" value="free" label="Free" checked />
        <Radio name="plan-group" value="pro" label="Pro" />
        <Radio name="plan-group" value="team" label="Team" />
      </RadioGroup>
      <RadioGroup legend="Size" direction="row">
        <Radio name="size" value="s" label="S" />
        <Radio name="size" value="m" label="M" checked />
        <Radio name="size" value="l" label="L" />
      </RadioGroup>
    </Group>
  </Showcase>
</ShowcasePage>
