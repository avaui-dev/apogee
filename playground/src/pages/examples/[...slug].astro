---
/**
 * One route per page in registry/pages: /examples/log-in/simple renders
 * registry/pages/log-in/Simple.astro on a bare page.
 */
import Example from '../../layouts/Example.astro'
import { examples } from '../../components/examples'

export function getStaticPaths() {
  return Object.entries(examples).map(([slug, e]) => ({ params: { slug }, props: e }))
}
const { title, Page } = Astro.props
// Headers open panels and a phone menu below the bar: give the frame room to show them.
const roomy = Astro.params.slug?.startsWith('header-navigation/')
---

<Example title={title}>
  <Page />
  {roomy && <div class="h-[36rem]" aria-hidden="true"></div>}
</Example>
