---
import ShowcasePage from '../showcase/ShowcasePage.astro'
import Showcase from '../showcase/Showcase.astro'
import Group from '../showcase/Group.astro'
import Container from '../../../registry/components/Container/Container.astro'
import Section from '../../../registry/components/Section/Section.astro'
import Stack from '../../../registry/components/Stack/Stack.astro'
import Grid from '../../../registry/components/Grid/Grid.astro'
import ContentWrapper from '../../../registry/components/ContentWrapper/ContentWrapper.astro'
import Heading from '../../../registry/components/Heading/Heading.astro'
import Text from '../../../registry/components/Text/Text.astro'
import Button from '../../../registry/components/Button/Button.astro'
import Box from '../../../registry/components/Box/Box.astro'
import Hidden from '../../../registry/components/Hidden/Hidden.astro'
import ScrollArea from '../../../registry/components/ScrollArea/ScrollArea.astro'
---

<ShowcasePage title="Layout">
  <Showcase name="Container" summary="Centers content at a max width with gutters. Section uses it inside.">
    <Group stack>
      <Container width="small" class="rounded-lg border border-neutral py-6 text-center text-neutral-faded">
        Centered · max-width · side gutters
      </Container>
    </Group>
  </Showcase>

  <Showcase name="Stack" summary="Column or row with a token gap.">
    <Group label="Column" stack>
      <Stack gap={3} class="rounded-lg border border-neutral p-4">
        <div class="rounded bg-neutral-faded p-3">One</div>
        <div class="rounded bg-neutral-faded p-3">Two</div>
        <div class="rounded bg-neutral-faded p-3">Three</div>
      </Stack>
    </Group>
    <Group label="Row (wrap)" stack>
      <Stack direction="row" gap={3} wrap class="rounded-lg border border-neutral p-4">
        <div class="rounded bg-neutral-faded px-3 py-2">A</div>
        <div class="rounded bg-neutral-faded px-3 py-2">B</div>
        <div class="rounded bg-neutral-faded px-3 py-2">C</div>
      </Stack>
    </Group>
  </Showcase>

  <Showcase name="Grid" summary="Autofit — as many columns as fit from a min width, no breakpoints.">
    <Group stack>
      <Grid minItemWidth="10rem">
        {[1, 2, 3, 4, 5].map((n) => <div class="rounded-lg bg-neutral-faded p-6 text-center">{n}</div>)}
      </Grid>
    </Group>
  </Showcase>

  <Showcase name="ContentWrapper" summary="One column or two, switched by a prop.">
    <Group label="columns" stack>
      <ContentWrapper variant="columns">
        <div class="rounded-lg bg-neutral-faded p-6">Column 1 (default slot)</div>
        <div slot="secondary" class="rounded-lg bg-neutral-faded p-6">Column 2 (secondary slot)</div>
      </ContentWrapper>
    </Group>
  </Showcase>

  <Showcase name="Section" summary="Themed band with vertical rhythm. theme flips tokens for the whole subtree.">
    <Group stack>
      <Section theme="dark" spacing="medium" containerWidth="medium" class="overflow-hidden rounded-xl">
        <Heading as="h3" size="h4">Dark section</Heading>
        <Text color="neutral-faded" size="small" class="mt-1">Everything inside recolors automatically — no per-child props.</Text>
        <Button size="small" class="mt-4">Action</Button>
      </Section>
    </Group>
  </Showcase>
  <Showcase name="Box" summary="The layout primitive: direction, gap, padding, surface, border, radius, shadow as token props.">
    <Group stack>
      <Box direction="row" gap={3} padding={4} background="elevation-raised" border="neutral" radius="lg" shadow="raised">
        <Box padding={3} background="neutral-faded" radius="md">One</Box>
        <Box padding={3} background="primary-faded" radius="md">Two</Box>
        <Box padding={3} background="inverted" radius="md">Three</Box>
      </Box>
    </Group>
  </Showcase>

  <Showcase name="Hidden" summary="Hide below or above a breakpoint, or visually only. Resize to see.">
    <Group>
      <Hidden below="md" as="span" class="rounded-md bg-neutral-faded px-3 py-2 text-sm">Visible from md up</Hidden>
      <Hidden above="md" as="span" class="rounded-md bg-primary-faded px-3 py-2 text-sm">Visible below md</Hidden>
      <Hidden visually>Screen readers only</Hidden>
    </Group>
  </Showcase>

  <Showcase name="ScrollArea" summary="A focusable scroll container with a thin, token-coloured scrollbar.">
    <Group>
      <ScrollArea height="8rem" aria-label="Rows" class="w-48 rounded-lg border border-neutral p-3 text-sm">
        {Array.from({ length: 14 }).map((_, i) => <p class="py-1">Row {i + 1}</p>)}
      </ScrollArea>
      <ScrollArea direction="horizontal" aria-label="Items" class="w-56 rounded-lg border border-neutral p-3 text-sm">
        <div class="flex gap-2">{Array.from({ length: 10 }).map((_, i) => <span class="shrink-0 rounded bg-neutral-faded px-3 py-1">Item {i + 1}</span>)}</div>
      </ScrollArea>
    </Group>
  </Showcase>
</ShowcasePage>
