---
import ShowcasePage from '../showcase/ShowcasePage.astro'
import Showcase from '../showcase/Showcase.astro'
import Group from '../showcase/Group.astro'
import Image from '../../../registry/components/Image/Image.astro'
import Card from '../../../registry/components/Card/Card.astro'
import List from '../../../registry/components/List/List.astro'
import Prose from '../../../registry/components/Prose/Prose.astro'
import Heading from '../../../registry/components/Heading/Heading.astro'
import Text from '../../../registry/components/Text/Text.astro'
import Button from '../../../registry/components/Button/Button.astro'
import placeholder from '../assets/placeholder.png'

const article = `
  <h2>A rich text block</h2>
  <p>This HTML wasn't written element by element — it's styled by <a href="#">Prose</a>,
  which themes with the same tokens as everything else.</p>
  <ul><li>Bullet one</li><li>Bullet two</li></ul>
  <blockquote>A quotation, set apart.</blockquote>
  <p>Inline <code>code</code> and a rule below.</p><hr/>
`
---

<ShowcasePage title="Content">
  <Showcase name="Image" summary="Wraps astro:assets — optimized, lazy, responsive.">
    <Group stack>
      <Image src={placeholder} alt="Placeholder gradient" class="rounded-lg" widths={[320, 640]} />
    </Group>
  </Showcase>

  <Showcase name="Card" summary="Surface container; optional media slot; optional link.">
    <Group>
      <Card class="w-72">
        <Heading as="h3" size="h4">Plain card</Heading>
        <Text color="neutral-faded" size="small" class="mt-1">Compose anything inside.</Text>
        <Button size="small" class="mt-4">Action</Button>
      </Card>

      <Card href="/" class="w-72">
        <Image slot="media" src={placeholder} alt="" widths={[320, 640]} />
        <Heading as="h3" size="h4">Link card</Heading>
        <Text color="neutral-faded" size="small" class="mt-1">The whole card is a link.</Text>
      </Card>
    </Group>
  </Showcase>

  <Showcase name="List">
    <Group>
      <List>
        <li>Unordered one</li>
        <li>Unordered two</li>
        <li>Unordered three</li>
      </List>
      <List as="ol">
        <li>Ordered one</li>
        <li>Ordered two</li>
      </List>
      <List marker="none">
        <li>No marker</li>
        <li>No marker</li>
      </List>
    </Group>
  </Showcase>

  <Showcase name="Prose" summary="Styles a block of rich/CMS HTML.">
    <Group stack>
      <Prose set:html={article} />
    </Group>
  </Showcase>
</ShowcasePage>
