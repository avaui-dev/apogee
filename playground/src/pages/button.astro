---
import ShowcasePage from '../showcase/ShowcasePage.astro'
import Showcase from '../showcase/Showcase.astro'
import Group from '../showcase/Group.astro'
import Button from '../../../registry/components/Button/Button.astro'
import Link from '../../../registry/components/Link/Link.astro'
import { Mail, ArrowRight, Search } from '@lucide/astro'
---

<ShowcasePage title="Button">
  <Showcase name="Button" summary="Triggers an action. Renders a button, or a link when href is set.">
    <Group label="Variants">
      <Button>Primary</Button>
      <Button variant="outline" color="neutral">Secondary</Button>
      <Button variant="ghost" color="neutral">Ghost</Button>
      <Button color="critical">Delete</Button>
      <Link href="/">Link</Link>
    </Group>

    <Group label="Link variant (inline)" stack>
      <p class="text-sm text-neutral-faded">
        A link-styled button flows inline in text —
        <Link href="/">just like this</Link> — with no button chrome.
      </p>
    </Group>

    <Group label="Sizes">
      <Button size="small">Small</Button>
      <Button>Medium</Button>
      <Button size="large">Large</Button>
    </Group>

    <Group label="States">
      <Button>Default</Button>
      <Button disabled>Disabled</Button>
      <Button loading>Saving…</Button>
    </Group>

    <Group label="As link">
      <Button href="/" variant="ghost" color="neutral">Back home</Button>
      <Button href="/">Go</Button>
      <Button href="/" disabled>Disabled link</Button>
    </Group>

    <Group label="With icons">
      <Button><Mail /> Email</Button>
      <Button variant="outline" color="neutral">Next <ArrowRight /></Button>
      <Button iconOnly aria-label="Search"><Search /></Button>
      <Button iconOnly variant="ghost" color="neutral" aria-label="Search"><Search stroke-width={2.5} /></Button>
    </Group>
  </Showcase>
</ShowcasePage>
