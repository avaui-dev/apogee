---
import ShowcasePage from '../showcase/ShowcasePage.astro'
import Showcase from '../showcase/Showcase.astro'
import Group from '../showcase/Group.astro'
import AspectRatio from '../../../registry/components/AspectRatio/AspectRatio.astro'
import Blockquote from '../../../registry/components/Blockquote/Blockquote.astro'
import Code from '../../../registry/components/Code/Code.astro'
import AvatarGroup from '../../../registry/components/AvatarGroup/AvatarGroup.astro'
import Steps from '../../../registry/components/Steps/Steps.astro'
import Slider from '../../../registry/components/Slider/Slider.astro'
import Popover from '../../../registry/components/Popover/Popover.astro'
import Combobox from '../../../registry/components/Combobox/Combobox.astro'
import Carousel from '../../../registry/components/Carousel/Carousel.astro'
import Marquee from '../../../registry/components/Marquee/Marquee.astro'
import Sidebar from '../../../registry/components/Sidebar/Sidebar.astro'
import NavLink from '../../../registry/components/NavLink/NavLink.astro'
import SegmentedControl from '../../../registry/components/SegmentedControl/SegmentedControl.astro'
import Rating from '../../../registry/components/Rating/Rating.astro'
import EmptyState from '../../../registry/components/EmptyState/EmptyState.astro'
import Timeline from '../../../registry/components/Timeline/Timeline.astro'
import Meter from '../../../registry/components/Meter/Meter.astro'
import FileUpload from '../../../registry/components/FileUpload/FileUpload.astro'
import TagInput from '../../../registry/components/TagInput/TagInput.astro'
import NumberInput from '../../../registry/components/NumberInput/NumberInput.astro'
import ColorPicker from '../../../registry/components/ColorPicker/ColorPicker.astro'
import PinInput from '../../../registry/components/PinInput/PinInput.astro'
import Button from '../../../registry/components/Button/Button.astro'
import { Inbox } from '@lucide/astro'

const people = [
  { name: 'Ada Lovelace' },
  { name: 'Alan Turing' },
  { name: 'Grace Hopper' },
  { name: 'Katherine Johnson' },
  { name: 'Linus Torvalds' },
]
---

<ShowcasePage title="Extras">
  <Showcase name="AspectRatio">
    <Group label="16 / 9" stack>
      <AspectRatio ratio="16 / 9" class="max-w-sm rounded-lg bg-muted">
        <div class="grid place-items-center text-sm text-muted-foreground">16 / 9</div>
      </AspectRatio>
    </Group>
    <Group label="1 / 1" stack>
      <AspectRatio ratio="1 / 1" class="w-40 rounded-lg bg-muted">
        <div class="grid place-items-center text-sm text-muted-foreground">1 / 1</div>
      </AspectRatio>
    </Group>
  </Showcase>

  <Showcase name="Blockquote">
    <Group stack>
      <Blockquote cite="Ada Lovelace" class="max-w-lg">
        <p>The Analytical Engine weaves algebraic patterns, just as the Jacquard loom weaves flowers and leaves.</p>
      </Blockquote>
    </Group>
  </Showcase>

  <Showcase name="Code">
    <Group label="Inline">
      <span class="text-sm text-muted-foreground">Install with <Code>npm i @ava-ui/apogee</Code>.</span>
    </Group>
    <Group label="Block" stack>
      <Code block class="max-w-lg">npx @ava-ui/apogee add button</Code>
    </Group>
    <Group label="Block + copy" stack>
      <Code copy class="max-w-lg">npx @ava-ui/apogee add code</Code>
    </Group>
  </Showcase>

  <Showcase name="AvatarGroup">
    <Group label="All" stack>
      <AvatarGroup items={people} />
    </Group>
    <Group label="max = 3" stack>
      <AvatarGroup items={people} max={3} />
    </Group>
  </Showcase>

  <Showcase name="Steps">
    <Group stack>
      <Steps
        class="max-w-sm"
        current={2}
        items={[
          { title: 'Account', description: 'Create your login' },
          { title: 'Profile', description: 'Add your details' },
          { title: 'Confirm', description: 'Review and finish' },
        ]}
      />
    </Group>
  </Showcase>

  <Showcase name="Slider">
    <Group label="Badge on top" stack>
      <Slider value={40} aria-label="Volume" class="max-w-sm" />
    </Group>
    <Group label="Badge on bottom" stack>
      <Slider value={65} labelPosition="bottom" aria-label="Brightness" class="max-w-sm" />
    </Group>
    <Group label="Disabled" stack>
      <Slider value={70} disabled aria-label="Disabled" class="max-w-sm" />
    </Group>
  </Showcase>

  <Showcase name="Popover">
    <Group>
      <Popover>
        <span slot="trigger">Details</span>
        <p class="font-medium text-foreground">Shipping</p>
        <p class="mt-1 text-muted-foreground">Free 2-day shipping on orders over $50. Click away or press Esc to close.</p>
        <Button size="sm" class="mt-3">Got it</Button>
      </Popover>
    </Group>
  </Showcase>

  <Showcase name="Combobox">
    <Group label="With caret" stack>
      <Combobox
        label="Framework"
        hint="Type to filter, or enter your own"
        class="max-w-sm"
        options={['Astro', 'Angular', 'Next.js', 'Nuxt', 'SvelteKit', 'Remix', 'SolidStart', 'Qwik']}
      />
    </Group>
    <Group label="No caret" stack>
      <Combobox
        label="City"
        caret={false}
        class="max-w-sm"
        options={['Amsterdam', 'Berlin', 'Bucharest', 'London', 'Lisbon', 'Madrid', 'Paris']}
      />
    </Group>
  </Showcase>

  <Showcase name="Carousel">
    <Group label="Arrows (default)" stack>
      <Carousel class="max-w-xl">
        {
          ['Zinc', 'Blue', 'Green', 'Amber', 'Red', 'Violet'].map((c, i) => (
            <div class="grid h-32 w-56 place-items-center rounded-lg border border-border bg-surface text-sm font-medium text-muted-foreground">
              {i + 1}. {c}
            </div>
          ))
        }
      </Carousel>
    </Group>
    <Group label="Dots + centered + fixed itemWidth" stack>
      <Carousel class="max-w-xl" dots align="center" itemWidth="14rem" controls={false}>
        {
          ['One', 'Two', 'Three', 'Four', 'Five'].map((c) => (
            <div class="grid h-32 place-items-center rounded-lg border border-border bg-surface text-sm font-medium text-muted-foreground">
              {c}
            </div>
          ))
        }
      </Carousel>
    </Group>
    <Group label="Autoplay + loop (pauses on hover)" stack>
      <Carousel class="max-w-xl" autoplay interval={2500} loop itemWidth="16rem">
        {
          ['Alpha', 'Bravo', 'Charlie', 'Delta'].map((c) => (
            <div class="grid h-32 place-items-center rounded-lg border border-border bg-accent/10 text-sm font-medium text-accent">
              {c}
            </div>
          ))
        }
      </Carousel>
    </Group>
  </Showcase>

  <Showcase name="Marquee">
    <Group label="Forwards" stack>
      <Marquee label="Logos" class="max-w-xl">
        {
          ['Astro', 'Tailwind', 'Vite', 'Lucide', 'Zinc', 'Blue'].map((c) => (
            <span class="text-lg font-semibold text-muted-foreground">{c}</span>
          ))
        }
      </Marquee>
    </Group>
    <Group label="Backwards + faster" stack>
      <Marquee label="Tags" direction="backwards" speed={2} class="max-w-xl">
        {
          ['accessible', 'responsive', 'zero-JS', 'native-first', 'copy-in'].map((c) => (
            <span class="rounded-full border border-border px-3 py-1 text-sm text-foreground">{c}</span>
          ))
        }
      </Marquee>
    </Group>
  </Showcase>

  <Showcase name="Sidebar">
    <Group stack>
      <div class="flex max-w-2xl overflow-hidden rounded-lg border border-border">
        <Sidebar class="md:h-auto md:w-56">
          <span slot="brand" class="text-sm font-semibold tracking-tight">Apogee</span>
          <NavLink href="/extras">Overview</NavLink>
          <NavLink href="/settings">Settings</NavLink>
          <NavLink href="/billing">Billing</NavLink>
          <span slot="footer" class="text-xs text-muted-foreground">v1.0.0</span>
        </Sidebar>
        <div class="flex-1 p-6 text-sm text-muted-foreground">
          Main content. Narrow the window to collapse the sidebar nav behind the toggle.
        </div>
      </div>
    </Group>
  </Showcase>

  <Showcase name="SegmentedControl">
    <Group label="Sizes" stack>
      <SegmentedControl name="view-sm" size="sm" value="list" options={['list', 'board', 'calendar']} aria-label="View" />
      <SegmentedControl name="view-md" value="board" options={['list', 'board', 'calendar']} aria-label="View" />
      <SegmentedControl
        name="range"
        size="lg"
        value="month"
        options={[
          { label: 'Day', value: 'day' },
          { label: 'Week', value: 'week' },
          { label: 'Month', value: 'month' },
        ]}
        aria-label="Range"
      />
    </Group>
  </Showcase>

  <Showcase name="Rating">
    <Group label="Interactive" stack>
      <Rating name="rate" value={3} aria-label="Rate this" />
    </Group>
    <Group label="Read-only" stack>
      <Rating readonly value={4} />
    </Group>
  </Showcase>

  <Showcase name="EmptyState">
    <Group stack>
      <EmptyState
        class="max-w-md"
        title="No projects yet"
        description="Create your first project to get started — it only takes a minute."
      >
        <Inbox slot="icon" aria-hidden="true" />
        <Button slot="actions" size="sm">New project</Button>
        <Button slot="actions" size="sm" variant="ghost">Import</Button>
      </EmptyState>
    </Group>
  </Showcase>

  <Showcase name="Timeline">
    <Group stack>
      <Timeline
        class="max-w-md"
        items={[
          { title: 'Deployed v1.2.0', time: '2h ago', description: 'Rolled out to production.' },
          { title: 'Merged #482', time: 'Yesterday', description: 'Custom combobox listbox.' },
          { title: 'Opened the repo', time: 'Sep 15' },
        ]}
      />
    </Group>
  </Showcase>

  <Showcase name="Meter">
    <Group stack>
      <Meter label="Disk" value={35} class="max-w-sm" low={20} high={80} optimum={10} />
      <Meter label="Memory" value={72} class="max-w-sm" low={20} high={80} optimum={10} />
      <Meter label="Quota" value={95} class="max-w-sm" low={20} high={80} optimum={10} />
    </Group>
  </Showcase>

  <Showcase name="FileUpload">
    <Group stack>
      <FileUpload name="doc" class="max-w-sm" />
    </Group>
  </Showcase>

  <Showcase name="TagInput">
    <Group stack>
      <TagInput name="tags" class="max-w-sm" value={['astro', 'tailwind']} />
    </Group>
  </Showcase>

  <Showcase name="NumberInput">
    <Group label="Sizes" stack>
      <NumberInput label="Quantity" size="sm" value={1} min={0} max={99} class="max-w-40" />
      <NumberInput label="Seats" value={4} min={1} max={20} class="max-w-40" />
      <NumberInput label="Amount" size="lg" value={10} step={5} class="max-w-40" />
    </Group>
  </Showcase>

  <Showcase name="ColorPicker">
    <Group stack>
      <ColorPicker label="Brand color" name="brand" value="#3b82f6" />
    </Group>
  </Showcase>

  <Showcase name="PinInput">
    <Group label="Numeric (6)" stack>
      <PinInput name="otp" />
    </Group>
    <Group label="Text (4)" stack>
      <PinInput name="pin" length={4} type="text" />
    </Group>
  </Showcase>
</ShowcasePage>
