---
import '../styles/global.css'
import Button from '../../../registry/components/Button/Button.astro'
import Input from '../../../registry/components/Input/Input.astro'
import Select from '../../../registry/components/Select/Select.astro'
import Switch from '../../../registry/components/Switch/Switch.astro'
import Alert from '../../../registry/components/Alert/Alert.astro'
import Breadcrumbs from '../../../registry/components/Breadcrumbs/Breadcrumbs.astro'
import Pagination from '../../../registry/components/Pagination/Pagination.astro'
import Dropdown from '../../../registry/components/Dropdown/Dropdown.astro'
import DropdownItem from '../../../registry/components/Dropdown/DropdownItem.astro'
import DropdownSub from '../../../registry/components/Dropdown/DropdownSub.astro'
import Tooltip from '../../../registry/components/Tooltip/Tooltip.astro'
import Popover from '../../../registry/components/Popover/Popover.astro'
import Blockquote from '../../../registry/components/Blockquote/Blockquote.astro'
import Steps from '../../../registry/components/Steps/Steps.astro'
import Table from '../../../registry/components/Table/Table.astro'
import ButtonGroup from '../../../registry/components/ButtonGroup/ButtonGroup.astro'
import Dialog from '../../../registry/components/Dialog/Dialog.astro'
import Carousel from '../../../registry/components/Carousel/Carousel.astro'
import Tabs from '../../../registry/components/Tabs/Tabs.astro'
import Slider from '../../../registry/components/Slider/Slider.astro'
import Toaster from '../../../registry/components/Toast/Toaster.astro'
import CheckboxGroup from '../../../registry/components/CheckboxGroup/CheckboxGroup.astro'
import Checkbox from '../../../registry/components/Checkbox/Checkbox.astro'
import Box from '../../../registry/components/Box/Box.astro'
import Expandable from '../../../registry/components/Expandable/Expandable.astro'
import Hero from '../../../registry/sections/Hero/Hero.astro'
import Features from '../../../registry/sections/Features/Features.astro'
import Testimonials from '../../../registry/sections/Testimonials/Testimonials.astro'
import { picture } from '../components/demo-data'
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>RTL — Apogee playground</title>
  </head>
  <body class="min-h-dvh bg-page p-8 text-neutral">
    <main class="mx-auto max-w-2xl space-y-8">
      <div>
        <a href="/" class="text-sm text-primary underline underline-offset-2" dir="ltr">← index</a>
        <h1 class="mt-3 text-2xl font-semibold tracking-tight">RTL smoke test</h1>
        <p class="mt-2 text-neutral-faded">
          The page is <code>dir="rtl"</code>. Logical properties should mirror layout;
          directional icons (chevrons, separators) should flip.
        </p>
      </div>

      <Breadcrumbs
        items={[
          { label: 'الرئيسية', href: '/' },
          { label: 'المكوّنات', href: '/' },
          { label: 'المسار' },
        ]}
      />

      <div class="flex flex-wrap items-center gap-3">
        <Button>حفظ التغييرات</Button>
        <Button variant="outline" color="neutral">إلغاء</Button>
        <ButtonGroup>
          <Button variant="outline" color="neutral">يوم</Button>
          <Button variant="outline" color="neutral">أسبوع</Button>
          <Button variant="outline" color="neutral">شهر</Button>
        </ButtonGroup>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <Input label="البريد الإلكتروني" placeholder="name@company.com" hint="لن نشاركه مع أحد" />
        <Input labelPosition="floating" label="الاسم الكامل" />
        <Select label="الدولة">
          <option>مصر</option>
          <option>السعودية</option>
          <option>الإمارات</option>
        </Select>
        <Select label="الخطة" name="plan" placeholder="اختر خطة" options={[
          { value: 'free', label: 'مجاني', description: 'للتجربة' },
          { value: 'pro', label: 'احترافي', description: 'للفرق' },
        ]} />
        <label class="flex items-center gap-2 text-sm">
          <Switch name="notify" checked label="الإشعارات" />
        </label>
      </div>

      <Alert color="primary" title="معلومة">
        النص يبدأ من اليمين، والأيقونة على الجانب الصحيح.
      </Alert>

      <Dropdown label="إجراءات">
        <DropdownItem>تعديل</DropdownItem>
        <DropdownItem>تكرار</DropdownItem>
        <DropdownSub label="مشاركة">
          <DropdownItem>نسخ الرابط</DropdownItem>
          <DropdownItem>بريد إلكتروني</DropdownItem>
        </DropdownSub>
        <DropdownItem>حذف</DropdownItem>
      </Dropdown>

      <Tooltip text="تلميح على الجانب الأيمن" placement="start">
        <Button variant="outline" color="neutral">تلميح</Button>
      </Tooltip>

      <div data-apogee-popover="end">
        <Popover placement="end">
          <span slot="trigger">المزيد</span>
          <p>تفتح اللوحة على الجانب الأيسر في الاتجاه من اليمين إلى اليسار.</p>
        </Popover>
      </div>

      <Blockquote cite="أدا لوفليس">
        <p>الآلة التحليلية تنسج الأنماط الجبرية.</p>
      </Blockquote>

      <Steps
        current={2}
        items={[
          { title: 'الحساب', description: 'أنشئ تسجيل الدخول' },
          { title: 'الملف', description: 'أضف بياناتك' },
          { title: 'التأكيد', description: 'راجع وأنهِ' },
        ]}
      />

      <Table>
        <thead>
          <tr><th>الاسم</th><th>الدور</th><th class="text-end">التعديلات</th></tr>
        </thead>
        <tbody>
          <tr><td>أدا</td><td>مطوّرة</td><td class="text-end tabular-nums">128</td></tr>
          <tr><td>آلان</td><td>مصمم</td><td class="text-end tabular-nums">42</td></tr>
        </tbody>
      </Table>

      <Pagination currentPage={3} totalPages={8} getHref={() => '#'} />

      <div class="flex flex-wrap items-center gap-3">
        <Button variant="outline" color="neutral" command="show-modal" commandfor="rtl-panel">فتح اللوحة الجانبية</Button>
        <Button variant="outline" color="neutral" command="show-modal" commandfor="rtl-sheet">فتح الورقة</Button>
        <Button variant="outline" color="neutral" onclick="apogeeToast('تم الحفظ', { color: 'positive', title: 'تم' })">إظهار تنبيه</Button>
      </div>
      <Dialog id="rtl-panel" position="end" title="لوحة جانبية">
        تنزلق من الحافة النهائية (اليسار في RTL) وتُغلق بالزر أو بالنقر خارجها.
      </Dialog>
      <Dialog id="rtl-sheet" position={{ base: 'bottom', md: 'start' }} title="ورقة" subtitle="ورقة سفلية على الهاتف، درج بدائي من md.">
        الموضع يتغير حسب نقطة الفصل.
      </Dialog>

      <Tabs tabs={['الحساب', 'كلمة المرور', 'الإشعارات']}>
        <p slot="panel-0">السهم الأيسر ينتقل إلى اللسان التالي.</p>
        <p slot="panel-1">الأسهم تعكس اتجاهها تحت RTL.</p>
        <p slot="panel-2">Home / End يصلان إلى الطرفين.</p>
      </Tabs>
      <Tabs variant="pills-raised" tabs={['الحساب', 'كلمة المرور']}>
        <p slot="panel-0">أقراص مرتفعة.</p>
        <p slot="panel-1">كلمة المرور.</p>
      </Tabs>

      <Slider range name="السعر" minValue={20} maxValue={60} aria-label="السعر" class="max-w-sm" />

      <Carousel dots itemWidth="14rem">
        {['١', '٢', '٣', '٤', '٥'].map((n) => (
          <div class="grid h-28 place-items-center rounded-lg border border-neutral bg-elevation-raised text-2xl font-semibold">{n}</div>
        ))}
      </Carousel>

      <CheckboxGroup legend="أبلغني عن" hint="اختر ما تريد." direction="row">
        <Checkbox label="التعليقات" checked />
        <Checkbox label="الإشارات" />
      </CheckboxGroup>

      <Box direction="row" gap={3} padding={4} border="neutral" radius="lg" justify="between">
        <span>البداية</span>
        <span>النهاية</span>
      </Box>

      <Expandable maxHeight="3rem" moreLabel="عرض المزيد" lessLabel="عرض أقل" class="text-sm">
        <p>نص طويل يتم اقتطاعه إلى ارتفاع المعاينة مع تلاشٍ، ثم زر لعرض المزيد. المحتوى يبقى في الصفحة دائماً. نص طويل يتم اقتطاعه إلى ارتفاع المعاينة مع تلاشٍ، ثم زر لعرض المزيد. المحتوى يبقى في الصفحة دائماً.</p>
      </Expandable>

      <Toaster position="bottom-end" />
    </main>
    <Hero layout="split" eyebrow="نظام التصميم" heading="أقسام جاهزة تنعكس تلقائياً" description="الخصائص المنطقية في كل مكان؛ اقلب الاتجاه وينعكس كل قسم." primaryAction={{ label: 'ابدأ الآن', href: '#' }} secondaryAction={{ label: 'الوثائق', href: '#' }} media={picture('rtl-hero', 1200, 900)} headingLevel={2} />
    <Features layout="alternating" eyebrow="المزايا" heading="صفوف متناوبة" items={[{ icon: 'zap', title: 'سريع افتراضياً', description: 'صفحات ثابتة بلا وقت تشغيل.', media: picture('rtl-f1', 800, 600) }, { icon: 'globe', title: 'من اليمين إلى اليسار', description: 'الخصائص المنطقية في كل مكان.', media: picture('rtl-f2', 800, 600) }]} />
    <Testimonials layout="grid" heading="آراء الفرق" items={[{ quote: 'أطلقنا الموقع في أسبوع.', name: 'آدا', role: 'التصميم' }, { quote: 'الأقسام HTML صادق.', name: 'آلان', role: 'الهندسة' }, { quote: 'الوضع الداكن والاتجاه والتباين: كلها جاهزة.', name: 'غريس' }]} />
  </body>
</html>
