---
/**
 * Card 03: A centred heading and a wide photo, then open positions grouped by department.
 *
 * @block careers
 * @order 7
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import JobCard, { type Job } from '../../components/JobCard/JobCard.astro'
import Image from '../../components/Image/Image.astro'
import Badge from '../../components/Badge/Badge.astro'
import Heading from '../../components/Heading/Heading.astro'

const jobs: Job[] = [
  {
    title: 'Product Designer',
    href: '#',
    description: "We're looking for a mid-level product designer to join our team.",
    department: 'Design',
    location: 'Remote',
    type: 'Full-time',
    salary: '80k – 100k',
    badge: { label: 'Design', color: 'primary' },
  },
  {
    title: 'Engineering Manager',
    href: '#',
    description: "We're looking for an experienced engineering manager to lead a product team.",
    department: 'Software Development',
    location: 'Remote',
    type: 'Full-time',
    salary: '120k – 150k',
    badge: { label: 'Software', color: 'neutral' },
  },
  {
    title: 'Customer Success Manager',
    href: '#',
    description: "Help our customers get the most out of the product, from first call to renewal.",
    department: 'Customer Success',
    location: 'Lisbon, Portugal',
    type: 'Full-time',
    salary: '70k – 90k',
    badge: { label: 'Customer success', color: 'positive' },
  },
  {
    title: 'Account Executive',
    href: '#',
    description: "Work with teams who are choosing their next design system.",
    department: 'Sales',
    location: 'London, UK',
    type: 'Full-time',
    salary: '90k – 120k',
    badge: { label: 'Sales', color: 'warning' },
  },
  {
    title: 'Content Marketing Lead',
    href: '#',
    description: "Write and plan the guides, notes and case studies people share.",
    department: 'Marketing',
    location: 'Remote',
    type: 'Part-time',
    salary: '60k – 80k',
    badge: { label: 'Marketing', color: 'primary' },
  },
  {
    title: 'UX Researcher',
    href: '#',
    description: "Talk to the people who use what we build and bring what you learn back.",
    department: 'Design',
    location: 'Remote',
    type: 'Contract',
    salary: '75k – 95k',
    badge: { label: 'Design', color: 'primary' },
  },
]
const intros: Record<string, string> = { Design: 'Open positions in our design team.', 'Software Development': 'Open positions in our software team.', 'Customer Success': 'Open positions in our customer success team.' }
const groups = ['Design', 'Software Development', 'Customer Success'].map((department) => ({ department, intro: intros[department], jobs: jobs.filter((job) => job.department === department) }))

---

<Section spacing="large">
  <div class="mx-auto flex max-w-3xl flex-col items-center gap-4 text-center">
    <Badge color="primary" rounded>Careers</Badge>
    <SectionHeader heading="We're looking for talented people" description="We're a remote team spread all across the world. Join us!" align="center" />
  </div>
  <Image src="https://picsum.photos/seed/apogee-careers-2/1600/700" alt="" width={1600} height={700} fit="cover" radius="xl" class="mt-12 h-60 w-full md:mt-16 md:h-[35rem]" />
  <ul class="mx-auto mt-12 flex max-w-3xl list-none flex-col gap-12 p-0 md:mt-16 md:gap-16">
    {groups.map((g) => (
      <li>
        <Heading as="h3" size="h5">{g.department}</Heading>
        <ul class="mt-5 flex list-none flex-col gap-4 p-0 md:gap-6">
          {g.jobs.map((job) => <li><JobCard job={{ ...job, department: undefined }} variant="card" headingLevel={4} /></li>)}
        </ul>
      </li>
    ))}
  </ul>
</Section>
