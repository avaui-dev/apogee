---
/**
 * Card 03: A centred heading and a wide photo, then open positions grouped by department.
 *
 * @block careers
 * @order 7
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import JobCard from '../../components/JobCard/JobCard.astro'
import { plain } from '../../sections/_shared/spine.ts'
import { type CareersContent, type Job } from '../../sections/_shared/careers.ts'
import Image from '../../components/Image/Image.astro'
import Badge from '../../components/Badge/Badge.astro'
import Heading from '../../components/Heading/Heading.astro'

const demoJobs: Job[] = [
  {
    title: 'Product Designer',
    href: '#',
    description: "We're looking for a mid-level product designer to join our team.",
    department: 'Design',
    location: 'Remote',
    type: 'Full-time',
    salary: '80k – 100k',
    badge: { label: 'Design', color: 'primary' },
  },
  {
    title: 'Engineering Manager',
    href: '#',
    description: "We're looking for an experienced engineering manager to lead a product team.",
    department: 'Software Development',
    location: 'Remote',
    type: 'Full-time',
    salary: '120k – 150k',
    badge: { label: 'Software', color: 'neutral' },
  },
  {
    title: 'Customer Success Manager',
    href: '#',
    description: "Help our customers get the most out of the product, from first call to renewal.",
    department: 'Customer Success',
    location: 'Lisbon, Portugal',
    type: 'Full-time',
    salary: '70k – 90k',
    badge: { label: 'Customer success', color: 'positive' },
  },
  {
    title: 'UX Researcher',
    href: '#',
    description: "Talk to the people who use what we build and bring what you learn back.",
    department: 'Design',
    location: 'Remote',
    type: 'Contract',
    salary: '75k – 95k',
    badge: { label: 'Design', color: 'primary' },
  },
]

/** @composable */
interface Props extends CareersContent {}

const {
  eyebrow = 'Careers',
  heading = "We're looking for talented people",
  description = "We're a remote team spread all across the world. Join us!",
  items = demoJobs,
  media = { src: 'https://picsum.photos/seed/apogee-careers-2/1600/700', alt: '', width: 1600, height: 700 },
} = Astro.props
// Jobs grouped by department, in order of first appearance.
const groups = [...new Set(items.flatMap((job) => job.department ?? []))].map((department) => ({ department, jobs: items.filter((job) => job.department === department) }))

---

<Section spacing="large">
  <div class="mx-auto flex max-w-3xl flex-col items-center gap-4 text-center">
    {eyebrow && <Badge color="primary" rounded>{eyebrow}</Badge>}
    <SectionHeader heading={plain(heading)} description={description ?? undefined} align="center" />
  </div>
  {media && <Image src={media.src} alt={media.alt} width={media.width} height={media.height} fit="cover" radius="xl" class="mt-12 h-60 w-full md:mt-16 md:h-[35rem]" />}
  <ul class="mx-auto mt-12 flex max-w-3xl list-none flex-col gap-12 p-0 md:mt-16 md:gap-16">
    {groups.map((g) => (
      <li>
        <Heading as="h3" size="h5">{g.department}</Heading>
        <ul class="mt-5 flex list-none flex-col gap-4 p-0 md:gap-6">
          {g.jobs.map((job) => <li><JobCard job={{ ...job, department: undefined }} variant="card" headingLevel={4} /></li>)}
        </ul>
      </li>
    ))}
  </ul>
</Section>
