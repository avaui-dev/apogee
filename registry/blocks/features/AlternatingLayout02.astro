---
/**
 * Alternating layout 02: A centred heading over three rows of text, buttons and a screenshot on a panel, swapping sides.
 *
 * @block features
 * @order 2
 */
import { ChartLine, CirclePlay, MessagesSquare, Zap } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Heading from '../../components/Heading/Heading.astro'
import FeaturedIcon from '../../components/FeaturedIcon/FeaturedIcon.astro'
import Button from '../../components/Button/Button.astro'
import DeviceFrame from '../../components/DeviceFrame/DeviceFrame.astro'

---

<Section spacing="large">
  <SectionHeader eyebrow="Features" heading="Beautiful analytics to grow smarter" description="Powerful, self-serve product and growth analytics to help you convert, engage and retain more users. Trusted by over 4,000 startups." align="center" class="mb-12 md:mb-16" />
  <div class="flex flex-col gap-16 md:gap-24">
    <div class="grid items-center gap-10 lg:gap-16 lg:grid-cols-2">
      <div class="flex max-w-xl flex-col gap-8">
        <div class="flex flex-col items-start gap-4">
          <FeaturedIcon theme="light" color="primary" size="large"><MessagesSquare /></FeaturedIcon>
          <Heading as="h3" size="h4">Share team inboxes</Heading>
          <p class="text-lg text-neutral-faded">Whether your team is 2 people or 200, shared inboxes keep everyone on the same page and in the loop.</p>
        </div>
        <div class="flex flex-col-reverse gap-3 sm:flex-row">
          <Button href="#" variant="outline" color="neutral"><CirclePlay slot="start" aria-hidden="true" />Demo</Button>
          <Button href="#">Learn more</Button>
        </div>
      </div>
      <div class="flex items-center justify-center overflow-hidden rounded-3xl bg-neutral-faded p-6 md:p-10 md:p-12">
      <DeviceFrame device="browser" src="/mockups/app-desktop-light.jpg" srcDark="/mockups/app-desktop-dark.jpg" alt="The dashboard overview in a browser" class="" />
    </div>
    </div>
    <div class="grid items-center gap-10 lg:gap-16 lg:grid-cols-2">
      <div class="flex max-w-xl flex-col gap-8 lg:order-last">
        <div class="flex flex-col items-start gap-4">
          <FeaturedIcon theme="light" color="primary" size="large"><Zap /></FeaturedIcon>
          <Heading as="h3" size="h4">Deliver instant answers</Heading>
          <p class="text-lg text-neutral-faded">One place for support, so customers get what they need without waiting on a reply.</p>
        </div>
        <div class="flex flex-col-reverse gap-3 sm:flex-row">
          <Button href="#" variant="outline" color="neutral"><CirclePlay slot="start" aria-hidden="true" />Demo</Button>
          <Button href="#">Learn more</Button>
        </div>
      </div>
      <div class="flex items-center justify-center overflow-hidden rounded-3xl bg-neutral-faded p-6 md:p-10 md:p-12">
      <DeviceFrame device="browser" src="/mockups/app-customers-desktop-light.jpg" srcDark="/mockups/app-customers-desktop-dark.jpg" alt="The customers table in a browser" class="" />
    </div>
    </div>
    <div class="grid items-center gap-10 lg:gap-16 lg:grid-cols-2">
      <div class="flex max-w-xl flex-col gap-8">
        <div class="flex flex-col items-start gap-4">
          <FeaturedIcon theme="light" color="primary" size="large"><ChartLine /></FeaturedIcon>
          <Heading as="h3" size="h4">Manage your team with reports</Heading>
          <p class="text-lg text-neutral-faded">Measure what matters. Filter, export and drill down on the data in a couple of clicks.</p>
        </div>
        <div class="flex flex-col-reverse gap-3 sm:flex-row">
          <Button href="#" variant="outline" color="neutral"><CirclePlay slot="start" aria-hidden="true" />Demo</Button>
          <Button href="#">Learn more</Button>
        </div>
      </div>
      <div class="flex items-center justify-center overflow-hidden rounded-3xl bg-neutral-faded p-6 md:p-10 md:p-12">
      <DeviceFrame device="browser" src="/mockups/app-settings-desktop-light.jpg" srcDark="/mockups/app-settings-desktop-dark.jpg" alt="The settings page in a browser" class="" />
    </div>
    </div>
  </div>
</Section>
