---
/**
 * Alternating layout 02: A centred heading over three rows of text, buttons and a screenshot on a panel, swapping sides.
 *
 * @block features
 * @order 2
 */
import { ChartLine, CirclePlay, MessagesSquare, Zap } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Heading from '../../components/Heading/Heading.astro'
import FeaturedIcon from '../../components/FeaturedIcon/FeaturedIcon.astro'
import Button from '../../components/Button/Button.astro'
import DeviceFrame from '../../components/DeviceFrame/DeviceFrame.astro'
import { plain, type Action } from '../../sections/_shared/spine.ts'
import type { FeaturesContent, FeatureItem } from '../../sections/_shared/features.ts'

const icons = [MessagesSquare, Zap, ChartLine]

/** @composable */
interface Props extends FeaturesContent {
  /** The rows; `href` is the solid button, `secondaryAction` the outline one, `media` the screenshot. @category content */
  items?: (FeatureItem & { secondaryAction?: Action | null })[]
}

const {
  eyebrow = 'Features',
  heading = 'Built for the way your team works',
  description = 'Powerful, self-serve product and growth analytics to help you convert, engage and retain more users. Trusted by over 4,000 startups.',
  items = [
    { title: 'Share team inboxes', description: 'Whether your team is 2 people or 200, shared inboxes keep everyone on the same page and in the loop.', href: '#', secondaryAction: { label: 'Demo', href: '#' }, media: { src: '/mockups/app-desktop-light.jpg', srcDark: '/mockups/app-desktop-dark.jpg', alt: 'The dashboard overview in a browser' } },
    { title: 'Deliver instant answers', description: 'One place for support, so customers get what they need without waiting on a reply.', href: '#', secondaryAction: { label: 'Demo', href: '#' }, media: { src: '/mockups/app-customers-desktop-light.jpg', srcDark: '/mockups/app-customers-desktop-dark.jpg', alt: 'The customers table in a browser' } },
    { title: 'Manage your team with reports', description: 'Measure what matters. Filter, export and drill down on the data in a couple of clicks.', href: '#', secondaryAction: { label: 'Demo', href: '#' }, media: { src: '/mockups/app-settings-desktop-light.jpg', srcDark: '/mockups/app-settings-desktop-dark.jpg', alt: 'The settings page in a browser' } },
  ],
  linkLabel = 'Learn more',
} = Astro.props
---

<Section spacing="large">
  <SectionHeader eyebrow={eyebrow ?? undefined} heading={plain(heading)} description={description ?? undefined} align="center" class="mb-12 md:mb-16" />
  <div class="flex flex-col gap-16 md:gap-24">
    {items.map((f, i) => { const Icon = icons[i % icons.length]!; return (
    <div class="grid items-center gap-10 lg:gap-16 lg:grid-cols-2">
      <div class:list={['flex max-w-xl flex-col gap-8', i % 2 === 1 && 'lg:order-last']}>
        <div class="flex flex-col items-start gap-4">
          <FeaturedIcon theme="light" color="primary" size="large"><Icon /></FeaturedIcon>
          <Heading as="h3" size="h4">{f.title}</Heading>
          <p class="text-lg text-neutral-faded">{f.description}</p>
        </div>
        {(f.secondaryAction || f.href) && (
        <div class="flex flex-col-reverse gap-3 sm:flex-row">
          {f.secondaryAction && <Button href={f.secondaryAction.href} variant="outline" color="neutral"><CirclePlay slot="start" aria-hidden="true" />{f.secondaryAction.label}</Button>}
          {f.href && <Button href={f.href}>{f.linkLabel ?? linkLabel}</Button>}
        </div>
        )}
      </div>
      {f.media && (
      <div class="flex items-center justify-center overflow-hidden rounded-3xl bg-neutral-faded p-6 md:p-10 md:p-12">
      <DeviceFrame device="browser" src={f.media.src} srcDark={f.media.srcDark} alt={f.media.alt} width={f.media.width} height={f.media.height} class="" />
    </div>
      )}
    </div>
    )})}
  </div>
</Section>
