---
/**
 * Simple icons 04 brand: An icon and heading beside six features in two columns, on the brand colour.
 *
 * @block features
 * @order 46
 */
import { Zap } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import Heading from '../../components/Heading/Heading.astro'
import FeaturedIcon from '../../components/FeaturedIcon/FeaturedIcon.astro'
import { plain } from '../../sections/_shared/spine.ts'
import type { FeaturesContent } from '../../sections/_shared/features.ts'

/** @composable */
interface Props extends FeaturesContent {}

const {
  heading = "Everything you need, nothing you don't",
  description = 'Powerful, self-serve product and growth analytics to help you convert, engage and retain more users.',
  items = [
    { title: 'Share team inboxes', description: 'Whether your team is 2 people or 200, shared inboxes keep everyone on the same page and in the loop.' },
    { title: 'Deliver instant answers', description: 'One place for support, so customers get what they need without waiting on a reply.' },
    { title: 'Manage your team with reports', description: 'Measure what matters. Filter, export and drill down on the data in a couple of clicks.' },
    { title: 'Connect with customers', description: 'Solve a problem or close a sale in real time with chat, and fall back to email when no one is free.' },
    { title: 'Connect the tools you already use', description: 'Over 100 integrations make your day-to-day work faster and familiar, plus a full set of developer tools.' },
    { title: 'Our people make the difference', description: "We're an extension of your support team, and our help is free. Chat to us any time, day or night." },
  ],
} = Astro.props
---

<Section spacing="large" background="primary">
  <div class="grid gap-12 lg:grid-cols-3 lg:gap-16">
    <div class="flex flex-col items-start gap-5">
      <FeaturedIcon theme="light" color="primary" size="xlarge"><Zap /></FeaturedIcon>
      <Heading as="h2" size="h2">{plain(heading)}</Heading>
      {description && <p class="text-lg opacity-85">{description}</p>}
    </div>
    <ul class="grid list-none p-0 gap-x-8 gap-y-10 md:gap-y-16 sm:grid-cols-2 sm:grid-flow-col sm:grid-rows-3 lg:col-span-2">
    {items.map((f) => (
      <li class="flex flex-col gap-2">
        <div class="flex flex-col gap-2">
            <Heading as="h3" size="h6">{f.title}</Heading>
            <p class="opacity-85">{f.description}</p>
          </div>
      </li>
    ))}
  </ul>
  </div>
</Section>
