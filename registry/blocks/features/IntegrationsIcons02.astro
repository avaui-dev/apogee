---
/**
 * Integrations icons 02: A centred heading over sixteen integration icons and a button.
 *
 * @block features
 * @order 40
 */
import { BookOpen, Bug, Calendar, CreditCard, FileText, Folder, GitBranch, HardDrive, LifeBuoy, Mail, MessageCircle, MessagesSquare, PenTool, Ticket, Users, Workflow } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import FeaturedIcon from '../../components/FeaturedIcon/FeaturedIcon.astro'
import Button from '../../components/Button/Button.astro'
import { plain, type Action } from '../../sections/_shared/spine.ts'
import type { FeaturesContent } from '../../sections/_shared/features.ts'

const tools = [
  { name: 'Docs', icon: FileText },
  { name: 'Chat', icon: MessagesSquare },
  { name: 'Drive', icon: HardDrive },
  { name: 'Help desk', icon: LifeBuoy },
  { name: 'Issues', icon: Bug },
  { name: 'Files', icon: Folder },
  { name: 'Payments', icon: CreditCard },
  { name: 'Automations', icon: Workflow },
  { name: 'Design', icon: PenTool },
  { name: 'Wiki', icon: BookOpen },
  { name: 'Email', icon: Mail },
  { name: 'Tickets', icon: Ticket },
  { name: 'Calendar', icon: Calendar },
  { name: 'Messages', icon: MessageCircle },
  { name: 'Community', icon: Users },
  { name: 'Code', icon: GitBranch },
]

/** @composable */
interface Props extends FeaturesContent {
  /** The button under the icons. @category content */
  primaryAction?: Action | null
}

const {
  eyebrow = 'Integrations',
  heading = 'Get more value from your tools',
  description = "Connect your tools, connect your teams. With over 100 apps already in our directory, your team's favourite tools are a click away.",
  primaryAction = { label: 'All integrations', href: '#' },
} = Astro.props
---

<Section spacing="large">
  <SectionHeader eyebrow={eyebrow ?? undefined} heading={plain(heading)} description={description ?? undefined} align="center" class="mb-12 md:mb-16" />
  <ul class="mx-auto grid max-w-4xl list-none grid-cols-4 justify-items-center gap-6 p-0 md:gap-8 lg:grid-cols-8">
    {tools.map((t) => <li><FeaturedIcon theme="outline" color="neutral" size="xlarge" label={t.name} class=""><t.icon /></FeaturedIcon></li>)}
  </ul>
  {primaryAction && <div class="mt-12 flex justify-center"><Button href={primaryAction.href}>{primaryAction.label}</Button></div>}
</Section>
