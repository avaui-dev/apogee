---
/**
 * Center mockup 01: A centred heading over a large screenshot, then three features with links.
 *
 * @block features
 * @order 15
 */
import { ArrowRight, ChartLine, Command, MessageCircle, MessageCircleHeart, MessagesSquare, Zap } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Heading from '../../components/Heading/Heading.astro'
import FeaturedIcon from '../../components/FeaturedIcon/FeaturedIcon.astro'
import Link from '../../components/Link/Link.astro'
import DeviceFrame from '../../components/DeviceFrame/DeviceFrame.astro'
import Badge from '../../components/Badge/Badge.astro'
import { plain } from '../../sections/_shared/spine.ts'
import type { FeaturesContent } from '../../sections/_shared/features.ts'

const icons = [MessagesSquare, Zap, ChartLine, MessageCircle, Command, MessageCircleHeart]

/** @composable */
interface Props extends FeaturesContent {}

const {
  eyebrow = 'Features',
  heading = 'Cutting-edge features for advanced analytics',
  description = 'Powerful, self-serve product and growth analytics to help you convert, engage and retain more users. Trusted by over 4,000 startups.',
  items = [
    { title: 'Share team inboxes', description: 'Whether your team is 2 people or 200, shared inboxes keep everyone on the same page and in the loop.', href: '#' },
    { title: 'Deliver instant answers', description: 'One place for support, so customers get what they need without waiting on a reply.', href: '#' },
    { title: 'Manage your team with reports', description: 'Measure what matters. Filter, export and drill down on the data in a couple of clicks.', href: '#' },
  ],
  linkLabel = 'Learn more',
  media = { src: '/mockups/app-desktop-light.jpg', srcDark: '/mockups/app-desktop-dark.jpg', alt: 'The dashboard overview in a browser' },
} = Astro.props
---

<Section spacing="large">
  <div class="flex flex-col gap-4 items-center mb-12 md:mb-16">
    {eyebrow && <Badge color="primary" variant="faded" rounded>{eyebrow}</Badge>}
    <SectionHeader heading={plain(heading)} description={description ?? undefined} align="center" />
  </div>
  {media && <DeviceFrame device="browser" src={media.src} srcDark={media.srcDark} alt={media.alt} width={media.width} height={media.height} class="mx-auto max-w-5xl" />}
  <ul class="grid list-none p-0 gap-x-8 gap-y-10 md:gap-y-16 sm:grid-cols-2 lg:grid-cols-3 mt-16 md:mt-24">
    {items.map((f, i) => { const Icon = icons[i % icons.length]!; return (
      <li class="flex flex-col items-center gap-4 text-center">
        <FeaturedIcon theme="outline" color="neutral" size="large"><Icon /></FeaturedIcon>
          <div class="flex flex-col gap-2">
            <Heading as="h3" size="h6">{f.title}</Heading>
            <p class="text-neutral-faded">{f.description}</p>
          </div>
          {f.href && <Link href={f.href} color="primary" underline="none" class="inline-flex items-center gap-1.5 font-semibold">{f.linkLabel ?? linkLabel}<span class="sr-only"> about {f.title}</span><ArrowRight class="size-4 rtl:-scale-x-100" aria-hidden="true" /></Link>}
      </li>
    )})}
  </ul>
</Section>
