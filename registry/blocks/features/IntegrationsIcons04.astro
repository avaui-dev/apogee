---
/**
 * Integrations icons 04: A centred heading over six integration cards, each icon overlapping its card.
 *
 * @block features
 * @order 42
 */
import { Bug, FileText, Folder, HardDrive, LifeBuoy, MessagesSquare } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Heading from '../../components/Heading/Heading.astro'
import FeaturedIcon from '../../components/FeaturedIcon/FeaturedIcon.astro'
import { plain } from '../../sections/_shared/spine.ts'
import type { FeaturesContent } from '../../sections/_shared/features.ts'

const icons = [FileText, MessagesSquare, HardDrive, LifeBuoy, Bug, Folder]

/** @composable */
interface Props extends FeaturesContent {}

const {
  eyebrow = 'Integrations',
  heading = 'Get more value from your tools',
  description = "Connect your tools, connect your teams. With over 100 apps already in our directory, your team's favourite tools are a click away.",
  items = [
    { title: 'Docs integration', description: 'Work faster by connecting docs straight to your workspace.' },
    { title: 'Chat integration', description: 'Work faster by connecting chat straight to your workspace.' },
    { title: 'Drive integration', description: 'Work faster by connecting drive straight to your workspace.' },
    { title: 'Help desk integration', description: 'Work faster by connecting help desk straight to your workspace.' },
    { title: 'Issues integration', description: 'Work faster by connecting issues straight to your workspace.' },
    { title: 'Files integration', description: 'Work faster by connecting files straight to your workspace.' },
  ],
} = Astro.props
---

<Section spacing="large">
  <SectionHeader eyebrow={eyebrow ?? undefined} heading={plain(heading)} description={description ?? undefined} align="center" class="mb-12 md:mb-16" />
  <ul class="grid list-none gap-x-8 gap-y-12 p-0 sm:grid-cols-2 lg:grid-cols-3">
    {items.map((f, i) => { const Icon = icons[i % icons.length]!; return (
      <li class="mt-6 flex flex-col items-center gap-4 rounded-2xl bg-neutral-faded px-6 pb-8 text-center">
        <FeaturedIcon theme="outline" color="neutral" size="xlarge" class="-mt-7"><Icon /></FeaturedIcon>
        <div class="flex flex-col gap-2">
          <Heading as="h3" size="h6">{f.title}</Heading>
          <p class="text-neutral-faded">{f.description}</p>
        </div>
      </li>
    )})}
  </ul>
</Section>
