---
/**
 * Tabs mockup 12: A heading over feature tabs beside payment cards on the brand colour; each tab shows its own arrangement.
 *
 * @block features
 * @order 38
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Tabs from '../../components/Tabs/Tabs.astro'
import PaymentCard from '../../components/PaymentCard/PaymentCard.astro'
import { plain } from '../../sections/_shared/spine.ts'
import type { FeaturesContent } from '../../sections/_shared/features.ts'

/** @composable */
interface Props extends FeaturesContent {}

const {
  eyebrow = 'Features',
  heading = 'Cards your whole team can use',
  description = 'Powerful, self-serve product and growth analytics to help you convert, engage and retain more users. Trusted by over 4,000 startups.',
  items = [
    { title: 'A card for every team', description: 'Issue cards in seconds, each with its own name and budget.' },
    { title: 'Set spending limits', description: 'Cap each card by day, month or merchant, and change it any time.' },
    { title: 'See every payment', description: 'Every charge lands in one feed, matched to its receipt.' },
  ],
} = Astro.props
---

<Section spacing="large">
  <SectionHeader eyebrow={eyebrow ?? undefined} heading={plain(heading)} description={description ?? undefined} class="mb-12 md:mb-16" />
  <Tabs variant="feature" orientation="vertical" tabs={items.map((f) => ({ label: f.title, description: f.description }))} label="Features" class="flex-col gap-12 lg:grid lg:grid-cols-2 lg:items-center lg:gap-16">
    <div slot="panel-0"><div class="flex items-center justify-center overflow-hidden rounded-3xl bg-neutral-faded p-6 md:p-10 h-80 md:h-120">
      <PaymentCard color="primary" class="w-64 -rotate-3 md:w-80" />
    </div></div>
    <div slot="panel-1"><div class="flex items-center justify-center overflow-hidden rounded-3xl bg-neutral-faded p-6 md:p-10 h-80 md:h-120">
      <div class="relative h-full w-full max-w-md">
        <div class="absolute start-0 top-1/2 w-60 -translate-y-3/4 -rotate-6 md:w-80"><PaymentCard variant="glass" last4="8080" /></div>
        <div class="absolute end-0 top-1/2 w-60 -translate-y-1/4 rotate-6 md:w-80"><PaymentCard color="neutral" last4="1234" /></div>
      </div>
    </div></div>
    <div slot="panel-2"><div class="flex items-center justify-center overflow-hidden rounded-3xl bg-primary p-6 md:p-10 h-80 md:h-120">
      <div class="relative h-full w-full max-w-md">
        <div class="absolute inset-x-0 top-1/2 mx-auto w-56 -translate-y-1/2 -rotate-12 md:w-72"><PaymentCard color="neutral" last4="8080" /></div>
        <div class="absolute inset-x-0 top-1/2 mx-auto w-56 -translate-y-1/2 md:w-72"><PaymentCard color="neutral" last4="1234" /></div>
        <div class="absolute inset-x-0 top-1/2 mx-auto w-56 -translate-y-1/2 rotate-12 md:w-72"><PaymentCard color="neutral" last4="4242" /></div>
      </div>
    </div></div>
  </Tabs>
</Section>
