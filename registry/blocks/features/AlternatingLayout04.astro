---
/**
 * Alternating layout 04: A centred heading over three rows of text and a tall photo, swapping sides.
 *
 * @block features
 * @order 4
 */
import { ChartLine, CircleCheck, MessagesSquare, Zap } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Heading from '../../components/Heading/Heading.astro'
import FeaturedIcon from '../../components/FeaturedIcon/FeaturedIcon.astro'
import Image from '../../components/Image/Image.astro'
import { plain } from '../../sections/_shared/spine.ts'
import type { FeaturesContent, FeatureItem } from '../../sections/_shared/features.ts'

const icons = [MessagesSquare, Zap, ChartLine]

/** @composable */
interface Props extends FeaturesContent {
  /** The rows; `bullets` are the checked points under each, `media` its photo. @category content */
  items?: (FeatureItem & { bullets?: string[] })[]
}

const {
  eyebrow = 'Features',
  heading = "We're a mission-driven company",
  description = 'Powerful, self-serve product and growth analytics to help you convert, engage and retain more users. Trusted by over 4,000 startups.',
  items = [
    { title: 'Share team inboxes', description: 'Whether your team is 2 people or 200, shared inboxes keep everyone on the same page and in the loop.', bullets: ['Leverage automation to move fast', 'Always give customers a human to chat to', 'Automate support and close leads faster'], media: { src: 'https://picsum.photos/seed/apogee-features-1/1200/1100', alt: '', width: 1200, height: 1100 } },
    { title: 'Deliver instant answers', description: 'One place for support, so customers get what they need without waiting on a reply.', bullets: ['Keep customers in the loop with live chat', 'Embed help articles right on your website', 'Customers never leave the page to find an answer'], media: { src: 'https://picsum.photos/seed/apogee-features-2/1200/1100', alt: '', width: 1200, height: 1100 } },
    { title: 'Manage your team with reports', description: 'Measure what matters. Filter, export and drill down on the data in a couple of clicks.', bullets: ['Filter, export and drill down on the data', 'Save, schedule and send reports to your inbox', 'Connect the tools you already use'], media: { src: 'https://picsum.photos/seed/apogee-features-3/1200/1100', alt: '', width: 1200, height: 1100 } },
  ],
} = Astro.props
---

<Section spacing="large">
  <SectionHeader eyebrow={eyebrow ?? undefined} heading={plain(heading)} description={description ?? undefined} align="center" class="mb-12 md:mb-16" />
  <div class="flex flex-col gap-16 md:gap-24">
    {items.map((f, i) => { const Icon = icons[i % icons.length]!; return (
    <div class="grid items-center gap-10 lg:gap-16 lg:grid-cols-2">
      <div class:list={['flex max-w-xl flex-col gap-8', i % 2 === 1 && 'lg:order-last']}>
        <div class="flex flex-col items-start gap-4">
          <FeaturedIcon theme="light" color="primary" size="large"><Icon /></FeaturedIcon>
          <Heading as="h3" size="h4">{f.title}</Heading>
          <p class="text-lg text-neutral-faded">{f.description}</p>
        </div>
        {f.bullets && (
        <ul class="flex list-none flex-col gap-4 p-0">
          {f.bullets.map((b) => <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span class="text-neutral-faded">{b}</span></li>)}
        </ul>
        )}
      </div>
      {f.media && <Image src={f.media.src} alt={f.media.alt} width={f.media.width} height={f.media.height} fit="cover" radius="xl" class="h-80 w-full md:h-140" />}
    </div>
    )})}
  </div>
</Section>
