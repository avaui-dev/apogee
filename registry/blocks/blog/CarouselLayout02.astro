---
/**
 * Carousel layout 02: A heading, intro and View all posts button over a carousel of four posts.
 *
 * @block blog
 * @order 20
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import PostCard from '../../components/PostCard/PostCard.astro'
import { plain } from '../../sections/_shared/spine.ts'
import { toCard, type BlogContent, type Post } from '../../sections/_shared/blog.ts'
import Button from '../../components/Button/Button.astro'
import Carousel from '../../components/Carousel/Carousel.astro'

const demoPosts: Post[] = [
  {
    title: 'Designing review sessions people look forward to',
    href: '#',
    excerpt: 'How to run critiques that sharpen the work instead of draining the room.',
    date: '2026-01-20',
    readingTime: '8 min read',
    image: { src: 'https://picsum.photos/seed/apogee-blog-1/960/640', alt: '', width: 960, height: 640 },
    category: { name: 'Design', href: '#' },
    author: { name: 'Ada Lovelace', href: '#' },
    tags: [{ name: 'Design', href: '#', color: 'primary' }, { name: 'Research', href: '#', color: 'neutral' }, { name: 'Process', href: '#', color: 'positive' }],
  },
  {
    title: 'Migrating to a typed component library',
    href: '#',
    excerpt: 'What changed when we moved two hundred screens onto one set of typed parts.',
    date: '2026-01-19',
    readingTime: '6 min read',
    image: { src: 'https://picsum.photos/seed/apogee-blog-2/960/640', alt: '', width: 960, height: 640 },
    category: { name: 'Engineering', href: '#' },
    author: { name: 'Alan Turing', href: '#' },
    tags: [{ name: 'Engineering', href: '#', color: 'primary' }, { name: 'Tooling', href: '#', color: 'neutral' }],
  },
  {
    title: 'Building your first internal API',
    href: '#',
    excerpt: 'The shape of a small API that teams can grow without rewriting.',
    date: '2026-01-18',
    readingTime: '7 min read',
    image: { src: 'https://picsum.photos/seed/apogee-blog-3/960/640', alt: '', width: 960, height: 640 },
    category: { name: 'Engineering', href: '#' },
    author: { name: 'Grace Hopper', href: '#' },
    tags: [{ name: 'Engineering', href: '#', color: 'primary' }, { name: 'APIs', href: '#', color: 'warning' }],
  },
  {
    title: 'A field guide to product discovery',
    href: '#',
    excerpt: 'Questions that turn a vague request into something you can build.',
    date: '2026-01-16',
    readingTime: '5 min read',
    image: { src: 'https://picsum.photos/seed/apogee-blog-4/960/640', alt: '', width: 960, height: 640 },
    category: { name: 'Product', href: '#' },
    author: { name: 'Katherine Johnson', href: '#' },
    tags: [{ name: 'Product', href: '#', color: 'primary' }, { name: 'Research', href: '#', color: 'neutral' }],
  },
  {
    title: 'Writing release notes people read',
    href: '#',
    excerpt: 'Lead with what changed for the reader, not what changed in the code.',
    date: '2026-01-15',
    readingTime: '4 min read',
    image: { src: 'https://picsum.photos/seed/apogee-blog-5/960/640', alt: '', width: 960, height: 640 },
    category: { name: 'Product', href: '#' },
    author: { name: 'Margaret Hamilton', href: '#' },
    tags: [{ name: 'Product', href: '#', color: 'primary' }, { name: 'Writing', href: '#', color: 'positive' }],
  },
  {
    title: 'Leadership lessons from a year of remote teams',
    href: '#',
    excerpt: 'Rituals, writing and trust: what held a distributed team together.',
    date: '2026-01-14',
    readingTime: '9 min read',
    image: { src: 'https://picsum.photos/seed/apogee-blog-6/960/640', alt: '', width: 960, height: 640 },
    category: { name: 'Leadership', href: '#' },
    author: { name: 'Alan Kay', href: '#' },
    tags: [{ name: 'Leadership', href: '#', color: 'primary' }, { name: 'Remote', href: '#', color: 'neutral' }],
  },
]
/** @composable */
interface Props extends BlogContent {}

const {
  eyebrow = 'Our blog',
  heading = 'Latest writings',
  description = 'The latest news, technologies, and resources from our team.',
  items = demoPosts,
  locale = Astro.currentLocale ?? 'en',
  secondaryAction = { label: 'View all posts', href: '#' },
} = Astro.props

---

<Section spacing="large" background="neutral-faded">
  <SectionHeader eyebrow={eyebrow ?? undefined} heading={plain(heading)} description={description ?? undefined} class="mb-12">
    {secondaryAction && <Button slot="actions" href={secondaryAction.href} size="large" variant="outline" color="neutral" class="max-sm:hidden">{secondaryAction.label}</Button>}
  </SectionHeader>
  <Carousel label="Latest writings" visibleItems={{ base: 1, md: 2, lg: 4 }} gap={6} controlsPosition="below">
    {items.map((post) => <PostCard post={toCard(post)} locale={locale} frame="card" headingLevel={3} class="h-full" />)}
  </Carousel>
  {secondaryAction && <Button href={secondaryAction.href} size="large" variant="outline" color="neutral" fullWidth class="mt-8 sm:hidden">{secondaryAction.label}</Button>}
</Section>
