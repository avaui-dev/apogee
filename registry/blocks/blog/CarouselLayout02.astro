---

<Section spacing="large" background="neutral-faded">
  <SectionHeader eyebrow="Our blog" heading="Latest writings" description="The latest news, technologies, and resources from our team." class="mb-12">
    <Button slot="actions" href="#" size="large" variant="outline" color="neutral" class="max-sm:hidden">View all posts</Button>
  </SectionHeader>
  <Carousel label="Latest writings" visibleItems={{ base: 1, md: 2, lg: 4 }} gap={6} controlsPosition="below">
    {posts.map((post) => <PostCard post={post} frame="card" headingLevel={3} class="h-full" />)}
  </Carousel>
  <Button href="#" size="large" variant="outline" color="neutral" fullWidth class="mt-8 sm:hidden">View all posts</Button>
</Section>
