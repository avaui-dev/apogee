const categories = [
  { label: 'View all', value: 'all', href: '#' },
  { label: 'Design', value: 'design', href: '#design' },
  { label: 'Product', value: 'product', href: '#product' },
  { label: 'Engineering', value: 'engineering', href: '#engineering' },
  { label: 'Leadership', value: 'leadership', href: '#leadership' },
  { label: 'Marketing', value: 'marketing', href: '#marketing' },
