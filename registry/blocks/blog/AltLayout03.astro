---

<Section spacing="large">
  <SectionHeader eyebrow="Our blog" heading="Resource library" description="Subscribe to learn about new product features, the latest in technology, solutions, and updates." headingLevel={1} class="mb-16">
    <div slot="actions" class="w-full sm:w-auto">
      <form method="post" class="flex w-full flex-col gap-2 sm:max-w-md">
      <div class="flex flex-col gap-3 sm:flex-row">
        <Input type="email" name="email" placeholder="Enter your email" aria-label="Email" autocomplete="email" required class="flex-1" />
        <Button type="submit">Subscribe</Button>
      </div>
      <p class="text-sm opacity-85">We care about your data in our <Link href="#" color="neutral">privacy policy</Link>.</p>
    </form>
    </div>
  </SectionHeader>
  <PostCard post={posts[0]!} frame="overlay" meta="none" size="large" footer="link" headingLevel={2} class="mb-16 max-md:hidden" />
  <div class="mb-10 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
    <Tabs label="Categories" value="all" variant="primary" tabs={categories} class="min-w-0" />
    <div class="lg:w-72"><Input type="search" name="q" placeholder="Search" aria-label="Search posts"><SearchIcon slot="start" /></Input></div>
  </div>
  <Grid as="ul" cols={{ base: 1, md: 2, lg: 3 }} gap={8} class="list-none p-0">
    {posts.slice(1).map((post) => (
      <li><PostCard post={post} frame="overlay" meta="none" footer="link" headingLevel={2} class="h-full" /></li>
    ))}
  </Grid>
  <div class="mt-12 flex justify-center">
    <Button href="?page=2" variant="outline" color="neutral" size="large">Load more</Button>
  </div>
</Section>
