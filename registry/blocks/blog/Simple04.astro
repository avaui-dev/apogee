<Section spacing="large" background="primary">
  <SectionHeader eyebrow="Our blog" heading="Stories and interviews" description="Interviews, tips, guides, industry best practices, and news." background="primary" size="large" align="center" headingLevel={1} class="mb-8" />
  <div class="flex justify-center"><form method="post" class="flex w-full flex-col gap-2 sm:max-w-md">
      <div class="flex flex-col gap-3 sm:flex-row">
        <Input type="email" name="email" placeholder="Enter your email" aria-label="Email" autocomplete="email" required class="flex-1" />
        <Button type="submit" color="neutral">Subscribe</Button>
      </div>
      <p class="text-sm opacity-85">We care about your data in our <Link href="#" color="inherit">privacy policy</Link>.</p>
    </form></div>
</Section>
<Section spacing="large">
  <Grid as="ul" cols={{ base: 1, md: 2, lg: 3 }} gap={8} class="list-none p-0">
    {posts.slice(0).map((post) => (
      <li><PostCard post={post} frame="overlay" meta="none" footer="link" headingLevel={2} class="h-full" /></li>
    ))}
  </Grid>
  <div class="mt-12 flex justify-center">
    <Button href="?page=2" variant="outline" color="neutral" size="large">Load more</Button>
  </div>
</Section>
