---

<Section spacing="large">
  <SectionHeader eyebrow="Our blog" heading="Stories and interviews" description="Subscribe to learn about new product features, the latest in technology, solutions, and updates." align="center" headingLevel={1} class="mb-8" />
  <div class="mb-16 flex justify-center"><form method="post" class="flex w-full flex-col gap-2 sm:max-w-md">
      <div class="flex flex-col gap-3 sm:flex-row">
        <Input type="email" name="email" placeholder="Enter your email" aria-label="Email" autocomplete="email" required class="flex-1" />
        <Button type="submit">Subscribe</Button>
      </div>
      <p class="text-sm opacity-85">We care about your data in our <Link href="#" color="neutral">privacy policy</Link>.</p>
    </form></div>
  <section aria-labelledby="recent-posts" class="mb-16">
    <Heading id="recent-posts" as="h2" size="h4" class="mb-8">Recent blog posts</Heading>
    <div class="grid gap-8 lg:grid-cols-2">
      <PostCard post={posts[0]!} meta="byline" footer="tags" headingLevel={3} />
      <div class="flex flex-col gap-8">
        {posts.slice(1, 3).map((post) => <PostCard post={post} orientation="horizontal" meta="byline" footer="tags" headingLevel={3} />)}
      </div>
    </div>
  </section>
  <section aria-labelledby="all-posts">
    <Heading id="all-posts" as="h2" size="h4" class="mb-8">All blog posts</Heading>
    <Grid as="ul" cols={{ base: 1, md: 2, lg: 3 }} gap={8} class="list-none p-0">
      {posts.slice(3).map((post) => <li><PostCard post={post} meta="byline" footer="tags" headingLevel={3} class="h-full" /></li>)}
    </Grid>
    <Pagination currentPage={1} totalPages={10} getHref={(p) => `?page=${p}`} labels class="mt-12 justify-between border-t border-neutral pt-5" />
  </section>
</Section>
