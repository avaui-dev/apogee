---

<Section spacing="large">
  <SectionHeader eyebrow="Our blog" heading="Resources and insights" description="The latest industry news, interviews, technologies and resources." headingLevel={1} class="mb-12" />
  <PostCard post={posts[0]!} orientation="horizontal" size="large" footer="tags" headingLevel={2} class="mb-12" />
  <div class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <Tabs label="Categories" value="all" tabs={categories} class="min-w-0" />
    <Select aria-label="Sort by" class="sm:w-48">
      <option>Most recent</option>
      <option>Most popular</option>
      <option>Oldest</option>
    </Select>
  </div>
  <Grid as="ul" cols={{ base: 1, md: 2, lg: 3 }} gap={8} class="list-none p-0">
    {posts.slice(1).map((post) => (
      <li><PostCard post={post} headingLevel={2} class="h-full" /></li>
    ))}
  </Grid>
  <Pagination currentPage={1} totalPages={10} getHref={(p) => `?page=${p}`} labels class="mt-12 justify-between border-t border-neutral pt-5" />
</Section>
