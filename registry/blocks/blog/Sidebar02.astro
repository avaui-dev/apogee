---

<Section spacing="large">
  <SectionHeader eyebrow="Our blog" heading="Resources and insights" description="The latest industry news, interviews, technologies and resources." headingLevel={1} class="mb-16" />
  <div class="grid gap-12 lg:grid-cols-[16rem_minmax(0,1fr)]">
    <aside class="flex flex-col gap-6">
      <Input type="search" name="q" placeholder="Search" aria-label="Search posts"><SearchIcon slot="start" /></Input>
      <Select aria-label="Category" class="lg:hidden">
        {categories.map((c) => <option value={c.value}>{c.label}</option>)}
      </Select>
      <Tabs label="Categories" value="all" orientation="vertical" variant="borderless" tabs={categories} class="max-lg:hidden" />
    </aside>
    <div>
      <PostCard post={posts[0]!} meta="badge" size="large" headingLevel={2} class="mb-12" />
      <Grid as="ul" cols={{ base: 1, md: 2 }} gap={8} class="list-none p-0">
    {posts.slice(1).map((post) => (
      <li><PostCard post={post} meta="badge" headingLevel={2} class="h-full" /></li>
    ))}
  </Grid>
      <Pagination currentPage={1} totalPages={10} getHref={(p) => `?page=${p}`} labels class="mt-12 justify-between border-t border-neutral pt-5" />
    </div>
  </div>
</Section>
