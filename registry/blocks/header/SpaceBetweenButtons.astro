---
/**
 * Space between buttons: A split heading, line and two buttons.
 *
 * @block header
 * @order 23
 */
import Section from '../../components/Section/Section.astro'
import Eyebrow from '../../components/Eyebrow/Eyebrow.astro'
import Heading from '../../components/Heading/Heading.astro'
import Text from '../../components/Text/Text.astro'
import Button from '../../components/Button/Button.astro'

---

<Section spacing="large">
  <Eyebrow as="p" color="primary">Pricing</Eyebrow>
  <div class="mt-3 grid gap-4 md:gap-6 lg:grid-cols-[minmax(0,1fr)_30rem] lg:gap-x-16">
    <Heading as="h1" size="display" class="text-balance">Plans that fit your scale</Heading>
    <Text size="large" class="text-neutral-faded lg:mt-3">Simple, transparent pricing that grows with you. Try any plan free for 30 days.</Text>
  </div>
  <div class="mt-8">
    <div class="flex flex-col-reverse gap-3 sm:flex-row">
      <Button href="#" size="large" variant="outline" color="neutral">Chat to sales</Button>
      <Button href="#" size="large">Get started</Button>
    </div>
  </div>
</Section>
