---
/**
 * Centered email brand: A centred heading, line and email signup on the brand colour.
 *
 * @block header
 * @order 6
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Button from '../../components/Button/Button.astro'
import Link from '../../components/Link/Link.astro'
import Input from '../../components/Input/Input.astro'

interface Props {
  eyebrow?: string
  heading?: string
  description?: string
}
const { eyebrow = 'Resources', heading = 'The Larkspur blog', description = 'The latest industry news, technologies and resources from our team.' } = Astro.props
---

<Section spacing="large" background="primary">
  <div class="flex flex-col gap-8 md:gap-12 items-stretch sm:items-center">
    <SectionHeader eyebrow={eyebrow} heading={heading} description={description} headingLevel={1} size="large" align="center" background="primary" />
    <form method="post" class="flex w-full max-w-md flex-col gap-2 text-center">
      <div class="flex flex-col gap-3 sm:flex-row">
        <Input type="email" name="email" placeholder="Enter your email" aria-label="Email" autocomplete="email" required size="large" class="flex-1 text-start" />
        <Button type="submit" size="large" color="neutral">Get started</Button>
      </div>
      <p class="text-sm opacity-85">We care about your data in our <Link href="#" color="inherit">privacy policy</Link>.</p>
    </form>
  </div>
</Section>
