---
/**
 * Centered buttons: A centred heading, line and two buttons.
 *
 * @block header
 * @order 3
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Button from '../../components/Button/Button.astro'

---

<Section spacing="large">
  <div class="flex flex-col gap-8 md:gap-12 items-stretch sm:items-center">
    <SectionHeader eyebrow="Pricing" heading="Plans that fit your scale" description="Simple, transparent pricing that grows with you. Try any plan free for 30 days." headingLevel={1} size="large" align="center" />
    <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-center">
      <Button href="#" size="large" variant="outline" color="neutral">Chat to sales</Button>
      <Button href="#" size="large">Get started</Button>
    </div>
  </div>
</Section>
