---
/**
 * Left email brand: A left-aligned heading, line and email signup on the brand colour.
 *
 * @block header
 * @order 16
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Button from '../../components/Button/Button.astro'
import Link from '../../components/Link/Link.astro'
import Input from '../../components/Input/Input.astro'
import { plain } from '../../sections/_shared/spine.ts'
import type { PageHeaderContent } from '../../sections/_shared/header.ts'

/** @composable */
interface Props extends PageHeaderContent {
  /** The email form button. @category content */
  submitLabel?: string
}
const {
  eyebrow = 'Resources',
  heading = 'The Larkspur blog',
  description = 'The latest industry news, technologies and resources from our team.',
  submitLabel = 'Get started',
} = Astro.props
---

<Section spacing="large" background="primary">
  <div class="flex flex-col gap-8 md:gap-12 items-start">
    <SectionHeader eyebrow={eyebrow ?? undefined} heading={plain(heading)} description={description ?? undefined} headingLevel={1} size="large" background="primary" />
    <form method="post" class="flex w-full max-w-md flex-col gap-2">
      <div class="flex flex-col gap-3 sm:flex-row">
        <Input type="email" name="email" placeholder="Enter your email" aria-label="Email" autocomplete="email" required size="large" class="flex-1 text-start" />
        <Button type="submit" size="large" color="neutral">{submitLabel}</Button>
      </div>
      <p class="text-sm opacity-85">We care about your data in our <Link href="#" color="inherit">privacy policy</Link>.</p>
    </form>
  </div>
</Section>
