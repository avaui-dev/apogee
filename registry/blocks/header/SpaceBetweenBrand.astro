---
/**
 * Space between brand: A split eyebrow, heading and line on the brand colour.
 *
 * @block header
 * @order 22
 */
import Section from '../../components/Section/Section.astro'
import Eyebrow from '../../components/Eyebrow/Eyebrow.astro'
import Heading from '../../components/Heading/Heading.astro'
import Text from '../../components/Text/Text.astro'
import { plain } from '../../sections/_shared/spine.ts'
import type { PageHeaderContent } from '../../sections/_shared/header.ts'

/** @composable */
interface Props extends PageHeaderContent {}
const { eyebrow = 'About us', heading = 'About the company', description = 'Learn more about the company and the team behind it.' } = Astro.props
---

<Section spacing="large" background="primary">
  {eyebrow && <Eyebrow as="p" color="inherit">{eyebrow}</Eyebrow>}
  <div class="mt-3 grid gap-4 md:gap-6 lg:grid-cols-[minmax(0,1fr)_30rem] lg:gap-x-16">
    <Heading as="h1" size="display" class="text-balance">{plain(heading)}</Heading>
    {description && <Text size="large" class="opacity-85 lg:mt-3">{description}</Text>}
  </div>
</Section>
