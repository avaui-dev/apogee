---
/**
 * Space between tabs: A split heading, line and a billing switch.
 *
 * @block header
 * @order 29
 */
import Section from '../../components/Section/Section.astro'
import Eyebrow from '../../components/Eyebrow/Eyebrow.astro'
import Heading from '../../components/Heading/Heading.astro'
import Text from '../../components/Text/Text.astro'
import SegmentedControl from '../../components/SegmentedControl/SegmentedControl.astro'
import { plain } from '../../sections/_shared/spine.ts'
import type { PageHeaderContent } from '../../sections/_shared/header.ts'

/** @composable */
interface Props extends PageHeaderContent {}
const { eyebrow = 'Pricing', heading = 'Simple, transparent pricing', description = 'Simple, transparent pricing that grows with you. Try any plan free for 30 days.' } = Astro.props
---

<Section spacing="large">
  {eyebrow && <Eyebrow as="p" color="primary">{eyebrow}</Eyebrow>}
  <div class="mt-3 grid gap-4 md:gap-6 lg:grid-cols-[minmax(0,1fr)_30rem] lg:gap-x-16">
    <Heading as="h1" size="display" class="text-balance">{plain(heading)}</Heading>
    {description && <Text size="large" class="text-neutral-faded lg:mt-3">{description}</Text>}
  </div>
  <div class="mt-8">
    <SegmentedControl name="billing" options={[{ label: 'Monthly billing', value: 'monthly' }, { label: 'Annual billing', value: 'annual' }]} value="monthly" aria-label="Billing period" size="large" />
  </div>
</Section>
