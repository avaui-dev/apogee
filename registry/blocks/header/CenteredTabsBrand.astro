---
/**
 * Centered tabs brand: A centred heading, line and a billing switch on the brand colour.
 *
 * @block header
 * @order 10
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import SegmentedControl from '../../components/SegmentedControl/SegmentedControl.astro'
import { plain } from '../../sections/_shared/spine.ts'
import type { PageHeaderContent } from '../../sections/_shared/header.ts'

/** @composable */
interface Props extends PageHeaderContent {}
const { eyebrow = 'Pricing', heading = 'Simple, transparent pricing', description = 'Simple, transparent pricing that grows with you. Try any plan free for 30 days.' } = Astro.props
---

<Section spacing="large" background="primary">
  <div class="flex flex-col gap-8 md:gap-12 items-stretch sm:items-center">
    <SectionHeader eyebrow={eyebrow ?? undefined} heading={plain(heading)} description={description ?? undefined} headingLevel={1} size="large" align="center" background="primary" />
    <SegmentedControl name="billing" options={[{ label: 'Monthly billing', value: 'monthly' }, { label: 'Annual billing', value: 'annual' }]} value="monthly" aria-label="Billing period" size="large" class="bg-page" />
  </div>
</Section>
