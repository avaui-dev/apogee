---
/**
 * Left: A left-aligned eyebrow, heading and line.
 *
 * @block header
 * @order 11
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'

interface Props {
  eyebrow?: string
  heading?: string
  description?: string
}
const { eyebrow = 'About us', heading = 'About the company', description = 'Learn more about the company and the team behind it.' } = Astro.props
---

<Section spacing="large">
  <SectionHeader eyebrow={eyebrow} heading={heading} description={description} headingLevel={1} size="large" />
</Section>
