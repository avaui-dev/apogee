---
/**
 * Centered buttons brand: A centred heading, line and two buttons on the brand colour.
 *
 * @block header
 * @order 4
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Button from '../../components/Button/Button.astro'
import { plain } from '../../sections/_shared/spine.ts'
import type { PageHeaderContent } from '../../sections/_shared/header.ts'

/** @composable */
interface Props extends PageHeaderContent {}
const {
  eyebrow = 'Pricing',
  heading = 'Plans that fit your scale',
  description = 'Simple, transparent pricing that grows with you. Try any plan free for 30 days.',
  primaryAction = { label: 'Get started', href: '#' },
  secondaryAction = { label: 'Chat to sales', href: '#' },
} = Astro.props
---

<Section spacing="large" background="primary">
  <div class="flex flex-col gap-8 md:gap-12 items-stretch sm:items-center">
    <SectionHeader eyebrow={eyebrow ?? undefined} heading={plain(heading)} description={description ?? undefined} headingLevel={1} size="large" align="center" background="primary" />
    {(primaryAction || secondaryAction) && (
      <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-center">
        {secondaryAction && <Button href={secondaryAction.href} size="large" variant="outline" color="neutral" class="border-current! bg-transparent! text-inherit! shadow-none!">{secondaryAction.label}</Button>}
        {primaryAction && <Button href={primaryAction.href} size="large" color="neutral">{primaryAction.label}</Button>}
      </div>
    )}
  </div>
</Section>
