---
/**
 * Left brand: A left-aligned eyebrow, heading and line on the brand colour.
 *
 * @block header
 * @order 12
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import { plain } from '../../sections/_shared/spine.ts'
import type { PageHeaderContent } from '../../sections/_shared/header.ts'

/** @composable */
interface Props extends PageHeaderContent {}
const { eyebrow = 'About us', heading = 'About the company', description = 'Learn more about the company and the team behind it.' } = Astro.props
---

<Section spacing="large" background="primary">
  <SectionHeader eyebrow={eyebrow ?? undefined} heading={plain(heading)} description={description ?? undefined} headingLevel={1} size="large" background="primary" />
</Section>
