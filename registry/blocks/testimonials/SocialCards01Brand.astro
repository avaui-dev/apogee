---
/**
 * Social cards 01brand: Four quote cards with the person, a verified mark and their company on the brand colour.
 *
 * @block testimonials
 * @order 12
 */
import { Atom, BadgeCheck, Hexagon, Mountain, Sprout } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Avatar from '../../components/Avatar/Avatar.astro'

---

<Section spacing="large" background="primary">
  <div class="flex flex-col gap-12 md:gap-16">
    <SectionHeader heading="What our customers say" description="Hear from the teams building with us every day." size="large" align="center" background="primary" />
    <div class="grid gap-5 lg:grid-cols-2 lg:gap-6">
    <figure class="flex flex-col gap-8 rounded-xl p-6 lg:min-h-64 lg:justify-between lg:p-8 bg-page/10">
      <span class="lg:hidden"><span class="flex items-center gap-2 text-lg font-semibold opacity-85"><Hexagon class="size-7" aria-hidden="true" />Lumen</span></span>
      <blockquote class="text-lg font-medium lg:text-xl"><p>“We shipped our redesign in three weeks instead of three months. The team still talks about it.”</p></blockquote>
      <div class="flex items-center justify-between gap-4"><figcaption class="flex items-center gap-3"><Avatar src="https://picsum.photos/id/1027/192/192" name="Amara Nwosu" alt="" size="large" border /><span class="flex flex-col"><span class="flex items-center gap-1 font-semibold">Amara Nwosu<BadgeCheck class="size-4 text-inherit" aria-label="Verified" /></span><span class="text-sm opacity-85">Head of Operations, Lumen</span></span></figcaption><span class="max-lg:hidden"><span class="flex items-center gap-2 text-lg font-semibold opacity-85"><Hexagon class="size-7" aria-hidden="true" />Lumen</span></span></div>
    </figure>
    <figure class="flex flex-col gap-8 rounded-xl p-6 lg:min-h-64 lg:justify-between lg:p-8 bg-page/10">
      <span class="lg:hidden"><span class="flex items-center gap-2 text-lg font-semibold opacity-85"><Atom class="size-7" aria-hidden="true" />Quanta</span></span>
      <blockquote class="text-lg font-medium lg:text-xl"><p>“Every page we build now looks like it belongs together. Our designers finally trust what ships.”</p></blockquote>
      <div class="flex items-center justify-between gap-4"><figcaption class="flex items-center gap-3"><Avatar src="https://picsum.photos/id/91/192/192" name="Daniel Reyes" alt="" size="large" border /><span class="flex flex-col"><span class="flex items-center gap-1 font-semibold">Daniel Reyes<BadgeCheck class="size-4 text-inherit" aria-label="Verified" /></span><span class="text-sm opacity-85">Engineering Lead, Quanta</span></span></figcaption><span class="max-lg:hidden"><span class="flex items-center gap-2 text-lg font-semibold opacity-85"><Atom class="size-7" aria-hidden="true" />Quanta</span></span></div>
    </figure>
    <figure class="flex flex-col gap-8 rounded-xl p-6 lg:min-h-64 lg:justify-between lg:p-8 bg-page/10">
      <span class="lg:hidden"><span class="flex items-center gap-2 text-lg font-semibold opacity-85"><Sprout class="size-7" aria-hidden="true" />Fieldwork</span></span>
      <blockquote class="text-lg font-medium lg:text-xl"><p>“Support answered in minutes, and the fix was live the same afternoon.”</p></blockquote>
      <div class="flex items-center justify-between gap-4"><figcaption class="flex items-center gap-3"><Avatar src="https://picsum.photos/id/832/192/192" name="Sofia Marchetti" alt="" size="large" border /><span class="flex flex-col"><span class="flex items-center gap-1 font-semibold">Sofia Marchetti<BadgeCheck class="size-4 text-inherit" aria-label="Verified" /></span><span class="text-sm opacity-85">Product Designer, Fieldwork</span></span></figcaption><span class="max-lg:hidden"><span class="flex items-center gap-2 text-lg font-semibold opacity-85"><Sprout class="size-7" aria-hidden="true" />Fieldwork</span></span></div>
    </figure>
    <figure class="flex flex-col gap-8 rounded-xl p-6 lg:min-h-64 lg:justify-between lg:p-8 bg-page/10">
      <span class="lg:hidden"><span class="flex items-center gap-2 text-lg font-semibold opacity-85"><Mountain class="size-7" aria-hidden="true" />Northpeak</span></span>
      <blockquote class="text-lg font-medium lg:text-xl"><p>“We tried building our own component library twice. This time we started from parts that were already accessible and tested, and spent our time on the product instead of on focus rings and contrast checks.”</p></blockquote>
      <div class="flex items-center justify-between gap-4"><figcaption class="flex items-center gap-3"><Avatar src="https://picsum.photos/id/856/192/192" name="Kenji Watanabe" alt="" size="large" border /><span class="flex flex-col"><span class="flex items-center gap-1 font-semibold">Kenji Watanabe<BadgeCheck class="size-4 text-inherit" aria-label="Verified" /></span><span class="text-sm opacity-85">Founder, Northpeak</span></span></figcaption><span class="max-lg:hidden"><span class="flex items-center gap-2 text-lg font-semibold opacity-85"><Mountain class="size-7" aria-hidden="true" />Northpeak</span></span></div>
    </figure>
    </div>
  </div>
</Section>
