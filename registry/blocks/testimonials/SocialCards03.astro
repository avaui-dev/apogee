---
/**
 * Social cards 03: Nine quote cards in staggered columns that fade out at the bottom.
 *
 * @block testimonials
 * @order 15
 */
import { Atom, BadgeCheck, Hexagon, Mountain, Sprout, Waves, Wind } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Avatar from '../../components/Avatar/Avatar.astro'

---

<Section spacing="large">
  <div class="flex flex-col gap-12 md:gap-16">
    <SectionHeader heading="What our customers say" description="Hear from the teams building with us every day." size="large" align="center" />
    <div class="-mx-4 -mt-4 max-h-[61rem] gap-6 overflow-hidden px-4 pt-4 mask-b-from-70% lg:columns-3 max-md:[&>*:nth-child(n+4)]:hidden">
      <figure class="mb-6 flex break-inside-avoid flex-col gap-6 rounded-xl p-6 lg:p-8 bg-elevation-raised shadow-raised ring-1 ring-neutral">
        <span class="flex items-center gap-2 text-lg font-semibold text-neutral"><Hexagon class="size-7" aria-hidden="true" />Lumen</span>
        <blockquote class="text-neutral-faded"><p>“We shipped our redesign in three weeks instead of three months. The team still talks about it.”</p></blockquote>
        <figcaption class="flex items-center gap-3"><Avatar src="https://picsum.photos/id/1027/192/192" name="Amara Nwosu" alt="" size="large" border /><span class="flex flex-col"><span class="flex items-center gap-1 font-semibold">Amara Nwosu<BadgeCheck class="size-4 text-primary" aria-label="Verified" /></span><span class="text-sm text-neutral-faded">Head of Operations, Lumen</span></span></figcaption>
      </figure>
      <figure class="mb-6 flex break-inside-avoid flex-col gap-6 rounded-xl p-6 lg:p-8 bg-elevation-raised shadow-raised ring-1 ring-neutral">
        <span class="flex items-center gap-2 text-lg font-semibold text-neutral"><Atom class="size-7" aria-hidden="true" />Quanta</span>
        <blockquote class="text-neutral-faded"><p>“Every page we build now looks like it belongs together. Our designers finally trust what ships.”</p></blockquote>
        <figcaption class="flex items-center gap-3"><Avatar src="https://picsum.photos/id/91/192/192" name="Daniel Reyes" alt="" size="large" border /><span class="flex flex-col"><span class="flex items-center gap-1 font-semibold">Daniel Reyes<BadgeCheck class="size-4 text-primary" aria-label="Verified" /></span><span class="text-sm text-neutral-faded">Engineering Lead, Quanta</span></span></figcaption>
      </figure>
      <figure class="mb-6 flex break-inside-avoid flex-col gap-6 rounded-xl p-6 lg:p-8 bg-elevation-raised shadow-raised ring-1 ring-neutral">
        <span class="flex items-center gap-2 text-lg font-semibold text-neutral"><Sprout class="size-7" aria-hidden="true" />Fieldwork</span>
        <blockquote class="text-neutral-faded"><p>“Support answered in minutes, and the fix was live the same afternoon.”</p></blockquote>
        <figcaption class="flex items-center gap-3"><Avatar src="https://picsum.photos/id/832/192/192" name="Sofia Marchetti" alt="" size="large" border /><span class="flex flex-col"><span class="flex items-center gap-1 font-semibold">Sofia Marchetti<BadgeCheck class="size-4 text-primary" aria-label="Verified" /></span><span class="text-sm text-neutral-faded">Product Designer, Fieldwork</span></span></figcaption>
      </figure>
      <figure class="mb-6 flex break-inside-avoid flex-col gap-6 rounded-xl p-6 lg:p-8 bg-elevation-raised shadow-raised ring-1 ring-neutral">
        <span class="flex items-center gap-2 text-lg font-semibold text-neutral"><Mountain class="size-7" aria-hidden="true" />Northpeak</span>
        <blockquote class="text-neutral-faded"><p>“We tried building our own component library twice. This time we started from parts that were already accessible and tested, and spent our time on the product instead of on focus rings and contrast checks.”</p></blockquote>
        <figcaption class="flex items-center gap-3"><Avatar src="https://picsum.photos/id/856/192/192" name="Kenji Watanabe" alt="" size="large" border /><span class="flex flex-col"><span class="flex items-center gap-1 font-semibold">Kenji Watanabe<BadgeCheck class="size-4 text-primary" aria-label="Verified" /></span><span class="text-sm text-neutral-faded">Founder, Northpeak</span></span></figcaption>
      </figure>
      <figure class="mb-6 flex break-inside-avoid flex-col gap-6 rounded-xl p-6 lg:p-8 bg-elevation-raised shadow-raised ring-1 ring-neutral">
        <span class="flex items-center gap-2 text-lg font-semibold text-neutral"><Waves class="size-7" aria-hidden="true" />Arcwave</span>
        <blockquote class="text-neutral-faded"><p>“The reports used to take a whole afternoon to put together. Now they are ready before our Monday meeting, and everyone reads the same numbers.”</p></blockquote>
        <figcaption class="flex items-center gap-3"><Avatar src="https://picsum.photos/id/823/192/192" name="Leah Goldberg" alt="" size="large" border /><span class="flex flex-col"><span class="flex items-center gap-1 font-semibold">Leah Goldberg<BadgeCheck class="size-4 text-primary" aria-label="Verified" /></span><span class="text-sm text-neutral-faded">Customer Success Lead, Arcwave</span></span></figcaption>
      </figure>
      <figure class="mb-6 flex break-inside-avoid flex-col gap-6 rounded-xl p-6 lg:p-8 bg-elevation-raised shadow-raised ring-1 ring-neutral">
        <span class="flex items-center gap-2 text-lg font-semibold text-neutral"><Wind class="size-7" aria-hidden="true" />Kitestring</span>
        <blockquote class="text-neutral-faded"><p>“What sold us was the detail: keyboard support everywhere, dark mode that just works, and docs that answer the question you actually have.”</p></blockquote>
        <figcaption class="flex items-center gap-3"><Avatar src="https://picsum.photos/id/375/192/192" name="Omar Haddad" alt="" size="large" border /><span class="flex flex-col"><span class="flex items-center gap-1 font-semibold">Omar Haddad<BadgeCheck class="size-4 text-primary" aria-label="Verified" /></span><span class="text-sm text-neutral-faded">CTO, Kitestring</span></span></figcaption>
      </figure>
      <figure class="mb-6 flex break-inside-avoid flex-col gap-6 rounded-xl p-6 lg:p-8 bg-elevation-raised shadow-raised ring-1 ring-neutral">
        <span class="flex items-center gap-2 text-lg font-semibold text-neutral"><Hexagon class="size-7" aria-hidden="true" />Lumen</span>
        <blockquote class="text-neutral-faded"><p>“It replaced four tools and a spreadsheet nobody wanted to open.”</p></blockquote>
        <figcaption class="flex items-center gap-3"><Avatar src="https://picsum.photos/id/64/192/192" name="Ines Duarte" alt="" size="large" border /><span class="flex flex-col"><span class="flex items-center gap-1 font-semibold">Ines Duarte<BadgeCheck class="size-4 text-primary" aria-label="Verified" /></span><span class="text-sm text-neutral-faded">Marketing Director, Lumen</span></span></figcaption>
      </figure>
      <figure class="mb-6 flex break-inside-avoid flex-col gap-6 rounded-xl p-6 lg:p-8 bg-elevation-raised shadow-raised ring-1 ring-neutral">
        <span class="flex items-center gap-2 text-lg font-semibold text-neutral"><Atom class="size-7" aria-hidden="true" />Quanta</span>
        <blockquote class="text-neutral-faded"><p>“Onboarding took a day. Our new hires were shipping by the end of their first week.”</p></blockquote>
        <figcaption class="flex items-center gap-3"><Avatar src="https://picsum.photos/id/669/192/192" name="Tobias Brandt" alt="" size="large" border /><span class="flex flex-col"><span class="flex items-center gap-1 font-semibold">Tobias Brandt<BadgeCheck class="size-4 text-primary" aria-label="Verified" /></span><span class="text-sm text-neutral-faded">Frontend Developer, Quanta</span></span></figcaption>
      </figure>
      <figure class="mb-6 flex break-inside-avoid flex-col gap-6 rounded-xl p-6 lg:p-8 bg-elevation-raised shadow-raised ring-1 ring-neutral">
        <span class="flex items-center gap-2 text-lg font-semibold text-neutral"><Sprout class="size-7" aria-hidden="true" />Fieldwork</span>
        <blockquote class="text-neutral-faded"><p>“We shipped our redesign in three weeks instead of three months. The team still talks about it.”</p></blockquote>
        <figcaption class="flex items-center gap-3"><Avatar src="https://picsum.photos/id/836/192/192" name="Priya Nair" alt="" size="large" border /><span class="flex flex-col"><span class="flex items-center gap-1 font-semibold">Priya Nair<BadgeCheck class="size-4 text-primary" aria-label="Verified" /></span><span class="text-sm text-neutral-faded">Head of Design, Fieldwork</span></span></figcaption>
      </figure>
    </div>
  </div>
</Section>
