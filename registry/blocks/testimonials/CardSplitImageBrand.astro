---
/**
 * Card split image brand: Rotating quotes in a brand-colour card beside a video of the customer.
 *
 * @block testimonials
 * @order 22
 */
import Section from '../../components/Section/Section.astro'
import Rating from '../../components/Rating/Rating.astro'
import Carousel from '../../components/Carousel/Carousel.astro'
import VideoPlayer from '../../components/VideoPlayer/VideoPlayer.astro'
import type { TestimonialsContent } from '../../sections/_shared/testimonials.ts'

/** @composable */
interface Props extends TestimonialsContent {
  /** The customer video beside the quotes; `title` names it for screen readers. @category content */
  video?: { src: string; title: string; poster?: string; captions?: string } | null
}

const {
  label = 'Testimonials',
  items = [
    { quote: 'We shipped our redesign in three weeks instead of three months. The team still talks about it.', name: 'Amara Nwosu', role: 'Head of Operations, Lumen', rating: 5 },
    { quote: 'Every page we build now looks like it belongs together. Our designers finally trust what ships.', name: 'Daniel Reyes', role: 'Engineering Lead, Quanta', rating: 5 },
    { quote: 'Support answered in minutes, and the fix was live the same afternoon.', name: 'Sofia Marchetti', role: 'Product Designer, Fieldwork', rating: 5 },
  ],
  video = { src: '/media/app-tour.mp4', poster: 'https://picsum.photos/id/823/960/1080', captions: '/media/app-tour.vtt', title: 'Leah Goldberg on working with us' },
} = Astro.props
---

<Section spacing="large">
  <div class="grid overflow-hidden rounded-2xl md:rounded-3xl lg:grid-cols-[1fr_auto] bg-primary text-on-primary">
    <div class="min-w-0 p-6 md:p-8 lg:p-16">
      <Carousel label={label} visibleItems={{ base: 1 }} controls={false} dots>
          {items.map((t) => (
          <figure class="flex flex-col gap-6">
            {t.rating != null && <Rating value={t.rating} readonly size="small" color="warning" aria-label={`Rated ${t.rating} out of 5`} />}
            <blockquote class="text-xl font-medium tracking-tight text-balance md:text-3xl"><p>“{t.quote}”</p></blockquote>
            <figcaption class="flex flex-col gap-1"><span class="flex flex-col"><span class="flex items-center gap-1 font-semibold">— {t.name}</span>{t.role && <span class="text-sm opacity-85">{t.role}</span>}</span></figcaption>
          </figure>
          ))}
      </Carousel>
    </div>
    {video && <VideoPlayer src={video.src} poster={video.poster} captions={video.captions} title={video.title} ratio="1/1" radius="none" class="border-0 lg:w-120" />}
  </div>
</Section>
