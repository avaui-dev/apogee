---
/**
 * Large table 01: A centred heading over a plan comparison table with grouped features and tooltips.
 *
 * @block pricing
 * @order 21
 */
import { CircleCheck, CircleHelp, Minus } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Button from '../../components/Button/Button.astro'
import Badge from '../../components/Badge/Badge.astro'
import Table from '../../components/Table/Table.astro'
import Tooltip from '../../components/Tooltip/Tooltip.astro'

---

<Section spacing="large">
