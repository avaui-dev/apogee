---
/**
 * Simple cards 03: A centred heading over three plan cards with two actions and a features panel.
 *
 * @block pricing
 * @order 3
 */
import { CircleCheck } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Heading from '../../components/Heading/Heading.astro'
import Button from '../../components/Button/Button.astro'
import Badge from '../../components/Badge/Badge.astro'

---

<Section spacing="large">
  <div class="flex flex-col gap-12 md:gap-16">
    <SectionHeader eyebrow="Pricing" heading="Plans that fit your scale" description="Simple, transparent pricing that grows with you. Try any plan free for 30 days." size="medium" align="center" />
    <div class="grid gap-4 md:grid-cols-2 md:gap-8 xl:grid-cols-3">
    <div class="flex flex-col overflow-hidden rounded-2xl bg-elevation-raised shadow-raised ring-1 ring-neutral">
      <div class="flex flex-col gap-4 p-6 md:p-8">
        <div class="flex items-center justify-between gap-2"><Heading as="h3" size="h6" class="text-neutral-faded">Basic plan</Heading><Badge color="primary" rounded>Popular</Badge></div>
        <p class="flex items-baseline gap-1"><span class="text-5xl font-semibold tracking-tight tabular-nums md:text-6xl">$10</span><span class="text-neutral-faded">per month</span></p>
        <p class="text-neutral-faded">Basic features for up to 10 users.</p>
        <div class="flex flex-col gap-3 mt-4">
        <Button href="#" size="large" fullWidth>Get started</Button>
        <Button href="#" size="large" variant="outline" color="neutral" fullWidth>Chat to sales</Button>
      </div>
      </div>
      <div class="flex flex-1 flex-col gap-6 border-t border-neutral bg-neutral-faded p-6 md:p-8">
        <div class="flex flex-col gap-1">
          <p class="text-sm font-semibold uppercase tracking-wide">Features</p>
          <p class="text-neutral-faded">Everything in <strong class="font-semibold text-neutral">Starter</strong>, plus:</p>
        </div>
      <ul class="flex list-none flex-col gap-4 p-0 text-neutral-faded">
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Access to basic features</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Basic reporting and analytics</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Up to 10 individual users</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>20 GB individual data</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Basic chat and email support</span></li>
      </ul>
      </div>
    </div>
    <div class="flex flex-col overflow-hidden rounded-2xl bg-elevation-raised shadow-raised ring-1 ring-neutral">
      <div class="flex flex-col gap-4 p-6 md:p-8">
        <div class="flex items-center justify-between gap-2"><Heading as="h3" size="h6" class="text-neutral-faded">Business plan</Heading></div>
        <p class="flex items-baseline gap-1"><span class="text-5xl font-semibold tracking-tight tabular-nums md:text-6xl">$20</span><span class="text-neutral-faded">per month</span></p>
        <p class="text-neutral-faded">Advanced features and reporting.</p>
        <div class="flex flex-col gap-3 mt-4">
        <Button href="#" size="large" fullWidth>Get started</Button>
        <Button href="#" size="large" variant="outline" color="neutral" fullWidth>Chat to sales</Button>
      </div>
      </div>
      <div class="flex flex-1 flex-col gap-6 border-t border-neutral bg-neutral-faded p-6 md:p-8">
        <div class="flex flex-col gap-1">
          <p class="text-sm font-semibold uppercase tracking-wide">Features</p>
          <p class="text-neutral-faded">Everything in <strong class="font-semibold text-neutral">Basic</strong>, plus:</p>
        </div>
      <ul class="flex list-none flex-col gap-4 p-0 text-neutral-faded">
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Access to basic features</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Basic reporting and analytics</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Up to 10 individual users</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>20 GB individual data</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Basic chat and email support</span></li>
      </ul>
      </div>
    </div>
    <div class="flex flex-col overflow-hidden rounded-2xl bg-elevation-raised shadow-raised ring-1 ring-neutral">
      <div class="flex flex-col gap-4 p-6 md:p-8">
        <div class="flex items-center justify-between gap-2"><Heading as="h3" size="h6" class="text-neutral-faded">Enterprise plan</Heading></div>
        <p class="flex items-baseline gap-1"><span class="text-5xl font-semibold tracking-tight tabular-nums md:text-6xl">$40</span><span class="text-neutral-faded">per month</span></p>
        <p class="text-neutral-faded">Unlimited features.</p>
        <div class="flex flex-col gap-3 mt-4">
        <Button href="#" size="large" fullWidth>Get started</Button>
        <Button href="#" size="large" variant="outline" color="neutral" fullWidth>Chat to sales</Button>
      </div>
      </div>
      <div class="flex flex-1 flex-col gap-6 border-t border-neutral bg-neutral-faded p-6 md:p-8">
        <div class="flex flex-col gap-1">
          <p class="text-sm font-semibold uppercase tracking-wide">Features</p>
          <p class="text-neutral-faded">Everything in <strong class="font-semibold text-neutral">Business</strong>, plus:</p>
        </div>
      <ul class="flex list-none flex-col gap-4 p-0 text-neutral-faded">
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Access to basic features</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Basic reporting and analytics</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Up to 10 individual users</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>20 GB individual data</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Basic chat and email support</span></li>
      </ul>
      </div>
    </div>
  </div>
  </div>
</Section>
