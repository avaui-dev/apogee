---
/**
 * Dual action: A centred heading and billing switch over three plan cards with two actions and a features panel.
 *
 * @block pricing
 * @order 18
 */
import { CircleCheck } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Heading from '../../components/Heading/Heading.astro'
import Button from '../../components/Button/Button.astro'
import Badge from '../../components/Badge/Badge.astro'
import SegmentedControl from '../../components/SegmentedControl/SegmentedControl.astro'

interface Props {
  /** 1 when the block opens a page; its items move one level down with it. */
  headingLevel?: 1 | 2
}
const { headingLevel = 2 } = Astro.props
const itemLevel = headingLevel === 1 ? (2 as const) : (3 as const)
---

<Section spacing="large">
  <div class="group/pricing flex flex-col gap-12 md:gap-16">
    <div class="flex flex-col items-stretch gap-8 sm:items-center md:gap-12">
      <SectionHeader headingLevel={headingLevel} eyebrow="Pricing" heading="Simple, transparent pricing" description="We believe good tools should be open to every company, whatever its size." size="large" align="center" />
      <SegmentedControl name="billing" options={[{ label: 'Monthly billing', value: 'monthly' }, { label: 'Annual billing', value: 'annual' }]} value="monthly" aria-label="Billing period" size="large" />
    </div>
    <div class="grid gap-4 md:grid-cols-2 md:gap-8 xl:grid-cols-3 items-end">
    <div class="flex flex-col overflow-hidden rounded-2xl bg-elevation-raised shadow-raised ring-1 ring-neutral">
      <div class="flex flex-col gap-4 p-6 md:p-8">
        <div class="flex items-center justify-between gap-2"><Heading as={itemLevel === 2 ? 'h2' : 'h3'} size="h6" class="text-neutral-faded">Basic plan</Heading><Badge color="primary" rounded>Popular</Badge></div>
        <p class="flex items-baseline gap-1"><span class="text-5xl font-semibold tracking-tight tabular-nums md:text-6xl"><span class="group-has-[[value=annual]:checked]/pricing:hidden">$10</span><span class="hidden group-has-[[value=annual]:checked]/pricing:inline">$9</span></span><span class="text-neutral-faded">per month</span></p>
        <p class="text-neutral-faded">Our most popular plan.</p>
        <div class="flex flex-col gap-3 mt-4">
        <Button href="#" size="large" fullWidth>Get started</Button>
        <Button href="#" size="large" variant="outline" color="neutral" fullWidth>Chat to sales</Button>
      </div>
      </div>
      <div class="flex flex-1 flex-col gap-6 border-t border-neutral bg-neutral-faded p-6 md:p-8">
        <div class="flex flex-col gap-1">
          <p class="text-sm font-semibold uppercase tracking-wide">Features</p>
          <p class="text-neutral-faded">Everything in <strong class="font-semibold text-neutral">our free plan</strong>, plus:</p>
        </div>
      <ul class="flex list-none flex-col gap-4 p-0 text-neutral-faded">
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Access to basic features</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Basic reporting and analytics</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Up to 10 individual users</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>20 GB individual data</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Basic chat and email support</span></li>
      </ul>
      </div>
    </div>
    <div class="flex flex-col overflow-hidden rounded-2xl bg-elevation-raised shadow-raised ring-1 ring-neutral">
      <div class="flex flex-col gap-4 p-6 md:p-8">
        <div class="flex items-center justify-between gap-2"><Heading as={itemLevel === 2 ? 'h2' : 'h3'} size="h6" class="text-neutral-faded">Business plan</Heading></div>
        <p class="flex items-baseline gap-1"><span class="text-5xl font-semibold tracking-tight tabular-nums md:text-6xl"><span class="group-has-[[value=annual]:checked]/pricing:hidden">$20</span><span class="hidden group-has-[[value=annual]:checked]/pricing:inline">$15</span></span><span class="text-neutral-faded">per month</span></p>
        <p class="text-neutral-faded">Growing teams up to 20 users.</p>
        <div class="flex flex-col gap-3 mt-4">
        <Button href="#" size="large" fullWidth>Get started</Button>
        <Button href="#" size="large" variant="outline" color="neutral" fullWidth>Chat to sales</Button>
      </div>
      </div>
      <div class="flex flex-1 flex-col gap-6 border-t border-neutral bg-neutral-faded p-6 md:p-8">
        <div class="flex flex-col gap-1">
          <p class="text-sm font-semibold uppercase tracking-wide">Features</p>
          <p class="text-neutral-faded">Everything in <strong class="font-semibold text-neutral">Basic</strong>, plus:</p>
        </div>
      <ul class="flex list-none flex-col gap-4 p-0 text-neutral-faded">
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>200+ integrations</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Advanced reporting and analytics</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Up to 20 individual users</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>40 GB individual data</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Priority chat and email support</span></li>
      </ul>
      </div>
    </div>
    <div class="flex flex-col overflow-hidden rounded-2xl bg-elevation-raised shadow-raised ring-1 ring-neutral">
      <div class="flex flex-col gap-4 p-6 md:p-8">
        <div class="flex items-center justify-between gap-2"><Heading as={itemLevel === 2 ? 'h2' : 'h3'} size="h6" class="text-neutral-faded">Enterprise plan</Heading></div>
        <p class="flex items-baseline gap-1"><span class="text-5xl font-semibold tracking-tight tabular-nums md:text-6xl"><span class="group-has-[[value=annual]:checked]/pricing:hidden">$40</span><span class="hidden group-has-[[value=annual]:checked]/pricing:inline">$39</span></span><span class="text-neutral-faded">per month</span></p>
        <p class="text-neutral-faded">Advanced features and unlimited users.</p>
        <div class="flex flex-col gap-3 mt-4">
        <Button href="#" size="large" fullWidth>Get started</Button>
        <Button href="#" size="large" variant="outline" color="neutral" fullWidth>Chat to sales</Button>
      </div>
      </div>
      <div class="flex flex-1 flex-col gap-6 border-t border-neutral bg-neutral-faded p-6 md:p-8">
        <div class="flex flex-col gap-1">
          <p class="text-sm font-semibold uppercase tracking-wide">Features</p>
          <p class="text-neutral-faded">Everything in <strong class="font-semibold text-neutral">Business</strong>, plus:</p>
        </div>
      <ul class="flex list-none flex-col gap-4 p-0 text-neutral-faded">
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Advanced custom fields</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Audit log and data history</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Unlimited individual users</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Unlimited individual data</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Personalised and priority service</span></li>
      </ul>
      </div>
    </div>
  </div>
  </div>
</Section>
