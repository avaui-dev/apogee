---
/**
 * Simple icon offset: A centred heading with actions over three grey plan cards with icons on their top edge.
 *
 * @block pricing
 * @order 11
 */
import { CircleCheck, Layers2, Layers3, Zap } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Heading from '../../components/Heading/Heading.astro'
import Button from '../../components/Button/Button.astro'
import FeaturedIcon from '../../components/FeaturedIcon/FeaturedIcon.astro'

---

<Section spacing="large">
  <div class="flex flex-col gap-12 md:gap-16">
    <div class="flex flex-col items-center gap-8">
      <SectionHeader eyebrow="Pricing" heading="Plans that fit your scale" description="Simple, transparent pricing that grows with you. Try any plan free for 30 days." size="large" align="center" />
      <div class="flex flex-col-reverse gap-3 sm:flex-row">
        <Button href="#" size="large" variant="outline" color="neutral">Chat to sales</Button>
        <Button href="#" size="large">Get started</Button>
      </div>
    </div>
    <div class="grid gap-4 md:grid-cols-2 md:gap-8 xl:grid-cols-3 gap-10">
    <div class="relative mt-6 flex flex-col items-center gap-8 rounded-2xl bg-neutral-faded px-6 pt-12 pb-8 text-center md:px-8">
      <div class="absolute -top-6 start-1/2 -translate-x-1/2 rtl:translate-x-1/2"><FeaturedIcon theme="outline" color="neutral" size="large"><Zap /></FeaturedIcon></div>
      <div class="flex flex-col items-center gap-2">
        <Heading as="h3" size="h5">Basic plan</Heading>
        <p class="flex items-baseline justify-center gap-1"><span class="text-5xl md:text-6xl font-semibold tracking-tight tabular-nums">$10</span><span class="text-neutral-faded">/mth</span></p>
        <p class="text-neutral-faded">Our most popular plan.</p>
      </div>
      <ul class="flex list-none flex-col gap-4 p-0 text-neutral-faded self-stretch text-start">
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Access to basic features</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Basic reporting and analytics</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Up to 10 individual users</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>20 GB individual data</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Basic chat and email support</span></li>
      </ul>
      <Button href="#" size="large" fullWidth class="mt-auto">Get started</Button>
    </div>
    <div class="relative mt-6 flex flex-col items-center gap-8 rounded-2xl bg-neutral-faded px-6 pt-12 pb-8 text-center md:px-8">
      <div class="absolute -top-6 start-1/2 -translate-x-1/2 rtl:translate-x-1/2"><FeaturedIcon theme="outline" color="neutral" size="large"><Layers2 /></FeaturedIcon></div>
      <div class="flex flex-col items-center gap-2">
        <Heading as="h3" size="h5">Business plan</Heading>
        <p class="flex items-baseline justify-center gap-1"><span class="text-5xl md:text-6xl font-semibold tracking-tight tabular-nums">$20</span><span class="text-neutral-faded">/mth</span></p>
        <p class="text-neutral-faded">Billed annually.</p>
      </div>
      <ul class="flex list-none flex-col gap-4 p-0 text-neutral-faded self-stretch text-start">
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>200+ integrations</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Advanced reporting and analytics</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Up to 20 individual users</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>40 GB individual data</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Priority chat and email support</span></li>
      </ul>
      <Button href="#" size="large" fullWidth class="mt-auto">Get started</Button>
    </div>
    <div class="relative mt-6 flex flex-col items-center gap-8 rounded-2xl bg-neutral-faded px-6 pt-12 pb-8 text-center md:px-8">
      <div class="absolute -top-6 start-1/2 -translate-x-1/2 rtl:translate-x-1/2"><FeaturedIcon theme="outline" color="neutral" size="large"><Layers3 /></FeaturedIcon></div>
      <div class="flex flex-col items-center gap-2">
        <Heading as="h3" size="h5">Enterprise plan</Heading>
        <p class="flex items-baseline justify-center gap-1"><span class="text-5xl md:text-6xl font-semibold tracking-tight tabular-nums">$40</span><span class="text-neutral-faded">/mth</span></p>
        <p class="text-neutral-faded">Billed annually.</p>
      </div>
      <ul class="flex list-none flex-col gap-4 p-0 text-neutral-faded self-stretch text-start">
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Advanced custom fields</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Audit log and data history</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Unlimited individual users</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Unlimited individual data</span></li>
        <li class="flex gap-3"><CircleCheck class="size-6 shrink-0 text-primary" aria-hidden="true" /><span>Personalised and priority service</span></li>
      </ul>
      <Button href="#" size="large" fullWidth class="mt-auto">Get started</Button>
    </div>
  </div>
  </div>
</Section>
