---
/**
 * Simple call out: A large heading over three plan cards with two actions each, the first marked most popular.
 *
 * @block pricing
 * @order 10
 */
import { Check, CornerLeftDown } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Heading from '../../components/Heading/Heading.astro'
import Button from '../../components/Button/Button.astro'

interface Props {
  /** 1 when the block opens a page; its items move one level down with it. */
  headingLevel?: 1 | 2
}
const { headingLevel = 2 } = Astro.props
const itemLevel = headingLevel === 1 ? (2 as const) : (3 as const)
---

<Section spacing="large">
  <div class="flex flex-col gap-16 md:gap-24">
    <SectionHeader headingLevel={headingLevel} eyebrow="Pricing" heading="Simple, transparent pricing" description="We believe good tools should be open to every company, whatever its size." size="large" />
    <div class="grid gap-4 md:grid-cols-2 md:gap-8 xl:grid-cols-3 pt-8">
    <div class="relative">
      <p class="absolute -top-8 end-4 flex items-center gap-1 text-sm font-semibold text-primary"><CornerLeftDown class="size-4 rtl:-scale-x-100" aria-hidden="true" />Most popular</p>
      <div class="flex flex-col overflow-hidden rounded-2xl bg-elevation-raised shadow-raised ring-1 ring-neutral h-full">
      <div class="flex flex-col items-center gap-2 px-6 pt-8 text-center md:px-8 md:pt-10">
        <p class="flex items-baseline justify-center gap-1"><span class="text-5xl md:text-6xl font-semibold tracking-tight tabular-nums">$10</span><span class="text-neutral-faded">/mth</span></p>
        <Heading as={itemLevel === 2 ? 'h2' : 'h3'} size="h5">Basic plan</Heading>
        <p class="text-neutral-faded">Billed annually.</p>
      </div>
      <div class="flex-1 px-6 py-8 md:px-8">
      <ul class="flex list-none flex-col gap-4 p-0 text-neutral-faded">
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>Access to all basic features</span></li>
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>Basic reporting and analytics</span></li>
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>Up to 10 individual users</span></li>
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>20 GB individual data</span></li>
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>Basic chat and email support</span></li>
      </ul>
      </div>
      <div class="border-t border-neutral p-6 md:px-8">
      <div class="flex flex-col gap-3">
        <Button href="#" size="large" fullWidth>Get started</Button>
        <Button href="#" size="large" variant="outline" color="neutral" fullWidth>Chat to sales</Button>
      </div>
      </div>
      </div>
    </div>
    <div class="relative">
      <div class="flex flex-col overflow-hidden rounded-2xl bg-elevation-raised shadow-raised ring-1 ring-neutral h-full">
      <div class="flex flex-col items-center gap-2 px-6 pt-8 text-center md:px-8 md:pt-10">
        <p class="flex items-baseline justify-center gap-1"><span class="text-5xl md:text-6xl font-semibold tracking-tight tabular-nums">$20</span><span class="text-neutral-faded">/mth</span></p>
        <Heading as={itemLevel === 2 ? 'h2' : 'h3'} size="h5">Business plan</Heading>
        <p class="text-neutral-faded">Billed annually.</p>
      </div>
      <div class="flex-1 px-6 py-8 md:px-8">
      <ul class="flex list-none flex-col gap-4 p-0 text-neutral-faded">
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>200+ integrations</span></li>
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>Advanced reporting and analytics</span></li>
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>Up to 20 individual users</span></li>
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>40 GB individual data</span></li>
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>Priority chat and email support</span></li>
      </ul>
      </div>
      <div class="border-t border-neutral p-6 md:px-8">
      <div class="flex flex-col gap-3">
        <Button href="#" size="large" fullWidth>Get started</Button>
        <Button href="#" size="large" variant="outline" color="neutral" fullWidth>Chat to sales</Button>
      </div>
      </div>
      </div>
    </div>
    <div class="relative">
      <div class="flex flex-col overflow-hidden rounded-2xl bg-elevation-raised shadow-raised ring-1 ring-neutral h-full">
      <div class="flex flex-col items-center gap-2 px-6 pt-8 text-center md:px-8 md:pt-10">
        <p class="flex items-baseline justify-center gap-1"><span class="text-5xl md:text-6xl font-semibold tracking-tight tabular-nums">$40</span><span class="text-neutral-faded">/mth</span></p>
        <Heading as={itemLevel === 2 ? 'h2' : 'h3'} size="h5">Enterprise plan</Heading>
        <p class="text-neutral-faded">Billed annually.</p>
      </div>
      <div class="flex-1 px-6 py-8 md:px-8">
      <ul class="flex list-none flex-col gap-4 p-0 text-neutral-faded">
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>Advanced custom fields</span></li>
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>Audit log and data history</span></li>
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>Unlimited individual users</span></li>
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>Unlimited individual data</span></li>
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>Personalised and priority service</span></li>
      </ul>
      </div>
      <div class="border-t border-neutral p-6 md:px-8">
      <div class="flex flex-col gap-3">
        <Button href="#" size="large" fullWidth>Get started</Button>
        <Button href="#" size="large" variant="outline" color="neutral" fullWidth>Chat to sales</Button>
      </div>
      </div>
      </div>
    </div>
  </div>
  </div>
</Section>
