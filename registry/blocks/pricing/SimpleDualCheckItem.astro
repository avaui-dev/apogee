---
/**
 * Simple dual check item: A centred heading and billing switch over two wide plan cards with features in two columns.
 *
 * @block pricing
 * @order 13
 */
import { Check } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Heading from '../../components/Heading/Heading.astro'
import Button from '../../components/Button/Button.astro'
import Badge from '../../components/Badge/Badge.astro'
import SegmentedControl from '../../components/SegmentedControl/SegmentedControl.astro'

interface Props {
  /** 1 when the block opens a page; its items move one level down with it. */
  headingLevel?: 1 | 2
}
const { headingLevel = 2 } = Astro.props
const itemLevel = headingLevel === 1 ? (2 as const) : (3 as const)
---

<Section spacing="large">
  <div class="group/pricing flex flex-col gap-12 md:gap-16">
    <div class="flex flex-col items-stretch gap-8 sm:items-center md:gap-12">
      <SectionHeader headingLevel={headingLevel} eyebrow="Pricing" heading="Plans that fit your scale" description="Simple, transparent pricing that grows with you. Try any plan free for 30 days." size="large" align="center" />
      <SegmentedControl name="billing" options={[{ label: 'Monthly', value: 'monthly' }, { label: 'Annual (save 20%)', value: 'annual' }]} value="monthly" aria-label="Billing period" size="large" />
    </div>
    <div class="mx-auto grid w-full max-w-xl gap-8 xl:max-w-none xl:grid-cols-2">
    <div class="flex flex-col overflow-hidden rounded-2xl bg-elevation-raised shadow-raised ring-1 ring-neutral">
      <div class="flex flex-col-reverse gap-6 p-6 md:flex-row md:justify-between md:p-8">
        <div class="flex flex-col gap-2">
          <div class="flex items-center gap-2"><Heading as={itemLevel === 2 ? 'h2' : 'h3'} size="h5">Basic plan</Heading></div>
          <p class="text-neutral-faded">Our most popular plan for small teams.</p>
        </div>
        <p class="flex items-start gap-1"><span class="mt-2 text-2xl font-semibold">$</span><span class="text-6xl font-semibold tracking-tight tabular-nums"><span class="group-has-[[value=annual]:checked]/pricing:hidden">10</span><span class="hidden group-has-[[value=annual]:checked]/pricing:inline">9</span></span><span class="self-end pb-2 text-neutral-faded">per month</span></p>
      </div>
      <div class="flex flex-col gap-6 border-t border-neutral p-6 md:p-8">
        <div class="flex flex-col gap-1">
          <p class="font-semibold">Features</p>
          <p class="text-neutral-faded">Everything in our <strong class="font-semibold text-neutral">free</strong> plan, plus:</p>
        </div>
      <ul class="flex list-none flex-col gap-4 p-0 text-neutral-faded md:grid md:grid-cols-2 md:gap-x-8">
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>Access to basic features</span></li>
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>Attend events</span></li>
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>Basic reporting and analytics</span></li>
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>Automatic updates</span></li>
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>Up to 10 individual users</span></li>
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>Back up your account</span></li>
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>20 GB individual data</span></li>
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>Audit log and notes</span></li>
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>Basic chat support</span></li>
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>Feature requests</span></li>
      </ul>
      </div>
      <div class="border-t border-neutral p-6 md:px-8">
        <Button href="#" size="large" fullWidth>Get started</Button>
      </div>
    </div>
    <div class="flex flex-col overflow-hidden rounded-2xl bg-elevation-raised shadow-raised ring-1 ring-neutral">
      <div class="flex flex-col-reverse gap-6 p-6 md:flex-row md:justify-between md:p-8">
        <div class="flex flex-col gap-2">
          <div class="flex items-center gap-2"><Heading as={itemLevel === 2 ? 'h2' : 'h3'} size="h5">Business plan</Heading><Badge color="primary" rounded>Popular</Badge></div>
          <p class="text-neutral-faded">Advanced features and reporting.</p>
        </div>
        <p class="flex items-start gap-1"><span class="mt-2 text-2xl font-semibold">$</span><span class="text-6xl font-semibold tracking-tight tabular-nums"><span class="group-has-[[value=annual]:checked]/pricing:hidden">20</span><span class="hidden group-has-[[value=annual]:checked]/pricing:inline">15</span></span><span class="self-end pb-2 text-neutral-faded">per month</span></p>
      </div>
      <div class="flex flex-col gap-6 border-t border-neutral p-6 md:p-8">
        <div class="flex flex-col gap-1">
          <p class="font-semibold">Features</p>
          <p class="text-neutral-faded">Everything in our <strong class="font-semibold text-neutral">Basic</strong> plan, plus:</p>
        </div>
      <ul class="flex list-none flex-col gap-4 p-0 text-neutral-faded md:grid md:grid-cols-2 md:gap-x-8">
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>200+ integrations</span></li>
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>Advanced custom fields</span></li>
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>Advanced reporting</span></li>
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>Audit log and data history</span></li>
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>Up to 20 individual users</span></li>
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>Back up your account</span></li>
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>40 GB individual data</span></li>
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>Personalised service</span></li>
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>Priority chat support</span></li>
        <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span><span>And much more</span></li>
      </ul>
      </div>
      <div class="border-t border-neutral p-6 md:px-8">
        <Button href="#" size="large" fullWidth>Get started</Button>
      </div>
    </div>
    </div>
  </div>
</Section>
