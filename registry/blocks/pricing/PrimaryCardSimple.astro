---
/**
 * Primary card simple: A heading over three tinted plan panels with filled checks.
 *
 * @block pricing
 * @order 20
 */
import { Check } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Heading from '../../components/Heading/Heading.astro'
import Button from '../../components/Button/Button.astro'
import { plain } from '../../sections/_shared/spine.ts'
import type { PricingContent } from '../../sections/_shared/pricing.ts'

/** @composable */
interface Props extends PricingContent {
  /** 1 when the block opens a page; its items move one level down with it. */
  headingLevel?: 1 | 2
}

const {
  headingLevel = 2,
  eyebrow = 'Pricing',
  heading = 'Simple, transparent pricing',
  description = 'We believe good tools should be open to every company, whatever its size.',
  items = [
    { name: 'Basic plan', price: '$10', period: 'mth', description: 'Billed annually.', features: ['Access to all basic features', 'Basic reporting and analytics', 'Up to 10 individual users', '20 GB individual data', 'Basic chat and email support'], action: { label: 'Get started', href: '#' } },
    { name: 'Business plan', price: '$20', period: 'mth', description: 'Billed annually.', features: ['200+ integrations', 'Advanced reporting and analytics', 'Up to 20 individual users', '40 GB individual data', 'Priority chat and email support'], action: { label: 'Get started', href: '#' } },
    { name: 'Enterprise plan', price: '$40', period: 'mth', description: 'Billed annually.', features: ['Advanced custom fields', 'Audit log and data history', 'Unlimited individual users', 'Unlimited individual data', 'Personalised and priority service'], action: { label: 'Get started', href: '#' } },
  ],
} = Astro.props
const itemLevel = headingLevel === 1 ? (2 as const) : (3 as const)
---

<Section spacing="large">
  <div class="flex flex-col gap-12 md:gap-16">
    <SectionHeader headingLevel={headingLevel} eyebrow={eyebrow ?? undefined} heading={plain(heading)} description={description ?? undefined} size="large" />
    <div class="grid gap-4 md:grid-cols-2 md:gap-8 xl:grid-cols-3">
    {items.map((plan) => (
    <div class="flex flex-col gap-8 bg-primary-faded px-6 py-8 md:px-8 md:py-10">
      <div class="flex flex-col items-center gap-3 text-center"><p class="flex items-baseline justify-center gap-1"><span class="text-5xl md:text-6xl font-semibold tracking-tight tabular-nums">{plan.price}</span>{plan.period && <span class="text-neutral-faded">/{plan.period}</span>}</p>
        <Heading as={itemLevel === 2 ? 'h2' : 'h3'} size="h5" class="text-primary">{plan.name}</Heading>
        <p class="text-neutral-faded">{plan.description}</p>
      </div>
      <ul class="flex list-none flex-col gap-4 p-0 text-neutral-faded flex-1">
        {plan.features.map((f) => <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-primary text-on-primary"><Check class="size-4" aria-hidden="true" /></span><span>{f}</span></li>)}
      </ul>
      <Button href={plan.action.href} size="large" fullWidth>{plan.action.label}</Button>
    </div>
    ))}
  </div>
  </div>
</Section>
