---
/**
 * Dual action, full width: A cookie notice with Decline and Allow buttons, as a bar across the page on a neutral fill.
 *
 * @block banner
 * @order 13
 */
import { BadgeCheck } from '@lucide/astro'
import Banner from '../../sections/Banner/Banner.astro'
import Button from '../../components/Button/Button.astro'
import Link from '../../components/Link/Link.astro'
---

<Banner layout="full-width" inline heading="We use cookies to improve your experience">
  <BadgeCheck slot="icon" class="size-5 text-primary" aria-hidden="true" />
  Read our <Link href="#" color="neutral">cookie policy</Link>.
  <div slot="actions" class="flex flex-col-reverse gap-2 sm:flex-row">
    <Button size="small" variant="outline" color="neutral">Decline</Button>
    <Button size="small">Allow</Button>
  </div>
</Banner>
