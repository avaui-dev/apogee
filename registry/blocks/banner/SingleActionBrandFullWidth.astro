---
/**
 * Single action brand, full width: An icon, a one-line announcement and one link button, as a bar across the page on the brand colour.
 *
 * @block banner
 * @order 12
 */
import { Sparkles } from '@lucide/astro'
import Banner from '../../sections/Banner/Banner.astro'
import FeaturedIcon from '../../components/FeaturedIcon/FeaturedIcon.astro'
import Button from '../../components/Button/Button.astro'
---

<Banner layout="full-width" background="primary" inline heading="We've just raised our Series A" description="Read the note from our founders.">
  <FeaturedIcon slot="icon" theme="light" color="primary" size="small"><Sparkles /></FeaturedIcon>
  <Button slot="actions" href="#" size="small" color="neutral">Read update</Button>
</Banner>
