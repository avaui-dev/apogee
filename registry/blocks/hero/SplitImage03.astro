---
/**
 * Split image 03: A heading, line and two buttons beside a photo with one large rounded corner.
 *
 * @block hero
 * @order 3
 */
import { CirclePlay } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import Heading from '../../components/Heading/Heading.astro'
import Button from '../../components/Button/Button.astro'
import Image from '../../components/Image/Image.astro'

---

<Section spacing="large">
  <div class="grid items-center gap-12 lg:gap-16 lg:grid-cols-2">
    <div class="flex flex-col gap-8 md:gap-12">
      <div class="flex flex-col gap-4 md:gap-6 items-start">
      
      <Heading as="h1" size="display" class="text-balance">People who care about your growth</Heading>
      <p class="max-w-2xl text-lg md:text-xl text-neutral-faded">Powerful, self-serve product and growth analytics to help you convert, engage and retain more users. Trusted by over 4,000 startups.</p>
    </div>
      <div class="flex flex-col-reverse gap-3 sm:flex-row ">
      <Button href="#" size="large" variant="outline" color="neutral"><CirclePlay slot="start" aria-hidden="true" />Demo</Button>
      <Button href="#" size="large">Sign up</Button>
    </div>
    </div>
    <Image src="https://picsum.photos/seed/apogee-hero-3/1200/1400" alt="" width={1200} height={1400} fit="cover" loading="eager" class="aspect-[6/7] w-full rounded-xl rounded-ss-[8rem]" />
  </div>
</Section>
