---
/**
 * Abstract angles 03: A centred heading and two buttons over a screenshot on a slanted band.
 *
 * @block hero
 * @order 11
 */
import { ArrowRight, CirclePlay } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import Heading from '../../components/Heading/Heading.astro'
import Button from '../../components/Button/Button.astro'
import Link from '../../components/Link/Link.astro'
import Badge from '../../components/Badge/Badge.astro'
import DeviceFrame from '../../components/DeviceFrame/DeviceFrame.astro'
import { plain, type HeroContent } from '../../sections/_shared/spine.ts'

/** @composable */
interface Props extends HeroContent {}

const {
  announcement = { badge: 'New feature', label: 'Check out the team dashboard', href: '#' },
  heading = 'High-performing remote teams. The future of work.',
  description = 'Self-serve team engagement tools and analytics. Support your managers and keep people engaged from anywhere.',
  primaryAction = { label: 'Sign up', href: '#' },
  secondaryAction = { label: 'Demo', href: '#' },
  media = { src: '/mockups/app-desktop-light.jpg', srcDark: '/mockups/app-desktop-dark.jpg', alt: 'The dashboard overview in a browser' },
} = Astro.props
---

<Section spacing="large" class="overflow-hidden">
  <div class="flex flex-col gap-8 md:gap-12 md:items-center">
    <div class="flex flex-col gap-4 md:gap-6 items-start md:items-center md:text-center">
      {announcement && (
        <Link href={announcement.href} color="inherit" underline="none" class="inline-flex items-center gap-2 self-start md:self-center rounded-full py-1 ps-1 pe-3 text-sm font-medium bg-primary-faded text-primary">
          {announcement.badge && <Badge color="primary" rounded>{announcement.badge}</Badge>}{announcement.label}<ArrowRight class="size-4 rtl:-scale-x-100" aria-hidden="true" />
        </Link>
      )}
      <Heading as="h1" size="display" class="text-balance">{plain(heading)}</Heading>
      {description && <p class="max-w-2xl text-lg md:text-xl text-neutral-faded">{description}</p>}
    </div>
    {(primaryAction || secondaryAction) && (
      <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-center ">
        {secondaryAction && <Button href={secondaryAction.href} size="large" variant="outline" color="neutral"><CirclePlay slot="start" aria-hidden="true" />{secondaryAction.label}</Button>}
        {primaryAction && <Button href={primaryAction.href} size="large">{primaryAction.label}</Button>}
      </div>
    )}
  </div>
  <div class="relative mt-16 md:mt-20">
    <div class="absolute inset-x-[-50vw] top-1/4 h-1/2 -skew-y-6 bg-primary-faded" aria-hidden="true"></div>
    {media && <div class="relative mx-auto max-w-5xl"><DeviceFrame device="browser" src={media.src} srcDark={media.srcDark} alt={media.alt} width={media.width} height={media.height} class="" /></div>}
  </div>
</Section>
