---
/**
 * Abstract angles 02: A centred heading and two buttons over a wide video on a slanted band.
 *
 * @block hero
 * @order 10
 */
import { ArrowRight, CirclePlay } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import Heading from '../../components/Heading/Heading.astro'
import Button from '../../components/Button/Button.astro'
import Link from '../../components/Link/Link.astro'
import Badge from '../../components/Badge/Badge.astro'
import VideoPlayer from '../../components/VideoPlayer/VideoPlayer.astro'

---

<Section spacing="large" class="overflow-hidden">
  <div class="flex flex-col gap-8 md:gap-12 md:items-center">
    <div class="flex flex-col gap-4 md:gap-6 items-start md:items-center md:text-center">
      <Link href="#" color="inherit" underline="none" class="inline-flex items-center gap-2 self-start md:self-center rounded-full py-1 ps-1 pe-3 text-sm font-medium bg-primary-faded text-primary">
      <Badge color="primary" rounded>New feature</Badge>Check out the team dashboard<ArrowRight class="size-4 rtl:-scale-x-100" aria-hidden="true" />
    </Link>
      <Heading as="h1" size="display" class="text-balance">High-performing remote teams. The future of work.</Heading>
      <p class="max-w-2xl text-lg md:text-xl text-neutral-faded">Self-serve team engagement tools and analytics. Support your managers and keep people engaged from anywhere.</p>
    </div>
    <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-center ">
      <Button href="#" size="large" variant="outline" color="neutral"><CirclePlay slot="start" aria-hidden="true" />Demo</Button>
      <Button href="#" size="large">Sign up</Button>
    </div>
  </div>
  <div class="relative mt-16 md:mt-20">
    <div class="absolute inset-x-[-50vw] top-1/4 h-1/2 -skew-y-6 bg-primary-faded" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-5xl"><VideoPlayer src="/media/app-tour.mp4" poster="/mockups/app-desktop-light.jpg" captions="/media/app-tour.vtt" title="A tour of the dashboard" ratio="16/10" /></div>
  </div>
</Section>
