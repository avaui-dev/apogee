---
/**
 * Card mockup 03: A centred heading and two buttons over five payment cards fanned on a brand panel, over a fine grid.
 *
 * @block hero
 * @order 31
 */
import { ArrowRight, CirclePlay } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import Container from '../../components/Container/Container.astro'
import Heading from '../../components/Heading/Heading.astro'
import Button from '../../components/Button/Button.astro'
import Link from '../../components/Link/Link.astro'
import Badge from '../../components/Badge/Badge.astro'
import PaymentCard from '../../components/PaymentCard/PaymentCard.astro'
import { plain, type HeroContent } from '../../sections/_shared/spine.ts'

/** @composable */
interface Props extends HeroContent {}

const {
  announcement = { badge: "What's new?", label: 'Instantly issue virtual cards', href: '#' },
  heading = 'No more banking headaches',
  description = 'A new kind of business account: cards, payments and reports in one place. Start with a 30-day free trial.',
  primaryAction = { label: 'Sign up', href: '#' },
  secondaryAction = { label: 'Demo', href: '#' },
} = Astro.props
---

<Section spacing="large" container={false} class="overflow-hidden">
  <div class="pointer-events-none absolute inset-0 mask-[radial-gradient(ellipse_at_top,black,transparent_70%)] bg-[linear-gradient(var(--border-neutral-faded)_1px,transparent_1px),linear-gradient(90deg,var(--border-neutral-faded)_1px,transparent_1px)] bg-size-[2rem_2rem]" aria-hidden="true"></div>
  <Container class="relative">
    <div class="flex flex-col gap-8 md:gap-12 items-center text-center">
    <div class="flex flex-col gap-4 md:gap-6 items-center text-center">
      {announcement && (
        <Link href={announcement.href} color="inherit" underline="none" class="inline-flex items-center gap-2 self-center rounded-full py-1 ps-1 pe-3 text-sm font-medium bg-primary-faded text-primary">
          {announcement.badge && <Badge color="primary" rounded>{announcement.badge}</Badge>}{announcement.label}<ArrowRight class="size-4 rtl:-scale-x-100" aria-hidden="true" />
        </Link>
      )}
      <Heading as="h1" size="display" class="text-balance">{plain(heading)}</Heading>
      {description && <p class="max-w-2xl text-lg md:text-xl text-neutral-faded">{description}</p>}
    </div>
    {(primaryAction || secondaryAction) && (
      <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-center ">
        {secondaryAction && <Button href={secondaryAction.href} size="large" variant="outline" color="neutral"><CirclePlay slot="start" aria-hidden="true" />{secondaryAction.label}</Button>}
        {primaryAction && <Button href={primaryAction.href} size="large">{primaryAction.label}</Button>}
      </div>
    )}
  </div>
    <div class="mt-16 md:mt-20"><div class="relative flex items-center justify-center overflow-hidden rounded-3xl bg-primary p-6 md:p-10 mx-auto h-80 max-w-4xl md:h-112">
      <div class="relative mx-auto h-full w-full max-w-2xl">
        <div class="absolute inset-x-0 bottom-0 mx-auto w-56 origin-bottom md:w-80 -rotate-[24deg]"><PaymentCard variant="glass" last4="1001" /></div>
        <div class="absolute inset-x-0 bottom-0 mx-auto w-56 origin-bottom md:w-80 -rotate-12"><PaymentCard variant="glass" last4="2002" /></div>
        <div class="absolute inset-x-0 bottom-0 mx-auto w-56 origin-bottom md:w-80 "><PaymentCard variant="glass" last4="3003" /></div>
        <div class="absolute inset-x-0 bottom-0 mx-auto w-56 origin-bottom md:w-80 rotate-12"><PaymentCard variant="glass" last4="4004" /></div>
        <div class="absolute inset-x-0 bottom-0 mx-auto w-56 origin-bottom md:w-80 rotate-[24deg]"><PaymentCard variant="glass" last4="4242" /></div>
      </div>
    </div></div>
  </Container>
</Section>
