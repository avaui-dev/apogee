---
/**
 * Screen mockup 07: A centred heading and two buttons over a screenshot, over a fine grid.
 *
 * @block hero
 * @order 19
 */
import { ArrowRight, CirclePlay } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import Container from '../../components/Container/Container.astro'
import Heading from '../../components/Heading/Heading.astro'
import Button from '../../components/Button/Button.astro'
import Link from '../../components/Link/Link.astro'
import Badge from '../../components/Badge/Badge.astro'
import DeviceFrame from '../../components/DeviceFrame/DeviceFrame.astro'
import { plain, type HeroContent, type Media } from '../../sections/_shared/spine.ts'

/** @composable */
interface Props extends HeroContent {
  /** The screenshot; `srcDark` swaps in when the page is dark. @category content */
  media?: Media | null
}

const {
  announcement = { badge: 'New feature', label: 'Check out the team dashboard', href: '#' },
  heading = 'Beautiful analytics to grow smarter',
  description = 'Powerful, self-serve product and growth analytics to help you convert, engage and retain more users. Trusted by over 4,000 startups.',
  primaryAction = { label: 'Sign up', href: '#' },
  secondaryAction = { label: 'Demo', href: '#' },
  media = { src: '/mockups/app-desktop-light.jpg', srcDark: '/mockups/app-desktop-dark.jpg', alt: 'The dashboard overview in a browser' },
} = Astro.props
---

<Section spacing="large" container={false} class="overflow-hidden">
  <div class="pointer-events-none absolute inset-0 mask-[radial-gradient(ellipse_at_top,black,transparent_70%)] bg-[linear-gradient(var(--border-neutral-faded)_1px,transparent_1px),linear-gradient(90deg,var(--border-neutral-faded)_1px,transparent_1px)] bg-size-[2rem_2rem]" aria-hidden="true"></div>
  <Container class="relative">
    <div class="flex flex-col gap-8 md:gap-12 items-center text-center">
    <div class="flex flex-col gap-4 md:gap-6 items-center text-center">
      {announcement && (
        <Link href={announcement.href} color="inherit" underline="none" class="inline-flex items-center gap-2 self-center rounded-full py-1 ps-1 pe-3 text-sm font-medium bg-primary-faded text-primary">
          {announcement.badge && <Badge color="primary" rounded>{announcement.badge}</Badge>}{announcement.label}<ArrowRight class="size-4 rtl:-scale-x-100" aria-hidden="true" />
        </Link>
      )}
      <Heading as="h1" size="display" class="text-balance">{plain(heading)}</Heading>
      {description && <p class="max-w-2xl text-lg md:text-xl text-neutral-faded">{description}</p>}
    </div>
    {(primaryAction || secondaryAction) && (
      <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-center ">
        {secondaryAction && <Button href={secondaryAction.href} size="large" variant="outline" color="neutral"><CirclePlay slot="start" aria-hidden="true" />{secondaryAction.label}</Button>}
        {primaryAction && <Button href={primaryAction.href} size="large">{primaryAction.label}</Button>}
      </div>
    )}
  </div>
    <div class="mt-16 md:mt-20">{media && <DeviceFrame device="browser" src={media.src} srcDark={media.srcDark} alt={media.alt} width={media.width} height={media.height} class="mx-auto max-w-5xl" />}</div>
  </Container>
</Section>
