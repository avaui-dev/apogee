---
/**
 * Screen mockup 06: A heading and two buttons beside a screenshot with a phone in front, over a dot grid.
 *
 * @block hero
 * @order 18
 */
import { ArrowRight, CirclePlay } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import Container from '../../components/Container/Container.astro'
import Heading from '../../components/Heading/Heading.astro'
import Button from '../../components/Button/Button.astro'
import Link from '../../components/Link/Link.astro'
import Badge from '../../components/Badge/Badge.astro'
import DeviceFrame from '../../components/DeviceFrame/DeviceFrame.astro'
import { plain, type HeroContent, type Media } from '../../sections/_shared/spine.ts'

/** @composable */
interface Props extends HeroContent {
  /** The screenshot; `srcDark` swaps in when the page is dark. @category content */
  media?: Media | null
  /** A phone screenshot over the corner; `srcDark` swaps in when the page is dark. @category content */
  phoneMedia?: Media | null
}

const {
  announcement = { badge: "We're hiring!", label: 'Join our remote team', href: '#' },
  heading = 'Beautiful banking to grow smarter',
  description = 'A new kind of business account: cards, payments and reports in one place. Start with a 30-day free trial.',
  primaryAction = { label: 'Sign up', href: '#' },
  secondaryAction = { label: 'Demo', href: '#' },
  media = { src: '/mockups/app-desktop-light.jpg', srcDark: '/mockups/app-desktop-dark.jpg', alt: 'The dashboard overview in a browser' },
  phoneMedia = { src: '/mockups/app-customers-phone-light.jpg', srcDark: '/mockups/app-customers-phone-dark.jpg', alt: 'The customers table on a phone' },
} = Astro.props
---

<Section spacing="large" container={false} class="overflow-hidden">
  <div class="pointer-events-none absolute inset-0 mask-[radial-gradient(ellipse_at_top,black,transparent_70%)] bg-[radial-gradient(var(--border-neutral)_1px,transparent_1px)] bg-size-[1.5rem_1.5rem]" aria-hidden="true"></div>
  <Container class="relative">
    <div class="grid items-center gap-12 lg:gap-16 lg:grid-cols-2">
    <div class="flex flex-col gap-8 md:gap-12">
      <div class="flex flex-col gap-4 md:gap-6 items-start">
      {announcement && (
        <Link href={announcement.href} color="inherit" underline="none" class="inline-flex items-center gap-2 self-start rounded-full py-1 ps-1 pe-3 text-sm font-medium bg-primary-faded text-primary">
          {announcement.badge && <Badge color="primary" rounded>{announcement.badge}</Badge>}{announcement.label}<ArrowRight class="size-4 rtl:-scale-x-100" aria-hidden="true" />
        </Link>
      )}
      <Heading as="h1" size="display" class="text-balance">{plain(heading)}</Heading>
      {description && <p class="max-w-2xl text-lg md:text-xl text-neutral-faded">{description}</p>}
    </div>
      {(primaryAction || secondaryAction) && (
      <div class="flex flex-col-reverse gap-3 sm:flex-row ">
        {secondaryAction && <Button href={secondaryAction.href} size="large" variant="outline" color="neutral"><CirclePlay slot="start" aria-hidden="true" />{secondaryAction.label}</Button>}
        {primaryAction && <Button href={primaryAction.href} size="large">{primaryAction.label}</Button>}
      </div>
    )}
    </div>
    <div class="relative pb-10 ps-10 md:pb-16 md:ps-16">{media && <DeviceFrame device="browser" src={media.src} srcDark={media.srcDark} alt={media.alt} width={media.width} height={media.height} class="" />}{phoneMedia && <div class="absolute start-0 bottom-0 w-24 md:w-36"><DeviceFrame device="phone" src={phoneMedia.src} srcDark={phoneMedia.srcDark} alt={phoneMedia.alt} width={phoneMedia.width} height={phoneMedia.height} class="" /></div>}</div>
  </div>
  </Container>
</Section>
