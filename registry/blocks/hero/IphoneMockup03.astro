---
/**
 * iPhone mockup 03: A heading, line and a text-me-a-link form beside a phone over a screenshot, over a dot grid.
 *
 * @block hero
 * @order 23
 */
import Section from '../../components/Section/Section.astro'
import Container from '../../components/Container/Container.astro'
import Heading from '../../components/Heading/Heading.astro'
import Button from '../../components/Button/Button.astro'
import Input from '../../components/Input/Input.astro'
import DeviceFrame from '../../components/DeviceFrame/DeviceFrame.astro'
import { plain, type HeroContent } from '../../sections/_shared/spine.ts'

/** @composable */
interface Props extends HeroContent {
  /** The form's submit button. @category content */
  submitLabel?: string
}

const {
  heading = 'Banking, built for digital creators',
  description = 'A new kind of business account: cards, payments and reports in one place. Start with a 30-day free trial.',
  submitLabel = 'Text me a link',
} = Astro.props
---

<Section spacing="large" container={false} class="overflow-hidden">
  <div class="pointer-events-none absolute inset-0 mask-[radial-gradient(ellipse_at_top,black,transparent_70%)] bg-[radial-gradient(var(--border-neutral)_1px,transparent_1px)] bg-size-[1.5rem_1.5rem]" aria-hidden="true"></div>
  <Container class="relative">
    <div class="grid items-center gap-12 lg:gap-16 lg:grid-cols-2">
    <div class="flex flex-col gap-8 md:gap-12">
      <div class="flex flex-col gap-4 md:gap-6 items-start">
      
      <Heading as="h1" size="display" class="text-balance">{plain(heading)}</Heading>
      {description && <p class="max-w-2xl text-lg md:text-xl text-neutral-faded">{description}</p>}
    </div>
      <form method="post" class="flex w-full max-w-md flex-col gap-3 md:flex-row">
      <Input size="large" type="tel" name="phone" placeholder="Your phone number" aria-label="Phone number" autocomplete="tel" required class="flex-1" />
      <Button type="submit" size="large">{submitLabel}</Button>
    </form>
    </div>
    <div class="relative flex justify-center lg:block"><DeviceFrame device="browser" src="/mockups/app-settings-desktop-light.jpg" srcDark="/mockups/app-settings-desktop-dark.jpg" alt="The settings page in a browser" class="max-lg:hidden w-[85%]" /><div class="w-64 lg:absolute lg:end-0 lg:-bottom-12 lg:w-56"><DeviceFrame device="phone" src="/mockups/app-phone-light.jpg" srcDark="/mockups/app-phone-dark.jpg" alt="The dashboard overview on a phone" class="" /></div></div>
  </div>
  </Container>
</Section>
