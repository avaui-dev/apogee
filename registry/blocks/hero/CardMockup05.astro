---
/**
 * Card mockup 05: A centred eyebrow, heading and two buttons over two tilted payment cards, over a fine grid.
 *
 * @block hero
 * @order 33
 */
import { CirclePlay } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import Container from '../../components/Container/Container.astro'
import Heading from '../../components/Heading/Heading.astro'
import Button from '../../components/Button/Button.astro'
import PaymentCard from '../../components/PaymentCard/PaymentCard.astro'

---

<Section spacing="large" container={false} class="overflow-hidden">
  <div class="pointer-events-none absolute inset-0 mask-[radial-gradient(ellipse_at_top,black,transparent_70%)] bg-[linear-gradient(var(--border-neutral-faded)_1px,transparent_1px),linear-gradient(90deg,var(--border-neutral-faded)_1px,transparent_1px)] bg-size-[2rem_2rem]" aria-hidden="true"></div>
  <Container class="relative">
    <div class="flex flex-col gap-8 md:gap-12 items-center text-center">
    <div class="flex flex-col gap-4 md:gap-6 items-center text-center">
      <p class="text-sm font-semibold text-primary">Super. Simple. Banking.</p>
      <Heading as="h1" size="display" class="text-balance">Simple banking that works like magic.</Heading>
      <p class="max-w-2xl text-lg md:text-xl text-neutral-faded">A new kind of business account: cards, payments and reports in one place. Start with a 30-day free trial.</p>
    </div>
    <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-center ">
      <Button href="#" size="large" variant="outline" color="neutral"><CirclePlay slot="start" aria-hidden="true" />Demo</Button>
      <Button href="#" size="large">Sign up</Button>
    </div>
  </div>
    <div class="mx-auto mt-12 h-72 max-w-4xl md:h-96"><div class="relative h-full w-full max-w-2xl">
        <div class="absolute w-56 md:w-72 start-[5%] top-[15%] -rotate-[30deg]"><PaymentCard color="neutral" last4="1234" /></div>
        <div class="absolute w-56 md:w-72 end-[5%] top-[25%] rotate-[30deg]"><PaymentCard color="primary" last4="4242" /></div>
      </div></div>
  </Container>
</Section>
