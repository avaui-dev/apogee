---
/**
 * Blog posts with sidebar: A bar whose menus open across the page: blog categories beside six posts.
 *
 * @block header-navigation
 * @order 18
 */
import { Orbit } from '@lucide/astro'
import Navbar from '../../components/Navbar/Navbar.astro'
import NavLink from '../../components/NavLink/NavLink.astro'
import NavDropdown from '../../components/NavDropdown/NavDropdown.astro'
import Link from '../../components/Link/Link.astro'
import Button from '../../components/Button/Button.astro'
import FeaturedIcon from '../../components/FeaturedIcon/FeaturedIcon.astro'
import Image from '../../components/Image/Image.astro'
import type { NavGroup, NavigationContent } from '../../sections/_shared/navigation.ts'

// A menu's first group is the category list, its second the posts.
const groups: NavGroup[] = [
  { heading: 'Blog categories', items: [
    { label: 'Design', href: '#' },
    { label: 'Product', href: '#' },
    { label: 'Data analytics', href: '#' },
    { label: 'Marketing and growth', href: '#' },
    { label: 'Customer success', href: '#' },
    { label: 'Team collaboration', href: '#' },
  ] },
  { items: [
    { label: 'Auto layout explained', href: '#', description: 'How flexible layouts save hours on every screen.', media: { src: 'https://picsum.photos/seed/apogee-nav-1/288/176', alt: '' } },
    { label: 'Ways to level up your product design', href: '#', description: 'Small habits that make a big difference over a year.', media: { src: 'https://picsum.photos/seed/apogee-nav-2/288/176', alt: '' } },
    { label: 'Synthesise data with affinity diagrams', href: '#', description: 'Turn a wall of notes into findings your team trusts.', media: { src: 'https://picsum.photos/seed/apogee-nav-3/288/176', alt: '' } },
    { label: 'Streamline your user research', href: '#', description: 'Plan, run and share research in half the time.', media: { src: 'https://picsum.photos/seed/apogee-nav-4/288/176', alt: '' } },
    { label: 'Inclusive UX research', href: '#', description: 'Who you leave out shapes what you build.', media: { src: 'https://picsum.photos/seed/apogee-nav-5/288/176', alt: '' } },
    { label: 'The anatomy of a good story', href: '#', description: 'Why some product stories stick and others slide off.', media: { src: 'https://picsum.photos/seed/apogee-nav-6/288/176', alt: '' } },
  ] },
]

/** @composable */
interface Props extends NavigationContent {
  /** The bar's fill: the page, a grey band or the brand colour. */
  background?: 'page' | 'neutral-faded' | 'primary' | undefined
  /** `dark` sets the bar in the dark theme on a light page. */
  theme?: 'dark' | undefined
}
const {
  brand = 'Example',
  links = [
    { label: 'Products', groups },
    { label: 'Services', groups },
    { label: 'Pricing', href: '#' },
    { label: 'Resources', groups },
    { label: 'About', href: '#' },
  ],
  primaryAction = { label: 'Sign up', href: '#' },
  secondaryAction = { label: 'Log in', href: '#' },
  background,
  theme,
} = Astro.props
---

<Navbar background={background} data-theme={theme}>
  <Link slot="brand" href="/" color="inherit" underline="none" class="inline-flex items-center gap-2 text-lg font-semibold"><FeaturedIcon theme="solid" color="primary" size="small"><Orbit /></FeaturedIcon>{brand}</Link>
  {links.map((l) => {
    if (!('groups' in l)) return <NavLink href={l.href}>{l.label}</NavLink>
    const [categories, posts] = l.groups
    return (
  <NavDropdown label={l.label} fullWidth>
    <div class="mx-auto max-w-7xl px-4 py-6 md:py-8 sm:px-6">
        <div class="grid gap-6 lg:grid-cols-[14rem_minmax(0,1fr)]">
          {categories && <div class="flex flex-col gap-3">
            {categories.heading && <p class="text-sm font-semibold text-primary">{categories.heading}</p>}
            <ul class="flex list-none flex-col gap-3 p-0 font-semibold">
              {categories.items.map((c) => <li><Link href={c.href} color="neutral" underline="hover">{c.label}</Link></li>)}
            </ul>
          </div>}
          {posts && <ul class="list-none p-0 grid gap-2 lg:grid-cols-2">
            {posts.items.map((p) => (
              <li>
                <Link href={p.href} color="inherit" underline="none" class="flex gap-4 rounded-lg p-2 transition-colors hover:bg-neutral-faded">
                  {p.media && <Image src={p.media.src} alt={p.media.alt} width={288} height={176} fit="cover" radius="md" class="h-[5.5rem] w-36 shrink-0" />}
                  <span class="flex flex-col gap-1">
                    <span class="line-clamp-2 font-semibold">{p.label}</span>
                    {p.description && <span class="line-clamp-2 text-sm text-neutral-faded">{p.description}</span>}
                  </span>
                </Link>
              </li>
            ))}
          </ul>}
        </div>
      </div>
  </NavDropdown>
    )
  })}
  {secondaryAction && <Button slot="actions" href={secondaryAction.href} variant="outline" color="neutral" size="small">{secondaryAction.label}</Button>}
  {primaryAction && <Button slot="actions" href={primaryAction.href} size="small">{primaryAction.label}</Button>}
</Navbar>
