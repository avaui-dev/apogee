---
/**
 * Simple form 03: A heading, an email link and a contact form with a services checklist beside a photo.
 *
 * @block contact
 * @order 24
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import ContactForm from '../../components/ContactForm/ContactForm.astro'
import Image from '../../components/Image/Image.astro'
import Link from '../../components/Link/Link.astro'
import { plain } from '../../sections/_shared/spine.ts'
import type { ContactContent } from '../../sections/_shared/contact.ts'

/** @composable */
interface Props extends ContactContent {
  /** 1 when the block opens a page; its items move one level down with it. */
  headingLevel?: 1 | 2
  /** Linked after the description. @category content */
  email?: string | null
}
const {
  headingLevel = 2,
  heading = "Let's level up your brand, together",
  description = 'You can reach us anytime via',
  email = 'hi@example.com',
  media = { src: 'https://picsum.photos/seed/apogee-contact-5/1200/1600', alt: '', width: 1200, height: 1600 },
  action,
  method,
  submitLabel = 'Get started',
} = Astro.props
---

<Section spacing="none" container={false}>
  <div class="grid lg:grid-cols-2">
    <div class="px-gutter py-section lg:px-16">
      <div class="mx-auto max-w-lg">
        <SectionHeader headingLevel={headingLevel} heading={plain(heading)} class="mb-4" />
        {(description || email) && <p class="mb-12 text-neutral-faded">{description} {email && <Link href={`mailto:${email}`}>{email}</Link>}</p>}
        <ContactForm services={['Website design', 'Content creation', 'UX design', 'Strategy & consulting', 'User research', 'Other']} action={action} method={method} submitLabel={submitLabel} />
      </div>
    </div>
    {media && <Image src={media.src} alt={media.alt} width={media.width} height={media.height} fit="cover" class="h-full min-h-[50rem] w-full max-lg:hidden" />}
  </div>
</Section>
