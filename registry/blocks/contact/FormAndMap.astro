---
/**
 * Form and map: A heading and contact form beside a map (the map shows from lg).
 *
 * @block contact
 * @order 2
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import ContactForm from '../../components/ContactForm/ContactForm.astro'
import MapEmbed from '../../components/MapEmbed/MapEmbed.astro'
import { plain } from '../../sections/_shared/spine.ts'
import type { ContactContent } from '../../sections/_shared/contact.ts'


/** @composable */
interface Props extends ContactContent {
  /** 1 when the block opens a page; its items move one level down with it. */
  headingLevel?: 1 | 2
}
const {
  headingLevel = 2,
  eyebrow = 'Contact us',
  heading = 'Get in touch',
  description = "We'd love to hear from you. Please fill out this form.",
  locations = [
    { name: 'Melbourne', address: '100 Flinders Street, Melbourne VIC 3000 AU', lat: -37.8183, lon: 144.9671 },
  ],
  action,
  method,
  submitLabel = 'Send message',
} = Astro.props
const office = locations?.[0]
---

<Section spacing="large">
  <div class="grid gap-16 lg:grid-cols-2">
    <div>
      <SectionHeader headingLevel={headingLevel} eyebrow={eyebrow ?? undefined} heading={plain(heading)} description={description ?? undefined} class="mb-12" />
      <ContactForm action={action} method={method} submitLabel={submitLabel} />
    </div>
    {office && <MapEmbed lat={office.lat} lon={office.lon} title={`Map of our ${office.name} office`} class="h-full min-h-[40rem] max-lg:hidden" />}
  </div>
</Section>
