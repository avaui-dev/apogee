---
/**
 * Form and map: A heading and contact form beside a map (the map shows from lg).
 *
 * @block contact
 * @order 2
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import ContactForm from '../../components/ContactForm/ContactForm.astro'
import MapEmbed from '../../components/MapEmbed/MapEmbed.astro'

const stores = [
  { city: 'Melbourne', address: '100 Flinders Street, Melbourne VIC 3000 AU', lat: -37.8183, lon: 144.9671 },
  { city: 'Sydney', address: '100 George Street, Sydney NSW 2000 AU', lat: -33.8615, lon: 151.2073 },
  { city: 'Byron Bay', address: '50 Jonson Street, Byron Bay NSW 2481 AU', lat: -28.6431, lon: 153.6139 },
  { city: 'London', address: '100 Oxford Street, London W1D 1LL UK', lat: 51.5154, lon: -0.141 },
  { city: 'San Francisco', address: '100 Market Street, San Francisco, CA 94105 US', lat: 37.7936, lon: -122.395 },
  { city: 'Stockholm', address: 'Drottninggatan 100, 111 60 Stockholm SE', lat: 59.3326, lon: 18.0649 },
]
---

<Section spacing="large">
  <div class="grid gap-16 lg:grid-cols-2">
    <div>
      <SectionHeader eyebrow="Contact us" heading="Contact us" description="We'd love to hear from you. Please fill out this form." class="mb-12" />
      <ContactForm />
    </div>
    <MapEmbed lat={stores[0]!.lat} lon={stores[0]!.lon} title={`Map of our ${stores[0]!.city} office`} class="h-full min-h-[40rem] max-lg:hidden" />
  </div>
</Section>
