---
/**
 * Form and image 01: A heading and contact form beside a photo (the photo shows from lg).
 *
 * @block contact
 * @order 3
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import ContactForm from '../../components/ContactForm/ContactForm.astro'
import Image from '../../components/Image/Image.astro'
import { plain } from '../../sections/_shared/spine.ts'
import type { ContactContent } from '../../sections/_shared/contact.ts'

/** @composable */
interface Props extends ContactContent {
  /** 1 when the block opens a page; its items move one level down with it. */
  headingLevel?: 1 | 2
}
const {
  headingLevel = 2,
  eyebrow = 'Contact us',
  heading = 'Get in touch',
  description = "We'd love to hear from you. Please fill out this form.",
  media = { src: 'https://picsum.photos/seed/apogee-contact-1/1200/1500', alt: '', width: 1200, height: 1500 },
  action,
  method,
  submitLabel = 'Send message',
} = Astro.props
---

<Section spacing="large">
  <div class="grid gap-16 lg:grid-cols-2">
    <div>
      <SectionHeader headingLevel={headingLevel} eyebrow={eyebrow ?? undefined} heading={plain(heading)} description={description ?? undefined} class="mb-12" />
      <ContactForm rows={4} action={action} method={method} submitLabel={submitLabel} />
    </div>
    {media && <Image src={media.src} alt={media.alt} width={media.width} height={media.height} fit="cover" radius="xl" class="h-full min-h-[40rem] w-full max-lg:hidden" />}
  </div>
</Section>
