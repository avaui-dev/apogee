---
/**
 * Simple form 02: A portrait photo (from lg) beside a heading and a contact form.
 *
 * @block contact
 * @order 26
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import ContactForm from '../../components/ContactForm/ContactForm.astro'
import Image from '../../components/Image/Image.astro'

---

<Section spacing="large">
  <div class="grid gap-16 lg:grid-cols-2">
    <Image src="https://picsum.photos/seed/apogee-contact-6/1200/1500" alt="" width={1200} height={1500} fit="cover" radius="xl" class="h-full min-h-[40rem] w-full max-lg:hidden" />
    <div>
      <SectionHeader eyebrow="Contact us" heading="Contact us" description="We'd love to hear from you. Please fill out this form." class="mb-12" />
      <ContactForm />
    </div>
  </div>
</Section>
