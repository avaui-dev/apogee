---
/**
 * Map 01: A centred heading, a wide map and three office cards with their hours and addresses.
 *
 * @block contact
 * @order 7
 */
import { MapPin } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import ContactMethod from '../../components/ContactMethod/ContactMethod.astro'
import MapEmbed from '../../components/MapEmbed/MapEmbed.astro'
import FeaturedIcon from '../../components/FeaturedIcon/FeaturedIcon.astro'
import { plain } from '../../sections/_shared/spine.ts'
import type { ContactContent } from '../../sections/_shared/contact.ts'


/** @composable */
interface Props extends ContactContent {
  /** 1 when the block opens a page; its items move one level down with it. */
  headingLevel?: 1 | 2
}
const {
  headingLevel = 2,
  eyebrow = 'Locations',
  heading = 'Our locations',
  description = 'Find us at these locations.',
  locations = [
    { name: 'Melbourne', address: '100 Flinders Street, Melbourne VIC 3000 AU', lat: -37.8183, lon: 144.9671, hours: 'Mon–Sat 10am to 6pm' },
    { name: 'Sydney', address: '100 George Street, Sydney NSW 2000 AU', lat: -33.8615, lon: 151.2073, hours: 'Mon–Sat 10am to 6pm' },
    { name: 'Byron Bay', address: '50 Jonson Street, Byron Bay NSW 2481 AU', lat: -28.6431, lon: 153.6139, hours: 'Mon–Sat 10am to 6pm' },
  ],
} = Astro.props
const office = locations?.[0]
const itemLevel = headingLevel === 1 ? (2 as const) : (3 as const)
---

<Section spacing="large">
  <SectionHeader headingLevel={headingLevel} eyebrow={eyebrow ?? undefined} heading={plain(heading)} description={description ?? undefined} align="center" class="mb-12" />
  {office && <MapEmbed lat={office.lat} lon={office.lon} title={`Map of our ${office.name} office`} class="h-96 md:h-[30rem]" />}
  {locations && <ul class="mt-12 grid list-none gap-6 p-0 md:grid-cols-3">
    {locations.map((s) => (
      <li>
        <ContactMethod title={s.name} description={s.hours} link={{ label: s.address, href: '#map' }} variant="card" headingLevel={itemLevel}>
          <FeaturedIcon slot="icon" theme="outline" color="neutral"><MapPin /></FeaturedIcon>
        </ContactMethod>
      </li>
    ))}
  </ul>}
</Section>
