---
/**
 * Map 01: A centred heading, a wide map and three office cards with their hours and addresses.
 *
 * @block contact
 * @order 7
 */
import { MapPin } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import ContactMethod from '../../components/ContactMethod/ContactMethod.astro'
import MapEmbed from '../../components/MapEmbed/MapEmbed.astro'
import FeaturedIcon from '../../components/FeaturedIcon/FeaturedIcon.astro'

const stores = [
  { city: 'Melbourne', address: '100 Flinders Street, Melbourne VIC 3000 AU', lat: -37.8183, lon: 144.9671 },
  { city: 'Sydney', address: '100 George Street, Sydney NSW 2000 AU', lat: -33.8615, lon: 151.2073 },
  { city: 'Byron Bay', address: '50 Jonson Street, Byron Bay NSW 2481 AU', lat: -28.6431, lon: 153.6139 },
  { city: 'London', address: '100 Oxford Street, London W1D 1LL UK', lat: 51.5154, lon: -0.141 },
  { city: 'San Francisco', address: '100 Market Street, San Francisco, CA 94105 US', lat: 37.7936, lon: -122.395 },
  { city: 'Stockholm', address: 'Drottninggatan 100, 111 60 Stockholm SE', lat: 59.3326, lon: 18.0649 },
]

interface Props {
  /** 1 when the block opens a page; its items move one level down with it. */
  headingLevel?: 1 | 2
}
const { headingLevel = 2 } = Astro.props
const itemLevel = headingLevel === 1 ? (2 as const) : (3 as const)
---

<Section spacing="large">
  <SectionHeader headingLevel={headingLevel} eyebrow="Locations" heading="Our locations" description="Find us at these locations." align="center" class="mb-12" />
  <MapEmbed lat={stores[0]!.lat} lon={stores[0]!.lon} title={`Map of our ${stores[0]!.city} office`} class="h-96 md:h-[30rem]" />
  <ul class="mt-12 grid list-none gap-6 p-0 md:grid-cols-3">
    {stores.slice(0, 3).map((s) => (
      <li>
        <ContactMethod title={s.city} description="Mon–Sat 10am to 6pm" link={{ label: s.address, href: '#map' }} variant="card" headingLevel={itemLevel}>
          <FeaturedIcon slot="icon" theme="outline" color="neutral"><MapPin /></FeaturedIcon>
        </ContactMethod>
      </li>
    ))}
  </ul>
</Section>
