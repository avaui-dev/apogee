---
/**
 * Icons and form: A heading and four contact methods beside a contact form.
 *
 * @block contact
 * @order 13
 */
import { Mail, MapPin, MessageCircle, Phone } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import ContactForm from '../../components/ContactForm/ContactForm.astro'
import ContactMethod from '../../components/ContactMethod/ContactMethod.astro'
import FeaturedIcon from '../../components/FeaturedIcon/FeaturedIcon.astro'

const methods = [
  { icon: Mail, title: 'Email', description: "Our friendly team is here to help.", link: { label: 'hi@example.com', href: 'mailto:hi@example.com' } },
  { icon: MessageCircle, title: 'Live chat', description: "Our friendly team is here to help.", link: { label: 'Start new chat', href: '#chat' } },
  { icon: MapPin, title: 'Office', description: "Come say hello at our office HQ.", link: { label: '100 Flinders Street, Melbourne VIC 3000 AU', href: '#map' } },
  { icon: Phone, title: 'Phone', description: "Mon–Fri from 8am to 5pm.", link: { label: '+1 (555) 000-0000', href: 'tel:+15550000000' } },
]
---

<Section spacing="large">
  <SectionHeader eyebrow="Contact us" heading="Chat to our friendly team" description="We'd love to hear from you. Please fill out this form or shoot us an email." class="mb-16" />
  <div class="grid gap-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)]">
    <ul class="list-none p-0 grid gap-10 sm:grid-cols-2 lg:grid-cols-1">
    {methods.map((m) => (
      <li><ContactMethod title={m.title} description={m.description} link={m.link} inline><FeaturedIcon slot="icon" theme="outline" color="neutral"><m.icon /></FeaturedIcon></ContactMethod></li>
    ))}
  </ul>
    <div class="rounded-2xl bg-neutral-faded p-6 sm:p-8"><ContactForm /></div>
  </div>
</Section>
