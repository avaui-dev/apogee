---
/**
 * Vector map 03: A heading over a world map with office pins (from lg) and three contact cards.
 *
 * @block contact
 * @order 21
 */
import { LifeBuoy, MessagesSquare, Phone } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import ContactMethod from '../../components/ContactMethod/ContactMethod.astro'
import WorldMap from '../../components/WorldMap/WorldMap.astro'
import FeaturedIcon from '../../components/FeaturedIcon/FeaturedIcon.astro'
import Badge from '../../components/Badge/Badge.astro'

const methods = [
  { icon: LifeBuoy, title: 'Chat to support', description: "We're here to help.", link: { label: 'support@example.com', href: 'mailto:support@example.com' } },
  { icon: MessagesSquare, title: 'Chat to sales', description: "Speak to our friendly team.", link: { label: 'sales@example.com', href: 'mailto:sales@example.com' } },
  { icon: Phone, title: 'Phone', description: "Mon–Fri from 8am to 5pm.", link: { label: '+1 (555) 000-0000', href: 'tel:+15550000000' } },
]
const pins = [
  { label: 'Melbourne', detail: '100 Flinders Street, Melbourne VIC 3000 AU', lat: -37.8183, lon: 144.9671 },
  { label: 'Sydney', detail: '100 George Street, Sydney NSW 2000 AU', lat: -33.8615, lon: 151.2073 },
  { label: 'Byron Bay', detail: '50 Jonson Street, Byron Bay NSW 2481 AU', lat: -28.6431, lon: 153.6139 },
  { label: 'London', detail: '100 Oxford Street, London W1D 1LL UK', lat: 51.5154, lon: -0.141 },
  { label: 'San Francisco', detail: '100 Market Street, San Francisco, CA 94105 US', lat: 37.7936, lon: -122.395 },
  { label: 'Stockholm', detail: 'Drottninggatan 100, 111 60 Stockholm SE', lat: 59.3326, lon: 18.0649 },
  { label: 'New York', detail: '100 Broadway, New York, NY 10005 US', lat: 40.7081, lon: -74.011 },
  { label: 'Tokyo', detail: '1-1 Marunouchi, Chiyoda City, Tokyo JP', lat: 35.6812, lon: 139.7671 },
  { label: 'Cape Town', detail: '100 Long Street, Cape Town 8001 ZA', lat: -33.9213, lon: 18.418 },
]
---

<Section spacing="large">
  <div class="mb-16 flex flex-col items-start gap-4">
    <Badge color="primary" rounded>Stores</Badge>
    <SectionHeader heading="Our locations" description="Find us at these locations." />
  </div>
  <WorldMap pins={pins} label="Our offices" class="mb-16 max-lg:hidden" />
  <ul class="list-none p-0 grid gap-6 md:grid-cols-3">
    {methods.map((m) => (
      <li><ContactMethod title={m.title} description={m.description} link={m.link} variant="card"><FeaturedIcon slot="icon" theme="outline" color="neutral"><m.icon /></FeaturedIcon></ContactMethod></li>
    ))}
  </ul>
</Section>
