---
/**
 * Simple links 02: A heading over four contact cards.
 *
 * @block contact
 * @order 6
 */
import { LifeBuoy, Mail, MapPin, MessageCircle, MessagesSquare, Phone } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import ContactMethod from '../../components/ContactMethod/ContactMethod.astro'
import FeaturedIcon from '../../components/FeaturedIcon/FeaturedIcon.astro'
import { plain } from '../../sections/_shared/spine.ts'
import type { ContactContent } from '../../sections/_shared/contact.ts'

const icons = { mail: Mail, phone: Phone, 'map-pin': MapPin, 'message-circle': MessageCircle, 'messages-square': MessagesSquare, 'life-buoy': LifeBuoy } as const

/** @composable */
interface Props extends ContactContent {
  /** 1 when the block opens a page; its items move one level down with it. */
  headingLevel?: 1 | 2
}
const {
  headingLevel = 2,
  eyebrow = 'Contact us',
  heading = 'Chat to our friendly team',
  description = 'Our friendly team would love to hear from you.',
  details = [
    { icon: 'messages-square', label: 'Chat to sales', description: 'Speak to our friendly team.', value: 'sales@example.com', href: 'mailto:sales@example.com' },
    { icon: 'life-buoy', label: 'Chat to support', description: "We're here to help.", value: 'support@example.com', href: 'mailto:support@example.com' },
    { icon: 'map-pin', label: 'Visit us', description: 'Visit our office HQ.', value: 'View on the map', href: '#map' },
    { icon: 'phone', label: 'Call us', description: 'Mon–Fri from 8am to 5pm.', value: '+1 (555) 000-0000', href: 'tel:+15550000000' },
  ],
} = Astro.props
const itemLevel = headingLevel === 1 ? (2 as const) : (3 as const)
---

<Section spacing="large">
  <SectionHeader headingLevel={headingLevel} eyebrow={eyebrow ?? undefined} heading={plain(heading)} description={description ?? undefined} class="mb-16" />
  {details && <ul class="list-none p-0 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {details.map((d) => {
      const Icon = icons[d.icon]
      return <li><ContactMethod headingLevel={itemLevel} title={d.label} description={d.description} link={d.href ? { label: d.value, href: d.href } : undefined} variant="card"><FeaturedIcon slot="icon" theme="outline" color="neutral"><Icon /></FeaturedIcon>{!d.href && <p>{d.value}</p>}</ContactMethod></li>
    })}
  </ul>}
</Section>
