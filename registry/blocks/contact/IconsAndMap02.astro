---
/**
 * Icons and map 02: A heading and two offices on a grey band, over a map that overlaps its edge.
 *
 * @block contact
 * @order 36
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import MapEmbed from '../../components/MapEmbed/MapEmbed.astro'
import Heading from '../../components/Heading/Heading.astro'
import { plain } from '../../sections/_shared/spine.ts'
import type { ContactContent } from '../../sections/_shared/contact.ts'


/** @composable */
interface Props extends ContactContent {}

const {
  eyebrow = 'Locations',
  heading = 'Our locations',
  description = 'Come visit our friendly team at one of our offices.',
  locations = [
    { name: 'Melbourne', address: '100 Flinders Street, Melbourne VIC 3000 AU', lat: -37.8183, lon: 144.9671 },
    { name: 'Sydney', address: '100 George Street, Sydney NSW 2000 AU', lat: -33.8615, lon: 151.2073 },
  ],
} = Astro.props
const office = locations?.[0]
---

<Section spacing="large" background="neutral-faded" class="pb-0">
  <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
    <SectionHeader eyebrow={eyebrow ?? undefined} heading={plain(heading)} description={description ?? undefined} />
    {locations && <ul class="list-none p-0 grid gap-8 sm:grid-cols-2">
    {locations.map((s) => (
      <li class="flex flex-col gap-1">
        <Heading as="h3" size="h6">{s.name}</Heading>
        <p class="apogee-store-address">{s.address}</p>
      </li>
    ))}
  </ul>}
  </div>
  {office && <MapEmbed lat={office.lat} lon={office.lon} title={`Map of our ${office.name} office`} class="relative -mb-24 mt-16 h-96 bg-page md:-mb-32 md:h-[30rem]" />}
</Section>
<div class="h-24 md:h-32" aria-hidden="true"></div>

<style>
  .apogee-store-address {
    color: var(--foreground-neutral-faded);
  }
  :global(:is(.bg-primary, .bg-inverted)) .apogee-store-address {
    color: inherit;
    opacity: 0.85;
  }
</style>
