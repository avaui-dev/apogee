---
/**
 * Simple form 01: A centred heading over a contact form capped to a readable width.
 *
 * @block contact
 * @order 22
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import ContactForm from '../../components/ContactForm/ContactForm.astro'
import { plain } from '../../sections/_shared/spine.ts'
import type { ContactContent } from '../../sections/_shared/contact.ts'

/** @composable */
interface Props extends ContactContent {}

const {
  eyebrow = 'Contact us',
  heading = 'Get in touch',
  description = "We'd love to hear from you. Please fill out this form.",
  action,
  method,
  submitLabel = 'Send message',
} = Astro.props
---

<Section spacing="large" containerWidth="small">
  <SectionHeader eyebrow={eyebrow ?? undefined} heading={plain(heading)} description={description ?? undefined} align="center" class="mb-12" />
  <div class="mx-auto w-full md:max-w-md"><ContactForm action={action} method={method} submitLabel={submitLabel} /></div>
</Section>
