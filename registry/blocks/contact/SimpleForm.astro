---
/**
 * Simple form: A centred heading over a contact form.
 *
 * @block contact
 * @order 1
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import ContactForm from '../../components/ContactForm/ContactForm.astro'

---

<Section spacing="large" containerWidth="small">
  <SectionHeader eyebrow="Contact us" heading="Contact us" description="We'd love to hear from you. Please fill out this form." align="center" class="mb-12" />
  <div class="mx-auto w-full max-w-lg"><ContactForm /></div>
</Section>
