---
/**
 * Simple form: A centred heading over a contact form.
 *
 * @block contact
 * @order 1
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import ContactForm from '../../components/ContactForm/ContactForm.astro'

interface Props {
  /** 1 when the block opens a page; its items move one level down with it. */
  headingLevel?: 1 | 2
}
const { headingLevel = 2 } = Astro.props
---

<Section spacing="large" containerWidth="small">
  <SectionHeader headingLevel={headingLevel} eyebrow="Contact us" heading="Get in touch" description="We'd love to hear from you. Please fill out this form." align="center" class="mb-12" />
  <div class="mx-auto w-full max-w-lg"><ContactForm /></div>
</Section>
