---
/**
 * Simple logos 01 brand: Simple logos 01 on the brand colour.
 *
 * @block cta
 * @order 26
 */
import { Atom, Circle, Hexagon, Mountain, Sprout, Square, Sun, Waves, Wind } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Button from '../../components/Button/Button.astro'

const logos = [
  { name: 'Lumen', icon: Hexagon },
  { name: 'Quanta', icon: Atom },
  { name: 'Fieldwork', icon: Sprout },
  { name: 'Northpeak', icon: Mountain },
  { name: 'Arcwave', icon: Waves },
  { name: 'Kitestring', icon: Wind },
  { name: 'Ovalis', icon: Circle },
  { name: 'Brightline', icon: Sun },
  { name: 'Corner', icon: Square },
]
---

<Section spacing="large" background="primary">
  <div class="flex flex-col items-center gap-8 text-center">
    <SectionHeader heading="Start your 30-day free trial" description="Join over 4,000+ startups already growing with us." align="center" background="primary" />
    <div class="flex flex-col-reverse gap-3 sm:flex-row ">
      <Button href="#" size="large" variant="outline" color="neutral" class="border-current! text-inherit! shadow-none!">Learn more</Button>
      <Button href="#" size="large" color="neutral">Get started</Button>
    </div>
  </div>
  <div class="mt-16">
    <ul class="list-none p-0 flex flex-wrap items-center justify-center gap-x-10 gap-y-6" aria-label="Customers">
      {logos.map((l) => <li class="flex items-center gap-2 text-lg font-semibold opacity-85"><l.icon class="size-6" aria-hidden="true" />{l.name}</li>)}
    </ul>
  </div>
</Section>
