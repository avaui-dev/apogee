---
/**
 * Simple logos 02: A heading and two buttons beside a grid of customer logos.
 *
 * @block cta
 * @order 4
 */
import { Atom, Circle, Hexagon, Mountain, Sprout, Square, Sun, Waves, Wind } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Button from '../../components/Button/Button.astro'

const logos = [
  { name: 'Lumen', icon: Hexagon },
  { name: 'Quanta', icon: Atom },
  { name: 'Fieldwork', icon: Sprout },
  { name: 'Northpeak', icon: Mountain },
  { name: 'Arcwave', icon: Waves },
  { name: 'Kitestring', icon: Wind },
  { name: 'Ovalis', icon: Circle },
  { name: 'Brightline', icon: Sun },
  { name: 'Corner', icon: Square },
]
---

<Section spacing="large">
  <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div class="flex flex-col gap-8">
      <SectionHeader heading="Join 4,000+ startups growing with us" description="Start your 30-day free trial today." />
      <div class="flex flex-col-reverse gap-3 sm:flex-row ">
      <Button href="#" size="large" variant="outline" color="neutral">Learn more</Button>
      <Button href="#" size="large">Get started</Button>
    </div>
    </div>
    <ul class="list-none p-0 grid grid-cols-2 gap-x-8 gap-y-8 sm:grid-cols-3" aria-label="Customers">
      {logos.map((l) => <li class="flex items-center gap-2 text-lg font-semibold text-neutral-faded"><l.icon class="size-6" aria-hidden="true" />{l.name}</li>)}
    </ul>
  </div>
</Section>
