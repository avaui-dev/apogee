---
/**
 * Split image quote 01: A heading, three checks and two buttons beside a sliding testimonial.
 *
 * @block cta
 * @order 9
 */
import { Check } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Button from '../../components/Button/Button.astro'
import Image from '../../components/Image/Image.astro'
import Carousel from '../../components/Carousel/Carousel.astro'
import Rating from '../../components/Rating/Rating.astro'

const reviews = [
  { quote: 'We shipped our redesign in half the time, and the reviews are about the product now, not the buttons.', name: 'Ada Lovelace', role: 'Design Lead', company: 'Northpeak', seed: 'apogee-cta-q1' },
  { quote: 'The team finally speaks one language. New people ship on their first day.', name: 'Alan Turing', role: 'Engineering Manager', company: 'Quanta', seed: 'apogee-cta-q2' },
  { quote: 'Accessibility stopped being an audit at the end. It is in every part we use.', name: 'Grace Hopper', role: 'Product Manager', company: 'Fieldwork', seed: 'apogee-cta-q3' },
]
---

<Section spacing="large">
  <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div class="flex flex-col justify-center gap-8">
      <SectionHeader heading="Join 4,000+ startups growing with us" description="Start your 30-day free trial today." />
      <ul class="flex list-none flex-col gap-4 p-0">
      {['30-day free trial', 'Personalised onboarding', 'Access to all features'].map((c) => (
        <li class="flex items-center gap-3"><span class="grid size-7 shrink-0 place-items-center rounded-full bg-positive-faded text-positive"><Check class="size-4" aria-hidden="true" /></span>{c}</li>
      ))}
    </ul>
      <div class="flex flex-col-reverse gap-3 sm:flex-row ">
      <Button href="#" size="large" variant="outline" color="neutral">Learn more</Button>
      <Button href="#" size="large">Get started</Button>
    </div>
    </div>
    <Carousel label="What customers say" visibleItems={1} controlsVariant="overlay" class="min-w-0">
      {reviews.map((r) => (
        <figure class="relative m-0 overflow-hidden rounded-2xl">
          <Image src={`https://picsum.photos/seed/${r.seed}/1200/1400`} alt="" width={1200} height={1400} fit="cover" class="aspect-[6/7] w-full" />
          <figcaption class="absolute inset-x-0 bottom-0 flex flex-col gap-4 bg-inverted/40 p-6 text-on-inverted backdrop-blur-md md:p-8">
            <Rating value={5} readonly aria-label="Rated 5 out of 5" />
            <blockquote class="m-0 text-xl font-semibold text-balance md:text-2xl">“{r.quote}”</blockquote>
            <p><span class="font-semibold">{r.name}</span><br /><span class="text-sm">{r.role}, {r.company}</span></p>
          </figcaption>
        </figure>
      ))}
    </Carousel>
  </div>
</Section>
