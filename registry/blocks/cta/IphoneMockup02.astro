---
/**
 * Phone mockup 02: A heading and download buttons beside a phone rising out of a tinted band.
 *
 * @block cta
 * @order 14
 */
import { Download, Smartphone } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Button from '../../components/Button/Button.astro'
import DeviceFrame from '../../components/DeviceFrame/DeviceFrame.astro'

---

<Section spacing="large">
  <div class="grid items-end gap-12 lg:grid-cols-2 lg:gap-16">
    <div class="flex flex-col gap-8 lg:pb-16">
      <SectionHeader heading="Growth performance tracking made easy" description="Start your 30-day free trial today." />
      <div class="flex flex-wrap gap-3">
      <Button href="#" size="large" variant="outline" color="neutral"><Smartphone slot="start" aria-hidden="true" />Download for iOS</Button>
      <Button href="#" size="large" variant="outline" color="neutral"><Download slot="start" aria-hidden="true" />Get it on Android</Button>
    </div>
    </div>
    <div class="relative flex justify-center pt-12">
      <div class="absolute inset-x-0 bottom-0 h-3/4 rounded-2xl bg-neutral-faded" aria-hidden="true"></div>
      <DeviceFrame device="phone" src="/mockups/app-phone-light.jpg" srcDark="/mockups/app-phone-dark.jpg" alt="The dashboard on a phone" class="relative max-w-64" />
    </div>
  </div>
</Section>
