---
/**
 * Card vertical: A centred tinted card with a heading, line and two buttons.
 *
 * @block cta
 * @order 23
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Button from '../../components/Button/Button.astro'

---

<Section spacing="large" containerWidth="medium">
  <div class="flex flex-col items-center gap-8 rounded-2xl bg-neutral-faded p-8 text-center md:p-16">
    <SectionHeader heading="Start your 30-day free trial" description="Join over 4,000+ startups already growing with us." align="center" />
    <div class="flex flex-col-reverse gap-3 sm:flex-row ">
      <Button href="#" size="large" variant="outline" color="neutral">Learn more</Button>
      <Button href="#" size="large">Get started</Button>
    </div>
  </div>
</Section>
