---
/**
 * Card vertical brand: A brand-colour card with the heading and line beside two buttons from lg.
 *
 * @block cta
 * @order 29
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Button from '../../components/Button/Button.astro'

---

<Section spacing="large">
  <div class="flex flex-col gap-8 rounded-2xl bg-primary p-8 text-on-primary md:p-16 lg:flex-row lg:items-center lg:justify-between">
    <SectionHeader heading="Start your 30-day free trial" description="Join over 4,000+ startups already growing with us." background="primary" />
    <div class="flex flex-col-reverse gap-3 sm:flex-row shrink-0">
      <Button href="#" size="large" variant="outline" color="neutral" class="border-current! bg-transparent! text-inherit! shadow-none!">Learn more</Button>
      <Button href="#" size="large" color="neutral">Get started</Button>
    </div>
  </div>
</Section>
