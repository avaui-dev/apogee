---
/**
 * Simple centred brand: Simple centred on the brand colour.
 *
 * @block cta
 * @order 24
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Button from '../../components/Button/Button.astro'

---

<Section spacing="large" background="primary">
  <div class="flex flex-col items-center gap-8 text-center">
    <SectionHeader heading="Start your free trial" description="Join over 4,000+ startups already growing with us." align="center" background="primary" />
    <div class="flex flex-col-reverse gap-3 sm:flex-row ">
      <Button href="#" size="large" variant="outline" color="neutral" class="border-current! text-inherit! shadow-none!">Learn more</Button>
      <Button href="#" size="large" color="neutral">Get started</Button>
    </div>
  </div>
</Section>
