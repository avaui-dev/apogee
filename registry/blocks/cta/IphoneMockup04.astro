---
/**
 * Phone mockup 04: A brand-colour card: a heading and download buttons beside a phone.
 *
 * @block cta
 * @order 16
 */
import { Download, Smartphone } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Button from '../../components/Button/Button.astro'
import DeviceFrame from '../../components/DeviceFrame/DeviceFrame.astro'

---

<Section spacing="large">
  <div class="grid items-center gap-12 overflow-hidden rounded-2xl bg-primary px-8 pt-12 text-on-primary md:px-16 lg:grid-cols-2 lg:pt-0">
    <div class="flex flex-col gap-8 lg:py-16">
      <SectionHeader heading="Start your free trial" description="Personal performance tracking made easy." background="primary" />
      <div class="flex flex-wrap gap-3">
      <Button href="#" size="large" variant="outline" color="neutral" class="border-current! bg-transparent! text-inherit! shadow-none!"><Smartphone slot="start" aria-hidden="true" />Download for iOS</Button>
      <Button href="#" size="large" variant="outline" color="neutral" class="border-current! bg-transparent! text-inherit! shadow-none!"><Download slot="start" aria-hidden="true" />Get it on Android</Button>
    </div>
    </div>
    <div class="flex h-80 justify-center lg:h-auto lg:self-stretch lg:pt-12">
      <DeviceFrame device="phone" src="/mockups/app-phone-light.jpg" srcDark="/mockups/app-phone-dark.jpg" alt="The dashboard on a phone" class="max-w-64" />
    </div>
  </div>
</Section>
