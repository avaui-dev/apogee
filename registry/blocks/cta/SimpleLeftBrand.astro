---
/**
 * Simple left brand: Simple left on the brand colour.
 *
 * @block cta
 * @order 25
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Button from '../../components/Button/Button.astro'
import { plain } from '../../sections/_shared/spine.ts'
import type { CTAContent } from '../../sections/_shared/cta.ts'

/** @composable */
interface Props extends CTAContent {}

const {
  eyebrow,
  heading = 'Start your free trial',
  description = 'Join over 4,000+ startups already growing with us.',
  primaryAction = { label: 'Get started', href: '#' },
  secondaryAction = { label: 'Learn more', href: '#' },
} = Astro.props

---

<Section spacing="large" background="primary">
  <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
    <SectionHeader eyebrow={eyebrow ?? undefined} heading={plain(heading)} description={description ?? undefined} background="primary" />
    {(primaryAction || secondaryAction) && (
    <div class="flex flex-col-reverse gap-3 sm:flex-row shrink-0">
      {secondaryAction && <Button href={secondaryAction.href} size="large" variant="outline" color="neutral" class="border-current! bg-transparent! text-inherit! shadow-none!">{secondaryAction.label}</Button>}
      {primaryAction && <Button href={primaryAction.href} size="large" color="neutral">{primaryAction.label}</Button>}
    </div>
    )}
  </div>
</Section>
