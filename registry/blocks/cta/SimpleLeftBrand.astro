    <SectionHeader heading="Start your free trial" description="Join over 4,000+ startups already growing with us." background="primary" />
    <div class="flex flex-col-reverse gap-3 sm:flex-row shrink-0">
      <Button href="#" size="large" variant="outline" color="neutral" class="border-current! text-inherit! shadow-none!">Learn more</Button>
      <Button href="#" size="large" color="neutral">Get started</Button>
    </div>
  </div>
