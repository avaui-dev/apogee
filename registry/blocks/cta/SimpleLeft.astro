---
/**
 * Simple left: A heading and line with two buttons beside them from lg.
 *
 * @block cta
 * @order 2
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Button from '../../components/Button/Button.astro'

---

<Section spacing="large">
  <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
    <SectionHeader heading="Start your free trial" description="Join over 4,000+ startups already growing with us." />
    <div class="flex flex-col-reverse gap-3 sm:flex-row shrink-0">
      <Button href="#" size="large" variant="outline" color="neutral">Learn more</Button>
      <Button href="#" size="large">Get started</Button>
    </div>
  </div>
</Section>
