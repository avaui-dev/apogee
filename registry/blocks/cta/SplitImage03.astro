---
/**
 * Split image 03: A centred heading block on a tinted band over a wide photo.
 *
 * @block cta
 * @order 7
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Button from '../../components/Button/Button.astro'
import Image from '../../components/Image/Image.astro'

---

<Section spacing="large" background="neutral-faded">
  <div class="flex flex-col items-center gap-8 text-center">
    <SectionHeader eyebrow="Get started" heading="Start your 30-day free trial" description="Join over 4,000+ startups already growing with us." align="center" />
    <div class="flex flex-col-reverse gap-3 sm:flex-row ">
      <Button href="#" size="large" variant="outline" color="neutral">Learn more</Button>
      <Button href="#" size="large">Get started</Button>
    </div>
  </div>
  <Image src="https://picsum.photos/seed/apogee-cta-3/1600/700" alt="" width={1600} height={700} fit="cover" radius="xl" class="mt-16 aspect-[16/7] w-full" />
</Section>
