---
/**
 * Screen mockup 02: A heading and two buttons beside the app in a browser window (from lg).
 *
 * @block cta
 * @order 18
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Button from '../../components/Button/Button.astro'
import DeviceFrame from '../../components/DeviceFrame/DeviceFrame.astro'

---

<Section spacing="large" class="overflow-hidden">
  <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] lg:gap-16">
    <div class="flex flex-col gap-8">
      <SectionHeader heading="Join 4,000+ startups growing with us" description="Start your 30-day free trial today." />
      <div class="flex flex-col-reverse gap-3 sm:flex-row ">
      <Button href="#" size="large" variant="outline" color="neutral">Learn more</Button>
      <Button href="#" size="large">Get started</Button>
    </div>
    </div>
    <DeviceFrame device="browser" src="/mockups/app-desktop-light.jpg" srcDark="/mockups/app-desktop-dark.jpg" alt="The dashboard in a browser" class="max-lg:hidden lg:w-[140%]" />
  </div>
</Section>
