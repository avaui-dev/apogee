---
/**
 * Simple centred: A centred heading, line and two buttons.
 *
 * @block cta
 * @order 1
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Button from '../../components/Button/Button.astro'
import { plain } from '../../sections/_shared/spine.ts'
import type { CTAContent } from '../../sections/_shared/cta.ts'

/** @composable */
interface Props extends CTAContent {}

const {
  eyebrow,
  heading = 'Start your free trial',
  description = 'Join over 4,000+ startups already growing with us.',
  primaryAction = { label: 'Get started', href: '#' },
  secondaryAction = { label: 'Learn more', href: '#' },
} = Astro.props

---

<Section spacing="large">
  <div class="flex flex-col items-center gap-8 text-center">
    <SectionHeader eyebrow={eyebrow ?? undefined} heading={plain(heading)} description={description ?? undefined} align="center" />
    {(primaryAction || secondaryAction) && (
    <div class="flex flex-col-reverse gap-3 sm:flex-row ">
      {secondaryAction && <Button href={secondaryAction.href} size="large" variant="outline" color="neutral">{secondaryAction.label}</Button>}
      {primaryAction && <Button href={primaryAction.href} size="large">{primaryAction.label}</Button>}
    </div>
    )}
  </div>
</Section>
