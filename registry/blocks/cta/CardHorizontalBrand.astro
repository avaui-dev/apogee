---
/**
 * Card horizontal brand: A brand-colour card, centred, with a heading, line and two buttons.
 *
 * @block cta
 * @order 28
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Button from '../../components/Button/Button.astro'

---

<Section spacing="large">
  <div class="flex flex-col items-center gap-8 rounded-2xl bg-primary p-8 text-center text-on-primary md:p-16">
    <SectionHeader heading="Start your 30-day free trial" description="Join over 4,000+ startups already growing with us." align="center" background="primary" />
    <div class="flex flex-col-reverse gap-3 sm:flex-row ">
      <Button href="#" size="large" variant="outline" color="neutral" class="border-current! bg-transparent! text-inherit! shadow-none!">Learn more</Button>
      <Button href="#" size="large" color="neutral">Get started</Button>
    </div>
  </div>
</Section>
