---
/**
 * Split image 04: A brand-colour card: a heading and two buttons beside a photo.
 *
 * @block cta
 * @order 8
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Button from '../../components/Button/Button.astro'
import Image from '../../components/Image/Image.astro'

---

<Section spacing="large">
  <div class="grid overflow-hidden rounded-2xl bg-primary text-on-primary lg:grid-cols-2">
    <div class="flex flex-col justify-center gap-8 p-8 md:p-16">
      <SectionHeader heading="Give us a shot" description="Join over 4,000+ startups already growing with us." background="primary" />
      <div class="flex flex-col-reverse gap-3 sm:flex-row ">
      <Button href="#" size="large" variant="outline" color="neutral" class="border-current! bg-transparent! text-inherit! shadow-none!">Learn more</Button>
      <Button href="#" size="large" color="neutral">Get started</Button>
    </div>
    </div>
    <Image src="https://picsum.photos/seed/apogee-cta-4/1200/1000" alt="" width={1200} height={1000} fit="cover" class="min-h-72 size-full" />
  </div>
</Section>
