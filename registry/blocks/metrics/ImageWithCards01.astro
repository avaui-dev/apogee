---
/**
 * Image with cards 01: A centred heading with a badge over three figure cards on a photo.
 *
 * @block metrics
 * @order 3
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Badge from '../../components/Badge/Badge.astro'
import Image from '../../components/Image/Image.astro'

---

<Section spacing="large">
  <div class="flex flex-col items-center gap-12 md:gap-16">
    <div class="flex flex-col items-center gap-4">
      <Badge color="primary" rounded>Launch faster</Badge>
      <SectionHeader heading="Build something great" description="Everything you need to build modern interfaces and great products." size="large" align="center" />
    </div>
    <div class="relative isolate overflow-hidden rounded-2xl px-6 py-8 md:p-16">
      <div class="absolute inset-0 -z-10"><Image src="https://picsum.photos/seed/apogee-metrics-1/1600/900" alt="" width={1600} height={900} fit="cover" class="size-full" /></div>
      <dl class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-2xl bg-page/85 p-6 shadow-raised ring-1 ring-inset ring-neutral backdrop-blur-lg">
          <div class="flex flex-col gap-3 items-center text-center">
            <dt class="order-2 text-lg font-semibold">Projects completed</dt>
            <dd class="order-1 text-5xl font-semibold tracking-tight tabular-nums md:text-6xl text-primary">400+</dd>
            <dd class="order-3 text-neutral-faded">We've helped build over 400 projects with teams of every size.</dd>
          </div>
        </div>
        <div class="rounded-2xl bg-page/85 p-6 shadow-raised ring-1 ring-inset ring-neutral backdrop-blur-lg">
          <div class="flex flex-col gap-3 items-center text-center">
            <dt class="order-2 text-lg font-semibold">Return on investment</dt>
            <dd class="order-1 text-5xl font-semibold tracking-tight tabular-nums md:text-6xl text-primary">600%</dd>
            <dd class="order-3 text-neutral-faded">Customers report an average return of about 600%.</dd>
          </div>
        </div>
        <div class="rounded-2xl bg-page/85 p-6 shadow-raised ring-1 ring-inset ring-neutral backdrop-blur-lg">
          <div class="flex flex-col gap-3 items-center text-center">
            <dt class="order-2 text-lg font-semibold">Global downloads</dt>
            <dd class="order-1 text-5xl font-semibold tracking-tight tabular-nums md:text-6xl text-primary">10k</dd>
            <dd class="order-3 text-neutral-faded">Our starter kit has been downloaded over 10k times.</dd>
          </div>
        </div>
      </dl>
    </div>
  </div>
</Section>
