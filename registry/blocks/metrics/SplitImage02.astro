---
/**
 * Split image 02: A photo beside a heading and four figures.
 *
 * @block metrics
 * @order 15
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Image from '../../components/Image/Image.astro'
import { plain } from '../../sections/_shared/spine.ts'
import type { MetricsContent } from '../../sections/_shared/metrics.ts'

/** @composable */
interface Props extends MetricsContent {}

const {
  eyebrow = 'Build better, launch faster',
  heading = 'Build great products, faster than ever',
  description = "Everything you need to build modern interfaces and great products. We've done the heavy lifting, so you can start any project from a solid base.",
  items = [
    { value: '400+', label: 'Projects completed' },
    { value: '600%', label: 'Return on investment' },
    { value: '10k', label: 'Global downloads' },
    { value: '200+', label: 'Five-star reviews' },
  ],
  media = { src: 'https://picsum.photos/seed/apogee-metrics-5/1200/1100', alt: '', width: 1200, height: 1100 },
} = Astro.props
---

<Section spacing="large">
  <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
    <div class="flex flex-col gap-12 self-center">
      <SectionHeader eyebrow={eyebrow ?? undefined} heading={plain(heading)} description={description ?? undefined} size="large" />
      <dl class="grid gap-8 sm:grid-cols-2 sm:gap-y-12">
        {items.map((s) => (
          <div class="flex flex-col gap-3">
            <dt class="order-2 text-lg font-semibold">{s.label}</dt>
            <dd class="order-1 text-5xl font-semibold tracking-tight tabular-nums md:text-6xl text-primary">{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
    {media && <Image src={media.src} alt={media.alt} width={media.width} height={media.height} fit="cover" radius="xl" class="h-70 w-full md:h-140 lg:order-first" />}
  </div>
</Section>
