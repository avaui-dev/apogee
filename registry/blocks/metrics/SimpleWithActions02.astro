---
/**
 * Simple with actions 02: A heading and actions beside four figures, each with an icon.
 *
 * @block metrics
 * @order 12
 */
import { ChartLine, CirclePlay, CloudDownload, Star, Zap } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Button from '../../components/Button/Button.astro'
import FeaturedIcon from '../../components/FeaturedIcon/FeaturedIcon.astro'

---

<Section spacing="large">
  <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
    <div class="flex flex-col gap-8">
      <SectionHeader heading="Build something great" description="Everything you need to build modern interfaces and great products." size="large" />
      <div class="flex flex-col gap-3 sm:flex-row">
        <Button href="#" size="large" variant="outline" color="neutral"><CirclePlay slot="start" aria-hidden="true" />Demo</Button>
        <Button href="#" size="large">Get started</Button>
      </div>
    </div>
    <ul role="list" aria-label="Key figures" class="grid gap-x-8 gap-y-10 md:grid-cols-2 md:gap-y-12">
      <li class="flex flex-col items-center gap-4 text-center md:flex-row md:items-start md:text-start">
          <FeaturedIcon theme="light" color="primary" size="large" class="shrink-0"><Zap /></FeaturedIcon>
          <div class="flex flex-col gap-3">
            <p class="text-5xl font-semibold tracking-tight tabular-nums md:text-6xl text-primary">400+</p>
            <p class="text-lg font-semibold">Projects completed</p>
          </div>
        </li>
        <li class="flex flex-col items-center gap-4 text-center md:flex-row md:items-start md:text-start">
          <FeaturedIcon theme="light" color="primary" size="large" class="shrink-0"><ChartLine /></FeaturedIcon>
          <div class="flex flex-col gap-3">
            <p class="text-5xl font-semibold tracking-tight tabular-nums md:text-6xl text-primary">600%</p>
            <p class="text-lg font-semibold">Return on investment</p>
          </div>
        </li>
        <li class="flex flex-col items-center gap-4 text-center md:flex-row md:items-start md:text-start">
          <FeaturedIcon theme="light" color="primary" size="large" class="shrink-0"><CloudDownload /></FeaturedIcon>
          <div class="flex flex-col gap-3">
            <p class="text-5xl font-semibold tracking-tight tabular-nums md:text-6xl text-primary">10k</p>
            <p class="text-lg font-semibold">Global downloads</p>
          </div>
        </li>
        <li class="flex flex-col items-center gap-4 text-center md:flex-row md:items-start md:text-start">
          <FeaturedIcon theme="light" color="primary" size="large" class="shrink-0"><Star /></FeaturedIcon>
          <div class="flex flex-col gap-3">
            <p class="text-5xl font-semibold tracking-tight tabular-nums md:text-6xl text-primary">200+</p>
            <p class="text-lg font-semibold">Five-star reviews</p>
          </div>
        </li>
    </ul>
  </div>
</Section>
