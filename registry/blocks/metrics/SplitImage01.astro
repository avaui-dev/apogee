---
/**
 * Split image 01: A heading over four figures with a line each, beside a photo.
 *
 * @block metrics
 * @order 13
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Image from '../../components/Image/Image.astro'
import { plain } from '../../sections/_shared/spine.ts'
import type { MetricsContent } from '../../sections/_shared/metrics.ts'

/** @composable */
interface Props extends MetricsContent {}

const {
  eyebrow = 'Launch faster',
  heading = 'Build something great',
  description = "Everything you need to build modern interfaces and great products. We've done the heavy lifting, so you can start any project from a solid base.",
  items = [
    { value: '400+', label: 'Projects completed', description: "We've helped build over 400 projects with teams of every size." },
    { value: '600%', label: 'Return on investment', description: "Customers report an average return of about 600%." },
    { value: '10k', label: 'Global downloads', description: "Our starter kit has been downloaded over 10k times." },
    { value: '200+', label: 'Five-star reviews', description: "We're proud of a five-star rating across 200+ reviews." },
  ],
  media = { src: 'https://picsum.photos/seed/apogee-metrics-3/1200/1100', alt: '', width: 1200, height: 1100 },
} = Astro.props
---

<Section spacing="large">
  <div class="flex flex-col gap-12 md:gap-16">
    <SectionHeader eyebrow={eyebrow ?? undefined} heading={plain(heading)} description={description ?? undefined} size="large" />
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <dl class="grid gap-8 self-center md:grid-cols-2 md:gap-y-16">
        {items.map((s) => (
          <div class="flex flex-col gap-3 items-center text-center">
            <dt class="order-2 text-lg font-semibold">{s.label}</dt>
            <dd class="order-1 text-5xl font-semibold tracking-tight tabular-nums md:text-6xl text-primary">{s.value}</dd>
            {s.description && <dd class="order-3 text-neutral-faded">{s.description}</dd>}
          </div>
        ))}
      </dl>
      {media && <Image src={media.src} alt={media.alt} width={media.width} height={media.height} fit="cover" radius="xl" class="h-70 w-full md:h-140" />}
    </div>
  </div>
</Section>
