---
/**
 * Simple with actions 01: A heading with actions beside it, over four figures with a line each.
 *
 * @block metrics
 * @order 11
 */
import { CirclePlay } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Button from '../../components/Button/Button.astro'
import { plain } from '../../sections/_shared/spine.ts'
import type { MetricsContent } from '../../sections/_shared/metrics.ts'

/** @composable */
interface Props extends MetricsContent {}

const {
  heading = 'Build something great',
  description = 'Everything you need to build modern interfaces and great products.',
  primaryAction = { label: 'Get started', href: '#' },
  secondaryAction = { label: 'Demo', href: '#' },
  items = [
    { value: '400+', label: 'Projects completed', description: "We've helped build over 400 projects with teams of every size." },
    { value: '600%', label: 'Return on investment', description: "Customers report an average return of about 600%." },
    { value: '10k', label: 'Global downloads', description: "Our starter kit has been downloaded over 10k times." },
    { value: '200+', label: 'Five-star reviews', description: "We're proud of a five-star rating across 200+ reviews." },
  ],
} = Astro.props
---

<Section spacing="large">
  <div class="flex flex-col gap-12 md:gap-16">
    <SectionHeader heading={plain(heading)} description={description ?? undefined} size="large">
      {(primaryAction || secondaryAction) && (
        <Fragment slot="actions">
          {secondaryAction && <Button href={secondaryAction.href} size="large" variant="outline" color="neutral"><CirclePlay slot="start" aria-hidden="true" />{secondaryAction.label}</Button>}
          {primaryAction && <Button href={primaryAction.href} size="large">{primaryAction.label}</Button>}
        </Fragment>
      )}
    </SectionHeader>
    <dl class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {items.map((s) => (
        <div class="flex flex-col gap-3">
          <dt class="order-2 text-lg font-semibold">{s.label}</dt>
          <dd class="order-1 text-5xl font-semibold tracking-tight tabular-nums md:text-6xl text-primary">{s.value}</dd>
          {s.description && <dd class="order-3 text-neutral-faded">{s.description}</dd>}
        </div>
      ))}
    </dl>
  </div>
</Section>
