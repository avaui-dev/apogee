---
/**
 * Split image 02brand: A photo beside a heading and four figures, on the brand colour.
 *
 * @block metrics
 * @order 16
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Image from '../../components/Image/Image.astro'

---

<Section spacing="large" background="primary">
  <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
    <div class="flex flex-col gap-12 self-center">
      <SectionHeader eyebrow="Build better, launch faster" heading="Build great products, faster than ever" description="Everything you need to build modern interfaces and great products. We've done the heavy lifting, so you can start any project from a solid base." size="large" background="primary" />
      <dl class="grid gap-8 sm:grid-cols-2 sm:gap-y-12">
        <div class="flex flex-col gap-3">
            <dt class="order-2 text-lg font-semibold">Projects completed</dt>
            <dd class="order-1 text-5xl font-semibold tracking-tight tabular-nums md:text-6xl ">400+</dd>
          </div>
        <div class="flex flex-col gap-3">
            <dt class="order-2 text-lg font-semibold">Return on investment</dt>
            <dd class="order-1 text-5xl font-semibold tracking-tight tabular-nums md:text-6xl ">600%</dd>
          </div>
        <div class="flex flex-col gap-3">
            <dt class="order-2 text-lg font-semibold">Global downloads</dt>
            <dd class="order-1 text-5xl font-semibold tracking-tight tabular-nums md:text-6xl ">10k</dd>
          </div>
        <div class="flex flex-col gap-3">
            <dt class="order-2 text-lg font-semibold">Five-star reviews</dt>
            <dd class="order-1 text-5xl font-semibold tracking-tight tabular-nums md:text-6xl ">200+</dd>
          </div>
      </dl>
    </div>
    <Image src="https://picsum.photos/seed/apogee-metrics-6/1200/1100" alt="" width={1200} height={1100} fit="cover" radius="xl" class="h-70 w-full md:h-140 lg:order-first" />
  </div>
</Section>
