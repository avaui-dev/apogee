---
/**
 * Simple 04: A centred heading and actions over eight people in grey cards.
 *
 * @block team
 * @order 4
 */
import { AtSign, BriefcaseBusiness, Globe } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Heading from '../../components/Heading/Heading.astro'
import Image from '../../components/Image/Image.astro'
import Link from '../../components/Link/Link.astro'
import Button from '../../components/Button/Button.astro'

---

<Section spacing="large">
  <div class="flex flex-col gap-12 md:gap-16">
    <div class="flex flex-col gap-8 items-center">
      <SectionHeader eyebrow="We're hiring!" heading="Meet our team" description="We hire diverse, passionate people and build a culture that lets everyone do their best work." size="large" align="center" />
      <div class="flex flex-col gap-3 sm:flex-row-reverse sm:justify-center">
        <Button href="#" size="large">Open positions</Button>
        <Button href="#" size="large" variant="outline" color="neutral">About us</Button>
      </div>
    </div>
    <ul class="grid list-none p-0 gap-x-8 gap-y-6 sm:grid-cols-2 md:gap-y-8 lg:grid-cols-3 xl:grid-cols-4">
      <li><div class="flex h-full flex-col items-center gap-5 bg-neutral-faded p-6"><Image src="https://picsum.photos/id/1027/192/192" alt="" width={192} height={192} fit="cover" radius="full" outline class="size-24" /><div class="flex flex-col items-center text-center"><Heading as="h3" size="h6">Maya Okafor</Heading><p class="text-primary">Founder and CEO</p><p class="mt-2 text-neutral-faded">Started the company after ten years building tools for small teams.</p><ul class="flex list-none gap-4 p-0 mt-4 justify-center"><li><Link href="#" color="neutral" underline="none" aria-label="Maya's social profile" class="text-neutral-faded hover:text-neutral"><AtSign class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Maya's work history" class="text-neutral-faded hover:text-neutral"><BriefcaseBusiness class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Maya's website" class="text-neutral-faded hover:text-neutral"><Globe class="size-5" aria-hidden="true" /></Link></li></ul></div></div></li>
      <li><div class="flex h-full flex-col items-center gap-5 bg-neutral-faded p-6"><Image src="https://picsum.photos/id/856/192/192" alt="" width={192} height={192} fit="cover" radius="full" outline class="size-24" /><div class="flex flex-col items-center text-center"><Heading as="h3" size="h6">Tomas Lindqvist</Heading><p class="text-primary">Engineering Manager</p><p class="mt-2 text-neutral-faded">Keeps the team shipping and the pager quiet.</p><ul class="flex list-none gap-4 p-0 mt-4 justify-center"><li><Link href="#" color="neutral" underline="none" aria-label="Tomas's social profile" class="text-neutral-faded hover:text-neutral"><AtSign class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Tomas's work history" class="text-neutral-faded hover:text-neutral"><BriefcaseBusiness class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Tomas's website" class="text-neutral-faded hover:text-neutral"><Globe class="size-5" aria-hidden="true" /></Link></li></ul></div></div></li>
      <li><div class="flex h-full flex-col items-center gap-5 bg-neutral-faded p-6"><Image src="https://picsum.photos/id/832/192/192" alt="" width={192} height={192} fit="cover" radius="full" outline class="size-24" /><div class="flex flex-col items-center text-center"><Heading as="h3" size="h6">Priya Raman</Heading><p class="text-primary">Product Manager</p><p class="mt-2 text-neutral-faded">Turns customer calls into roadmaps people can read.</p><ul class="flex list-none gap-4 p-0 mt-4 justify-center"><li><Link href="#" color="neutral" underline="none" aria-label="Priya's social profile" class="text-neutral-faded hover:text-neutral"><AtSign class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Priya's work history" class="text-neutral-faded hover:text-neutral"><BriefcaseBusiness class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Priya's website" class="text-neutral-faded hover:text-neutral"><Globe class="size-5" aria-hidden="true" /></Link></li></ul></div></div></li>
      <li><div class="flex h-full flex-col items-center gap-5 bg-neutral-faded p-6"><Image src="https://picsum.photos/id/91/192/192" alt="" width={192} height={192} fit="cover" radius="full" outline class="size-24" /><div class="flex flex-col items-center text-center"><Heading as="h3" size="h6">Jonah Weiss</Heading><p class="text-primary">Frontend Developer</p><p class="mt-2 text-neutral-faded">Cares about fast pages and buttons that feel right.</p><ul class="flex list-none gap-4 p-0 mt-4 justify-center"><li><Link href="#" color="neutral" underline="none" aria-label="Jonah's social profile" class="text-neutral-faded hover:text-neutral"><AtSign class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Jonah's work history" class="text-neutral-faded hover:text-neutral"><BriefcaseBusiness class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Jonah's website" class="text-neutral-faded hover:text-neutral"><Globe class="size-5" aria-hidden="true" /></Link></li></ul></div></div></li>
      <li><div class="flex h-full flex-col items-center gap-5 bg-neutral-faded p-6"><Image src="https://picsum.photos/id/64/192/192" alt="" width={192} height={192} fit="cover" radius="full" outline class="size-24" /><div class="flex flex-col items-center text-center"><Heading as="h3" size="h6">Lucía Ortega</Heading><p class="text-primary">Backend Developer</p><p class="mt-2 text-neutral-faded">Builds the APIs and keeps the data honest.</p><ul class="flex list-none gap-4 p-0 mt-4 justify-center"><li><Link href="#" color="neutral" underline="none" aria-label="Lucía's social profile" class="text-neutral-faded hover:text-neutral"><AtSign class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Lucía's work history" class="text-neutral-faded hover:text-neutral"><BriefcaseBusiness class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Lucía's website" class="text-neutral-faded hover:text-neutral"><Globe class="size-5" aria-hidden="true" /></Link></li></ul></div></div></li>
      <li><div class="flex h-full flex-col items-center gap-5 bg-neutral-faded p-6"><Image src="https://picsum.photos/id/375/192/192" alt="" width={192} height={192} fit="cover" radius="full" outline class="size-24" /><div class="flex flex-col items-center text-center"><Heading as="h3" size="h6">Samir Haddad</Heading><p class="text-primary">Product Designer</p><p class="mt-2 text-neutral-faded">Sketches first, then sweats the last pixel.</p><ul class="flex list-none gap-4 p-0 mt-4 justify-center"><li><Link href="#" color="neutral" underline="none" aria-label="Samir's social profile" class="text-neutral-faded hover:text-neutral"><AtSign class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Samir's work history" class="text-neutral-faded hover:text-neutral"><BriefcaseBusiness class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Samir's website" class="text-neutral-faded hover:text-neutral"><Globe class="size-5" aria-hidden="true" /></Link></li></ul></div></div></li>
      <li><div class="flex h-full flex-col items-center gap-5 bg-neutral-faded p-6"><Image src="https://picsum.photos/id/823/192/192" alt="" width={192} height={192} fit="cover" radius="full" outline class="size-24" /><div class="flex flex-col items-center text-center"><Heading as="h3" size="h6">Hana Kobayashi</Heading><p class="text-primary">UX Researcher</p><p class="mt-2 text-neutral-faded">Talks to customers so the rest of us can listen.</p><ul class="flex list-none gap-4 p-0 mt-4 justify-center"><li><Link href="#" color="neutral" underline="none" aria-label="Hana's social profile" class="text-neutral-faded hover:text-neutral"><AtSign class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Hana's work history" class="text-neutral-faded hover:text-neutral"><BriefcaseBusiness class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Hana's website" class="text-neutral-faded hover:text-neutral"><Globe class="size-5" aria-hidden="true" /></Link></li></ul></div></div></li>
      <li><div class="flex h-full flex-col items-center gap-5 bg-neutral-faded p-6"><Image src="https://picsum.photos/id/836/192/192" alt="" width={192} height={192} fit="cover" radius="full" outline class="size-24" /><div class="flex flex-col items-center text-center"><Heading as="h3" size="h6">Eli Brennan</Heading><p class="text-primary">Customer Success</p><p class="mt-2 text-neutral-faded">Answers every question as if it were the first.</p><ul class="flex list-none gap-4 p-0 mt-4 justify-center"><li><Link href="#" color="neutral" underline="none" aria-label="Eli's social profile" class="text-neutral-faded hover:text-neutral"><AtSign class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Eli's work history" class="text-neutral-faded hover:text-neutral"><BriefcaseBusiness class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Eli's website" class="text-neutral-faded hover:text-neutral"><Globe class="size-5" aria-hidden="true" /></Link></li></ul></div></div></li>
    </ul>
  </div>
</Section>
