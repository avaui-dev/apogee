---
/**
 * Image collage 01: A centred heading and actions over a mosaic of eight people with details on glass panels.
 *
 * @block team
 * @order 9
 */
import { ArrowUpRight, AtSign, BriefcaseBusiness, Globe } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Heading from '../../components/Heading/Heading.astro'
import Image from '../../components/Image/Image.astro'
import Link from '../../components/Link/Link.astro'
import Button from '../../components/Button/Button.astro'

---

<Section spacing="large">
  <div class="flex flex-col gap-12 md:gap-16">
    <div class="flex flex-col gap-8 items-center">
      <SectionHeader eyebrow="Join our team" heading="We're just getting started" description="We hire diverse, passionate people and build a culture that lets everyone do their best work." size="large" align="center" />
      <div class="flex flex-col gap-3 sm:flex-row-reverse sm:justify-center">
        <Button href="#" size="large">We're hiring!</Button>
        <Button href="#" size="large" variant="outline" color="neutral">Read our principles</Button>
      </div>
    </div>
    <ul class="grid list-none p-0 auto-rows-[27rem] gap-6 sm:grid-cols-2 lg:auto-rows-[22.5rem] lg:grid-cols-3">
      <li class="relative isolate flex flex-col justify-end overflow-hidden rounded-2xl lg:col-span-2 lg:row-span-2">
        <div class="absolute inset-0 -z-10"><Image src="https://picsum.photos/id/1027/800/1000" alt="" width={800} height={1000} fit="cover" class="size-full" /></div>
        <div class="m-3 rounded-xl bg-page/80 px-4 pt-5 pb-6 ring-1 ring-inset ring-neutral backdrop-blur-md md:m-4 md:px-5">
          <div class="flex items-start justify-between gap-2"><Heading as="h3" size="h5">Maya Okafor</Heading><ArrowUpRight class="size-6 shrink-0" aria-hidden="true" /></div>
          <p class="font-semibold">Founder and CEO</p><p class="mt-2 text-sm text-neutral-faded md:text-base">Started the company after ten years building tools for small teams.</p><ul class="flex list-none gap-4 p-0 mt-4 gap-5"><li><Link href="#" color="neutral" underline="none" aria-label="Maya's social profile" class="text-neutral-faded hover:text-neutral"><AtSign class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Maya's work history" class="text-neutral-faded hover:text-neutral"><BriefcaseBusiness class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Maya's website" class="text-neutral-faded hover:text-neutral"><Globe class="size-5" aria-hidden="true" /></Link></li></ul>
        </div>
      </li>
      <li class="relative isolate flex flex-col justify-end overflow-hidden rounded-2xl ">
        <div class="absolute inset-0 -z-10"><Image src="https://picsum.photos/id/856/800/1000" alt="" width={800} height={1000} fit="cover" class="size-full" /></div>
        <div class="m-3 rounded-xl bg-page/80 px-4 pt-5 pb-6 ring-1 ring-inset ring-neutral backdrop-blur-md md:m-4 md:px-5">
          <div class="flex items-start justify-between gap-2"><Heading as="h3" size="h5">Tomas Lindqvist</Heading><ArrowUpRight class="size-6 shrink-0" aria-hidden="true" /></div>
          <p class="font-semibold">Engineering Manager</p><p class="mt-2 lg:hidden text-sm text-neutral-faded md:text-base">Keeps the team shipping and the pager quiet.</p><ul class="flex list-none gap-4 p-0 mt-4 gap-5 lg:hidden"><li><Link href="#" color="neutral" underline="none" aria-label="Tomas's social profile" class="text-neutral-faded hover:text-neutral"><AtSign class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Tomas's work history" class="text-neutral-faded hover:text-neutral"><BriefcaseBusiness class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Tomas's website" class="text-neutral-faded hover:text-neutral"><Globe class="size-5" aria-hidden="true" /></Link></li></ul>
        </div>
      </li>
      <li class="relative isolate flex flex-col justify-end overflow-hidden rounded-2xl ">
        <div class="absolute inset-0 -z-10"><Image src="https://picsum.photos/id/832/800/1000" alt="" width={800} height={1000} fit="cover" class="size-full" /></div>
        <div class="m-3 rounded-xl bg-page/80 px-4 pt-5 pb-6 ring-1 ring-inset ring-neutral backdrop-blur-md md:m-4 md:px-5">
          <div class="flex items-start justify-between gap-2"><Heading as="h3" size="h5">Priya Raman</Heading><ArrowUpRight class="size-6 shrink-0" aria-hidden="true" /></div>
          <p class="font-semibold">Product Manager</p><p class="mt-2 lg:hidden text-sm text-neutral-faded md:text-base">Turns customer calls into roadmaps people can read.</p><ul class="flex list-none gap-4 p-0 mt-4 gap-5 lg:hidden"><li><Link href="#" color="neutral" underline="none" aria-label="Priya's social profile" class="text-neutral-faded hover:text-neutral"><AtSign class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Priya's work history" class="text-neutral-faded hover:text-neutral"><BriefcaseBusiness class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Priya's website" class="text-neutral-faded hover:text-neutral"><Globe class="size-5" aria-hidden="true" /></Link></li></ul>
        </div>
      </li>
      <li class="relative isolate flex flex-col justify-end overflow-hidden rounded-2xl lg:row-span-2">
        <div class="absolute inset-0 -z-10"><Image src="https://picsum.photos/id/91/800/1000" alt="" width={800} height={1000} fit="cover" class="size-full" /></div>
        <div class="m-3 rounded-xl bg-page/80 px-4 pt-5 pb-6 ring-1 ring-inset ring-neutral backdrop-blur-md md:m-4 md:px-5">
          <div class="flex items-start justify-between gap-2"><Heading as="h3" size="h5">Jonah Weiss</Heading><ArrowUpRight class="size-6 shrink-0" aria-hidden="true" /></div>
          <p class="font-semibold">Frontend Developer</p><p class="mt-2 text-sm text-neutral-faded md:text-base">Cares about fast pages and buttons that feel right.</p><ul class="flex list-none gap-4 p-0 mt-4 gap-5"><li><Link href="#" color="neutral" underline="none" aria-label="Jonah's social profile" class="text-neutral-faded hover:text-neutral"><AtSign class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Jonah's work history" class="text-neutral-faded hover:text-neutral"><BriefcaseBusiness class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Jonah's website" class="text-neutral-faded hover:text-neutral"><Globe class="size-5" aria-hidden="true" /></Link></li></ul>
        </div>
      </li>
      <li class="relative isolate flex flex-col justify-end overflow-hidden rounded-2xl ">
        <div class="absolute inset-0 -z-10"><Image src="https://picsum.photos/id/64/800/1000" alt="" width={800} height={1000} fit="cover" class="size-full" /></div>
        <div class="m-3 rounded-xl bg-page/80 px-4 pt-5 pb-6 ring-1 ring-inset ring-neutral backdrop-blur-md md:m-4 md:px-5">
          <div class="flex items-start justify-between gap-2"><Heading as="h3" size="h5">Lucía Ortega</Heading><ArrowUpRight class="size-6 shrink-0" aria-hidden="true" /></div>
          <p class="font-semibold">Backend Developer</p><p class="mt-2 lg:hidden text-sm text-neutral-faded md:text-base">Builds the APIs and keeps the data honest.</p><ul class="flex list-none gap-4 p-0 mt-4 gap-5 lg:hidden"><li><Link href="#" color="neutral" underline="none" aria-label="Lucía's social profile" class="text-neutral-faded hover:text-neutral"><AtSign class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Lucía's work history" class="text-neutral-faded hover:text-neutral"><BriefcaseBusiness class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Lucía's website" class="text-neutral-faded hover:text-neutral"><Globe class="size-5" aria-hidden="true" /></Link></li></ul>
        </div>
      </li>
      <li class="relative isolate flex flex-col justify-end overflow-hidden rounded-2xl ">
        <div class="absolute inset-0 -z-10"><Image src="https://picsum.photos/id/375/800/1000" alt="" width={800} height={1000} fit="cover" class="size-full" /></div>
        <div class="m-3 rounded-xl bg-page/80 px-4 pt-5 pb-6 ring-1 ring-inset ring-neutral backdrop-blur-md md:m-4 md:px-5">
          <div class="flex items-start justify-between gap-2"><Heading as="h3" size="h5">Samir Haddad</Heading><ArrowUpRight class="size-6 shrink-0" aria-hidden="true" /></div>
          <p class="font-semibold">Product Designer</p><p class="mt-2 lg:hidden text-sm text-neutral-faded md:text-base">Sketches first, then sweats the last pixel.</p><ul class="flex list-none gap-4 p-0 mt-4 gap-5 lg:hidden"><li><Link href="#" color="neutral" underline="none" aria-label="Samir's social profile" class="text-neutral-faded hover:text-neutral"><AtSign class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Samir's work history" class="text-neutral-faded hover:text-neutral"><BriefcaseBusiness class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Samir's website" class="text-neutral-faded hover:text-neutral"><Globe class="size-5" aria-hidden="true" /></Link></li></ul>
        </div>
      </li>
      <li class="relative isolate flex flex-col justify-end overflow-hidden rounded-2xl lg:col-span-2 lg:row-span-2">
        <div class="absolute inset-0 -z-10"><Image src="https://picsum.photos/id/823/800/1000" alt="" width={800} height={1000} fit="cover" class="size-full" /></div>
        <div class="m-3 rounded-xl bg-page/80 px-4 pt-5 pb-6 ring-1 ring-inset ring-neutral backdrop-blur-md md:m-4 md:px-5">
          <div class="flex items-start justify-between gap-2"><Heading as="h3" size="h5">Hana Kobayashi</Heading><ArrowUpRight class="size-6 shrink-0" aria-hidden="true" /></div>
          <p class="font-semibold">UX Researcher</p><p class="mt-2 text-sm text-neutral-faded md:text-base">Talks to customers so the rest of us can listen.</p><ul class="flex list-none gap-4 p-0 mt-4 gap-5"><li><Link href="#" color="neutral" underline="none" aria-label="Hana's social profile" class="text-neutral-faded hover:text-neutral"><AtSign class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Hana's work history" class="text-neutral-faded hover:text-neutral"><BriefcaseBusiness class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Hana's website" class="text-neutral-faded hover:text-neutral"><Globe class="size-5" aria-hidden="true" /></Link></li></ul>
        </div>
      </li>
      <li class="relative isolate flex flex-col justify-end overflow-hidden rounded-2xl ">
        <div class="absolute inset-0 -z-10"><Image src="https://picsum.photos/id/836/800/1000" alt="" width={800} height={1000} fit="cover" class="size-full" /></div>
        <div class="m-3 rounded-xl bg-page/80 px-4 pt-5 pb-6 ring-1 ring-inset ring-neutral backdrop-blur-md md:m-4 md:px-5">
          <div class="flex items-start justify-between gap-2"><Heading as="h3" size="h5">Eli Brennan</Heading><ArrowUpRight class="size-6 shrink-0" aria-hidden="true" /></div>
          <p class="font-semibold">Customer Success</p><p class="mt-2 lg:hidden text-sm text-neutral-faded md:text-base">Answers every question as if it were the first.</p><ul class="flex list-none gap-4 p-0 mt-4 gap-5 lg:hidden"><li><Link href="#" color="neutral" underline="none" aria-label="Eli's social profile" class="text-neutral-faded hover:text-neutral"><AtSign class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Eli's work history" class="text-neutral-faded hover:text-neutral"><BriefcaseBusiness class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Eli's website" class="text-neutral-faded hover:text-neutral"><Globe class="size-5" aria-hidden="true" /></Link></li></ul>
        </div>
      </li>
    </ul>
  </div>
</Section>
