---
/**
 * Image glass 03: A heading and actions beside four portraits with details on glass panels.
 *
 * @block team
 * @order 13
 */
import { ArrowUpRight, AtSign, BriefcaseBusiness, Globe } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Heading from '../../components/Heading/Heading.astro'
import Image from '../../components/Image/Image.astro'
import Link from '../../components/Link/Link.astro'
import Button from '../../components/Button/Button.astro'

---

<Section spacing="large">
  <div class="grid gap-12 lg:grid-cols-[22.5rem_1fr] lg:gap-16">
    <div class="flex flex-col gap-8">
      <SectionHeader eyebrow="Our team" heading="Leadership team" description="We're a cross-disciplinary team that loves to create great experiences for our customers." size="large" />
      <div class="flex flex-col gap-3 sm:flex-row-reverse sm:justify-end">
        <Button href="#" size="large">Open positions</Button>
        <Button href="#" size="large" variant="outline" color="neutral">About us</Button>
      </div>
    </div>
    <ul class="grid list-none p-0 gap-x-8 gap-y-6 sm:grid-cols-2 md:gap-y-8">
      <li><div class="relative isolate flex flex-col justify-end overflow-hidden rounded-2xl aspect-[4/5] md:aspect-[3/4]">
        <div class="absolute inset-0 -z-10"><Image src="https://picsum.photos/id/1027/800/1000" alt="" width={800} height={1000} fit="cover" class="size-full" /></div>
        <div class="m-3 rounded-xl bg-page/80 px-4 pt-5 pb-6 ring-1 ring-inset ring-neutral backdrop-blur-md md:m-4 md:px-5">
          <div class="flex items-start justify-between gap-2"><Heading as="h3" size="h5">Maya Okafor</Heading><ArrowUpRight class="size-6 shrink-0" aria-hidden="true" /></div>
          <p class="font-semibold">Founder and CEO</p><p class="mt-2 text-sm text-neutral-faded md:text-base">Started the company after ten years building tools for small teams.</p><ul class="flex list-none gap-4 p-0 mt-4 gap-5"><li><Link href="#" color="neutral" underline="none" aria-label="Maya's social profile" class="text-neutral-faded hover:text-neutral"><AtSign class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Maya's work history" class="text-neutral-faded hover:text-neutral"><BriefcaseBusiness class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Maya's website" class="text-neutral-faded hover:text-neutral"><Globe class="size-5" aria-hidden="true" /></Link></li></ul>
        </div>
      </div></li>
      <li><div class="relative isolate flex flex-col justify-end overflow-hidden rounded-2xl aspect-[4/5] md:aspect-[3/4]">
        <div class="absolute inset-0 -z-10"><Image src="https://picsum.photos/id/856/800/1000" alt="" width={800} height={1000} fit="cover" class="size-full" /></div>
        <div class="m-3 rounded-xl bg-page/80 px-4 pt-5 pb-6 ring-1 ring-inset ring-neutral backdrop-blur-md md:m-4 md:px-5">
          <div class="flex items-start justify-between gap-2"><Heading as="h3" size="h5">Tomas Lindqvist</Heading><ArrowUpRight class="size-6 shrink-0" aria-hidden="true" /></div>
          <p class="font-semibold">Engineering Manager</p><p class="mt-2 text-sm text-neutral-faded md:text-base">Keeps the team shipping and the pager quiet.</p><ul class="flex list-none gap-4 p-0 mt-4 gap-5"><li><Link href="#" color="neutral" underline="none" aria-label="Tomas's social profile" class="text-neutral-faded hover:text-neutral"><AtSign class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Tomas's work history" class="text-neutral-faded hover:text-neutral"><BriefcaseBusiness class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Tomas's website" class="text-neutral-faded hover:text-neutral"><Globe class="size-5" aria-hidden="true" /></Link></li></ul>
        </div>
      </div></li>
      <li><div class="relative isolate flex flex-col justify-end overflow-hidden rounded-2xl aspect-[4/5] md:aspect-[3/4]">
        <div class="absolute inset-0 -z-10"><Image src="https://picsum.photos/id/832/800/1000" alt="" width={800} height={1000} fit="cover" class="size-full" /></div>
        <div class="m-3 rounded-xl bg-page/80 px-4 pt-5 pb-6 ring-1 ring-inset ring-neutral backdrop-blur-md md:m-4 md:px-5">
          <div class="flex items-start justify-between gap-2"><Heading as="h3" size="h5">Priya Raman</Heading><ArrowUpRight class="size-6 shrink-0" aria-hidden="true" /></div>
          <p class="font-semibold">Product Manager</p><p class="mt-2 text-sm text-neutral-faded md:text-base">Turns customer calls into roadmaps people can read.</p><ul class="flex list-none gap-4 p-0 mt-4 gap-5"><li><Link href="#" color="neutral" underline="none" aria-label="Priya's social profile" class="text-neutral-faded hover:text-neutral"><AtSign class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Priya's work history" class="text-neutral-faded hover:text-neutral"><BriefcaseBusiness class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Priya's website" class="text-neutral-faded hover:text-neutral"><Globe class="size-5" aria-hidden="true" /></Link></li></ul>
        </div>
      </div></li>
      <li><div class="relative isolate flex flex-col justify-end overflow-hidden rounded-2xl aspect-[4/5] md:aspect-[3/4]">
        <div class="absolute inset-0 -z-10"><Image src="https://picsum.photos/id/91/800/1000" alt="" width={800} height={1000} fit="cover" class="size-full" /></div>
        <div class="m-3 rounded-xl bg-page/80 px-4 pt-5 pb-6 ring-1 ring-inset ring-neutral backdrop-blur-md md:m-4 md:px-5">
          <div class="flex items-start justify-between gap-2"><Heading as="h3" size="h5">Jonah Weiss</Heading><ArrowUpRight class="size-6 shrink-0" aria-hidden="true" /></div>
          <p class="font-semibold">Frontend Developer</p><p class="mt-2 text-sm text-neutral-faded md:text-base">Cares about fast pages and buttons that feel right.</p><ul class="flex list-none gap-4 p-0 mt-4 gap-5"><li><Link href="#" color="neutral" underline="none" aria-label="Jonah's social profile" class="text-neutral-faded hover:text-neutral"><AtSign class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Jonah's work history" class="text-neutral-faded hover:text-neutral"><BriefcaseBusiness class="size-5" aria-hidden="true" /></Link></li><li><Link href="#" color="neutral" underline="none" aria-label="Jonah's website" class="text-neutral-faded hover:text-neutral"><Globe class="size-5" aria-hidden="true" /></Link></li></ul>
        </div>
      </div></li>
    </ul>
  </div>
</Section>
