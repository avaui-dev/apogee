---
/**
 * Image card 02: A heading with actions beside it, over eight people with square photos.
 *
 * @block team
 * @order 6
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Heading from '../../components/Heading/Heading.astro'
import Image from '../../components/Image/Image.astro'
import Button from '../../components/Button/Button.astro'

---

<Section spacing="large">
  <div class="flex flex-col gap-12 md:gap-16">
    <SectionHeader eyebrow="Our team" heading="Some of the people you'll work with" description="We're a fully remote team spread across the world. Join us!" size="large">
      <Fragment slot="actions"><div class="flex flex-col gap-3 sm:flex-row-reverse sm:justify-end">
        <Button href="#" size="large">Open positions</Button>
        <Button href="#" size="large" variant="outline" color="neutral">About us</Button>
      </div></Fragment>
    </SectionHeader>
    <ul class="grid list-none p-0 gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      <li><div class="flex flex-col gap-5"><Image src="https://picsum.photos/id/1027/600/600" alt="" width={600} height={600} fit="cover" class="aspect-square w-full" /><div class="flex flex-col"><Heading as="h3" size="h6">Maya Okafor</Heading><p class="text-primary">Founder and CEO</p></div></div></li>
      <li><div class="flex flex-col gap-5"><Image src="https://picsum.photos/id/856/600/600" alt="" width={600} height={600} fit="cover" class="aspect-square w-full" /><div class="flex flex-col"><Heading as="h3" size="h6">Tomas Lindqvist</Heading><p class="text-primary">Engineering Manager</p></div></div></li>
      <li><div class="flex flex-col gap-5"><Image src="https://picsum.photos/id/832/600/600" alt="" width={600} height={600} fit="cover" class="aspect-square w-full" /><div class="flex flex-col"><Heading as="h3" size="h6">Priya Raman</Heading><p class="text-primary">Product Manager</p></div></div></li>
      <li><div class="flex flex-col gap-5"><Image src="https://picsum.photos/id/91/600/600" alt="" width={600} height={600} fit="cover" class="aspect-square w-full" /><div class="flex flex-col"><Heading as="h3" size="h6">Jonah Weiss</Heading><p class="text-primary">Frontend Developer</p></div></div></li>
      <li><div class="flex flex-col gap-5"><Image src="https://picsum.photos/id/64/600/600" alt="" width={600} height={600} fit="cover" class="aspect-square w-full" /><div class="flex flex-col"><Heading as="h3" size="h6">Lucía Ortega</Heading><p class="text-primary">Backend Developer</p></div></div></li>
      <li><div class="flex flex-col gap-5"><Image src="https://picsum.photos/id/375/600/600" alt="" width={600} height={600} fit="cover" class="aspect-square w-full" /><div class="flex flex-col"><Heading as="h3" size="h6">Samir Haddad</Heading><p class="text-primary">Product Designer</p></div></div></li>
      <li><div class="flex flex-col gap-5"><Image src="https://picsum.photos/id/823/600/600" alt="" width={600} height={600} fit="cover" class="aspect-square w-full" /><div class="flex flex-col"><Heading as="h3" size="h6">Hana Kobayashi</Heading><p class="text-primary">UX Researcher</p></div></div></li>
      <li><div class="flex flex-col gap-5"><Image src="https://picsum.photos/id/836/600/600" alt="" width={600} height={600} fit="cover" class="aspect-square w-full" /><div class="flex flex-col"><Heading as="h3" size="h6">Eli Brennan</Heading><p class="text-primary">Customer Success</p></div></div></li>
    </ul>
  </div>
</Section>
