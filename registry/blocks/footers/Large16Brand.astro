---
/**
 * Large 16 brand: A centred logo and row of links, then an email signup beside the copyright, on the brand colour.
 *
 * @block footers
 * @order 36
 */
import { Orbit } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import FeaturedIcon from '../../components/FeaturedIcon/FeaturedIcon.astro'
import Button from '../../components/Button/Button.astro'
import Link from '../../components/Link/Link.astro'
import Input from '../../components/Input/Input.astro'

---

<Section as="footer" spacing="medium" background="primary">
  <div class="flex flex-col items-center gap-8">
    <Link href="/" color="inherit" underline="none" class="inline-flex items-center gap-2 text-lg font-semibold "><FeaturedIcon theme="solid" color="neutral" size="small"><Orbit /></FeaturedIcon>Example</Link>
    <nav aria-label="Footer" class=""><ul class="grid list-none grid-cols-2 gap-x-8 gap-y-3 p-0 sm:flex sm:flex-wrap"><li><Link href="#" color="inherit" underline="hover" class="font-semibold">Overview</Link></li><li><Link href="#" color="inherit" underline="hover" class="font-semibold">Features</Link></li><li><Link href="#" color="inherit" underline="hover" class="font-semibold">Pricing</Link></li><li><Link href="#" color="inherit" underline="hover" class="font-semibold">Careers</Link></li><li><Link href="#" color="inherit" underline="hover" class="font-semibold">Help</Link></li><li><Link href="#" color="inherit" underline="hover" class="font-semibold">Privacy</Link></li></ul></nav>
  </div>
  <div class="mt-12 md:mt-16 flex flex-col-reverse gap-6 border-t border-current/25 pt-8 md:flex-row md:items-center md:justify-between">
    <p class="opacity-85 ">© 2026 Example. All rights reserved.</p>
    <div class="flex flex-col gap-4 ">
      <form method="post" class="flex flex-col gap-3 sm:flex-row">
        <Input type="email" name="email" placeholder="Enter your email" aria-label="Email" autocomplete="email" required class="sm:w-64" />
        <Button type="submit" color="neutral">Subscribe</Button>
      </form>
    </div>
  </div>
</Section>
