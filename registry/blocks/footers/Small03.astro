---
/**
 * Small 03: Social links, the logo in the middle and the copyright.
 *
 * @block footers
 * @order 19
 */
import { Orbit } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import FeaturedIcon from '../../components/FeaturedIcon/FeaturedIcon.astro'
import Link from '../../components/Link/Link.astro'
import { socialIcons, type FooterContent } from '../../sections/_shared/footers.ts'

/** @composable */
interface Props extends FooterContent {}

const {
  brand = 'Example',
  copyright = '© 2026 Example. All rights reserved.',
  social = [
    { label: 'Email', href: '#', icon: 'mail' },
    { label: 'Blog feed', href: '#', icon: 'rss' },
    { label: 'Community', href: '#', icon: 'message' },
    { label: 'Website', href: '#', icon: 'globe' },
    { label: 'Contact', href: '#', icon: 'at-sign' },
  ],
} = Astro.props
---

<Section as="footer" spacing="small">
  <div class="grid items-center justify-items-center gap-6 lg:grid-cols-3">
    <div class="lg:order-2"><Link href="/" color="inherit" underline="none" class="inline-flex items-center gap-2 text-lg font-semibold "><FeaturedIcon theme="solid" color="primary" size="small"><Orbit /></FeaturedIcon>{brand}</Link></div>
    <div class="lg:order-1 lg:justify-self-start">{social && <ul class="flex list-none flex-wrap gap-6 p-0 text-neutral-faded">{social.map((s) => { const Icon = socialIcons[s.icon]; return <li><Link href={s.href} color="inherit" underline="none" aria-label={s.label} class="flex"><Icon class="size-6" aria-hidden="true" /></Link></li> })}</ul>}</div>
    {copyright && <p class="text-neutral-faded lg:order-3 lg:justify-self-end">{copyright}</p>}
  </div>
</Section>
