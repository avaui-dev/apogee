---
/**
 * Large 08: The logo and a row of links beside an email signup, then copyright and legal links.
 *
 * @block footers
 * @order 8
 */
import { Orbit } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import FeaturedIcon from '../../components/FeaturedIcon/FeaturedIcon.astro'
import Button from '../../components/Button/Button.astro'
import Link from '../../components/Link/Link.astro'
import Input from '../../components/Input/Input.astro'

---

<Section as="footer" spacing="medium">
  <div class="flex flex-col gap-12 md:flex-row md:justify-between">
    <div class="flex flex-col gap-6">
      <Link href="/" color="inherit" underline="none" class="inline-flex items-center gap-2 text-lg font-semibold "><FeaturedIcon theme="solid" color="primary" size="small"><Orbit /></FeaturedIcon>Example</Link>
      <nav aria-label="Footer" class="mt-2"><ul class="grid list-none grid-cols-2 gap-x-8 gap-y-3 p-0 sm:flex sm:flex-wrap"><li><Link href="#" color="neutral" underline="hover" class="font-semibold">Overview</Link></li><li><Link href="#" color="neutral" underline="hover" class="font-semibold">Features</Link></li><li><Link href="#" color="neutral" underline="hover" class="font-semibold">Pricing</Link></li><li><Link href="#" color="neutral" underline="hover" class="font-semibold">Careers</Link></li><li><Link href="#" color="neutral" underline="hover" class="font-semibold">Help</Link></li><li><Link href="#" color="neutral" underline="hover" class="font-semibold">Privacy</Link></li></ul></nav>
    </div>
    <div class="flex flex-col gap-4 ">
      <p class="text-sm font-semibold">Stay up to date</p>
      <form method="post" class="flex flex-col gap-3 sm:flex-row">
        <Input type="email" name="email" placeholder="Enter your email" aria-label="Email" autocomplete="email" required class="sm:w-64" />
        <Button type="submit">Subscribe</Button>
      </form>
    </div>
  </div>
  <div class="mt-12 md:mt-16 flex flex-col-reverse gap-6 border-t border-neutral pt-8 md:flex-row md:items-center md:justify-between">
    <p class="text-neutral-faded ">© 2026 Example. All rights reserved.</p>
    <nav aria-label="Legal"><ul class="flex list-none flex-wrap gap-x-6 gap-y-2 p-0 text-neutral-faded"><li><Link href="#" color="inherit" underline="hover">Terms</Link></li><li><Link href="#" color="inherit" underline="hover">Privacy</Link></li><li><Link href="#" color="inherit" underline="hover">Cookies</Link></li></ul></nav>
  </div>
</Section>
