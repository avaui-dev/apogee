---
/**
 * Large 02 brand: The logo, a line and a rating beside five columns, over a tinted band with copyright and social links, on the brand colour.
 *
 * @block footers
 * @order 22
 */
import { Orbit } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import FeaturedIcon from '../../components/FeaturedIcon/FeaturedIcon.astro'
import Link from '../../components/Link/Link.astro'
import Badge from '../../components/Badge/Badge.astro'
import Rating from '../../components/Rating/Rating.astro'
import { plain } from '../../sections/_shared/spine.ts'
import { socialIcons, type FooterContent } from '../../sections/_shared/footers.ts'

/** @composable */
interface Props extends FooterContent {
  /** The line beside the stars. @category content */
  reviews?: string | null
}

const {
  brand = 'Example',
  tagline = 'Design calm, accessible websites your whole team can edit.',
  columns = [
    { heading: 'Product', links: [{ label: 'Overview', href: '#' }, { label: 'Features', href: '#' }, { label: 'Solutions', href: '#', badge: 'New' }, { label: 'Tutorials', href: '#' }, { label: 'Pricing', href: '#' }, { label: 'Releases', href: '#' }] },
    { heading: 'Company', links: [{ label: 'About us', href: '#' }, { label: 'Careers', href: '#' }, { label: 'Press', href: '#' }, { label: 'News', href: '#' }, { label: 'Media kit', href: '#' }, { label: 'Contact', href: '#' }] },
    { heading: 'Resources', links: [{ label: 'Blog', href: '#' }, { label: 'Newsletter', href: '#' }, { label: 'Events', href: '#' }, { label: 'Help centre', href: '#' }, { label: 'Tutorials', href: '#' }, { label: 'Support', href: '#' }] },
    { heading: 'Community', links: [{ label: 'Forum', href: '#' }, { label: 'Meetups', href: '#' }, { label: 'Changelog', href: '#' }, { label: 'Status', href: '#' }, { label: 'Partners', href: '#' }, { label: 'Developers', href: '#' }] },
    { heading: 'Legal', links: [{ label: 'Terms', href: '#' }, { label: 'Privacy', href: '#' }, { label: 'Cookies', href: '#' }, { label: 'Licences', href: '#' }, { label: 'Settings', href: '#' }, { label: 'Contact', href: '#' }] },
  ],
  copyright = '© 2026 Example. All rights reserved.',
  social = [
    { label: 'Email', href: '#', icon: 'mail' },
    { label: 'Blog feed', href: '#', icon: 'rss' },
    { label: 'Community', href: '#', icon: 'message' },
    { label: 'Website', href: '#', icon: 'globe' },
    { label: 'Contact', href: '#', icon: 'at-sign' },
  ],
  reviews = '5.0 from 2,000+ reviews',
} = Astro.props
---

<footer>
  <Section as="div" spacing="medium" background="primary">
    <div class="grid gap-12 lg:gap-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
    <div class="flex flex-col gap-6">
      <Link href="/" color="inherit" underline="none" class="inline-flex items-center gap-2 text-lg font-semibold "><FeaturedIcon theme="solid" color="neutral" size="small"><Orbit /></FeaturedIcon>{brand}</Link>
      {tagline && <p class="max-w-xs opacity-85">{plain(tagline)}</p>}
      <div class="flex items-center gap-3">
        <Rating value={5} readonly size="small" color="warning" aria-label="Rated 5 out of 5" />
        {reviews && <span class="text-sm opacity-85">{reviews}</span>}
      </div>
    </div>
    <div class="grid grid-cols-2 gap-8 md:grid-cols-5">
      {columns.map((c) => (
        <nav aria-label={c.heading}>
          <p class="text-sm font-semibold opacity-85">{c.heading}</p>
          <ul class="mt-4 flex list-none flex-col gap-3 p-0">
            {c.links.map((l) => (
              <li class="flex items-center gap-2">
                <Link href={l.href} color="inherit" underline="hover" class="font-semibold">{l.label}</Link>
                {l.badge && <Badge size="small" variant="outline" color="neutral" class="border-current! bg-transparent! text-inherit!">{l.badge}</Badge>}
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
  </div>
  </Section>
  <Section as="div" spacing="small" background="primary" class="border-t border-current/25">
    <div class="flex flex-col-reverse gap-6 md:flex-row md:items-center md:justify-between">
      {copyright && <p class="opacity-85 ">{copyright}</p>}
      {social && <ul class="flex list-none flex-wrap gap-6 p-0 opacity-85">{social.map((s) => { const Icon = socialIcons[s.icon]; return <li><Link href={s.href} color="inherit" underline="none" aria-label={s.label} class="flex"><Icon class="size-6" aria-hidden="true" /></Link></li> })}</ul>}
    </div>
  </Section>
</footer>
