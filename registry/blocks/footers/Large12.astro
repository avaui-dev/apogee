---
/**
 * Large 12: A launch signup on a tinted band, then the logo and a join link beside five columns, copyright and social links.
 *
 * @block footers
 * @order 12
 */
import { ChevronRight, Orbit } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import Heading from '../../components/Heading/Heading.astro'
import FeaturedIcon from '../../components/FeaturedIcon/FeaturedIcon.astro'
import Button from '../../components/Button/Button.astro'
import Link from '../../components/Link/Link.astro'
import Input from '../../components/Input/Input.astro'
import Badge from '../../components/Badge/Badge.astro'
import AvatarGroup from '../../components/AvatarGroup/AvatarGroup.astro'
import { plain, type Action } from '../../sections/_shared/spine.ts'
import { socialIcons, type FooterContent } from '../../sections/_shared/footers.ts'

/** @composable */
interface Props extends FooterContent {
  /** The pill link with avatars. @category content */
  joinLink?: Action | null
}

const {
  brand = 'Example',
  tagline = 'Design calm, accessible websites your whole team can edit.',
  newsletterHeading = 'Get notified when we launch',
  newsletterDescription = 'The latest news, announcements and articles, in your inbox.',
  submitLabel = 'Subscribe',
  columns = [
    { heading: 'Product', links: [{ label: 'Overview', href: '#' }, { label: 'Features', href: '#' }, { label: 'Solutions', href: '#', badge: 'New' }, { label: 'Tutorials', href: '#' }, { label: 'Pricing', href: '#' }, { label: 'Releases', href: '#' }] },
    { heading: 'Company', links: [{ label: 'About us', href: '#' }, { label: 'Careers', href: '#' }, { label: 'Press', href: '#' }, { label: 'News', href: '#' }, { label: 'Media kit', href: '#' }, { label: 'Contact', href: '#' }] },
    { heading: 'Resources', links: [{ label: 'Blog', href: '#' }, { label: 'Newsletter', href: '#' }, { label: 'Events', href: '#' }, { label: 'Help centre', href: '#' }, { label: 'Tutorials', href: '#' }, { label: 'Support', href: '#' }] },
    { heading: 'Community', links: [{ label: 'Forum', href: '#' }, { label: 'Meetups', href: '#' }, { label: 'Changelog', href: '#' }, { label: 'Status', href: '#' }, { label: 'Partners', href: '#' }, { label: 'Developers', href: '#' }] },
    { heading: 'Legal', links: [{ label: 'Terms', href: '#' }, { label: 'Privacy', href: '#' }, { label: 'Cookies', href: '#' }, { label: 'Licences', href: '#' }, { label: 'Settings', href: '#' }, { label: 'Contact', href: '#' }] },
  ],
  copyright = '© 2026 Example. All rights reserved.',
  social = [
    { label: 'Email', href: '#', icon: 'mail' },
    { label: 'Blog feed', href: '#', icon: 'rss' },
    { label: 'Community', href: '#', icon: 'message' },
    { label: 'Website', href: '#', icon: 'globe' },
    { label: 'Contact', href: '#', icon: 'at-sign' },
  ],
  joinLink = { label: 'Join 2,000+ companies', href: '#' },
} = Astro.props
---

<footer>
  <Section as="div" spacing="medium" background="neutral-faded">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="flex flex-col gap-3 items-start">
      {newsletterHeading && <Heading as="h2" size="h2">{newsletterHeading}</Heading>}
      {newsletterDescription && <p class="text-lg text-neutral-faded">{newsletterDescription}</p>}
    </div>
      <div class="flex flex-col gap-4 ">
      <form method="post" class="flex flex-col gap-3 sm:flex-row">
        <Input type="email" name="email" placeholder="Enter your email" aria-label="Email" autocomplete="email" required class="sm:w-64" />
        <Button type="submit">{submitLabel}</Button>
      </form>
    </div>
    </div>
  </Section>
  <Section as="div" spacing="small">
    <div class="grid gap-12 lg:gap-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
    <div class="flex flex-col gap-6">
      <Link href="/" color="inherit" underline="none" class="inline-flex items-center gap-2 text-lg font-semibold "><FeaturedIcon theme="solid" color="primary" size="small"><Orbit /></FeaturedIcon>{brand}</Link>
      {tagline && <p class="max-w-xs text-neutral-faded">{plain(tagline)}</p>}
      {joinLink && <Link href={joinLink.href} color="inherit" underline="none" class="inline-flex items-center gap-3 self-start rounded-full py-1 ps-1 pe-3 text-sm font-semibold ring-1 ring-neutral">
        <span aria-hidden="true"><AvatarGroup items={[{ name: 'Ada Lovelace' }, { name: 'Alan Turing' }, { name: 'Grace Hopper' }, { name: 'Katherine Johnson' }]} size="small" /></span>
        {joinLink.label}
        <ChevronRight class="size-4 rtl:-scale-x-100" aria-hidden="true" />
      </Link>}
    </div>
    <div class="grid grid-cols-2 gap-8 md:grid-cols-5">
      {columns.map((c) => (
        <nav aria-label={c.heading}>
          <p class="text-sm font-semibold text-neutral-faded">{c.heading}</p>
          <ul class="mt-4 flex list-none flex-col gap-3 p-0">
            {c.links.map((l) => (
              <li class="flex items-center gap-2">
                <Link href={l.href} color="neutral" underline="hover" class="font-semibold">{l.label}</Link>
                {l.badge && <Badge size="small" variant="faded" color="primary">{l.badge}</Badge>}
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
  </div>
    <div class="mt-12 md:mt-16 flex flex-col-reverse gap-6 border-t border-neutral pt-8 md:flex-row md:items-center md:justify-between">
    {copyright && <p class="text-neutral-faded ">{copyright}</p>}
    {social && <ul class="flex list-none flex-wrap gap-6 p-0 text-neutral-faded">{social.map((s) => { const Icon = socialIcons[s.icon]; return <li><Link href={s.href} color="inherit" underline="none" aria-label={s.label} class="flex"><Icon class="size-6" aria-hidden="true" /></Link></li> })}</ul>}
  </div>
  </Section>
</footer>
