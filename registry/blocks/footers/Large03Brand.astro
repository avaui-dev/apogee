---
/**
 * Large 03 brand: Five link columns and app buttons, then the logo and copyright, on the brand colour.
 *
 * @block footers
 * @order 23
 */
import { Download, Orbit, Smartphone } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import FeaturedIcon from '../../components/FeaturedIcon/FeaturedIcon.astro'
import Button from '../../components/Button/Button.astro'
import Link from '../../components/Link/Link.astro'
import Badge from '../../components/Badge/Badge.astro'
import { type Action } from '../../sections/_shared/spine.ts'
import { type FooterContent } from '../../sections/_shared/footers.ts'

/** @composable */
interface Props extends FooterContent {
  /** The label over the app buttons. @category content */
  appsLabel?: string | null
  /** App store buttons; icons cycle phone, download. @category content */
  apps?: Action[] | null
}

const appIcons = [Smartphone, Download]

const {
  brand = 'Example',
  columns = [
    { heading: 'Product', links: [{ label: 'Overview', href: '#' }, { label: 'Features', href: '#' }, { label: 'Solutions', href: '#', badge: 'New' }, { label: 'Tutorials', href: '#' }, { label: 'Pricing', href: '#' }, { label: 'Releases', href: '#' }] },
    { heading: 'Company', links: [{ label: 'About us', href: '#' }, { label: 'Careers', href: '#' }, { label: 'Press', href: '#' }, { label: 'News', href: '#' }, { label: 'Media kit', href: '#' }, { label: 'Contact', href: '#' }] },
    { heading: 'Resources', links: [{ label: 'Blog', href: '#' }, { label: 'Newsletter', href: '#' }, { label: 'Events', href: '#' }, { label: 'Help centre', href: '#' }, { label: 'Tutorials', href: '#' }, { label: 'Support', href: '#' }] },
    { heading: 'Community', links: [{ label: 'Forum', href: '#' }, { label: 'Meetups', href: '#' }, { label: 'Changelog', href: '#' }, { label: 'Status', href: '#' }, { label: 'Partners', href: '#' }, { label: 'Developers', href: '#' }] },
    { heading: 'Legal', links: [{ label: 'Terms', href: '#' }, { label: 'Privacy', href: '#' }, { label: 'Cookies', href: '#' }, { label: 'Licences', href: '#' }, { label: 'Settings', href: '#' }, { label: 'Contact', href: '#' }] },
  ],
  copyright = '© 2026 Example. All rights reserved.',
  appsLabel = 'Get the app',
  apps = [{ label: 'Download for iOS', href: '#' }, { label: 'Get it on Android', href: '#' }],
} = Astro.props
---

<Section as="footer" spacing="medium" background="primary">
  <div class="grid grid-cols-2 gap-8 md:grid-cols-3 lg:grid-cols-6">
    <div class="grid grid-cols-2 gap-8 col-span-2 md:col-span-3 lg:col-span-5 lg:grid-cols-5">
      {columns.map((c) => (
        <nav aria-label={c.heading}>
          <p class="text-sm font-semibold opacity-85">{c.heading}</p>
          <ul class="mt-4 flex list-none flex-col gap-3 p-0">
            {c.links.map((l) => (
              <li class="flex items-center gap-2">
                <Link href={l.href} color="inherit" underline="hover" class="font-semibold">{l.label}</Link>
                {l.badge && <Badge size="small" variant="outline" color="neutral" class="border-current! bg-transparent! text-inherit!">{l.badge}</Badge>}
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <div class="col-span-2 md:col-span-1"><div class="flex flex-col gap-4">
      {appsLabel && <p class="text-sm font-semibold opacity-85">{appsLabel}</p>}
      {apps && <div class="flex flex-col gap-3">{apps.map((a, i) => { const Icon = appIcons[i % appIcons.length]!; return <Button href={a.href} variant="outline" color="neutral" class="border-current! bg-transparent! text-inherit! shadow-none!"><Icon slot="start" aria-hidden="true" />{a.label}</Button> })}</div>}
    </div></div>
  </div>
  <div class="mt-12 md:mt-16 flex flex-col gap-6 border-t border-current/25 pt-8 md:flex-row md:items-center md:justify-between">
    <Link href="/" color="inherit" underline="none" class="inline-flex items-center gap-2 text-lg font-semibold "><FeaturedIcon theme="solid" color="neutral" size="small"><Orbit /></FeaturedIcon>{brand}</Link>
    {copyright && <p class="opacity-85 ">{copyright}</p>}
  </div>
</Section>
