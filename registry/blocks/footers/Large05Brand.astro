---
/**
 * Large 05 brand: A newsletter signup with a join link, six link columns, then the logo and copyright, on the brand colour.
 *
 * @block footers
 * @order 25
 */
import { ChevronRight, Orbit } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import Heading from '../../components/Heading/Heading.astro'
import FeaturedIcon from '../../components/FeaturedIcon/FeaturedIcon.astro'
import Button from '../../components/Button/Button.astro'
import Link from '../../components/Link/Link.astro'
import Input from '../../components/Input/Input.astro'
import Badge from '../../components/Badge/Badge.astro'
import AvatarGroup from '../../components/AvatarGroup/AvatarGroup.astro'

const columns = [
  { heading: 'Product', links: [{ label: 'Overview' }, { label: 'Features' }, { label: 'Solutions', badge: 'New' }, { label: 'Tutorials' }, { label: 'Pricing' }, { label: 'Releases' }] },
  { heading: 'Company', links: [{ label: 'About us' }, { label: 'Careers' }, { label: 'Press' }, { label: 'News' }, { label: 'Media kit' }, { label: 'Contact' }] },
  { heading: 'Resources', links: [{ label: 'Blog' }, { label: 'Newsletter' }, { label: 'Events' }, { label: 'Help centre' }, { label: 'Tutorials' }, { label: 'Support' }] },
  { heading: 'Use cases', links: [{ label: 'Startups' }, { label: 'Enterprise' }, { label: 'Government' }, { label: 'SaaS centre' }, { label: 'Marketplaces' }, { label: 'Ecommerce' }] },
  { heading: 'Community', links: [{ label: 'Forum' }, { label: 'Meetups' }, { label: 'Changelog' }, { label: 'Status' }, { label: 'Partners' }, { label: 'Developers' }] },
  { heading: 'Legal', links: [{ label: 'Terms' }, { label: 'Privacy' }, { label: 'Cookies' }, { label: 'Licences' }, { label: 'Settings' }, { label: 'Contact' }] },
]
---

<Section as="footer" spacing="medium" background="primary">
  <div class="flex flex-col gap-8 border-b border-current/25 pb-12 md:pb-16 lg:flex-row lg:items-center lg:justify-between">
    <div class="flex flex-col gap-5">
      <div class="flex flex-col gap-3 items-start">
      <Heading as="h2" size="h5">Join our newsletter</Heading>
      <p class="text-lg opacity-85">We'll send you one short letter a week. No spam.</p>
    </div>
      <Link href="#" color="inherit" underline="none" class="inline-flex items-center gap-3 self-start rounded-full py-1 ps-1 pe-3 text-sm font-semibold ring-1 ring-current/25">
        <span aria-hidden="true"><AvatarGroup items={[{ name: 'Ada Lovelace' }, { name: 'Alan Turing' }, { name: 'Grace Hopper' }, { name: 'Katherine Johnson' }]} size="small" /></span>
        Join 2,000+ companies
        <ChevronRight class="size-4 rtl:-scale-x-100" aria-hidden="true" />
      </Link>
    </div>
    <div class="flex flex-col gap-4 ">
      <form method="post" class="flex flex-col gap-3 sm:flex-row">
        <Input type="email" name="email" placeholder="Enter your email" aria-label="Email" autocomplete="email" required class="sm:w-64" />
        <Button type="submit" color="neutral">Subscribe</Button>
      </form>
    </div>
  </div>
  <div class="grid grid-cols-2 gap-8 mt-12 md:mt-16 md:grid-cols-3 lg:grid-cols-6">
      {columns.map((c) => (
        <nav aria-label={c.heading}>
          <p class="text-sm font-semibold opacity-85">{c.heading}</p>
          <ul class="mt-4 flex list-none flex-col gap-3 p-0">
            {c.links.map((l) => (
              <li class="flex items-center gap-2">
                <Link href="#" color="inherit" underline="hover" class="font-semibold">{l.label}</Link>
                {l.badge && <Badge size="small" variant="outline" color="neutral" class="border-current! bg-transparent! text-inherit!">{l.badge}</Badge>}
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
  <div class="mt-12 md:mt-16 flex flex-col gap-6 border-t border-current/25 pt-8 md:flex-row md:items-center md:justify-between">
    <Link href="/" color="inherit" underline="none" class="inline-flex items-center gap-2 text-lg font-semibold "><FeaturedIcon theme="solid" color="neutral" size="small"><Orbit /></FeaturedIcon>Example</Link>
    <p class="opacity-85 ">© 2026 Example. All rights reserved.</p>
  </div>
</Section>
