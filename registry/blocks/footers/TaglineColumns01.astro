---
/**
 * Tagline columns 01: The logo and a two-tone tagline beside three link columns and a let's-talk column with arrow links and social icons, then the copyright and legal links.
 *
 * @block footers
 * @order 43
 */
import { ArrowUpRight, AtSign, Camera, Orbit } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import FeaturedIcon from '../../components/FeaturedIcon/FeaturedIcon.astro'
import Link from '../../components/Link/Link.astro'

const columns = [
  { heading: 'Platform', links: ['Platform', 'Use cases', 'Apps and integrations'] },
  { heading: 'Services', links: ['Creative team', 'Growth team', 'Custom setup', 'Pricing'] },
  { heading: 'Company', links: ['About', 'Careers', 'Become a partner', 'News'] },
]
---

<Section as="footer" spacing="medium">
  <div class="grid gap-12 lg:grid-cols-[2fr_repeat(4,1fr)]">
    <div class="flex flex-col gap-4">
      <Link href="/" color="inherit" underline="none" class="inline-flex items-center gap-2 font-semibold"><FeaturedIcon theme="solid" color="primary" size="small"><Orbit /></FeaturedIcon>Example</Link>
      <p class="text-2xl leading-tight tracking-tight">Good judgement.<span class="block text-neutral-faded">Better marketing.</span></p>
    </div>
    {columns.map((c) => (
      <nav aria-label={c.heading}>
        <p class="text-sm text-neutral-faded">{c.heading}</p>
        <ul class="mt-4 flex list-none flex-col gap-4 p-0">
          {c.links.map((l) => <li><Link href="#" color="neutral" underline="hover">{l}</Link></li>)}
        </ul>
      </nav>
    ))}
    <nav aria-label="Get in touch">
      <p class="text-sm text-neutral-faded">Let’s talk</p>
      <ul class="mt-4 flex list-none flex-col gap-4 p-0">
        <li><Link href="#" color="neutral" underline="hover" class="inline-flex items-center gap-1">Book a demo<ArrowUpRight class="size-3.5" aria-hidden="true" /></Link></li>
        <li><Link href="#" color="neutral" underline="hover" class="inline-flex items-center gap-1">Sign in<ArrowUpRight class="size-3.5" aria-hidden="true" /></Link></li>
        <li class="flex gap-4">
          <Link href="#" color="neutral" underline="none" aria-label="Photos"><Camera class="size-5" aria-hidden="true" /></Link>
          <Link href="#" color="neutral" underline="none" aria-label="Profile"><AtSign class="size-5" aria-hidden="true" /></Link>
        </li>
      </ul>
    </nav>
  </div>

  <div class="mt-12 flex flex-col gap-4 border-t border-neutral-faded pt-6 text-sm text-neutral-faded md:flex-row md:justify-between">
    <p>© 2026 Example</p>
    <ul class="flex list-none gap-6 p-0"><li><Link href="#" color="neutral" underline="hover">Status</Link></li><li><Link href="#" color="neutral" underline="hover">Privacy</Link></li><li><Link href="#" color="neutral" underline="hover">Terms</Link></li></ul>
  </div>
</Section>
