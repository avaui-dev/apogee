---
/**
 * Small 01: One row: the logo, a row of links and the copyright.
 *
 * @block footers
 * @order 17
 */
import { Orbit } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import FeaturedIcon from '../../components/FeaturedIcon/FeaturedIcon.astro'
import Link from '../../components/Link/Link.astro'

---

<Section as="footer" spacing="small">
  <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
    <Link href="/" color="inherit" underline="none" class="inline-flex items-center gap-2 text-lg font-semibold "><FeaturedIcon theme="solid" color="primary" size="small"><Orbit /></FeaturedIcon>Example</Link>
    <nav aria-label="Footer" class=""><ul class="grid list-none grid-cols-2 gap-x-8 gap-y-3 p-0 sm:flex sm:flex-wrap"><li><Link href="#" color="neutral" underline="hover" class="font-semibold">Overview</Link></li><li><Link href="#" color="neutral" underline="hover" class="font-semibold">Features</Link></li><li><Link href="#" color="neutral" underline="hover" class="font-semibold">Pricing</Link></li><li><Link href="#" color="neutral" underline="hover" class="font-semibold">Careers</Link></li><li><Link href="#" color="neutral" underline="hover" class="font-semibold">Help</Link></li><li><Link href="#" color="neutral" underline="hover" class="font-semibold">Privacy</Link></li></ul></nav>
    <p class="text-neutral-faded ">© 2026 Example. All rights reserved.</p>
  </div>
</Section>
