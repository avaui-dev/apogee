---
/**
 * Large 15 brand: A centred logo and row of links, then copyright and legal links, on the brand colour.
 *
 * @block footers
 * @order 35
 */
import { Orbit } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import FeaturedIcon from '../../components/FeaturedIcon/FeaturedIcon.astro'
import Link from '../../components/Link/Link.astro'
import { type FooterContent } from '../../sections/_shared/footers.ts'

/** @composable */
interface Props extends FooterContent {}

const {
  brand = 'Example',
  columns = [{ heading: 'Footer', links: [{ label: 'Overview', href: '#' }, { label: 'Features', href: '#' }, { label: 'Pricing', href: '#' }, { label: 'Careers', href: '#' }, { label: 'Help', href: '#' }, { label: 'Privacy', href: '#' }] }],
  navLabel = 'Footer',
  copyright = '© 2026 Example. All rights reserved.',
  legal = [{ label: 'Terms', href: '#' }, { label: 'Privacy', href: '#' }, { label: 'Cookies', href: '#' }],
} = Astro.props
const flat = columns.flatMap((c) => c.links)
---

<Section as="footer" spacing="medium" background="primary">
  <div class="flex flex-col items-center gap-8">
    <Link href="/" color="inherit" underline="none" class="inline-flex items-center gap-2 text-lg font-semibold "><FeaturedIcon theme="solid" color="neutral" size="small"><Orbit /></FeaturedIcon>{brand}</Link>
    {flat.length > 0 && <nav aria-label={navLabel} class=""><ul class="grid list-none grid-cols-2 gap-x-8 gap-y-3 p-0 sm:flex sm:flex-wrap">{flat.map((l) => <li><Link href={l.href} color="inherit" underline="hover" class="font-semibold">{l.label}</Link></li>)}</ul></nav>}
  </div>
  <div class="mt-12 md:mt-16 flex flex-col-reverse gap-6 border-t border-current/25 pt-8 md:flex-row md:items-center md:justify-between">
    {copyright && <p class="opacity-85 ">{copyright}</p>}
    {legal && <nav aria-label="Legal"><ul class="flex list-none flex-wrap gap-x-6 gap-y-2 p-0 opacity-85">{legal.map((l) => <li><Link href={l.href} color="inherit" underline="hover">{l.label}</Link></li>)}</ul></nav>}
  </div>
</Section>
