---
/**
 * Alternative 01: An article page: a photo beside the title block (from lg), the body, then topics.
 *
 * @block content
 * @order 9
 */
import Section from '../../components/Section/Section.astro'
import Prose from '../../components/Prose/Prose.astro'
import Image from '../../components/Image/Image.astro'
import Avatar from '../../components/Avatar/Avatar.astro'
import Badge from '../../components/Badge/Badge.astro'
import Heading from '../../components/Heading/Heading.astro'
import { plain } from '../../sections/_shared/spine.ts'
import type { ContentContent } from '../../sections/_shared/content.ts'
import { formatDate } from '../../sections/_shared/date.ts'

/** @composable */
interface Props extends ContentContent {}

const {
  eyebrow = 'Customer success',
  heading = 'How small teams win big accounts',
  description = 'What we learned from the customers who stayed, and the ones who left.',
  media = { src: 'https://picsum.photos/seed/apogee-content-25/1200/1000', alt: '', width: 1200, height: 1000 },
  date = '2026-01-20',
  author = { name: 'Ada Lovelace', role: 'Design Lead' },
  topics = ['Design', 'Research', 'Process'],
} = Astro.props
---

<article>
  <Section spacing="large">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      {media && <Image src={media.src} alt={media.alt} width={media.width} height={media.height} fit="cover" radius="xl" class="aspect-[6/5] w-full max-lg:order-last" />}
      <header class="flex flex-col items-start gap-4">
        <div class="flex items-center gap-3 text-sm">
          {eyebrow && <Badge color="primary" rounded>{eyebrow}</Badge>}
          <time datetime={date} class="text-neutral-faded">{formatDate(date, 'en', 'short')}</time>
        </div>
        <Heading as="h1" size="h1">{plain(heading)}</Heading>
        {description && <p class="text-lg text-neutral-faded">{description}</p>}
    {author && (
    <div class="flex items-center gap-3">
      <Avatar name={author.name} size="large" />
      <div>
        <p class="font-semibold">{author.name}</p>
        {author.role && <p class="text-neutral-faded">{author.role}</p>}
      </div>
    </div>
    )}
      </header>
    </div>
  </Section>
  <Section spacing="none" containerWidth="small" class="pb-section">
    <Prose>
      <p class="lead">A design system is the shared language a team speaks when it builds a product: the parts, the rules for using them and the reasons behind the rules.</p>
      <h2 >Introduction</h2>
      <p>Most teams start one after the third button that looks almost, but not quite, like the other two. The cost is rarely the button; it is the conversation every time someone has to choose between them.</p>
      <p>A system turns those conversations into decisions made once. It does not slow a team down; it removes the questions nobody needed to ask.</p>
      <figure>
        <Image src="https://picsum.photos/seed/apogee-content-26/1600/900" alt="" width={1600} height={900} fit="cover" class="aspect-video w-full" />
        <figcaption>A team review of the component inventory.</figcaption>
      </figure>
      <h2 >Software and tools</h2>
      <p>The tools matter less than the habits around them. Keep the source of truth in code, describe every part where people already work, and let the build check what people forget.</p>
      <ol>
        <li>Name the parts the way the team already talks about them.</li>
        <li>Write down when to use each one, and when not to.</li>
        <li>Fail the build when a colour pair misses contrast.</li>
      </ol>
      <blockquote>
        <p>“We stopped arguing about buttons and started arguing about the product. That was the point.”</p>
        <cite>Ada Lovelace, Design Lead</cite>
      </blockquote>
      <h2 >Other resources</h2>
      <p>Read the parts' own documentation first: every variant, every state, and the keyboard behaviour you get for free.</p>
      <Image src="https://picsum.photos/seed/apogee-content-27/1600/900" alt="" width={1600} height={900} fit="cover" class="aspect-video w-full" />
      <div class="not-prose mt-10 rounded-2xl bg-neutral-faded p-6 md:p-8">
        <h2 class="text-xl font-semibold">Conclusion</h2>
        <p class="mt-4 text-neutral-faded">Start small: one page built entirely from shared parts teaches more than any audit. Grow the system where the product needs it, not ahead of it.</p>
      </div>
    </Prose>
    <footer class="mt-12 border-t border-neutral pt-8">
    {topics && (
    <ul class="flex list-none flex-wrap gap-2 p-0" aria-label="Topics">
      {topics.map((t) => <li><Badge color="neutral" rounded>{t}</Badge></li>)}
    </ul>
    )}
    </footer>
  </Section>
</article>
