---
/**
 * Section simple 03: A heading block over two columns of body text.
 *
 * @block content
 * @order 18
 */
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Prose from '../../components/Prose/Prose.astro'
import { plain } from '../../sections/_shared/spine.ts'
import type { ContentContent } from '../../sections/_shared/content.ts'

/** @composable */
interface Props extends ContentContent {}

const {
  eyebrow = 'Features',
  heading = 'Beautiful analytics to grow smarter',
  description = 'Powerful, self-serve product and growth analytics to help you convert, engage and retain more users.',
} = Astro.props
---

<Section spacing="large">
  <SectionHeader eyebrow={eyebrow ?? undefined} heading={plain(heading)} description={description ?? undefined} class="mb-12 max-w-3xl" />
  <div class="grid gap-8 md:grid-cols-2 md:gap-16">
    <Prose>
      <p>Most teams start a design system after the third button that looks almost, but not quite, like the other two. The cost is rarely the button; it is the conversation every time someone has to choose.</p>
      <p>A system turns those conversations into decisions made once, written down where people work.</p>
    </Prose>
    <Prose>
      <p>We work in short cycles with the people who will use the result:</p>
      <ul>
        <li>Name the parts the way the team already talks about them.</li>
        <li>Write down when to use each one, and when not to.</li>
        <li>Let the build check what people forget.</li>
      </ul>
    </Prose>
  </div>
</Section>
