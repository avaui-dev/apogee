---
/**
 * Full width brand: One line over a row of six logos on the brand colour.
 *
 * @block social-proof
 * @order 7
 */
import { Atom, Hexagon, Mountain, Sprout, Waves, Wind } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import { plain } from '../../sections/_shared/spine.ts'
import type { SocialProofContent } from '../../sections/_shared/social-proof.ts'

/** @composable */
interface Props extends SocialProofContent {}

const {
  heading = 'Join 4,000+ companies already growing',
  label = 'Customers',
  logos = ['Lumen', 'Quanta', 'Fieldwork', 'Northpeak', 'Arcwave', 'Kitestring'],
} = Astro.props
const logoIcons = [Hexagon, Atom, Sprout, Mountain, Waves, Wind]
---

<Section spacing="large" background="primary">
  <div class="flex flex-col gap-8">
    {heading && <p class="text-center font-medium opacity-85">{plain(heading)}</p>}
    {logos && (
      <ul aria-label={label} class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4 md:gap-y-6 xl:gap-x-12">
        {logos.map((name, i) => { const Mark = logoIcons[i % logoIcons.length]!; return <li class="flex items-center gap-2 text-lg font-semibold md:text-xl opacity-85"><Mark class="size-7 md:size-8" aria-hidden="true" />{name}</li> })}
      </ul>
    )}
  </div>
</Section>
