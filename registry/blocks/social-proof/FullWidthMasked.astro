---
/**
 * Full width masked: One line over a scrolling strip of logos.
 *
 * @block social-proof
 * @order 3
 */
import { Atom, Circle, Droplet, Hexagon, Mountain, Sprout, Square, Sun, Waves, Wind } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import Marquee from '../../components/Marquee/Marquee.astro'

---

<Section spacing="large" class="overflow-hidden">
  <div class="flex flex-col gap-8">
    <p class="text-center font-medium text-neutral-faded">Trusted by 4,000+ companies</p>
    <Marquee label="Customers">
      <span class="flex items-center gap-2 text-lg font-semibold md:text-xl text-neutral"><Hexagon class="size-7 md:size-8" aria-hidden="true" />Lumen</span>
      <span class="flex items-center gap-2 text-lg font-semibold md:text-xl text-neutral"><Atom class="size-7 md:size-8" aria-hidden="true" />Quanta</span>
      <span class="flex items-center gap-2 text-lg font-semibold md:text-xl text-neutral"><Sprout class="size-7 md:size-8" aria-hidden="true" />Fieldwork</span>
      <span class="flex items-center gap-2 text-lg font-semibold md:text-xl text-neutral"><Mountain class="size-7 md:size-8" aria-hidden="true" />Northpeak</span>
      <span class="flex items-center gap-2 text-lg font-semibold md:text-xl text-neutral"><Waves class="size-7 md:size-8" aria-hidden="true" />Arcwave</span>
      <span class="flex items-center gap-2 text-lg font-semibold md:text-xl text-neutral"><Wind class="size-7 md:size-8" aria-hidden="true" />Kitestring</span>
      <span class="flex items-center gap-2 text-lg font-semibold md:text-xl text-neutral"><Circle class="size-7 md:size-8" aria-hidden="true" />Ovalis</span>
      <span class="flex items-center gap-2 text-lg font-semibold md:text-xl text-neutral"><Sun class="size-7 md:size-8" aria-hidden="true" />Brightline</span>
      <span class="flex items-center gap-2 text-lg font-semibold md:text-xl text-neutral"><Square class="size-7 md:size-8" aria-hidden="true" />Corner</span>
      <span class="flex items-center gap-2 text-lg font-semibold md:text-xl text-neutral"><Droplet class="size-7 md:size-8" aria-hidden="true" />Tidewater</span>
    </Marquee>
  </div>
</Section>
