---
/**
 * Full width masked: One line over a scrolling strip of logos.
 *
 * @block social-proof
 * @order 3
 */
import { Atom, Circle, Droplet, Hexagon, Mountain, Sprout, Square, Sun, Waves, Wind } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import Marquee from '../../components/Marquee/Marquee.astro'
import { plain } from '../../sections/_shared/spine.ts'
import type { SocialProofContent } from '../../sections/_shared/social-proof.ts'

/** @composable */
interface Props extends SocialProofContent {}

const {
  heading = 'Trusted by 4,000+ companies',
  label = 'Customers',
  logos = ['Lumen', 'Quanta', 'Fieldwork', 'Northpeak', 'Arcwave', 'Kitestring', 'Ovalis', 'Brightline', 'Corner', 'Tidewater'],
} = Astro.props
const logoIcons = [Hexagon, Atom, Sprout, Mountain, Waves, Wind, Circle, Sun, Square, Droplet]
---

<Section spacing="large" class="overflow-hidden">
  <div class="flex flex-col gap-8">
    {heading && <p class="text-center font-medium text-neutral-faded">{plain(heading)}</p>}
    {logos && (
      <Marquee label={label}>
        {logos.map((name, i) => { const Mark = logoIcons[i % logoIcons.length]!; return <span class="flex items-center gap-2 text-lg font-semibold md:text-xl text-neutral"><Mark class="size-7 md:size-8" aria-hidden="true" />{name}</span> })}
      </Marquee>
    )}
  </div>
</Section>
