---
/**
 * Press mentions brand: One line over five press names on the brand colour.
 *
 * @block social-proof
 * @order 12
 */
import Section from '../../components/Section/Section.astro'
import { plain } from '../../sections/_shared/spine.ts'
import type { SocialProofContent } from '../../sections/_shared/social-proof.ts'

/** @composable */
interface Props extends SocialProofContent {}

const {
  heading = "We've been mentioned in the press",
  label = 'Press mentions',
  logos = ['The Morning Ledger', 'Northline Times', 'Signal Weekly', 'The Field Report', 'Metro Wire'],
} = Astro.props
---

<Section spacing="large" background="primary">
  <div class="flex flex-col gap-8">
    {heading && <p class="text-center font-medium opacity-85">{plain(heading)}</p>}
    {logos && (
      <ul aria-label={label} class="flex flex-col items-center gap-x-8 gap-y-4 md:flex-row md:flex-wrap md:justify-center xl:gap-x-12">
        {logos.map((name) => <li class="font-serif text-2xl font-semibold tracking-tight italic md:text-3xl opacity-85">{name}</li>)}
      </ul>
    )}
  </div>
</Section>
