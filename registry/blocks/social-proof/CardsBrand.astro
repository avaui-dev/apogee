---
/**
 * Cards brand: One line over eight logos, each on its own tile on the brand colour.
 *
 * @block social-proof
 * @order 11
 */
import { Atom, Circle, Hexagon, Mountain, Sprout, Sun, Waves, Wind } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import { plain } from '../../sections/_shared/spine.ts'
import type { SocialProofContent } from '../../sections/_shared/social-proof.ts'

/** @composable */
interface Props extends SocialProofContent {}

const {
  heading = 'Trusted by 4,000+ companies',
  label = 'Customers',
  logos = ['Lumen', 'Quanta', 'Fieldwork', 'Northpeak', 'Arcwave', 'Kitestring', 'Ovalis', 'Brightline'],
} = Astro.props
const logoIcons = [Hexagon, Atom, Sprout, Mountain, Waves, Wind, Circle, Sun]
---

<Section spacing="large" background="primary">
  <div class="flex flex-col gap-8 lg:gap-10">
    {heading && <p class="text-center font-medium opacity-85">{plain(heading)}</p>}
    {logos && (
      <ul aria-label={label} class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
        {logos.map((name, i) => { const Mark = logoIcons[i % logoIcons.length]!; return <li class="flex h-28 items-center justify-center rounded-xl px-4 py-10 md:h-42 md:px-8 md:py-16 bg-page/10"><span class="flex items-center gap-2 text-lg font-semibold md:text-xl opacity-85"><Mark class="size-7 md:size-8" aria-hidden="true" />{name}</span></li> })}
      </ul>
    )}
  </div>
</Section>
