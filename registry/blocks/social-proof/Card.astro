---
/**
 * Card: One line and five logos in a grey card.
 *
 * @block social-proof
 * @order 4
 */
import { Atom, Hexagon, Mountain, Sprout, Waves, Wind } from '@lucide/astro'
import Section from '../../components/Section/Section.astro'
import { plain } from '../../sections/_shared/spine.ts'
import type { SocialProofContent } from '../../sections/_shared/social-proof.ts'

/** @composable */
interface Props extends SocialProofContent {}

const {
  heading = 'Trusted by 4,000+ companies',
  label = 'Customers',
  logos = ['Lumen', 'Quanta', 'Fieldwork', 'Northpeak', 'Arcwave', 'Kitestring'],
} = Astro.props
const logoIcons = [Hexagon, Atom, Sprout, Mountain, Waves, Wind]
---

<Section spacing="large">
  <div class="-mx-4 flex flex-col gap-8 px-6 py-12 sm:mx-0 sm:rounded-2xl md:p-16 bg-neutral-faded">
    {heading && <p class="text-center font-medium text-neutral-faded md:text-xl">{plain(heading)}</p>}
    {logos && (
      <ul aria-label={label} class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4 md:gap-y-6 xl:gap-x-12">
        {logos.map((name, i) => { const Mark = logoIcons[i % logoIcons.length]!; return <li class:list={["flex items-center gap-2 text-lg font-semibold md:text-xl text-neutral", i >= 5 && "md:hidden"]}><Mark class="size-7 md:size-8" aria-hidden="true" />{name}</li> })}
      </ul>
    )}
  </div>
</Section>
