---
/**
 * Select — a labeled native `<select>` (styled, with a chevron). Pass `<option>`s
 * in the slot. Native = zero JS, full keyboard + mobile support.
 */
import type { HTMLAttributes } from 'astro/types'
import { uid } from '../utils/uid.ts'
import Field from '../Field/Field.astro'
import { fieldSizes, fieldVariants, fieldBase, type FieldSize, type FieldVariant } from '../utils/field.ts'
import { ChevronDown } from '@lucide/astro'

/** @composable */
interface Props extends Omit<HTMLAttributes<'select'>, 'size'> {
  id?: string
  label?: string
  hint?: string
  error?: string
  /** Marks the field invalid without a message. */
  hasError?: boolean
  /** @category layout */
  size?: FieldSize
  /** @category layout */
  variant?: FieldVariant
  required?: boolean
  class?: string
}

const { id: idProp, label, hint, error, hasError = false, size = 'medium', variant = 'outline', required = false, class: className, ...rest } = Astro.props
const invalid = Boolean(error) || hasError
const id = idProp ?? uid(Astro.locals)
const describedby = error ? `${id}-error` : hint ? `${id}-hint` : undefined

---

<Field id={id} label={label} hint={hint} error={error} required={required} class={className}>
  <div class="relative">
    <select
      id={id}
      required={required}
      aria-describedby={describedby}
      aria-invalid={invalid ? 'true' : undefined}
      class:list={['appearance-none pe-9', fieldBase, fieldVariants[variant], fieldSizes[size]]}
      {...rest}
    >
      <slot />
    </select>
    <ChevronDown class="pointer-events-none absolute end-3 top-1/2 size-4 -translate-y-1/2 text-neutral-faded" aria-hidden="true" />
  </div>
</Field>
