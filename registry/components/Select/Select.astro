---
/**
 * Select — a labeled native `<select>` (styled, with a chevron). Pass `<option>`s
 * in the slot: native = zero JS, full keyboard + mobile support.
 *
 * Pass `options` instead for a custom listbox: a field-styled button opens a
 * `role="listbox"` popover anchored under it (arrows, Home/End, type-ahead,
 * Enter/Space, Escape), with descriptions, disabled options and `multiple`.
 * The native `<select>` stays in the DOM as the form control (hidden while JS
 * runs, shown without JS), so the value submits like any other field.
 * Slots: `start` (icon inside the control), `end` (replaces the chevron).
 */
import type { HTMLAttributes } from 'astro/types'
import { uid } from '../utils/uid.ts'
import Field from '../Field/Field.astro'
import { fieldSizes, fieldVariants, fieldBase, type FieldSize, type FieldVariant } from '../utils/field.ts'
import { panelStyle, panelClass, panelSurface, menuClass, itemBase, itemSizes, itemColors } from '../utils/panel.ts'
import { ChevronDown, Check } from '@lucide/astro'
import Avatar from '../Avatar/Avatar.astro'
import Checkbox from '../Checkbox/Checkbox.astro'

export interface SelectOption {
  value: string
  label: string
  description?: string
  disabled?: boolean
  /** A Lucide component (or any Astro component rendering an svg) shown before the label. */
  icon?: (props: Record<string, unknown>) => unknown
  /** Image URL shown as a 24px avatar before the label; wins over `icon`. */
  avatar?: string
  /** Name behind `avatar` (initials fallback, alt text). */
  avatarName?: string
}

/** @composable */
interface Props extends Omit<HTMLAttributes<'select'>, 'size' | 'value' | 'multiple' | 'disabled'> {
  id?: string
  label?: string
  hint?: string
  error?: string
  /** Marks the field invalid without a message. */
  hasError?: boolean
  /** @category layout */
  size?: FieldSize
  /** @category layout */
  variant?: FieldVariant
  required?: boolean
  /** Rich options render a custom listbox (JS island) over the native select. */
  options?: SelectOption[]
  /** Empty first choice; shown faded until a value is picked. */
  placeholder?: string
  /** Initial value(s); `selected` on an `<option>` works too. */
  value?: string | string[]
  multiple?: boolean
  disabled?: boolean
  /** A search box at the top of the custom listbox that filters options by label. */
  search?: boolean
  /** "Select all" / "Clear" footer (multiple only). */
  selectAll?: boolean
  /** Trigger text when more than one option is chosen; `{count}` is replaced. @category content */
  countLabel?: string
  /** Shown when the search hides every option. @category content */
  emptyText?: string
  /** @category content */
  searchPlaceholder?: string
  /** @category content */
  selectAllLabel?: string
  /** @category content */
  clearLabel?: string
  class?: string
}

const {
  id: idProp,
  label,
  hint,
  error,
  hasError = false,
  size = 'medium',
  variant = 'outline',
  required = false,
  options,
  placeholder,
  value,
  multiple = false,
  disabled = false,
  search = false,
  selectAll = false,
  countLabel = '{count} selected',
  emptyText = 'No matches',
  searchPlaceholder = 'Search…',
  selectAllLabel = 'Select all',
  clearLabel = 'Clear',
  class: className,
  ...rest
} = Astro.props
const invalid = Boolean(error) || hasError
const id = idProp ?? uid(Astro.locals)
const describedby = [hint && `${id}-hint`, error && `${id}-error`].filter(Boolean).join(' ') || undefined
const values = value === undefined ? [] : Array.isArray(value) ? value : [value]
const chosen = options?.filter((o) => values.includes(o.value)) ?? []
const listId = `${id}-list`
const anchor = `--${id}`
const hasStart = Astro.slots.has('start')
const optionSize = { small: 'small', medium: 'medium', large: 'medium', xlarge: 'large' } as const
const controlClass = ['appearance-none pe-9', hasStart && 'ps-9', fieldBase, fieldVariants[variant], fieldSizes[size]]
const listMaxHeight = { small: '14rem', medium: '15rem', large: '16rem', xlarge: '20rem' } as const
const single = !multiple && chosen.length === 1 ? chosen[0] : undefined
---

<Field id={id} label={label} size={size} hint={hint} error={error} required={required} class={className}>
  <div class="apogee-select relative" data-custom={options ? '' : undefined}>
    {
      hasStart && (
        <span class="pointer-events-none absolute start-3 top-1/2 z-10 inline-flex -translate-y-1/2 text-neutral-faded [&_svg]:size-4">
          <slot name="start" />
        </span>
      )
    }
    <select
      id={id}
      required={required}
      multiple={multiple || undefined}
      disabled={disabled || undefined}
      aria-describedby={describedby}
      aria-invalid={invalid ? 'true' : undefined}
      class:list={[...controlClass, options && 'js:hidden']}
      {...rest}
    >
      {placeholder && <option value="" disabled={required} selected={!values.length}>{placeholder}</option>}
      {
        options ? (
          options.map((o) => (
            <option value={o.value} disabled={o.disabled} selected={values.includes(o.value)}>
              {o.label}
            </option>
          ))
        ) : (
          <slot />
        )
      }
    </select>
    {
      options && (
        <button
          type="button"
          popovertarget={listId}
          aria-haspopup="listbox"
          aria-controls={`${listId}-options`}
          aria-labelledby={label ? `${id}-label ${id}-value` : `${id}-value`}
          aria-describedby={describedby}
          aria-invalid={invalid ? 'true' : undefined}
          disabled={disabled || undefined}
          style={`anchor-name: ${anchor}`}
          class:list={['no-js:hidden flex items-center text-start', ...controlClass]}
        >
          {single?.avatar && <Avatar src={single.avatar} name={single.avatarName ?? single.label} size="xsmall" class="me-2 shrink-0" data-media />}
          {single && !single.avatar && single.icon && <span class="me-2 inline-flex shrink-0 text-neutral-faded [&>svg]:size-4" data-media><single.icon aria-hidden="true" /></span>}
          <span id={`${id}-value`} class:list={['truncate', !chosen.length && 'text-neutral-faded']} data-placeholder={placeholder} data-count-label={countLabel}>
            {chosen.length > 1 ? countLabel.replace('{count}', String(chosen.length)) : chosen.length ? chosen[0]?.label : placeholder}
          </span>
        </button>
      )
    }
    <span class="pointer-events-none absolute end-3 top-1/2 inline-flex -translate-y-1/2 text-neutral-faded [&_svg]:size-4">
      <slot name="end">
        <ChevronDown aria-hidden="true" />
      </slot>
    </span>
    {
      options && (
        <div
          id={listId}
          popover
          data-placement="bottom-start"
          style={panelStyle({ anchor, placement: 'bottom-start', gap: 1, width: 'trigger', maxHeight: listMaxHeight[size] })}
          class:list={[panelClass, panelSurface.overlay, menuClass, 'overflow-hidden']}
        >
          {
            search && (
              <input
                type="search"
                placeholder={searchPlaceholder}
                aria-label={searchPlaceholder}
                aria-controls={`${listId}-options`}
                autocomplete="off"
                class="apogee-select-search mb-0.5 h-8 w-full rounded border border-neutral bg-page px-2 text-sm max-md:text-base pointer-coarse:text-base text-neutral outline-none placeholder:text-neutral-faded focus-visible:border-primary"
              />
            )
          }
          <div
          id={`${listId}-options`}
          role="listbox"
          aria-multiselectable={multiple ? 'true' : undefined}
          aria-labelledby={label ? `${id}-label` : undefined}
          class="flex min-h-0 flex-col gap-0.5 overflow-auto"
          >
          {options.map((o) => (
            <div
              role="option"
              tabindex="-1"
              data-value={o.value}
              data-label={o.label}
              aria-selected={values.includes(o.value) ? 'true' : 'false'}
              aria-disabled={o.disabled ? 'true' : undefined}
              class:list={['group cursor-pointer', itemBase, itemSizes[optionSize[size]], itemColors.neutral, !multiple && 'aria-selected:bg-neutral-faded']}
            >
              {
                multiple && (
                  // The option carries the state (aria-selected); the box only shows it.
                  <Checkbox
                    size="small"
                    class="pointer-events-none shrink-0 [&>input]:mt-0"
                    tabindex="-1"
                    aria-hidden="true"
                    data-option-mark
                    checked={values.includes(o.value)}
                  />
                )
              }
              {o.avatar && <Avatar src={o.avatar} name={o.avatarName ?? o.label} size="xsmall" class="shrink-0" />}
              {!o.avatar && o.icon && <span class="inline-flex shrink-0 text-neutral-faded [&>svg]:size-4"><o.icon aria-hidden="true" /></span>}
              <span class="flex-1">
                {o.label}
                {o.description && <span class="block text-xs text-neutral-faded">{o.description}</span>}
              </span>
              {!multiple && <Check class="hidden group-aria-selected:block" aria-hidden="true" />}
            </div>
          ))}
          </div>
          {search && <p class="apogee-select-empty px-2 py-1.5 text-sm text-neutral-faded" hidden>{emptyText}</p>}
          {
            selectAll && multiple && (
              <div class="mt-0.5 flex gap-1 border-t border-neutral pt-1">
                <button type="button" data-select-all class="rounded px-2 py-1 text-xs font-medium text-primary hover:bg-primary-faded-highlighted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">{selectAllLabel}</button>
                <button type="button" data-select-clear class="rounded px-2 py-1 text-xs font-medium text-neutral-faded hover:bg-neutral-faded-highlighted hover:text-neutral focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">{clearLabel}</button>
              </div>
            )
          }
        </div>
      )
    }
  </div>
</Field>

<script>
  import { island } from '../utils/island.ts'
  import { restoreFocus } from '../utils/menu.ts'

  island('.apogee-select[data-custom]', (root) => {
    const select = root.querySelector<HTMLSelectElement>('select')
    const trigger = root.querySelector<HTMLButtonElement>('button[aria-haspopup="listbox"]')
    const list = root.querySelector<HTMLElement>('[role="listbox"]')
    const value = trigger?.querySelector<HTMLElement>('[id$="-value"]')
    const panel = list?.closest<HTMLElement>('[popover]')
    if (!select || !trigger || !list || !value || !panel) return
    const options = [...list.querySelectorAll<HTMLElement>('[role="option"]')]
    const search = panel.querySelector<HTMLInputElement>('.apogee-select-search')
    const empty = panel.querySelector<HTMLElement>('.apogee-select-empty')
    const enabled = () => options.filter((o) => !o.hidden && o.getAttribute('aria-disabled') !== 'true')
    restoreFocus(panel, trigger)
    // Search filters by label; the empty line shows when nothing is left.
    const filter = () => {
      const q = (search?.value ?? '').trim().toLowerCase()
      for (const o of options) o.hidden = q !== '' && !(o.dataset.label ?? '').toLowerCase().includes(q)
      if (empty) empty.hidden = options.some((o) => !o.hidden)
    }
    search?.addEventListener('input', filter)
    const footer = [...panel.querySelectorAll<HTMLButtonElement>('[data-select-all], [data-select-clear]')]
    const leave = () => {
      panel.hidePopover()
      trigger.focus()
    }
    search?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || (e.key === 'Tab' && !e.shiftKey)) {
        e.preventDefault()
        ;(enabled()[0] ?? footer[0])?.focus()
      } else if (e.key === 'Enter') {
        // Inside a form Enter would submit; toggle the first match instead.
        e.preventDefault()
        const first = enabled()[0]
        if (first) choose(first)
      }
    })
    // Footer: Tab past the last button leaves the panel; Shift+Tab goes back to the options.
    for (const [i, b] of footer.entries()) {
      b.addEventListener('keydown', (e) => {
        if (e.key === 'Tab' && !e.shiftKey && i === footer.length - 1) {
          e.preventDefault()
          leave()
        } else if (e.key === 'Tab' && e.shiftKey && i === 0) {
          e.preventDefault()
          focusCurrent()
        } else if (e.key === 'Escape') leave()
      })
    }
    const optionFor = (o: HTMLElement) => select.querySelector<HTMLOptionElement>(`option[value="${CSS.escape(o.dataset.value ?? '')}"]`)

    // The label points at the hidden select; send its click to the trigger.
    document.querySelector<HTMLLabelElement>(`label[for="${CSS.escape(select.id)}"]`)?.addEventListener('click', (e) => {
      e.preventDefault()
      trigger.focus()
    })

    const render = () => {
      const picked = options.filter((o) => optionFor(o)?.selected)
      options.forEach((o) => {
        o.setAttribute('aria-selected', String(picked.includes(o)))
        const mark = o.querySelector<HTMLInputElement>('[data-option-mark]')
        if (mark) mark.checked = picked.includes(o)
      })
      value.textContent =
        picked.length > 1
          ? (value.dataset.countLabel ?? '{count} selected').replace('{count}', String(picked.length))
          : picked.length
            ? (picked[0]?.dataset.label ?? '')
            : (value.dataset.placeholder ?? '')
      value.classList.toggle('text-neutral-faded', !picked.length)
      // The chosen option's icon or avatar sits before the label (single select only).
      trigger.querySelector('[data-media]')?.remove()
      const media = !select.multiple && picked.length === 1 ? picked[0]?.querySelector(':scope > .apogee-avatar, :scope > span:not(.flex-1)') : null
      if (media) {
        const clone = media.cloneNode(true) as HTMLElement
        clone.setAttribute('data-media', '')
        clone.classList.add('me-2')
        value.before(clone)
      }
    }
    const choose = (o: HTMLElement) => {
      const opt = optionFor(o)
      if (!opt) return
      if (select.multiple) opt.selected = !opt.selected
      else select.value = opt.value
      render()
      select.dispatchEvent(new Event('change', { bubbles: true }))
      if (!select.multiple) {
        panel.hidePopover()
        trigger.focus()
      }
    }
    const setAll = (on: boolean) => {
      // Every enabled option, filtered out or not: Clear must clear everything.
      for (const o of options.filter((x) => x.getAttribute('aria-disabled') !== 'true')) {
        const opt = optionFor(o)
        if (opt) opt.selected = on
      }
      render()
      select.dispatchEvent(new Event('change', { bubbles: true }))
    }
    panel.querySelector('[data-select-all]')?.addEventListener('click', () => setAll(true))
    panel.querySelector('[data-select-clear]')?.addEventListener('click', () => setAll(false))

    function focusCurrent() {
      ;(options.find((o) => o.getAttribute('aria-selected') === 'true' && !o.hidden) ?? enabled()[0])?.focus()
    }
    panel.addEventListener('toggle', (e) => {
      if ((e as ToggleEvent).newState !== 'open') return
      if (search) {
        search.value = ''
        filter()
        search.focus()
      } else focusCurrent()
    })
    list.addEventListener('click', (e) => {
      const o = (e.target as Element).closest<HTMLElement>('[role="option"]')
      if (o && o.getAttribute('aria-disabled') !== 'true') choose(o)
    })
    let typed = ''
    let typedAt = 0
    list.addEventListener('keydown', (e) => {
      const items = enabled()
      const idx = items.indexOf(document.activeElement as HTMLElement)
      if (e.key === 'ArrowUp' && idx === 0 && search) {
        e.preventDefault()
        search.focus()
        return
      }
      const go = (i: number) => {
        e.preventDefault()
        items[i]?.focus()
      }
      if (e.key === 'ArrowDown') go(Math.min(idx + 1, items.length - 1))
      else if (e.key === 'ArrowUp') go(Math.max(idx - 1, 0))
      else if (e.key === 'Home') go(0)
      else if (e.key === 'End') go(items.length - 1)
      else if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault()
        const item = items[idx]
        if (item) choose(item)
      } else if (e.key === 'Tab') {
        // Options are one stop: forward goes to the footer, back to the search, else out.
        e.preventDefault()
        if (!e.shiftKey && footer[0]) footer[0].focus()
        else if (e.shiftKey && search) search.focus()
        else leave()
      }
      else if (e.key.length === 1 && !e.metaKey && !e.ctrlKey) {
        // Type-ahead across option text.
        typed = (Date.now() - typedAt < 600 ? typed : '') + e.key.toLowerCase()
        typedAt = Date.now()
        items.find((o) => (o.dataset.label ?? '').toLowerCase().startsWith(typed))?.focus()
      }
    })
    trigger.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault()
        if (panel.matches(':popover-open')) focusCurrent()
        else panel.showPopover()
      }
    })
    // The hidden select cannot show the browser's validation bubble: surface it on the trigger.
    select.addEventListener('invalid', (e) => {
      e.preventDefault()
      trigger.setAttribute('aria-invalid', 'true')
      let msg = root.parentElement?.querySelector<HTMLElement>(`#${CSS.escape(select.id)}-error`)
      if (!msg) {
        msg = document.createElement('p')
        msg.id = `${select.id}-error`
        msg.setAttribute('role', 'alert')
        msg.className = 'text-sm text-critical'
        root.after(msg)
        trigger.setAttribute('aria-describedby', msg.id)
      }
      msg.textContent = select.validationMessage
      trigger.focus()
    })
    select.addEventListener('change', (e) => {
      if (select.checkValidity()) trigger.removeAttribute('aria-invalid')
      if (e.isTrusted) render() // a form reset or script change
    })
    select.form?.addEventListener('reset', () => setTimeout(render))
    render()
  })
</script>
