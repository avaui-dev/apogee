---
/**
 * Field — the labeled-field scaffold: label + control + hint/error, wired for
 * accessibility. Input/Textarea/Select render this with a matching `id`; use it
 * standalone for a custom control (pass the same `id` to your control and set
 * its `aria-describedby` to `<id>-hint` / `<id>-error`).
 *
 * The root carries `data-size`, so label and hint scale with the control. A
 * `tooltip` adds a help icon after the label that stays focusable when the
 * control is disabled. Hint and error render together when both are set.
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'
import { Info } from '@lucide/astro'
import Tooltip from '../Tooltip/Tooltip.astro'
const labelSizes = { small: 'text-xs', medium: 'text-sm', large: 'text-base', xlarge: 'text-base' } as const
const hintSizes = { small: 'text-xs', medium: 'text-sm', large: 'text-base', xlarge: 'text-base' } as const
interface Props extends Omit<HTMLAttributes<'div'>, 'size'> {
  id: string
  /** Dims the label and marks the field. */
  disabled?: boolean | undefined
  /** Label and hint text size, matching the control. @category layout */
  size?: keyof typeof labelSizes | undefined
  label?: string | undefined
  /** Help text behind an info icon after the label. @category content */
  tooltip?: string | undefined
  hint?: string | undefined
  error?: string | undefined
  required?: boolean | undefined
  /** Keeps `required` semantics but hides the asterisk. */
  hideRequiredIndicator?: boolean | undefined
  /** Renders only the slot, no wrapper: the parent owns label, hint and error. */
  bare?: boolean | undefined
  class?: string | undefined
}

const {
  id,
  label,
  tooltip,
  hint,
  error,
  required = false,
  hideRequiredIndicator = false,
  bare = false,
  disabled = false,
  size = 'medium',
  class: className,
  ...rest
} = Astro.props
---

{bare ? <slot /> : (
<div class:list={['flex flex-col gap-1.5', className]} data-size={size} aria-disabled={disabled ? 'true' : undefined} {...rest}>
  {
    label && (
      <div class="flex items-center gap-1.5">
        <label for={id} id={`${id}-label`} class:list={['font-medium', labelSizes[size], disabled ? 'text-disabled' : 'text-neutral']}>
          {label}
          {required && !hideRequiredIndicator && <span class="text-critical" aria-hidden="true"> *</span>}
        </label>
        {tooltip && (
          <Tooltip text={tooltip}>
            <button type="button" class="inline-grid size-4 place-items-center rounded-full text-neutral-faded hover:text-neutral focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus" aria-label="More information">
              <Info class="size-3.5" aria-hidden="true" />
            </button>
          </Tooltip>
        )}
      </div>
    )
  }
  <slot />
  {hint && <p id={`${id}-hint`} class:list={[hintSizes[size], 'text-neutral-faded']}>{hint}</p>}
  {error && <p id={`${id}-error`} role="alert" class:list={[hintSizes[size], 'text-critical']}>{error}</p>}
</div>
)}
