---
/**
 * AccordionItem — a native `<details>` disclosure. Open/close is 100% native
 * (zero JS); CSS animates the height. Give several items the same `group` for
 * single-open (exclusive) behavior.
 *
 * @composable
 */
import { ChevronDown } from '@lucide/astro'

interface Props {
  title: string
  /** Shared name → single-open (exclusive) across items with the same value. */
  group?: string
  /** Open on load. */
  open?: boolean
  class?: string
}

const { title, group, open = false, class: className, ...rest } = Astro.props
---

<details name={group} open={open} class:list={['apogee-accordion', className]} {...rest}>
  <summary
    class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-4 text-sm font-medium text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring [&::-webkit-details-marker]:hidden"
  >
    {title}
    <ChevronDown class="apogee-accordion-icon size-4 shrink-0 text-muted-foreground" aria-hidden="true" />
  </summary>
  <div class="px-4 pb-4 text-sm text-muted-foreground">
    <slot />
  </div>
</details>

<style>
  .apogee-accordion {
    interpolate-size: allow-keywords;
  }
  .apogee-accordion-icon {
    transition: rotate 0.2s ease;
  }
  .apogee-accordion[open] .apogee-accordion-icon {
    rotate: 180deg;
  }
  .apogee-accordion::details-content {
    block-size: 0;
    overflow: hidden;
    content-visibility: hidden;
    transition:
      block-size 0.25s ease,
      content-visibility 0.25s ease allow-discrete;
  }
  .apogee-accordion[open]::details-content {
    block-size: auto;
    content-visibility: visible;
  }
  @media (prefers-reduced-motion: reduce) {
    .apogee-accordion::details-content,
    .apogee-accordion-icon {
      transition: none;
    }
  }
</style>
