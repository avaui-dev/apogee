---
/**
 * EmptyState — a centered placeholder for empty views (no results, first run,
 * cleared list). Zero JS. Slots: `icon` (leading glyph), `actions` (buttons).
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'
interface Props extends HTMLAttributes<'div'> {
  title: string
  description?: string
  class?: string
}

const { title, description, class: className, ...rest } = Astro.props
const hasIcon = Astro.slots.has('icon')
const hasActions = Astro.slots.has('actions')
---

<div
  class:list={[
    'flex flex-col items-center justify-center gap-3 rounded-lg border border-dashed border-neutral p-10 text-center',
    className,
  ]}
  {...rest}
>
  {
    hasIcon && (
      <div class="text-neutral-faded [&_svg]:size-8">
        <slot name="icon" />
      </div>
    )
  }
  <div>
    <p class="text-sm font-medium text-neutral">{title}</p>
    {description && <p class="mx-auto mt-1 max-w-sm text-sm text-neutral-faded">{description}</p>}
  </div>
  {
    hasActions && (
      <div class="mt-2 flex flex-wrap justify-center gap-2">
        <slot name="actions" />
      </div>
    )
  }
</div>
