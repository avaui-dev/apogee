---
/**
 * Rating — a star rating on native radios (zero JS). `readonly` renders a static
 * display instead of inputs. Uses the reverse-order CSS trick so hovering /
 * checking a star fills it and every lower one.
 */
import type { HTMLAttributes } from 'astro/types'
import { uid } from '../utils/uid.ts'
import { Star } from '@lucide/astro'

const colors = {
  primary: 'var(--foreground-primary)',
  neutral: 'var(--foreground-neutral)',
  critical: 'var(--foreground-critical)',
  positive: 'var(--foreground-positive)',
  warning: 'var(--foreground-warning)',
} as const

/** @composable */
interface Props extends HTMLAttributes<'div'> {
  name?: string
  max?: number
  /** Selected (or displayed, when readonly) rating. */
  value?: number
  readonly?: boolean
  /** Star size. @category layout */
  size?: 'small' | 'medium' | 'large'
  /** Hue of a filled star. @category layout */
  color?: keyof typeof colors
  'aria-label'?: string
  class?: string
}

const {
  name = 'rating',
  max = 5,
  value = 0,
  readonly = false,
  size = 'medium',
  color = 'warning',
  'aria-label': ariaLabel,
  class: className,
  ...rest
} = Astro.props
const rid = uid(Astro.locals)
const readonlySizes = { small: 'size-4', medium: 'size-5', large: 'size-6' } as const
const interactiveSizes = { small: 'size-5', medium: 'size-6', large: 'size-7' } as const
// Fractional fill: the coloured star is clipped to the fraction of the value that falls in it.
const fillOf = (i: number) => Math.max(0, Math.min(100, (value - i) * 100))
---

{
  readonly ? (
    <div
      class:list={['inline-flex', className]}
      role="img"
      style={`--apogee-color: ${colors[color]}`}
      aria-label={ariaLabel ?? `${value} out of ${max}`}
      {...rest}
    >
      {Array.from({ length: max }).map((_, i) => (
        <span class="inline-grid">
          <Star class:list={['[grid-area:1/1] fill-current text-(--foreground-disabled)', readonlySizes[size]]} aria-hidden="true" />
          <Star
            class:list={['apogee-rating-fill [grid-area:1/1] fill-current text-(--apogee-color)', readonlySizes[size]]}
            style={`--apogee-cut: ${100 - fillOf(i)}%`}
            aria-hidden="true"
          />
        </span>
      ))}
    </div>
  ) : (
    <div class:list={['apogee-rating inline-flex flex-row-reverse', className]} style={`--apogee-color: ${colors[color]}`} role="radiogroup" aria-label={ariaLabel ?? 'Rating'} {...rest}>
      {Array.from({ length: max }).map((_, i) => {
        const v = max - i
        const oid = `${name}-${v}-${rid}`
        return (
          <>
            <input type="radio" name={name} id={oid} value={v} checked={value === v} class="peer sr-only" />
            <label for={oid} class="apogee-rating-star cursor-pointer rounded-sm p-2.5">
              <Star class:list={['fill-current', interactiveSizes[size]]} aria-hidden="true" />
              <span class="sr-only">{`${v} star${v === 1 ? '' : 's'}`}</span>
            </label>
          </>
        )
      })}
    </div>
  )
}

<style is:global>
  /* Readonly: clip the coloured star from the end so 3.5 shows a half star; mirrored in RTL. */
  .apogee-rating-fill {
    clip-path: inset(0 var(--apogee-cut) 0 0);
  }
  .apogee-rating-fill:dir(rtl) {
    clip-path: inset(0 0 0 var(--apogee-cut));
  }
  /* Reverse-order fill: a star and every lower one light up. Container hover
     clears the checked state so the hover preview wins. */
  .apogee-rating label {
    color: var(--foreground-disabled);
    transition: color var(--duration-fast) var(--ease-standard);
  }
  /* 44px targets by default; compact spacing only where a precise pointer exists. */
  @media (pointer: fine) {
    .apogee-rating label {
      padding: 0.25rem 0.125rem;
    }
  }
  .apogee-rating input:checked ~ label {
    color: var(--apogee-color);
  }
  /* Hover preview only on devices that hover; touch keeps the checked state. */
  @media (hover: hover) {
    .apogee-rating:hover input:checked ~ label {
      color: var(--foreground-disabled);
    }
    /* Doubled class: must outrank the reset above regardless of how the sheet is bundled. */
    .apogee-rating.apogee-rating:hover label:hover,
    .apogee-rating.apogee-rating:hover label:hover ~ label {
      color: var(--apogee-color);
    }
  }
  .apogee-rating input:focus-visible + label {
    outline: 2px solid var(--outline-color-focus);
    outline-offset: 2px;
  }
</style>
