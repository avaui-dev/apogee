---
/**
 * Link — inline text link.
 *
 * For a link that looks like a button, use `Button` with `href`; for a
 * button that looks like a link, use `Button variant="link"`.
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'
interface Props extends HTMLAttributes<'a'> {
  href: string
  /** Text colour. `inherit` takes the surrounding text colour. @category layout */
  color?: 'primary' | 'neutral' | 'critical' | 'positive' | 'warning' | 'inherit'
  /** Not navigable: no href, aria-disabled, dimmed. */
  disabled?: boolean
  /** Underline behavior. */
  underline?: 'always' | 'hover' | 'none'
  /** Opens in a new tab with safe rel. */
  external?: boolean
  class?: string
}

const { color = 'primary', href, underline = 'always', external = false, disabled = false, class: className, ...rest } = Astro.props
const colors = {
  primary: 'text-primary',
  neutral: 'text-neutral',
  critical: 'text-critical',
  positive: 'text-positive',
  warning: 'text-warning',
  inherit: 'text-inherit',
} as const
const hasStart = Astro.slots.has('start')
const hasEnd = Astro.slots.has('end')

const underlineMap = {
  always: 'underline underline-offset-4',
  hover: 'no-underline hover:underline underline-offset-4',
  none: 'no-underline',
}
const ext = external ? { target: '_blank', rel: 'noopener noreferrer' } : {}
---

<a
  href={disabled ? undefined : href}
  aria-disabled={disabled ? 'true' : undefined}
  class:list={[
    'rounded-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary',
    (hasStart || hasEnd) && 'inline-flex items-center gap-[0.35em] [&_svg]:size-[1em] [&_svg]:shrink-0',
    disabled ? 'pointer-events-none text-disabled' : colors[color],
    underlineMap[underline],
    className,
  ]}
  {...ext}
  {...rest}
>
  {hasStart && <slot name="start" />}
  <slot />
  {hasEnd && <slot name="end" />}
</a>
