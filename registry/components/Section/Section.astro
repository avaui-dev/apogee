---
/**
 * Section — a full-width band with vertical rhythm, wrapping its content in a
 * Container. `theme` colors the whole section and everything inside it (it flips
 * the design tokens for the subtree — context theming). A `background`
 * slot renders behind the content, full-bleed.
 */
import type { HTMLAttributes } from 'astro/types'
import Container from '../Container/Container.astro'

/** @composable */
interface Props extends HTMLAttributes<'section'> {
  as?: string
  /** Colors this section and its children by flipping the tokens. */
  theme?: 'inherit' | 'light' | 'dark'
  /** Vertical padding. @category layout */
  spacing?: 'none' | 'small' | 'medium' | 'large' | 'xlarge'
  /** Surface token for the band. Solid fills also set the on-colour text. @category layout */
  background?: 'page' | 'neutral-faded' | 'primary-faded' | 'primary' | 'inverted'
  /** Inner Container width. @category layout */
  containerWidth?: 'small' | 'medium' | 'large' | 'xlarge' | 'full'
  /** Set false to skip the inner Container (content spans full width). */
  container?: boolean
  class?: string
}

const {
  as = 'section',
  theme = 'inherit',
  spacing = 'large',
  background,
  containerWidth = 'large',
  container = true,
  class: className,
  ...rest
} = Astro.props
const Tag = as

// Fluid vertical rhythm — the --spacing-section* tokens (clamp-based), so a
// section breathes with the viewport instead of stepping at breakpoints.
const spaces = {
  none: '',
  small: 'py-section-sm',
  medium: 'py-section',
  large: 'py-section-lg',
  xlarge: 'py-section-xl',
}
const backgrounds = {
  page: 'bg-page text-neutral',
  'neutral-faded': 'bg-neutral-faded',
  'primary-faded': 'bg-primary-faded',
  primary: 'bg-primary text-on-primary',
  inverted: 'bg-inverted text-on-inverted',
} as const
const themed = theme !== 'inherit'
const hasBackground = Astro.slots.has('background')
---

<Tag
  class:list={['relative', themed && 'bg-page text-neutral', background && backgrounds[background], spaces[spacing], className]}
  data-theme={themed ? theme : undefined}
  {...rest}
>
  {hasBackground && <div class="absolute inset-0 -z-10"><slot name="background" /></div>}
  {
    container ? (
      <Container width={containerWidth}>
        <slot />
      </Container>
    ) : (
      <slot />
    )
  }
</Tag>
