---
/**
 * Menubar — a desktop-style app menubar (File, Edit, View…). Each top item is a
 * `<button popovertarget>` whose menu is a native popover: open/close, light
 * dismiss and "opening one closes the others" are native, zero JS. The island
 * adds ← / → between menus, ↓ into a menu, arrow keys inside a menu, hover
 * switching while a menu is open, and item activation. Items with `href`
 * navigate; others dispatch `apogee:menu` (`detail: { id, label }`) on
 * `document`.
 */
import type { HTMLAttributes } from 'astro/types'
import { innerRadius } from '../utils/radius.ts'
import { uid } from '../utils/uid.ts'
import { panelStyle, panelClass, panelSurface, menuClass, itemBase, itemSizes, itemColors } from '../utils/panel.ts'
interface MenuItem {
  label?: string
  href?: string
  id?: string
  separator?: boolean
}
/** @composable */
interface Props extends HTMLAttributes<'div'> {
  menus: { label: string; items: MenuItem[] }[]
  class?: string
}

const { menus, class: className, ...rest } = Astro.props

const itemClass = `apogee-menubar-item ${itemBase} ${itemSizes.medium} ${itemColors.neutral}`
const ids = menus.map(() => uid(Astro.locals, 'apogee-mb'))
---

<div
  role="menubar"
  class:list={['apogee-menubar flex items-center gap-0.5 rounded-md border border-neutral bg-page p-1', className]}
  {...rest}
>
  {
    menus.map((menu, i) => (
      <div class="apogee-menubar-menu">
        <button
          type="button"
          popovertarget={ids[i]}
          role="menuitem"
          aria-haspopup="menu"
          style={`anchor-name: --${ids[i]}`}
          class:list={[
            'apogee-menubar-trigger cursor-pointer px-3 py-1.5 text-sm font-medium text-neutral transition-colors select-none hover:bg-neutral-faded-highlighted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus',
            innerRadius['md-1'],
          ]}
        >
          {menu.label}
        </button>
        <div
          id={ids[i]}
          popover
          role="menu"
          aria-label={menu.label}
          data-placement="bottom-start"
          style={panelStyle({ anchor: `--${ids[i]}`, placement: 'bottom-start', gap: 1 })}
          class:list={[panelClass, panelSurface.overlay, menuClass]}
        >
          {menu.items.map((item) =>
            item.separator ? (
              <hr class="my-1 border-neutral" />
            ) : item.href ? (
              <a href={item.href} role="menuitem" class={itemClass}>
                {item.label}
              </a>
            ) : (
              <button type="button" role="menuitem" class={itemClass} data-id={item.id}>
                {item.label}
              </button>
            ),
          )}
        </div>
      </div>
    ))
  }
</div>

<script>
  import { island } from '../utils/island.ts'
  import { menuKeydown, menuItems, restoreFocus } from '../utils/menu.ts'

  island('.apogee-menubar', (bar) => {
    const menus = [...bar.querySelectorAll<HTMLElement>('.apogee-menubar-menu')]
    const panelOf = (m: HTMLElement) => m.querySelector<HTMLElement>(':scope > [role="menu"]')!
    const triggerOf = (m: HTMLElement) => m.querySelector<HTMLElement>(':scope > button')!
    const anyOpen = () => menus.some((m) => panelOf(m).matches(':popover-open'))
    const openMenu = (m: HTMLElement, focusFirst: boolean) => {
      const p = panelOf(m)
      // Focus the trigger first: the browser restores focus to whatever was focused at
      // show time, so Escape later lands on this menu's trigger, not the previous one.
      triggerOf(m).focus()
      if (!p.matches(':popover-open')) p.showPopover() // opening one closes the others natively
      if (focusFirst) menuItems(p)[0]?.focus()
      else triggerOf(m).focus()
    }

    menus.forEach((m, i) => {
      restoreFocus(panelOf(m), triggerOf(m))
      const step = (d: number, focusFirst: boolean) => {
        const next = menus[(i + d + menus.length) % menus.length]!
        if (anyOpen()) openMenu(next, focusFirst)
        else triggerOf(next).focus()
      }
      // Hovering a sibling trigger while a menu is open switches menus.
      triggerOf(m).addEventListener('pointerenter', () => anyOpen() && openMenu(m, false))
      m.addEventListener('keydown', (e) => {
        const onTrigger = document.activeElement === triggerOf(m)
        // Next menu is toward the inline end, so the arrows swap under RTL.
        const rtl = getComputedStyle(m).direction === 'rtl'
        if (e.key === (rtl ? 'ArrowLeft' : 'ArrowRight')) {
          e.preventDefault()
          step(1, !onTrigger || anyOpen())
        } else if (e.key === (rtl ? 'ArrowRight' : 'ArrowLeft')) {
          e.preventDefault()
          step(-1, !onTrigger || anyOpen())
        } else if (e.key === 'ArrowDown' && onTrigger) {
          e.preventDefault()
          openMenu(m, true)
        } else menuKeydown(e, panelOf(m))
      })
    })

    // Activate an item: close the menu, then navigate (anchor) or dispatch.
    for (const btn of bar.querySelectorAll<HTMLButtonElement>('.apogee-menubar-item[data-id]')) {
      btn.addEventListener('click', () => {
        btn.closest<HTMLElement>('[role="menu"]')!.hidePopover()
        document.dispatchEvent(
          new CustomEvent('apogee:menu', { detail: { id: btn.dataset.id, label: btn.textContent?.trim() } }),
        )
      })
    }
  })
</script>
