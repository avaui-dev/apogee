---
/**
 * Menubar — a desktop-style app menubar (File, Edit, View…). Each top item is a
 * native `<details>` menu, so open/close works with zero JS; a small island adds
 * the expected menubar behaviour: opening one closes the siblings, and ← / →
 * move between menus. Items with `href` navigate; others dispatch `apogee:menu`
 * (`detail: { id, label }`) on `document`.
 */
import type { HTMLAttributes } from 'astro/types'
import { innerRadius } from '../utils/radius.ts'
interface MenuItem {
  label?: string
  href?: string
  id?: string
  separator?: boolean
}
/** @composable */
interface Props extends HTMLAttributes<'div'> {
  menus: { label: string; items: MenuItem[] }[]
  class?: string
}

const { menus, class: className, ...rest } = Astro.props

const itemClass = `apogee-menubar-item flex w-full items-center gap-2 ${innerRadius['md-1']} px-2 py-1.5 text-start text-sm text-neutral transition-colors hover:bg-neutral-faded-highlighted focus-visible:bg-neutral-faded-highlighted focus-visible:outline-none`
---

<div
  role="menubar"
  class:list={['apogee-menubar flex items-center gap-0.5 rounded-md border border-neutral bg-page p-1', className]}
  {...rest}
>
  {
    menus.map((menu) => (
      <details class="apogee-menubar-menu relative">
        <summary
          role="menuitem"
          aria-haspopup="true"
          class:list={['cursor-pointer list-none px-3 py-1.5 text-sm font-medium text-neutral transition-colors select-none hover:bg-neutral-faded-highlighted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary [&::-webkit-details-marker]:hidden', innerRadius['md-1']]}
        >
          {menu.label}
        </summary>
        <div
          role="menu"
          class="apogee-menubar-panel absolute top-full start-0 z-30 mt-1 flex min-w-44 flex-col gap-0.5 rounded-md border border-neutral bg-elevation-raised p-1 shadow-lg"
        >
          {menu.items.map((item) =>
            item.separator ? (
              <hr class="my-1 border-neutral" />
            ) : item.href ? (
              <a href={item.href} role="menuitem" class={itemClass}>
                {item.label}
              </a>
            ) : (
              <button type="button" role="menuitem" class={itemClass} data-id={item.id}>
                {item.label}
              </button>
            ),
          )}
        </div>
      </details>
    ))
  }
</div>

<style>
  /* Fade + slide in when a menu opens. */
  .apogee-menubar-menu[open] .apogee-menubar-panel {
    animation: apogee-menubar-in var(--duration-fast) var(--ease-standard);
  }
  @keyframes apogee-menubar-in {
    from {
      opacity: 0;
      transform: translateY(-0.25rem);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .apogee-menubar-panel {
      animation: none;
    }
  }
</style>

<script>
  import { island } from '../utils/island.ts'

  island('.apogee-menubar', (bar) => {
    const menus = [...bar.querySelectorAll<HTMLDetailsElement>('.apogee-menubar-menu')]

    menus.forEach((d, i) => {
      // Opening one closes the others.
      d.addEventListener('toggle', () => {
        if (d.open) menus.forEach((o) => o !== d && (o.open = false))
      })
      // Arrow keys move between top-level menus.
      const summary = d.querySelector<HTMLElement>('summary')
      summary?.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') {
          e.preventDefault()
          menus[(i + 1) % menus.length]?.querySelector<HTMLElement>('summary')?.focus()
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault()
          menus[(i - 1 + menus.length) % menus.length]?.querySelector<HTMLElement>('summary')?.focus()
        }
      })
    })

    // Activate an item: close the menu, then navigate (anchor) or dispatch.
    for (const btn of bar.querySelectorAll<HTMLButtonElement>('.apogee-menubar-item[data-id]')) {
      btn.addEventListener('click', () => {
        btn.closest('details')!.open = false
        document.dispatchEvent(
          new CustomEvent('apogee:menu', { detail: { id: btn.dataset.id, label: btn.textContent?.trim() } }),
        )
      })
    }

  })

  // Close on outside click / Escape — one listener for every menubar on the page.
  document.addEventListener('click', (e) => {
    for (const d of document.querySelectorAll<HTMLDetailsElement>('.apogee-menubar-menu[open]')) {
      if (!d.closest('.apogee-menubar')?.contains(e.target as Node)) d.open = false
    }
  })
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return
    for (const d of document.querySelectorAll<HTMLDetailsElement>('.apogee-menubar-menu[open]')) d.open = false
  })
</script>
