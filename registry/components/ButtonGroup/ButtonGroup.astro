---
/**
 * ButtonGroup — joins adjacent Buttons into a single control, collapsing the
 * inner corners and overlapping borders.
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'
interface Props extends HTMLAttributes<'fieldset'> {
  /** Accessible label for the group. */
  label?: string
  /** Disables every button inside (native fieldset behaviour, no JS). */
  disabled?: boolean
  class?: string
}

const { label, disabled = false, class: className, ...rest } = Astro.props
---

{/* A fieldset so `disabled` reaches every button natively; the focused item lifts above its overlapping neighbour. */}
<fieldset
  role="group"
  aria-label={label}
  disabled={disabled || undefined}
  class:list={[
    'm-0 inline-flex min-w-0 border-0 p-0 [&>*]:relative [&>*:focus-visible]:z-10 [&>*:not(:first-child)]:-ms-px [&>*:not(:first-child)]:rounded-s-none [&>*:not(:last-child)]:rounded-e-none',
    className,
  ]}
  {...rest}
>
  <slot />
</fieldset>
