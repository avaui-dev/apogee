---
/**
 * Prose — styles a block of rich/CMS/markdown HTML you don't control element by
 * element. Token-driven, so it themes with everything else. Pass rendered HTML:
 *
 *   <Prose set:html={article.body} />
 *   <Prose><h2>…</h2><p>…</p></Prose>
 *
 * Escape-hatch CSS (a global, `.apogee-prose`-scoped block) — Tailwind utilities
 * can't reach slotted/injected HTML, so this is the right tool here. `:where()`
 * keeps specificity at zero so you can still override. Wrap a block in
 * `.not-prose` (a callout, a card) to keep Prose's styles off it.
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'
interface Props extends HTMLAttributes<'div'> {
  class?: string
}
const { class: className, ...rest } = Astro.props
---

<div class:list={['apogee-prose', className]} {...rest}>
  <slot />
</div>

<style is:global>
  /* Prose mirrors the components: headings use the fluid type tokens (Heading),
     quotes the serif Blockquote, code the Code panel, tables the Table styles. */
  @layer components {
    .apogee-prose {
      color: var(--foreground-neutral);
      line-height: 1.7;
    }
    .apogee-prose :where(:first-child):not(:where(.not-prose, .not-prose *)) {
      margin-top: 0;
    }
    .apogee-prose :where(h1, h2, h3, h4, h5, h6):not(:where(.not-prose, .not-prose *)) {
      font-weight: 600;
      letter-spacing: -0.025em;
      text-wrap: balance;
      margin-block: 2rem 0.75rem;
    }
    .apogee-prose :where(h1):not(:where(.not-prose, .not-prose *)) { font-size: var(--text-h1); line-height: var(--text-h1--line-height); }
    .apogee-prose :where(h2):not(:where(.not-prose, .not-prose *)) { font-size: var(--text-h2); line-height: var(--text-h2--line-height); margin-top: 2.5rem; }
    .apogee-prose :where(h3):not(:where(.not-prose, .not-prose *)) { font-size: var(--text-h3); line-height: var(--text-h3--line-height); }
    .apogee-prose :where(h4):not(:where(.not-prose, .not-prose *)) { font-size: var(--text-h4); line-height: var(--text-h4--line-height); margin-block: 1.5rem 0.5rem; }
    .apogee-prose :where(h5):not(:where(.not-prose, .not-prose *)) { font-size: var(--text-h5); line-height: var(--text-h5--line-height); margin-block: 1.5rem 0.5rem; }
    .apogee-prose :where(h6):not(:where(.not-prose, .not-prose *)) { font-size: var(--text-h6); line-height: var(--text-h6--line-height); margin-block: 1.5rem 0.5rem; color: var(--foreground-neutral-faded); }
    .apogee-prose :where(p, ul, ol, dl, blockquote, pre, table, figure, video, iframe, details):not(:where(.not-prose, .not-prose *)) {
      margin-block: 1.25em 0;
    }
    .apogee-prose :where(.lead):not(:where(.not-prose, .not-prose *)) { font-size: 1.2em; color: var(--foreground-neutral-faded); }
    .apogee-prose :where(small):not(:where(.not-prose, .not-prose *)) { font-size: 0.875em; color: var(--foreground-neutral-faded); }
    .apogee-prose :where(em):not(:where(.not-prose, .not-prose *)) { font-style: italic; }
    .apogee-prose :where(strong):not(:where(.not-prose, .not-prose *)) { font-weight: 600; }
    .apogee-prose :where(a):not(:where(.not-prose, .not-prose *)) {
      color: var(--foreground-primary);
      text-decoration: underline;
      text-underline-offset: 4px;
    }
    .apogee-prose :where(a):not(:where(.not-prose, .not-prose *)):hover { text-decoration-thickness: 2px; }
    .apogee-prose :where(ul):not(:where(.not-prose, .not-prose *)) { list-style: disc; padding-inline-start: 1.5em; }
    .apogee-prose :where(ol):not(:where(.not-prose, .not-prose *)) { list-style: decimal; padding-inline-start: 1.5em; }
    .apogee-prose :where(ul ul):not(:where(.not-prose, .not-prose *)) { list-style: circle; }
    .apogee-prose :where(ol ol):not(:where(.not-prose, .not-prose *)) { list-style: lower-alpha; }
    .apogee-prose :where(li):not(:where(.not-prose, .not-prose *)) { margin-block: 0.4em; }
    .apogee-prose :where(li > ul, li > ol):not(:where(.not-prose, .not-prose *)) { margin-block: 0.4em; }
    .apogee-prose :where(li):not(:where(.not-prose, .not-prose *))::marker { color: var(--foreground-neutral-faded); }
    .apogee-prose :where(blockquote):not(:where(.not-prose, .not-prose *)) {
      border-inline-start: 2px solid var(--border-primary);
      padding-inline-start: 1rem;
      font-family: var(--font-serif);
      font-size: 1.125rem;
      font-style: italic;
      color: var(--foreground-neutral);
    }
    .apogee-prose :where(blockquote p):not(:where(.not-prose, .not-prose *)) { margin-top: 0; }
    .apogee-prose :where(blockquote cite):not(:where(.not-prose, .not-prose *)) {
      display: block;
      margin-top: 0.5rem;
      font-family: var(--font-sans);
      font-size: 0.875rem;
      font-style: normal;
      color: var(--foreground-neutral-faded);
    }
    .apogee-prose :where(blockquote cite):not(:where(.not-prose, .not-prose *))::before { content: '— '; }
    .apogee-prose :where(code):not(:where(.not-prose, .not-prose *)) {
      font-family: var(--font-mono);
      font-size: 0.85em;
      background: var(--background-neutral-faded);
      border: 1px solid var(--border-neutral);
      padding: 0.1em 0.375em;
      border-radius: var(--radius-sm);
    }
    .apogee-prose :where(pre):not(:where(.not-prose, .not-prose *)) {
      background: var(--background-neutral-faded);
      border: 1px solid var(--border-neutral);
      padding: 1rem;
      border-radius: var(--radius-lg);
      font-family: var(--font-mono);
      font-size: 0.875rem;
      line-height: 1.6;
      overflow-x: auto;
    }
    .apogee-prose :where(pre code):not(:where(.not-prose, .not-prose *)) { background: none; border: 0; padding: 0; font-size: inherit; }
    .apogee-prose :where(img, video):not(:where(.not-prose, .not-prose *)) { border-radius: var(--radius-md); max-width: 100%; height: auto; }
    .apogee-prose :where(iframe):not(:where(.not-prose, .not-prose *)) { width: 100%; aspect-ratio: 16 / 9; border: 0; border-radius: var(--radius-md); }
    .apogee-prose :where(figure):not(:where(.not-prose, .not-prose *)) { margin-inline: 0; }
    .apogee-prose :where(figcaption):not(:where(.not-prose, .not-prose *)) { margin-top: 0.5rem; font-size: 0.875rem; color: var(--foreground-neutral-faded); }
    .apogee-prose :where(table):not(:where(.not-prose, .not-prose *)) { width: 100%; border-collapse: collapse; font-size: 0.875rem; font-variant-numeric: tabular-nums; }
    .apogee-prose :where(th):not(:where(.not-prose, .not-prose *)) { text-align: start; font-weight: 600; padding: 0.625rem 0.75rem; border-bottom: 1px solid var(--border-neutral); }
    .apogee-prose :where(td):not(:where(.not-prose, .not-prose *)) { padding: 0.625rem 0.75rem; border-top: 1px solid var(--border-neutral); vertical-align: top; }
    .apogee-prose :where(kbd):not(:where(.not-prose, .not-prose *)) { font-family: var(--font-mono); font-size: 0.85em; padding: 0.1em 0.4em; border: 1px solid var(--border-neutral); border-bottom-width: 2px; border-radius: var(--radius-sm); background: var(--background-elevation-raised); }
    .apogee-prose :where(mark):not(:where(.not-prose, .not-prose *)) { background: var(--background-warning-faded); color: inherit; padding: 0 0.2em; border-radius: var(--radius-sm); }
    .apogee-prose :where(abbr[title]):not(:where(.not-prose, .not-prose *)) { text-decoration: underline dotted; text-underline-offset: 2px; cursor: help; }
    .apogee-prose :where(dt):not(:where(.not-prose, .not-prose *)) { font-weight: 600; margin-top: 0.75em; }
    .apogee-prose :where(dd):not(:where(.not-prose, .not-prose *)) { margin-inline-start: 1.5em; color: var(--foreground-neutral-faded); }
    .apogee-prose :where(summary):not(:where(.not-prose, .not-prose *)) { cursor: pointer; font-weight: 600; }
    .apogee-prose :where(details[open] > summary):not(:where(.not-prose, .not-prose *)) { margin-bottom: 0.5em; }
    .apogee-prose :where(hr):not(:where(.not-prose, .not-prose *)) {
      border: 0;
      border-top: 1px solid var(--border-neutral);
      margin-block: 2.5rem;
    }
  }
</style>
