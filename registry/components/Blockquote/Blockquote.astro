---
/**
 * Blockquote — a pull quote with optional attribution. Zero JS.
 *
 *   <Blockquote cite="Ada Lovelace">The Analytical Engine …</Blockquote>
 */
import type { HTMLAttributes } from 'astro/types'
/** @composable */
interface Props extends HTMLAttributes<'blockquote'> {
  /** Attribution shown below the quote. */
  cite?: string
  class?: string
}

const { cite, class: className, ...rest } = Astro.props
---

<figure class:list={['border-s-2 border-primary ps-4', className]} {...rest}>
  <blockquote class="font-serif text-lg text-neutral italic [&>p]:mt-0">
    <slot />
  </blockquote>
  {
    cite && (
      <figcaption class="mt-2 text-sm text-neutral-faded not-italic">— {cite}</figcaption>
    )
  }
</figure>
