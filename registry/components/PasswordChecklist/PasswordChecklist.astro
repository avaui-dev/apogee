---
/**
 * PasswordChecklist — the rules a new password must meet, ticked off as the
 * user types. Without JS it is a plain list of the rules. The island marks each
 * rule met or not, adds the list to the field's description, and keeps the
 * field invalid (`setCustomValidity`) until every rule holds, so the form will
 * not submit early. A `match` rule compares with another field: use it under a
 * confirm field.
 *
 *   <Input id="pw" label="Password" type="password" minlength="8" />
 *   <PasswordChecklist for="pw" rules={[{ label: 'At least 8 characters', minLength: 8 }, { label: 'One special character', pattern: '[^A-Za-z0-9]' }]} />
 *   <Input id="pw2" label="Confirm password" type="password" />
 *   <PasswordChecklist for="pw2" rules={[{ label: 'Passwords match', match: 'pw' }]} />
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'
import { Circle, CircleCheck } from '@lucide/astro'
import { uid } from '../utils/uid.ts'

export interface PasswordRule {
  /** What the user reads, e.g. "At least 8 characters". */
  label: string
  /** Met when the value has at least this many characters. */
  minLength?: number
  /** Met when this regular expression finds a match in the value. */
  pattern?: string
  /** Met when the value equals the value of the input with this id. */
  match?: string
}

const sizes = { small: 'text-xs gap-1.5 [&_svg]:size-3.5', medium: 'text-sm gap-2 [&_svg]:size-4' } as const satisfies Record<NonNullable<Props['size']>, string>

/** @composable */
interface Props extends HTMLAttributes<'ul'> {
  /** Id of the password input the rules apply to. */
  for: string
  /** @shape { label: string, minLength?: number, pattern?: string, match?: string } @category content */
  rules: PasswordRule[]
  /** @category layout */
  size?: 'small' | 'medium'
  class?: string
}

const { for: target, rules, size = 'medium', id: idProp, class: className, ...rest } = Astro.props
const id = idProp ?? uid(Astro.locals, 'password-rules')
---

<ul id={id} data-password-checklist data-for={target} class:list={['apogee-password-checklist flex flex-col', sizes[size], className]} {...rest}>
  {
    rules.map((r) => (
      <li
        data-password-rule
        data-met="false"
        data-label={r.label}
        data-min-length={r.minLength}
        data-pattern={r.pattern}
        data-match={r.match}
        class:list={['group flex items-center text-neutral-faded transition-colors data-[met=true]:text-neutral', size === 'small' ? 'gap-1.5' : 'gap-2']}
      >
        <span class="grid shrink-0 [&>*]:col-start-1 [&>*]:row-start-1" aria-hidden="true">
          <Circle class="group-data-[met=true]:hidden" />
          <CircleCheck class="hidden text-positive group-data-[met=true]:block" />
        </span>
        <span>{r.label}<span class="sr-only no-js:hidden" data-password-rule-state>, not met</span></span>
      </li>
    ))
  }
</ul>

<style>
  @media (prefers-reduced-motion: reduce) {
    .apogee-password-checklist li {
      transition: none;
    }
  }
</style>

<script>
  import { island } from '../utils/island.ts'

  island('[data-password-checklist]', (list) => {
    const input = document.getElementById(list.dataset.for ?? '')
    if (!(input instanceof HTMLInputElement)) return
    const items = [...list.querySelectorAll<HTMLElement>('[data-password-rule]')]
    const described = input.getAttribute('aria-describedby')?.split(' ') ?? []
    if (!described.includes(list.id)) input.setAttribute('aria-describedby', [...described, list.id].join(' '))

    const otherOf = (li: HTMLElement) => (li.dataset.match ? (document.getElementById(li.dataset.match) as HTMLInputElement | null) : null)
    const check = () => {
      const v = input.value
      let firstUnmet = ''
      for (const li of items) {
        const { minLength, pattern } = li.dataset
        const other = otherOf(li)
        const met =
          (!minLength || v.length >= Number(minLength)) &&
          (!pattern || new RegExp(pattern).test(v)) &&
          (!li.dataset.match || (v !== '' && v === other?.value))
        li.dataset.met = String(met)
        const state = li.querySelector('[data-password-rule-state]')
        if (state) state.textContent = met ? ', met' : ', not met'
        if (!met && !firstUnmet) firstUnmet = li.dataset.label ?? ''
      }
      input.setCustomValidity(firstUnmet)
    }
    input.addEventListener('input', check)
    for (const li of items) otherOf(li)?.addEventListener('input', check)
    check()
  })
</script>
