---
/**
 * PinInput — a row of single-character boxes for short codes (OTP, 2FA). JS
 * island: auto-advance, backspace, arrow keys and paste-to-fill, plus it joins
 * the boxes into one hidden field that submits under `name`. Without JS each box
 * submits its own character as a repeated `name` field (join them server-side) —
 * so the code is never lost.
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'
import { fieldVariants, type FieldVariant } from '../utils/field.ts'
import Field from '../Field/Field.astro'
import { uid } from '../utils/uid.ts'

const patterns = { numeric: '[0-9]', alphabetic: '[A-Za-z]', alphanumeric: '[A-Za-z0-9]' } as const

interface Props extends Omit<HTMLAttributes<'div'>, 'type'> {
  /** @category layout */
  size?: 'small' | 'medium' | 'large' | 'xlarge'
  /** @category layout */
  variant?: FieldVariant
  id?: string
  /** @category content */
  label?: string
  /** @category content */
  hint?: string
  /** @category content */
  error?: string
  name?: string
  length?: number
  /** Boxes per group; a separator sits between groups (6 boxes, `groups={3}` → 123 – 456). @category layout */
  groups?: number
  /** Accepted characters; sets the keypad and the native `pattern`. */
  pattern?: keyof typeof patterns
  /** Older alias: `numeric` ⇒ `pattern="numeric"`, `text` ⇒ `alphanumeric`. */
  type?: 'numeric' | 'text'
  'aria-label'?: string
  /** Marks the code invalid. */
  hasError?: boolean
  disabled?: boolean
  /** Initial code, split across the boxes. */
  value?: string
  class?: string
}

const {
  id: idProp,
  label,
  hint,
  error,
  groups,
  name = 'code',
  length = 6,
  type,
  pattern = type === 'text' ? 'alphanumeric' : 'numeric',
  'aria-label': ariaLabel,
  size = 'medium',
  variant = 'outline',
  hasError = false,
  disabled = false,
  value = '',
  class: className,
  ...rest
} = Astro.props
const cells = { small: 'size-9 text-base rounded-sm', medium: 'size-11 text-lg rounded-md', large: 'size-12 text-xl rounded-md', xlarge: 'size-14 text-2xl rounded-md' } as const
const id = idProp ?? uid(Astro.locals)
const invalid = Boolean(error) || hasError
const describedby = [hint && `${id}-hint`, error && `${id}-error`].filter(Boolean).join(' ') || undefined
const placeholder = pattern === 'numeric' ? '0' : '–'
---

<Field id={id} label={label} hint={hint} error={error} class={className}>
<div
  class="apogee-pin flex items-center gap-2"
  role="group"
  aria-label={label ? undefined : (ariaLabel ?? 'Verification code')}
  aria-labelledby={label ? `${id}-label` : undefined}
  aria-describedby={describedby}
  data-pattern={pattern}
  data-name={name}
  {...rest}
>
  {
    Array.from({ length }).map((_, i) => (
      <>
      {groups && i > 0 && i % groups === 0 && <span role="separator" aria-orientation="vertical" class="w-2 border-t border-neutral" />}
      <input
        id={i === 0 ? id : undefined}
        type="text"
        name={name}
        placeholder={placeholder}
        inputmode={pattern === 'numeric' ? 'numeric' : 'text'}
        pattern={patterns[pattern]}
        autocomplete={i === 0 ? 'one-time-code' : 'off'}
        maxlength="1"
        value={value[i] ?? undefined}
        disabled={disabled || undefined}
        aria-invalid={invalid ? 'true' : undefined}
        class:list={[
          'apogee-pin-box text-center font-medium text-neutral tabular-nums max-md:text-base aria-[invalid=true]:border-critical disabled:bg-disabled disabled:text-disabled transition-colors focus-visible:border-primary focus-visible:outline-none focus-visible:shadow-[inset_0_0_0_1.5px_var(--border-primary)]',
          // Filled boxes take the primary border; the placeholder marks an empty one.
          'placeholder:text-neutral-faded/50 [&:not(:placeholder-shown)]:border-primary',
          fieldVariants[variant],
          cells[size],
        ]}
        aria-label={`Character ${i + 1} of ${length}`}
      />
      </>
    ))
  }
  <input type="hidden" class="apogee-pin-value" />
</div>
</Field>

<script>
  import { island } from '../utils/island.ts'

  island('.apogee-pin', (root) => {
    const boxes = [...root.querySelectorAll<HTMLInputElement>('.apogee-pin-box')]
    const hidden = root.querySelector<HTMLInputElement>('.apogee-pin-value')
    const strip = { numeric: /\D/g, alphabetic: /[^a-z]/gi, alphanumeric: /[^a-z0-9]/gi }[root.dataset.pattern ?? 'numeric'] ?? /\D/g
    if (!boxes.length || !hidden) return

    // JS collects one joined value: name the hidden field, un-name the boxes so
    // they no longer submit individually (the no-JS fallback).
    hidden.name = root.dataset.name || 'code'
    boxes.forEach((b) => b.removeAttribute('name'))

    const sync = () => (hidden.value = boxes.map((b) => b.value).join(''))
    const clean = (s: string) => s.replace(strip, '')

    boxes.forEach((box, i) => {
      box.addEventListener('input', () => {
        box.value = clean(box.value).slice(-1)
        if (box.value && i < boxes.length - 1) boxes[i + 1]?.focus()
        sync()
      })
      box.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && !box.value && i > 0) {
          boxes[i - 1]?.focus()
        } else if (e.key === 'ArrowLeft' && i > 0) {
          e.preventDefault()
          boxes[i - 1]?.focus()
        } else if (e.key === 'ArrowRight' && i < boxes.length - 1) {
          e.preventDefault()
          boxes[i + 1]?.focus()
        }
      })
      box.addEventListener('paste', (e) => {
        e.preventDefault()
        const chars = clean(e.clipboardData?.getData('text') ?? '').split('')
        for (let j = 0; j < chars.length && i + j < boxes.length; j++) {
          boxes[i + j]!.value = chars[j] ?? ''
        }
        boxes[Math.min(i + chars.length, boxes.length - 1)]?.focus()
        sync()
      })
    })
  })
</script>
