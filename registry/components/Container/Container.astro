---
/**
 * Container — centers content at a max width with side gutters.
 *
 * @composable
 */
interface Props {
  as?: string
  size?: 'sm' | 'md' | 'lg' | 'xl' | 'full'
  class?: string
}

const { as = 'div', size = 'lg', class: className, ...rest } = Astro.props
const Tag = as

const sizes = {
  sm: 'max-w-3xl',
  md: 'max-w-5xl',
  lg: 'max-w-7xl',
  xl: 'max-w-[90rem]',
  full: 'max-w-none',
}
---

<Tag class:list={['mx-auto w-full px-4 sm:px-6', sizes[size], className]} {...rest}>
  <slot />
</Tag>
