---
/**
 * Container — centers content at a max width with side gutters.
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'
interface Props extends HTMLAttributes<'div'> {
  as?: string
  /** Max width: 48 / 64 / 80 / 90rem, or none. @category layout */
  width?: 'small' | 'medium' | 'large' | 'xlarge' | 'full'
  class?: string
}

const { as = 'div', width = 'large', class: className, ...rest } = Astro.props
const Tag = as

const widths = {
  small: 'max-w-3xl',
  medium: 'max-w-5xl',
  large: 'max-w-7xl',
  xlarge: 'max-w-[90rem]',
  full: 'max-w-none',
}
---

<Tag class:list={['mx-auto w-full px-gutter', widths[width], className]} {...rest}>
  <slot />
</Tag>
