---
/**
 * ToggleButton — a two-state button (`aria-pressed`). Icon and/or text in the
 * slot. Self-toggles on click by default (small island); pass `manual` when a
 * parent owns the state — a toolbar reading the document selection, or a
 * single-select ToggleButtonGroup.
 *
 * @composable
 */
interface Props {
  pressed?: boolean
  /** Don't self-toggle; the parent controls `aria-pressed`. */
  manual?: boolean
  size?: 'sm' | 'md' | 'lg'
  'aria-label'?: string
  class?: string
  [key: string]: any
}

const { pressed = false, manual = false, size = 'md', class: className, ...rest } = Astro.props

const sizeMap = {
  sm: 'h-8 min-w-8 px-2 text-xs',
  md: 'h-9 min-w-9 px-2.5 text-sm',
  lg: 'h-10 min-w-10 px-3 text-base',
}
---

<button
  type="button"
  aria-pressed={pressed}
  data-toggle={String(!manual)}
  class:list={[
    'apogee-toggle inline-flex items-center justify-center gap-2 rounded-md font-medium text-muted-foreground transition-colors hover:bg-muted/60 hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring aria-pressed:bg-muted aria-pressed:text-foreground disabled:opacity-50 [&>svg]:size-4',
    sizeMap[size],
    className,
  ]}
  {...rest}
>
  <slot />
</button>

<script>
  for (const b of document.querySelectorAll<HTMLButtonElement>('.apogee-toggle[data-toggle="true"]')) {
    b.addEventListener('click', () =>
      b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true')),
    )
  }
</script>
