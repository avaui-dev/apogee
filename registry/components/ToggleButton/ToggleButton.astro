---
/**
 * ToggleButton — a two-state button (`aria-pressed`). Icon and/or text in the
 * slot. Self-toggles on click by default (small island); pass `manual` when a
 * parent owns the state — a toolbar reading the document selection, or a
 * single-select ToggleButtonGroup.
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'
interface Props extends Omit<HTMLAttributes<'button'>, 'size'> {
  pressed?: boolean
  /** Don't self-toggle; the parent controls `aria-pressed`. */
  manual?: boolean
  /** @category layout */
  size?: 'small' | 'medium' | 'large'
  'aria-label'?: string
  class?: string
}

const { pressed = false, manual = false, size = 'medium', class: className, ...rest } = Astro.props

const sizeMap = {
  small: 'h-8 min-w-8 px-2 text-xs',
  medium: 'h-9 min-w-9 px-2.5 text-sm',
  large: 'h-10 min-w-10 px-3 text-base',
}
---

<button
  type="button"
  aria-pressed={pressed}
  data-toggle={String(!manual)}
  class:list={[
    'apogee-toggle inline-flex items-center justify-center gap-2 rounded-md font-medium text-neutral-faded transition-colors hover:bg-neutral-faded-highlighted hover:text-neutral focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary aria-pressed:bg-neutral aria-pressed:text-neutral disabled:opacity-50 [&>svg]:size-4',
    sizeMap[size],
    className,
  ]}
  {...rest}
>
  <slot />
</button>

<script>
  import { island } from '../utils/island.ts'

  island('.apogee-toggle[data-toggle="true"]', (b) => {
    b.addEventListener('click', () => {
      const pressed = b.getAttribute('aria-pressed') !== 'true'
      b.setAttribute('aria-pressed', String(pressed))
      b.dispatchEvent(new CustomEvent('apogee:toggle-change', { bubbles: true, detail: { pressed } }))
    })
  })
</script>
