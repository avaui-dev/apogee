---
/**
 * NumberInput — a native number field with styled −/+ steppers. The input works
 * with zero JS (type a value, native validation on submit); the buttons are a
 * progressive-enhancement island (`no-js:hidden`). Field-wired like Input.
 */
import type { HTMLAttributes } from 'astro/types'
import { uid } from '../utils/uid.ts'
import Field from '../Field/Field.astro'
import { fieldSizes, fieldVariants, type FieldSize, type FieldVariant } from '../utils/field.ts'
import { Minus, Plus } from '@lucide/astro'

/** @composable */
interface Props extends Omit<HTMLAttributes<'input'>, 'size'> {
  id?: string
  label?: string
  hint?: string
  error?: string
  name?: string
  min?: number
  max?: number
  step?: number
  value?: number
  /** Marks the field invalid without a message. */
  hasError?: boolean
  /** @category layout */
  size?: FieldSize
  /** @category layout */
  variant?: FieldVariant
  /** Text before the value. @category content */
  prefix?: string
  /** Text after the value. @category content */
  suffix?: string
  /** @category content */
  increaseLabel?: string
  /** @category content */
  decreaseLabel?: string
  required?: boolean
  class?: string
}

const {
  id: idProp,
  label,
  hint,
  error,
  hasError = false,
  size = 'medium',
  variant = 'outline',
  prefix,
  suffix,
  increaseLabel = 'Increase',
  decreaseLabel = 'Decrease',
  required = false,
  disabled = false,
  class: className,
  ...rest
} = Astro.props
const id = idProp ?? uid(Astro.locals)
const invalid = Boolean(error) || hasError
const describedby = [hint && `${id}-hint`, error && `${id}-error`].filter(Boolean).join(' ') || undefined
// The steppers sit inside the box; the input keeps the size's height and text.
const sizeClasses = fieldSizes[size].replace(/\bpx-\S+\s*/, '') + ' max-md:text-base'
const btn =
  'apogee-number-step grid aspect-square place-items-center text-neutral-faded transition-colors no-js:hidden hover:bg-neutral-faded-highlighted hover:text-neutral focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-focus disabled:opacity-50'
---

<Field id={id} label={label} size={size} hint={hint} error={error} required={required} class={className}>
  <div
    class:list={[
      'apogee-number flex items-stretch overflow-hidden px-0 focus-within:border-primary focus-within:shadow-[inset_0_0_0_1.5px_var(--border-primary)] aria-[invalid=true]:border-critical',
      fieldVariants[variant],
      sizeClasses,
    ]}
    aria-invalid={invalid ? 'true' : undefined}
  >
    <button type="button" class={btn} data-step="-1" aria-label={decreaseLabel} tabindex="-1" disabled={disabled}>
      <Minus class="size-4" aria-hidden="true" />
    </button>
    {prefix && <span class="self-center ps-2 text-sm text-neutral-faded">{prefix}</span>}
    <input
      id={id}
      type="number"
      required={required}
      disabled={disabled}
      aria-describedby={describedby}
      class="apogee-number-input w-full min-w-0 bg-transparent px-2 text-center text-neutral outline-none disabled:cursor-not-allowed [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
      {...rest}
    />
    {suffix && <span class="self-center pe-2 text-sm text-neutral-faded">{suffix}</span>}
    <button type="button" class={btn} data-step="1" aria-label={increaseLabel} tabindex="-1" disabled={disabled}>
      <Plus class="size-4" aria-hidden="true" />
    </button>
  </div>
</Field>

<script>
  import { island } from '../utils/island.ts'

  island('.apogee-number', (group) => {
    const input = group.querySelector<HTMLInputElement>('.apogee-number-input')
    if (!input) return
    const fire = () => {
      input.dispatchEvent(new Event('input', { bubbles: true }))
      input.dispatchEvent(new Event('change', { bubbles: true }))
    }
    for (const b of group.querySelectorAll<HTMLButtonElement>('.apogee-number-step')) {
      const step = () => input[b.dataset.step === '-1' ? 'stepDown' : 'stepUp']()
      let delay: number | undefined
      let timer: number | undefined
      const stop = () => {
        clearTimeout(delay)
        clearInterval(timer)
        delay = timer = undefined
      }
      b.addEventListener('click', () => {
        step()
        fire()
      })
      // Hold to repeat: after 400 ms, every 60 ms, until release or leave.
      b.addEventListener('pointerdown', (e) => {
        if (e.button !== 0) return
        stop()
        b.setPointerCapture(e.pointerId)
        delay = window.setTimeout(() => {
          timer = window.setInterval(() => {
            if (b.disabled || input.disabled) return stop()
            const before = input.value
            step()
            if (input.value !== before) fire()
          }, 60)
        }, 400)
      })
      for (const ev of ['pointerup', 'pointerleave', 'pointercancel', 'blur']) b.addEventListener(ev, stop)
    }
    // Clamp a typed value into min/max on commit.
    input.addEventListener('change', () => {
      const v = Number(input.value)
      if (input.value === '' || Number.isNaN(v)) return
      const min = input.min === '' ? -Infinity : Number(input.min)
      const max = input.max === '' ? Infinity : Number(input.max)
      const c = Math.min(max, Math.max(min, v))
      if (c !== v) {
        input.value = String(c)
        input.dispatchEvent(new Event('input', { bubbles: true }))
      }
    })
  })
</script>
