---
/**
 * SegmentedControl — a row of connected options backed by native radios. Zero JS.
 * One selection, submits with the form under `name`. Full keyboard support and
 * a11y come from the native radio group.
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'
import { uid } from '../utils/uid.ts'
import { innerRadius } from '../utils/radius.ts'
interface Props extends Omit<HTMLAttributes<'div'>, 'size'> {
  /** Form field name; generated when omitted. */
  name?: string
  /** Options as strings, or `{ label, value }` when they differ. */
  options: (string | { label: string; value: string })[]
  /** Selected value. */
  value?: string
  /** @category layout */
  size?: 'small' | 'medium' | 'large'
  'aria-label'?: string
  class?: string
}

const { name: nameProp, options, value, size = 'medium', class: className, ...rest } = Astro.props
const name = nameProp ?? uid(Astro.locals, 'seg')
const items = options.map((o) => (typeof o === 'string' ? { label: o, value: o } : o))
const rid = uid(Astro.locals)

const sizeMap = {
  small: 'h-8 px-2.5 text-xs',
  medium: 'h-9 px-3 text-sm',
  large: 'h-11 px-4 text-base',
}
---

<div
  role="group"
  data-apogee-segmented
  class:list={['inline-flex gap-0.5 rounded-md border border-neutral bg-neutral-faded p-0.5', className]}
  {...rest}
>
  {
    items.map((o) => {
      const oid = `${name}-${o.value}-${rid}`
      return (
        <span class="contents">
          <input
            type="radio"
            name={name}
            id={oid}
            value={o.value}
            checked={value === o.value}
            class="peer sr-only"
          />
          <label
            for={oid}
            class:list={[
              'flex cursor-pointer items-center justify-center font-medium text-neutral-faded transition-colors hover:text-neutral peer-checked:bg-page peer-checked:text-neutral peer-checked:shadow-outline dark:peer-checked:bg-neutral peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-primary',
              sizeMap[size],
              innerRadius['md-0.5'],
            ]}
          >
            {o.label}
          </label>
        </span>
      )
    })
  }
</div>
