---
/**
 * Stat — a metric with a label and an optional change. Zero JS.
 * `changeStyle` picks how the change reads: a plain arrow, a trend line, or a
 * small bordered pill where only the arrow takes the colour. `comparison`
 * adds "vs last month"; the `start` slot takes a FeaturedIcon.
 */
import type { HTMLAttributes } from 'astro/types'
import { TrendingUp, TrendingDown, ArrowUp, ArrowDown, ArrowUpRight, ArrowDownRight } from '@lucide/astro'

const glyphs = {
  simple: { up: ArrowUp, down: ArrowDown },
  trend: { up: TrendingUp, down: TrendingDown },
  modern: { up: ArrowUpRight, down: ArrowDownRight },
} as const satisfies Record<NonNullable<Props['changeStyle']>, unknown>

/** @composable */
interface Props extends HTMLAttributes<'div'> {
  label: string
  value: string
  /** Optional change, e.g. "+12%". */
  change?: string | undefined
  trend?: 'up' | 'down' | undefined
  /** How the change reads. @category layout */
  changeStyle?: 'simple' | 'trend' | 'modern' | undefined
  /** Text after the change, e.g. "vs last month". @category content */
  comparison?: string | undefined
  /** @category layout */
  size?: 'medium' | 'large' | undefined
  class?: string | undefined
}

const { label, value, change, trend = 'up', changeStyle = 'trend', comparison, size = 'medium', class: className, ...rest } = Astro.props
const Glyph = glyphs[changeStyle][trend]
const tone = trend === 'down' ? 'text-critical' : 'text-positive'
const modern = changeStyle === 'modern'
const hasStart = Astro.slots.has('start')
---

<div class:list={['apogee-stat', hasStart && 'flex items-start gap-3', className]} {...rest}>
  {hasStart && <slot name="start" />}
  <div class="flex min-w-0 flex-col gap-1">
    <span class="text-sm text-neutral-faded">{label}</span>
    <span class:list={['apogee-stat-value font-semibold tracking-tight text-neutral tabular-nums', size === 'large' ? 'text-4xl' : 'text-2xl']}>{value}</span>
    {
      (change || comparison) && (
        <span class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
          {change && (
            <span
              data-style={changeStyle}
              class:list={[
                'apogee-stat-change inline-flex items-center gap-1 tabular-nums',
                modern
                  ? ['rounded-md border border-neutral bg-elevation-raised px-1.5 py-0.5 font-medium text-neutral shadow-raised', trend === 'down' ? '[&>svg]:text-critical' : '[&>svg]:text-positive']
                  : tone,
              ]}
            >
              <Glyph class="size-4" aria-hidden="true" />
              <span class="sr-only">{trend === 'down' ? 'Down' : 'Up'}</span>
              {change}
            </span>
          )}
          {comparison && <span class="text-neutral-faded">{comparison}</span>}
        </span>
      )
    }
  </div>
</div>
