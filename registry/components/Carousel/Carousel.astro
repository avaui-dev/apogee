---
/**
 * Carousel — a horizontal scroll-snap track. Native scroll / swipe / keyboard
 * with zero JS; arrows, dots and autoplay are progressive-enhancement islands
 * (`no-js:hidden`, the track scrolls fine without them). Drop slides in the
 * default slot; snapping and `shrink-0` are applied for you. Give each slide a
 * width, or set `itemWidth` for uniform slides.
 */
import type { HTMLAttributes } from 'astro/types'
import { ChevronLeft, ChevronRight } from '@lucide/astro'
import { responsive, type Responsive } from '../utils/responsive.ts'
import { tables } from '../utils/responsive-tables.ts'

const gaps = { 2: 'gap-2 [--apogee-gap:calc(var(--spacing)*2)]', 3: 'gap-3 [--apogee-gap:calc(var(--spacing)*3)]', 4: 'gap-4 [--apogee-gap:calc(var(--spacing)*4)]', 6: 'gap-6 [--apogee-gap:calc(var(--spacing)*6)]', 8: 'gap-8 [--apogee-gap:calc(var(--spacing)*8)]' } as const

/** @composable */
interface Props extends Omit<HTMLAttributes<'div'>, 'align'> {
  /** Show the prev/next arrow buttons. */
  controls?: boolean
  /** Show clickable pagination dots (one per slide). */
  dots?: boolean
  /** Snap edge of each slide. */
  align?: 'start' | 'center'
  /** Fixed width applied to every slide, e.g. "16rem". Omit to size each slide yourself. */
  itemWidth?: string
  /** Slides per view, per breakpoint; sizes every slide to fit. Overrides `itemWidth`. @category layout */
  visibleItems?: Responsive<keyof typeof tables.carouselItems.base>
  /** Space between slides, in spacing steps. @category layout */
  gap?: keyof typeof gaps
  /** Let the track run under the page gutters. @category layout */
  bleed?: boolean
  /** Auto-advance. Pauses on hover / focus; off under reduced-motion. */
  autoplay?: boolean
  /** Autoplay delay in ms. */
  interval?: number
  /** With autoplay, jump back to the start after the last slide. */
  loop?: boolean
  /** Accessible name of the carousel region. @category content */
  label?: string
  /** `overlay`: borderless translucent arrows for image carousels. @category layout */
  controlsVariant?: 'default' | 'overlay'
  /** Dots under the track, or floating over its bottom edge. @category layout */
  dotsPosition?: 'below' | 'overlay'
  /** Arrows on the track's sides, or in a row under it (with the dots between them). @category layout */
  controlsPosition?: 'sides' | 'below'
  class?: string
}

const {
  controls = true,
  dots = false,
  align = 'start',
  itemWidth,
  visibleItems,
  gap = 4,
  bleed = false,
  autoplay = false,
  interval = 4000,
  loop = false,
  label = 'Carousel',
  controlsVariant = 'default',
  dotsPosition = 'below',
  controlsPosition = 'sides',
  class: className,
  ...rest
} = Astro.props

// Render the slot once so dots can be counted from the same markup.
const items = await Astro.slots.render('default')

// Count top-level elements of the slot (the slides). Depth-tracked so nested
// markup isn't counted; void elements never open a level.
const VOID = new Set(['area', 'base', 'br', 'col', 'embed', 'hr', 'img', 'input', 'link', 'meta', 'source', 'track', 'wbr'])
const slideCount = dots
  ? (() => {
      let depth = 0
      let n = 0
      for (const [, closing, name, , self] of items.matchAll(/<(\/?)([a-zA-Z][^\s/>]*)([^>]*?)(\/?)>/g)) {
        if (closing) {
          depth = Math.max(0, depth - 1)
          continue
        }
        if (depth === 0) n += 1
        if (!self && !VOID.has((name ?? '').toLowerCase())) depth += 1
      }
      return n
    })()
  : 0
const below = controls && controlsPosition === 'below'
const arrow = [
  below ? '' : 'absolute top-1/2 -translate-y-1/2',
  'press grid size-11 place-items-center rounded-full text-neutral no-js:hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus disabled:cursor-not-allowed disabled:[&>svg]:opacity-35',
  controlsVariant === 'overlay'
    ? 'border-0 bg-page/90 backdrop-blur-xs enabled:hover:bg-page'
    : 'border border-neutral bg-page shadow-md enabled:hover:bg-page-faded',
].join(' ')
---

<div
  class:list={['apogee-carousel group relative w-full min-w-0', ...responsive(visibleItems, tables.carouselItems), className]}
  data-align={align}
  data-autoplay={String(autoplay)}
  data-interval={interval}
  data-loop={String(loop)}
  style={itemWidth ? `--apogee-item-width: ${itemWidth}` : undefined}
  {...rest}
>
  <div
    class:list={[
      'apogee-carousel-track flex snap-x snap-mandatory overflow-x-auto pb-1 motion-safe:scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden [&>*]:shrink-0 [&>*]:snap-start group-data-[align=center]:[&>*]:snap-center',
      gaps[gap],
      bleed && '-mx-gutter px-gutter scroll-px-gutter',
      visibleItems !== undefined
        ? '[&>*]:w-[calc((100%-(var(--apogee-items)-1)*var(--apogee-gap))/var(--apogee-items))]'
        : itemWidth && '[&>*]:w-(--apogee-item-width)',
    ]}
    tabindex="0"
    role="region"
    aria-roledescription="carousel"
    aria-label={label}
  >
    <Fragment set:html={items} />
  </div>

  {
    controls && !below && (
      <>
        <button type="button" class:list={['apogee-carousel-prev start-2', arrow]} aria-label="Previous">
          <ChevronLeft class="size-5 rtl:-scale-x-100" aria-hidden="true" />
        </button>
        <button type="button" class:list={['apogee-carousel-next end-2', arrow]} aria-label="Next">
          <ChevronRight class="size-5 rtl:-scale-x-100" aria-hidden="true" />
        </button>
      </>
    )
  }

  {
    (below || (dots && slideCount > 0)) && (
      <div class:list={below ? ['mt-4 flex items-center gap-3 no-js:hidden', dots ? 'justify-center' : 'justify-end'] : 'contents'}>
        {below && (
          <button type="button" class:list={['apogee-carousel-prev', arrow]} aria-label="Previous">
            <ChevronLeft class="size-5 rtl:-scale-x-100" aria-hidden="true" />
          </button>
        )}
        {dots && slideCount > 0 && (
          <div
            class:list={[
              'apogee-carousel-dots flex justify-center gap-2 no-js:hidden',
              below ? 'gap-0' : dotsPosition === 'overlay'
                ? 'absolute bottom-3 left-1/2 -translate-x-1/2 gap-0 rounded-full bg-page/80 px-1 backdrop-blur-xs'
                : 'mt-3',
            ]}
            role="group"
            aria-label="Slides"
          >
            {Array.from({ length: slideCount }).map((_, i) => (
              <button
                type="button"
                class="apogee-carousel-dot group/dot rounded-full p-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
                aria-label={`Go to slide ${i + 1}`}
                aria-current={i === 0 ? 'true' : 'false'}
              >
                <span
                  class:list={[
                    'block size-2.5 rounded-full transition-colors group-aria-[current=true]/dot:bg-primary',
                    // Over media the inactive dots need more weight to read on the pill.
                    dotsPosition === 'overlay' ? 'bg-(--foreground-neutral-faded)' : 'bg-neutral',
                  ]}
                />
              </button>
            ))}
          </div>
        )}
        {below && (
          <button type="button" class:list={['apogee-carousel-next', arrow]} aria-label="Next">
            <ChevronRight class="size-5 rtl:-scale-x-100" aria-hidden="true" />
          </button>
        )}
      </div>
    )
  }
</div>

<style>
  /* On a primary fill the primary dot would vanish; it takes the on-colour there. */
  :global(.bg-primary) .apogee-carousel-dot[aria-current='true'] > span {
    background-color: var(--on-primary);
  }
</style>

<script>
  import { island } from '../utils/island.ts'

  const reduced = matchMedia('(prefers-reduced-motion: reduce)')

  island('.apogee-carousel', (c) => {
    const track = c.querySelector<HTMLElement>('.apogee-carousel-track')
    if (!track) return
    const slides = [...track.children] as HTMLElement[]
    slides.forEach((s, i) => {
      if (!s.hasAttribute('role')) s.setAttribute('role', 'group')
      s.setAttribute('aria-roledescription', 'slide')
      if (!s.hasAttribute('aria-label')) s.setAttribute('aria-label', `${i + 1} of ${slides.length}`)
    })
    // Arrows scroll to an exact slide position instead of a fixed distance: a script-driven
    // smooth scroll doesn't always re-snap (WebKit), which would leave a slide cut in half.
    const rtl = () => getComputedStyle(track).direction === 'rtl'
    const pad = () => parseFloat(getComputedStyle(track).scrollPaddingInlineStart) || 0
    // Distance from the track's start edge to a slide's start edge, in scroll units (always ≥ 0).
    const offset = (el: HTMLElement) => {
      const t = track.getBoundingClientRect()
      const r = el.getBoundingClientRect()
      return (rtl() ? t.right - r.right : r.left - t.left) + Math.abs(track.scrollLeft) - pad()
    }
    // The scroll position that shows a slide where snapping would put it.
    const target = (el: HTMLElement) => {
      const centre = c.dataset.align === 'center'
      const view = track.clientWidth - pad() * 2
      const left = centre ? offset(el) - (view - el.offsetWidth) / 2 : offset(el)
      return Math.max(0, Math.min(left, track.scrollWidth - track.clientWidth))
    }
    const scrollToSlide = (el: HTMLElement) =>
      track.scrollTo({ left: (rtl() ? -1 : 1) * target(el), behavior: reduced.matches ? 'auto' : 'smooth' })
    const go = (dir: number) => {
      const pos = Math.abs(track.scrollLeft)
      const view = track.clientWidth - pad() * 2
      // Next: the first slide that isn't fully in view. Previous: the first slide one view back.
      const el =
        dir > 0
          ? slides.find((s) => offset(s) + s.offsetWidth > pos + view + 1 && target(s) > pos + 1) ?? slides[slides.length - 1]
          : slides.find((s) => target(s) >= pos - view - 1 && target(s) < pos - 1) ?? slides[0]
      if (el) scrollToSlide(el)
    }

    const prev = c.querySelector<HTMLElement>('.apogee-carousel-prev')
    const next = c.querySelector<HTMLElement>('.apogee-carousel-next')
    prev?.addEventListener('click', () => go(-1))
    next?.addEventListener('click', () => go(1))
    // Disable an arrow at its edge (it keeps its place); `Math.abs` keeps it right under RTL.
    const edges = () => {
      const pos = Math.abs(track.scrollLeft)
      const atStart = pos <= 1
      const atEnd = pos + track.clientWidth >= track.scrollWidth - 1
      // A focused arrow that becomes disabled would drop focus: hand it to the other one.
      if (atEnd && next && document.activeElement === next) prev?.focus()
      if (atStart && prev && document.activeElement === prev) next?.focus()
      prev?.toggleAttribute('disabled', atStart)
      next?.toggleAttribute('disabled', atEnd)
    }
    edges()
    track.addEventListener('scroll', edges, { passive: true })
    new ResizeObserver(edges).observe(track)

    // The active slide (most visible) drives the dots and the change event.
    let current = 0
    const dots = [...c.querySelectorAll<HTMLElement>('.apogee-carousel-dot')]
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue
          const i = slides.indexOf(e.target as HTMLElement)
          dots.forEach((d, di) => d.setAttribute('aria-current', String(di === i)))
          if (i !== current) {
            current = i
            c.dispatchEvent(new CustomEvent('apogee:carousel-change', { bubbles: true, detail: { index: i } }))
          }
        }
      },
      { root: track, threshold: 0.6 },
    )
    slides.forEach((s) => io.observe(s))

    // Dots: click to scroll to a slide.
    dots.forEach((dot, i) => { const s = slides[i]; if (s) dot.addEventListener('click', () => scrollToSlide(s)) })

    // Autoplay: advance on a timer, pause on hover/focus, never under reduced-motion.
    if (c.dataset.autoplay === 'true' && !reduced.matches) {
      const delay = Number(c.dataset.interval) || 4000
      const loop = c.dataset.loop === 'true'
      let timer: number | undefined
      const tick = () => {
        const atEnd = Math.abs(track.scrollLeft) + track.clientWidth >= track.scrollWidth - 4
        if (atEnd) {
          if (loop) track.scrollTo({ left: 0, behavior: 'smooth' })
        } else {
          go(1)
        }
      }
      const start = () => (timer = window.setInterval(tick, delay))
      const stop = () => clearInterval(timer)
      start()
      c.addEventListener('mouseenter', stop)
      c.addEventListener('mouseleave', start)
      c.addEventListener('focusin', stop)
      c.addEventListener('focusout', start)
    }
  })
</script>
