---
/**
 * Carousel — a horizontal scroll-snap track. Native scroll / swipe / keyboard
 * with zero JS; arrows, dots and autoplay are progressive-enhancement islands
 * (`no-js:hidden`, the track scrolls fine without them). Drop slides in the
 * default slot; snapping and `shrink-0` are applied for you. Give each slide a
 * width, or set `itemWidth` for uniform slides.
 */
import type { HTMLAttributes } from 'astro/types'
import { ChevronLeft, ChevronRight } from '@lucide/astro'
import { responsive, type Responsive } from '../utils/responsive.ts'
import { tables } from '../utils/responsive-tables.ts'

const gaps = { 2: 'gap-2 [--apogee-gap:calc(var(--spacing)*2)]', 3: 'gap-3 [--apogee-gap:calc(var(--spacing)*3)]', 4: 'gap-4 [--apogee-gap:calc(var(--spacing)*4)]', 6: 'gap-6 [--apogee-gap:calc(var(--spacing)*6)]', 8: 'gap-8 [--apogee-gap:calc(var(--spacing)*8)]' } as const

/** @composable */
interface Props extends Omit<HTMLAttributes<'div'>, 'align'> {
  /** Show the prev/next arrow buttons. */
  controls?: boolean
  /** Show clickable pagination dots (one per slide). */
  dots?: boolean
  /** Snap edge of each slide. */
  align?: 'start' | 'center'
  /** Fixed width applied to every slide, e.g. "16rem". Omit to size each slide yourself. */
  itemWidth?: string
  /** Slides per view, per breakpoint; sizes every slide to fit. Overrides `itemWidth`. @category layout */
  visibleItems?: Responsive<keyof typeof tables.carouselItems.base>
  /** Space between slides, in spacing steps. @category layout */
  gap?: keyof typeof gaps
  /** Let the track run under the page gutters. @category layout */
  bleed?: boolean
  /** Auto-advance. Pauses on hover / focus; off under reduced-motion. */
  autoplay?: boolean
  /** Autoplay delay in ms. */
  interval?: number
  /** With autoplay, jump back to the start after the last slide. */
  loop?: boolean
  /** Accessible name of the carousel region. @category content */
  label?: string
  class?: string
}

const {
  controls = true,
  dots = false,
  align = 'start',
  itemWidth,
  visibleItems,
  gap = 4,
  bleed = false,
  autoplay = false,
  interval = 4000,
  loop = false,
  label = 'Carousel',
  class: className,
  ...rest
} = Astro.props

// Render the slot once so dots can be counted from the same markup.
const items = await Astro.slots.render('default')

// Count top-level elements of the slot (the slides). Depth-tracked so nested
// markup isn't counted; void elements never open a level.
const VOID = new Set(['area', 'base', 'br', 'col', 'embed', 'hr', 'img', 'input', 'link', 'meta', 'source', 'track', 'wbr'])
const slideCount = dots
  ? (() => {
      let depth = 0
      let n = 0
      for (const [, closing, name, , self] of items.matchAll(/<(\/?)([a-zA-Z][^\s/>]*)([^>]*?)(\/?)>/g)) {
        if (closing) {
          depth = Math.max(0, depth - 1)
          continue
        }
        if (depth === 0) n += 1
        if (!self && !VOID.has((name ?? '').toLowerCase())) depth += 1
      }
      return n
    })()
  : 0
---

<div
  class:list={['apogee-carousel group relative w-full min-w-0', ...responsive(visibleItems, tables.carouselItems), className]}
  data-align={align}
  data-autoplay={String(autoplay)}
  data-interval={interval}
  data-loop={String(loop)}
  style={itemWidth ? `--apogee-item-width: ${itemWidth}` : undefined}
  {...rest}
>
  <div
    class:list={[
      'apogee-carousel-track flex snap-x snap-mandatory overflow-x-auto pb-1 motion-safe:scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden [&>*]:shrink-0 [&>*]:snap-start group-data-[align=center]:[&>*]:snap-center',
      gaps[gap],
      bleed && '-mx-gutter px-gutter scroll-px-gutter',
      visibleItems !== undefined
        ? '[&>*]:w-[calc((100%-(var(--apogee-items)-1)*var(--apogee-gap))/var(--apogee-items))]'
        : itemWidth && '[&>*]:w-(--apogee-item-width)',
    ]}
    tabindex="0"
    role="region"
    aria-roledescription="carousel"
    aria-label={label}
  >
    <Fragment set:html={items} />
  </div>

  {
    controls && (
      <>
        <button
          type="button"
          class="apogee-carousel-prev absolute top-1/2 start-2 grid size-11 -translate-y-1/2 place-items-center rounded-full border border-neutral bg-page text-neutral shadow-md no-js:hidden hover:bg-page-faded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
          aria-label="Previous"
        >
          <ChevronLeft class="size-5 rtl:-scale-x-100" aria-hidden="true" />
        </button>
        <button
          type="button"
          class="apogee-carousel-next absolute top-1/2 end-2 grid size-11 -translate-y-1/2 place-items-center rounded-full border border-neutral bg-page text-neutral shadow-md no-js:hidden hover:bg-page-faded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
          aria-label="Next"
        >
          <ChevronRight class="size-5 rtl:-scale-x-100" aria-hidden="true" />
        </button>
      </>
    )
  }

  {
    dots && slideCount > 0 && (
      <div class="apogee-carousel-dots mt-3 flex justify-center gap-2 no-js:hidden" role="group" aria-label="Slides">
        {Array.from({ length: slideCount }).map((_, i) => (
          <button
            type="button"
            class="apogee-carousel-dot group/dot rounded-full p-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
            aria-label={`Go to slide ${i + 1}`}
            aria-current={i === 0 ? 'true' : 'false'}
          >
            <span class="block size-2.5 rounded-full bg-neutral transition-colors group-aria-[current=true]/dot:bg-primary" />
          </button>
        ))}
      </div>
    )
  }
</div>

<script>
  import { island } from '../utils/island.ts'

  const reduced = matchMedia('(prefers-reduced-motion: reduce)')

  island('.apogee-carousel', (c) => {
    const track = c.querySelector<HTMLElement>('.apogee-carousel-track')
    if (!track) return
    const slides = [...track.children] as HTMLElement[]
    slides.forEach((s, i) => {
      if (!s.hasAttribute('role')) s.setAttribute('role', 'group')
      s.setAttribute('aria-roledescription', 'slide')
      if (!s.hasAttribute('aria-label')) s.setAttribute('aria-label', `${i + 1} of ${slides.length}`)
    })
    const step = () => track.clientWidth * 0.8
    // In RTL the inline axis runs right-to-left, so "next" is a negative scroll.
    const sign = () => (getComputedStyle(track).direction === 'rtl' ? -1 : 1)
    const go = (dir: number) => track.scrollBy({ left: dir * sign() * step(), behavior: 'smooth' })

    const prev = c.querySelector<HTMLElement>('.apogee-carousel-prev')
    const next = c.querySelector<HTMLElement>('.apogee-carousel-next')
    prev?.addEventListener('click', () => go(-1))
    next?.addEventListener('click', () => go(1))
    // Hide an arrow at its edge; `Math.abs` keeps it right under RTL.
    const edges = () => {
      const pos = Math.abs(track.scrollLeft)
      prev?.toggleAttribute('hidden', pos <= 1)
      next?.toggleAttribute('hidden', pos + track.clientWidth >= track.scrollWidth - 1)
    }
    edges()
    track.addEventListener('scroll', edges, { passive: true })
    new ResizeObserver(edges).observe(track)

    // The active slide (most visible) drives the dots and the change event.
    let current = 0
    const dots = [...c.querySelectorAll<HTMLElement>('.apogee-carousel-dot')]
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue
          const i = slides.indexOf(e.target as HTMLElement)
          dots.forEach((d, di) => d.setAttribute('aria-current', String(di === i)))
          if (i !== current) {
            current = i
            c.dispatchEvent(new CustomEvent('apogee:carousel-change', { bubbles: true, detail: { index: i } }))
          }
        }
      },
      { root: track, threshold: 0.6 },
    )
    slides.forEach((s) => io.observe(s))

    // Dots: click to scroll to a slide.
    const scrollToSlide = (el: HTMLElement) => {
      const left = el.getBoundingClientRect().left - track.getBoundingClientRect().left + track.scrollLeft
      track.scrollTo({ left, behavior: 'smooth' })
    }
    dots.forEach((dot, i) => { const s = slides[i]; if (s) dot.addEventListener('click', () => scrollToSlide(s)) })

    // Autoplay: advance on a timer, pause on hover/focus, never under reduced-motion.
    if (c.dataset.autoplay === 'true' && !reduced.matches) {
      const delay = Number(c.dataset.interval) || 4000
      const loop = c.dataset.loop === 'true'
      let timer: number | undefined
      const tick = () => {
        const atEnd = Math.abs(track.scrollLeft) + track.clientWidth >= track.scrollWidth - 4
        if (atEnd) {
          if (loop) track.scrollTo({ left: 0, behavior: 'smooth' })
        } else {
          go(1)
        }
      }
      const start = () => (timer = window.setInterval(tick, delay))
      const stop = () => clearInterval(timer)
      start()
      c.addEventListener('mouseenter', stop)
      c.addEventListener('mouseleave', start)
      c.addEventListener('focusin', stop)
      c.addEventListener('focusout', start)
    }
  })
</script>
