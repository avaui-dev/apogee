---
/**
 * FileUpload — a styled file input / dropzone. The native input works with zero
 * JS (opens the picker, submits the file); a small island adds the selected file
 * name(s) and drag-and-drop (progressive enhancement).
 *
 * @composable
 */
import { UploadCloud } from '@lucide/astro'

interface Props {
  name?: string
  accept?: string
  multiple?: boolean
  class?: string
  [key: string]: any
}

const { id: idProp, class: className, ...rest } = Astro.props
const id = idProp ?? `apogee-file-${Math.random().toString(36).slice(2, 9)}`
---

<label
  for={id}
  class:list={[
    'apogee-file flex cursor-pointer flex-col items-center justify-center gap-2 rounded-lg border border-dashed border-border bg-background p-6 text-center transition-colors hover:border-accent data-[drag=true]:border-accent data-[drag=true]:bg-accent/5',
    className,
  ]}
>
  <input id={id} type="file" class="apogee-file-input sr-only" {...rest} />
  <UploadCloud class="size-6 text-muted-foreground" aria-hidden="true" />
  <span class="text-sm text-foreground">
    <span class="font-medium text-accent">Browse</span> or drag a file here
  </span>
  <span class="apogee-file-name text-xs text-muted-foreground no-js:hidden"></span>
</label>

<script>
  for (const label of document.querySelectorAll<HTMLElement>('.apogee-file')) {
    const input = label.querySelector<HTMLInputElement>('.apogee-file-input')
    const nameEl = label.querySelector<HTMLElement>('.apogee-file-name')
    if (!input) continue

    const show = () => {
      const files = [...(input.files ?? [])]
      if (nameEl) nameEl.textContent = files.map((f) => f.name).join(', ')
    }
    input.addEventListener('change', show)

    for (const ev of ['dragenter', 'dragover']) {
      label.addEventListener(ev, (e) => {
        e.preventDefault()
        label.dataset.drag = 'true'
      })
    }
    label.addEventListener('dragleave', (e) => {
      if (label.contains(e.relatedTarget as Node)) return
      label.dataset.drag = 'false'
    })
    label.addEventListener('drop', (e: DragEvent) => {
      e.preventDefault()
      label.dataset.drag = 'false'
      if (e.dataTransfer?.files?.length) {
        input.files = e.dataTransfer.files
        show()
      }
    })
  }
</script>
