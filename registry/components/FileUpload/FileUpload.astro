---
/**
 * FileUpload — a styled file input / dropzone. The native input works with zero
 * JS (opens the picker, submits the file); a small island adds the selected file
 * name(s) and drag-and-drop (progressive enhancement).
 */
import type { HTMLAttributes } from 'astro/types'
import { uid } from '../utils/uid.ts'
import { UploadCloud } from '@lucide/astro'

/** @composable */
interface Props extends HTMLAttributes<'input'> {
  name?: string
  accept?: string
  multiple?: boolean
  /** `headless` drops the dashed box so the slot is the whole look. @category layout */
  variant?: 'default' | 'headless'
  /** A single row (icon + text) instead of a stacked zone. @category layout */
  inline?: boolean
  class?: string
}

const { id: idProp, variant = 'default', inline = false, class: className, ...rest } = Astro.props
const id = idProp ?? uid(Astro.locals, 'apogee-file')
---

<label
  for={id}
  class:list={[
    'apogee-file flex cursor-pointer items-center justify-center gap-2 transition-colors data-[drag=true]:border-primary data-[drag=true]:bg-primary-faded-highlighted',
    inline ? 'flex-row p-3 text-start' : 'flex-col p-6 text-center',
    variant === 'default' && 'rounded-lg border border-dashed border-neutral bg-page hover:border-primary',
    className,
  ]}
>
  <input id={id} type="file" class="apogee-file-input sr-only" {...rest} />
  <slot>
    <UploadCloud class="size-6 shrink-0 text-neutral-faded" aria-hidden="true" />
    <span class="text-sm text-neutral">
      <span class="font-medium text-primary">Browse</span> or drag a file here
    </span>
  </slot>
  <span class="apogee-file-name text-xs text-neutral-faded no-js:hidden"></span>
</label>

<script>
  import { island } from '../utils/island.ts'

  island('.apogee-file', (label) => {
    const input = label.querySelector<HTMLInputElement>('.apogee-file-input')
    const nameEl = label.querySelector<HTMLElement>('.apogee-file-name')
    if (!input) return

    const show = () => {
      const files = [...(input.files ?? [])]
      if (nameEl) nameEl.textContent = files.map((f) => f.name).join(', ')
    }
    input.addEventListener('change', show)

    for (const ev of ['dragenter', 'dragover']) {
      label.addEventListener(ev, (e) => {
        e.preventDefault()
        label.dataset.drag = 'true'
      })
    }
    label.addEventListener('dragleave', (e) => {
      if (label.contains(e.relatedTarget as Node)) return
      label.dataset.drag = 'false'
    })
    label.addEventListener('drop', (e: DragEvent) => {
      e.preventDefault()
      label.dataset.drag = 'false'
      if (e.dataTransfer?.files?.length) {
        input.files = e.dataTransfer.files
        input.dispatchEvent(new Event('change', { bubbles: true }))
      }
    })
  })
</script>
