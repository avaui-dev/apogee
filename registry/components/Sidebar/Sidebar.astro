---
/**
 * Sidebar — a vertical navigation aside. Sticky, full-height on desktop; the nav
 * collapses behind a toggle on mobile (one small island, same pattern as Navbar).
 * Without JS the toggle is hidden and the nav + footer stay expanded (`no-js:`),
 * so nothing is unreachable. On mobile with JS, opening the nav also reveals the
 * footer. Slots: `brand` (top), default (nav links — use NavLink or <a>), `footer`.
 */
import type { HTMLAttributes } from 'astro/types'
import { uid } from '../utils/uid.ts'
import { Menu } from '@lucide/astro'

/** @composable */
interface Props extends HTMLAttributes<'div'> {
  class?: string
}

const { class: className, ...rest } = Astro.props
const navId = uid(Astro.locals, 'apogee-sidebar')
---

<aside
  class:list={[
    'apogee-sidebar w-full border-neutral bg-page md:sticky md:top-0 md:h-dvh md:w-64 md:shrink-0 md:border-e',
    className,
  ]}
  {...rest}
>
  <div class="flex items-center justify-between gap-4 border-b border-neutral p-4 md:border-0">
    <slot name="brand" />
    <button
      type="button"
      class="apogee-sidebar-toggle grid size-9 place-items-center rounded-md text-neutral transition-colors hover:bg-neutral-faded-highlighted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary no-js:hidden md:hidden"
      aria-controls={navId}
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <Menu class="size-5" aria-hidden="true" />
    </button>
  </div>

  <nav id={navId} class="apogee-sidebar-nav flex-col gap-0.5 p-4 pt-0 no-js:flex md:pt-4">
    <slot />
  </nav>

  <div class="apogee-sidebar-footer mt-auto border-t border-neutral p-4 no-js:block">
    <slot name="footer" />
  </div>
</aside>

<style>
  /* Desktop: a flex column so `footer` can push to the bottom (mt-auto). */
  @media (min-width: 768px) {
    .apogee-sidebar {
      display: flex;
      flex-direction: column;
    }
  }
  /* Nav: collapsed on mobile, a flex column when open, always shown on desktop. */
  .apogee-sidebar-nav {
    display: none;
  }
  .apogee-sidebar-nav[data-open='true'] {
    display: flex;
  }
  /* Footer: hidden on mobile until the nav is opened; always shown on desktop. */
  .apogee-sidebar-footer {
    display: none;
  }
  .apogee-sidebar-nav[data-open='true'] ~ .apogee-sidebar-footer {
    display: block;
  }
  @media (min-width: 768px) {
    .apogee-sidebar-nav,
    .apogee-sidebar-footer {
      display: flex;
    }
    .apogee-sidebar-footer {
      display: block;
    }
  }
</style>

<script>
  import { island } from '../utils/island.ts'

  island('.apogee-sidebar-toggle', (toggle) => {
    const id = toggle.getAttribute('aria-controls')
    const nav = id ? document.getElementById(id) : null
    if (!nav) return
    toggle.addEventListener('click', () => {
      const open = nav.dataset.open !== 'true'
      nav.dataset.open = String(open)
      toggle.setAttribute('aria-expanded', String(open))
    })
  })
</script>
