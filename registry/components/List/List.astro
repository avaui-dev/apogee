---
/**
 * List — a styled ordered or unordered list. Put `<li>`s in the slot.
 */
import type { HTMLAttributes } from 'astro/types'
/**
 * @composable
 * @children li
 */
interface Props extends Omit<HTMLAttributes<'ul'>, 'as'> {
  as?: 'ul' | 'ol'
  /** `none` drops the marker and indent. */
  marker?: 'default' | 'none'
  class?: string
}

const { as = 'ul', marker = 'default', class: className, ...rest } = Astro.props
const Tag = as

const markerClass =
  marker === 'none'
    ? 'list-none'
    : `${as === 'ol' ? 'list-decimal' : 'list-disc'} ps-5 marker:text-neutral-faded`
---

<Tag class:list={['space-y-1', markerClass, className]} {...rest}>
  <slot />
</Tag>
