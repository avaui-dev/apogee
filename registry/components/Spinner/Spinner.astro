---
/**
 * Spinner — a loading indicator. Inherits `currentColor`.
 *
 * @composable
 */
interface Props {
  size?: 'sm' | 'md' | 'lg'
  /** Accessible label. */
  label?: string
  class?: string
}

const { size = 'md', label = 'Loading', class: className, ...rest } = Astro.props
const sizeMap = { sm: 'size-4', md: 'size-5', lg: 'size-8' }
---

<svg
  class:list={['animate-spin text-current', sizeMap[size], className]}
  viewBox="0 0 24 24"
  fill="none"
  role="status"
  aria-label={label}
  {...rest}
>
  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.4 0 0 5.4 0 12h4z" />
</svg>
