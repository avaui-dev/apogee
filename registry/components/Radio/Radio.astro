---
/**
 * Radio — a native radio with a custom look. The real `<input>` is styled
 * directly (`appearance: none`), so it stays the actual control. Give every
 * radio in a group the same `name`.
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'
import { uid } from '../utils/uid.ts'
interface Props extends HTMLAttributes<'input'> {
  id?: string
  label?: string
  /** Supporting text under the label, read as the control's description. @category content */
  hint?: string
  name: string
  value: string
  /** @category layout */
  size?: 'small' | 'medium' | 'large'
  /** Marks the control invalid. */
  hasError?: boolean
  class?: string
}

const { id: idProp, label, hint, size = 'medium', hasError = false, class: className, ...rest } = Astro.props
const hasLabel = Boolean(label) || Astro.slots.has('default')
const sizes = { small: 'size-3.5', medium: 'size-4', large: 'size-5' } as const
const labelSizes = { small: 'text-xs', medium: 'text-sm', large: 'text-base' } as const
const id = idProp ?? uid(Astro.locals)
---

<label for={id} class:list={['group flex items-start gap-2', className]}>
  <input
    id={id}
    type="radio"
    class:list={['apogee-radio', sizes[size]]}
    aria-invalid={hasError ? 'true' : undefined}
    aria-describedby={hint ? `${id}-hint` : undefined}
    {...rest}
  />
  {
    hasLabel && (
      <span class="flex flex-col gap-0.5">
        <span class:list={[labelSizes[size], 'text-neutral group-has-[:disabled]:text-disabled', hint && 'font-medium']}>{label ?? <slot />}</span>
        {hint && <span id={`${id}-hint`} class:list={[labelSizes[size], 'text-neutral-faded group-has-[:disabled]:text-disabled']}>{hint}</span>}
      </span>
    )
  }
</label>

<style>
  .apogee-radio {
    appearance: none;
    -webkit-appearance: none;
    margin-top: 0.125rem;
    flex-shrink: 0;
    border: 1.5px solid var(--border-neutral);
    border-radius: 9999px;
    background-color: var(--background-page);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }
  .apogee-radio:hover:not(:checked):not(:disabled) {
    border-color: var(--foreground-neutral-faded);
  }
  .apogee-radio {
    box-shadow: var(--shadow-field);
  }
  .apogee-radio:checked {
    box-shadow: var(--shadow-control);
    background-image: var(--gradient-control);
  }
  .apogee-radio:checked {
    border-color: var(--background-primary);
    background-color: var(--background-primary);
    background-image: radial-gradient(circle at center, var(--on-primary) 0 32%, transparent 36%);
  }
  .apogee-radio[aria-invalid='true'] {
    border-color: var(--border-critical);
  }
  .apogee-radio:focus-visible {
    outline: 2px solid var(--outline-color-focus);
    outline-offset: 2px;
  }
  /* Disabled reads the disabled tokens (checked or not), never a faded opacity. */
  .apogee-radio:disabled,
  .apogee-radio:disabled:checked {
    border-color: var(--border-disabled);
    background-color: var(--background-disabled);
    box-shadow: none;
    cursor: not-allowed;
  }
  .apogee-radio:checked:disabled {
    background-image: radial-gradient(circle at center, var(--foreground-disabled) 0 32%, transparent 36%);
  }
  @media (prefers-reduced-motion: reduce) {
    .apogee-radio {
      transition: none;
    }
  }
</style>
