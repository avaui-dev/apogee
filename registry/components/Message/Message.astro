---
/**
 * Message — one chat message: sender, time, a bubble, and optional reply
 * quote, link preview, attachment, reactions and delivery status. Zero JS.
 * Your own messages (`me`) sit at the end with the bubble in the primary hue.
 * Put Messages in an `<ol aria-label="Conversation">`; `typing` shows the
 * three-dot indicator instead of text.
 *
 * Slots: `avatar`, default (text), `reply`, `preview`, `attachment`, `reactions`.
 */
import type { HTMLAttributes } from 'astro/types'
import { Check, CheckCheck, CircleAlert } from '@lucide/astro'

/** @composable */
interface Props extends HTMLAttributes<'li'> {
  /** @category content */
  name?: string
  /** Shown time, e.g. "9:41". @category content */
  time?: string
  /** Machine-readable time for `<time datetime>`. */
  datetime?: string
  /** Your own message: aligned to the end, primary bubble. */
  me?: boolean
  status?: 'sent' | 'read' | 'failed'
  /** Show the typing indicator instead of the text. */
  typing?: boolean
  /** `li` inside a conversation list, `div` on its own. */
  as?: 'li' | 'div'
  class?: string
}

const { name, time, datetime, me = false, status, typing = false, as: Tag = 'li', class: className, ...rest } = Astro.props
const statuses = {
  sent: { Icon: Check, text: 'Sent', cls: 'text-neutral-faded' },
  read: { Icon: CheckCheck, text: 'Read', cls: 'text-primary' },
  failed: { Icon: CircleAlert, text: 'Failed to send', cls: 'text-critical' },
} as const
const st = status ? statuses[status] : undefined
const has = (n: string) => Astro.slots.has(n)
---

<Tag class:list={['apogee-message flex items-end gap-3', me && 'flex-row-reverse', className]} data-me={me ? 'true' : undefined} {...rest}>
  {has('avatar') && <div class="shrink-0"><slot name="avatar" /></div>}
  <article class:list={['flex min-w-0 max-w-prose flex-col gap-1', me && 'items-end']}>
    {
      (name || time) && (
        <header class="flex items-baseline gap-2 text-xs">
          {name && <cite class="font-medium text-neutral not-italic">{name}</cite>}
          {time && (
            <time datetime={datetime} class="text-neutral-faded tabular-nums">
              {time}
            </time>
          )}
        </header>
      )
    }
    <div
      class:list={[
        'apogee-message-bubble rounded-lg px-3 py-2 text-sm',
        me ? 'rounded-se-none bg-primary text-on-primary' : 'rounded-ss-none bg-neutral-faded text-neutral',
      ]}
      aria-label={typing ? `${name ?? 'Someone'} is typing` : undefined}
      role={typing ? 'img' : undefined}
    >
      {
        typing ? (
          <span class="flex h-5 items-center gap-1" aria-hidden="true">
            <span class="apogee-message-dot size-1.5 rounded-full bg-current" />
            <span class="apogee-message-dot size-1.5 rounded-full bg-current" />
            <span class="apogee-message-dot size-1.5 rounded-full bg-current" />
          </span>
        ) : (
          <>
            {has('reply') && (
              <blockquote
                class:list={[
                  'apogee-message-reply mb-1.5 border-s-[3px] ps-2 text-xs',
                  me ? 'border-(--on-primary)/60' : 'border-primary text-neutral-faded',
                ]}
              >
                <slot name="reply" />
              </blockquote>
            )}
            <slot />
            {has('preview') && (
              <aside class="mt-2 rounded-md border border-neutral bg-page p-2 text-xs text-neutral">
                <slot name="preview" />
              </aside>
            )}
            {has('attachment') && (
              <figure class="mt-2">
                <slot name="attachment" />
              </figure>
            )}
          </>
        )
      }
    </div>
    {has('reactions') && <div class="flex flex-wrap gap-1 text-xs"><slot name="reactions" /></div>}
    {
      st && (
        <p class:list={['apogee-message-status flex items-center gap-1 text-xs', st.cls]}>
          <st.Icon class="size-3.5" aria-hidden="true" />
          <span class:list={[status !== 'failed' && 'sr-only']}>{st.text}</span>
        </p>
      )
    }
  </article>
</Tag>

<style>
  .apogee-message-dot {
    /* One cycle is three slow steps; the dots start a fast step apart. */
    animation: apogee-typing calc(var(--duration-slow) * 3) var(--ease-standard) infinite;
  }
  .apogee-message-dot:nth-child(2) {
    animation-delay: var(--duration-fast);
  }
  .apogee-message-dot:nth-child(3) {
    animation-delay: calc(var(--duration-fast) * 2);
  }
  @keyframes apogee-typing {
    0%,
    60%,
    100% {
      opacity: 0.35;
      translate: 0 0;
    }
    30% {
      opacity: 1;
      translate: 0 -2px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .apogee-message-dot {
      animation: none;
      opacity: 0.6;
    }
  }
</style>
