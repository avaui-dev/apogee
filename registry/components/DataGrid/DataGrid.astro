---
/**
 * DataGrid — a data table with client-side column sorting and optional row
 * selection. Renders sorted-as-given with zero JS; sort buttons and select-all
 * are a progressive-enhancement island. For a plain static table use Table.
 *
 * Numbers sort numerically; everything else sorts as text. `selectable` adds a
 * checkbox column with an indeterminate "select all".
 *
 * @composable
 */
import { ChevronsUpDown, ChevronUp, ChevronDown } from '@lucide/astro'
import Checkbox from '../Checkbox/Checkbox.astro'

interface Column {
  key: string
  label: string
  sortable?: boolean
  align?: 'left' | 'right' | 'center'
}
interface Props {
  columns: Column[]
  rows: Record<string, any>[]
  selectable?: boolean
  class?: string
}

const { columns, rows, selectable = false, class: className, ...rest } = Astro.props

const alignMap = { left: 'text-left', right: 'text-right', center: 'text-center' }
const cellAlign = (c: Column) => alignMap[c.align ?? 'left']
---

<div class:list={['apogee-datagrid overflow-x-auto rounded-lg border border-border', className]} {...rest}>
  <table class="w-full text-sm">
    <thead class="border-b border-border bg-muted/40">
      <tr>
        {selectable && (
          <th class="w-10 px-3 py-2">
            <Checkbox data-datagrid-all aria-label="Select all" />
          </th>
        )}
        {
          columns.map((col) => (
            <th
              class:list={['px-3 py-2 text-xs font-medium tracking-wide text-muted-foreground uppercase', cellAlign(col)]}
              data-key={col.key}
              aria-sort="none"
            >
              {col.sortable ? (
                <button
                  type="button"
                  class="apogee-datagrid-sort inline-flex items-center gap-1 transition-colors hover:text-foreground"
                  data-key={col.key}
                  data-sort="none"
                >
                  {col.label}
                  <ChevronsUpDown class="apogee-dg-none size-3.5" aria-hidden="true" />
                  <ChevronUp class="apogee-dg-asc size-3.5" aria-hidden="true" />
                  <ChevronDown class="apogee-dg-desc size-3.5" aria-hidden="true" />
                </button>
              ) : (
                col.label
              )}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody class="divide-y divide-border">
      {
        rows.map((row) => (
          <tr class="[&:has(:checked)]:bg-muted/40">
            {selectable && (
              <td class="px-3 py-2">
                <Checkbox data-datagrid-row aria-label="Select row" />
              </td>
            )}
            {columns.map((col) => (
              <td
                class:list={['px-3 py-2 text-foreground', cellAlign(col), typeof row[col.key] === 'number' && 'tabular-nums']}
                data-key={col.key}
                data-value={String(row[col.key] ?? '')}
              >
                {row[col.key]}
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  /* Directional sort indicator, driven by the button's data-sort. */
  .apogee-dg-asc,
  .apogee-dg-desc {
    display: none;
  }
  .apogee-datagrid-sort[data-sort='ascending'] .apogee-dg-none,
  .apogee-datagrid-sort[data-sort='descending'] .apogee-dg-none {
    display: none;
  }
  .apogee-datagrid-sort[data-sort='ascending'] .apogee-dg-asc,
  .apogee-datagrid-sort[data-sort='descending'] .apogee-dg-desc {
    display: inline;
  }
</style>

<script>
  for (const grid of document.querySelectorAll<HTMLElement>('.apogee-datagrid')) {
    const tbody = grid.querySelector<HTMLElement>('tbody')
    if (!tbody) continue

    // Sorting.
    for (const btn of grid.querySelectorAll<HTMLButtonElement>('.apogee-datagrid-sort')) {
      btn.addEventListener('click', () => {
        const key = btn.dataset.key!
        const th = btn.closest('th')!
        const dir = th.getAttribute('aria-sort') === 'ascending' ? 'descending' : 'ascending'

        for (const h of grid.querySelectorAll('th')) h.setAttribute('aria-sort', 'none')
        for (const b of grid.querySelectorAll<HTMLElement>('.apogee-datagrid-sort')) (b.dataset.sort = 'none')
        th.setAttribute('aria-sort', dir)
        btn.dataset.sort = dir

        const rows = [...tbody.querySelectorAll('tr')]
        rows.sort((a, b) => {
          const av = a.querySelector<HTMLElement>(`td[data-key="${key}"]`)?.dataset.value ?? ''
          const bv = b.querySelector<HTMLElement>(`td[data-key="${key}"]`)?.dataset.value ?? ''
          const na = parseFloat(av)
          const nb = parseFloat(bv)
          const cmp = !isNaN(na) && !isNaN(nb) ? na - nb : av.localeCompare(bv)
          return dir === 'ascending' ? cmp : -cmp
        })
        for (const r of rows) tbody.appendChild(r)
      })
    }

    // Row selection with an indeterminate select-all.
    const all = grid.querySelector<HTMLInputElement>('[data-datagrid-all]')
    const boxes = () => [...grid.querySelectorAll<HTMLInputElement>('[data-datagrid-row]')]
    all?.addEventListener('change', () => {
      for (const b of boxes()) b.checked = all.checked
      all.indeterminate = false
    })
    grid.addEventListener('change', (e) => {
      if (!(e.target as HTMLElement).matches('[data-datagrid-row]')) return
      const bs = boxes()
      const checked = bs.filter((b) => b.checked).length
      if (all) {
        all.checked = checked === bs.length
        all.indeterminate = checked > 0 && checked < bs.length
      }
    })
  }
</script>
