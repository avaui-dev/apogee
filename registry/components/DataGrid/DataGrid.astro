---
/**
 * DataGrid — a data table with client-side column sorting and optional row
 * selection. Renders sorted-as-given with zero JS; sort buttons and select-all
 * are a progressive-enhancement island. For a plain static table use Table.
 *
 * Numbers sort numerically; everything else sorts as text. `selectable` adds a
 * checkbox column with an indeterminate "select all".
 */
import type { HTMLAttributes } from 'astro/types'
import { ChevronsUpDown, ChevronUp, ChevronDown } from '@lucide/astro'
import Checkbox from '../Checkbox/Checkbox.astro'

interface Column {
  key: string
  label: string
  sortable?: boolean
  align?: 'start' | 'end' | 'center'
}
/** @composable */
interface Props extends HTMLAttributes<'div'> {
  /** Header text style. @category layout */
  headerStyle?: 'normal' | 'caps'
  columns: Column[]
  rows: Record<string, any>[]
  selectable?: boolean
  /** Cell padding. @category layout */
  size?: 'small' | 'medium'
  /** Alternate row fills. @category layout */
  striped?: boolean
  class?: string
}

const { headerStyle = 'normal', columns, rows, selectable = false, size = 'small', striped = false, class: className, ...rest } = Astro.props
const pad = size === 'medium' ? 'px-4 py-3' : 'px-3 py-2'

const alignMap = { start: 'text-start', end: 'text-end', center: 'text-center' }
const cellAlign = (c: Column) => alignMap[c.align ?? 'start']
---

<div class:list={['apogee-datagrid overflow-x-auto rounded-lg border border-neutral', className]} {...rest}>
  <table class="w-full text-sm">
    <thead class="border-b border-neutral bg-neutral-faded">
      <tr>
        {selectable && (
          <th class:list={['w-10', pad]}>
            <span class="no-js:hidden"><Checkbox data-all aria-label="Select all" /></span>
          </th>
        )}
        {
          columns.map((col) => (
            <th
              class:list={[pad, headerStyle === 'caps' ? 'text-xs font-medium tracking-wide text-neutral-faded uppercase' : 'text-sm font-semibold text-neutral normal-case', cellAlign(col)]}
              data-key={col.key}
              aria-sort="none"
            >
              {col.sortable ? (
                <>
                  <button
                    type="button"
                    class="apogee-datagrid-sort inline-flex items-center gap-1 transition-colors no-js:hidden hover:text-neutral"
                    data-sort="none"
                  >
                    {col.label}
                    <ChevronsUpDown class="apogee-dg-none size-3.5" aria-hidden="true" />
                    <ChevronUp class="apogee-dg-asc size-3.5" aria-hidden="true" />
                    <ChevronDown class="apogee-dg-desc size-3.5" aria-hidden="true" />
                  </button>
                  <span class="hidden no-js:inline">{col.label}</span>
                </>
              ) : (
                col.label
              )}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody class:list={['divide-y divide-neutral', striped && '[&>tr:nth-child(even)]:bg-neutral-faded']}>
      {
        rows.map((row) => (
          <tr class="[&:has(:checked)]:bg-neutral-faded">
            {selectable && (
              <td class={pad}>
                <Checkbox data-row aria-label="Select row" />
              </td>
            )}
            {columns.map((col) => (
              <td
                class:list={[pad, 'text-neutral', cellAlign(col), typeof row[col.key] === 'number' && 'tabular-nums']}
                data-key={col.key}
                data-value={String(row[col.key] ?? '')}
              >
                {row[col.key]}
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  /* Directional sort indicator, driven by the button's data-sort. */
  .apogee-dg-asc,
  .apogee-dg-desc {
    display: none;
  }
  .apogee-datagrid-sort[data-sort='ascending'] .apogee-dg-none,
  .apogee-datagrid-sort[data-sort='descending'] .apogee-dg-none {
    display: none;
  }
  .apogee-datagrid-sort[data-sort='ascending'] .apogee-dg-asc,
  .apogee-datagrid-sort[data-sort='descending'] .apogee-dg-desc {
    display: inline;
  }
</style>

<script>
  import { island } from '../utils/island.ts'
  import { enhanceTable } from '../utils/table-enhance.ts'

  island('.apogee-datagrid', enhanceTable)
</script>
