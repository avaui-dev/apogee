---
/**
 * Button — the Apogee action control. Renders a <button>, or an <a> when `href`
 * is set. `color` is the hue, `variant` is the fill style, `size` the height.
 * Icons go in the `start` / `end` slots; `iconOnly` makes a square button
 * (pass an `aria-label`). `class` is appended last, so a consumer utility wins
 * only when it is more specific or later in the stylesheet; there is no class
 * merging.
 */
import type { HTMLAttributes } from 'astro/types'
import Spinner from '../Spinner/Spinner.astro'
import {
  buttonSizes,
  iconOnlySizes,
  buttonStyles,
  type ButtonColor,
  type ButtonVariant,
  type ButtonSize,
} from './button.ts'

/** @composable */
interface Props extends Omit<HTMLAttributes<'button'>, 'type'> {
  /** Hue. @category layout */
  color?: ButtonColor
  /** Fill style. @category layout */
  variant?: ButtonVariant
  /** Height scale. @category layout */
  size?: ButtonSize
  /** Fully round ends. @category layout */
  rounded?: boolean
  /** Adds the raised shadow. @category layout */
  raised?: boolean
  /** Stretches to the container width. @category layout */
  fullWidth?: boolean
  /** Square, icon-only button; give it an `aria-label`. @category layout */
  iconOnly?: boolean
  /** Renders an <a> to this URL instead of a <button>. @category content */
  href?: string
  /** Native button type (ignored with `href`). */
  type?: 'button' | 'submit' | 'reset'
  /** Shows a spinner and blocks interaction. */
  loading?: boolean
  disabled?: boolean
  /** Invoker command for a Dialog or popover target. */
  command?: 'show-modal' | 'close' | 'request-close' | 'show-popover' | 'hide-popover' | 'toggle-popover' | (string & {})
  /** Id of the element the command targets. */
  commandfor?: string
  class?: string
}

const {
  color = 'primary',
  variant = 'solid',
  size = 'medium',
  rounded = false,
  raised = false,
  fullWidth = false,
  iconOnly = false,
  href,
  type = 'button',
  loading = false,
  disabled = false,
  class: className,
  ...rest
} = Astro.props

const Tag = href ? 'a' : 'button'
const isDisabled = disabled || loading

const base =
  'inline-flex items-center justify-center whitespace-nowrap font-medium transition ' +
  'active:scale-[0.985] motion-reduce:active:scale-100 ' +
  'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary ' +
  'disabled:pointer-events-none disabled:bg-disabled disabled:text-disabled disabled:border-disabled disabled:shadow-none ' +
  'aria-disabled:pointer-events-none aria-disabled:bg-disabled aria-disabled:text-disabled ' +
  '[&_svg]:size-4 [&_svg]:shrink-0'

// Icon-only keeps the size's text/gap/radius but swaps padding + height for a square.
const sizeClasses = iconOnly
  ? [iconOnlySizes[size], 'p-0', buttonSizes[size].replace(/\b(px|h)-\S+/g, '')]
  : buttonSizes[size]
---

<Tag
  class:list={[
    base,
    buttonStyles[variant][color],
    sizeClasses,
    rounded && 'rounded-full',
    raised && 'shadow-raised',
    fullWidth && 'w-full',
    className,
  ]}
  href={Tag === 'a' ? (isDisabled ? undefined : href) : undefined}
  type={Tag === 'button' ? type : undefined}
  disabled={Tag === 'button' ? isDisabled : undefined}
  aria-disabled={Tag === 'a' && isDisabled ? 'true' : undefined}
  aria-busy={loading ? 'true' : undefined}
  {...rest}
>
  {loading ? <Spinner size={size === 'small' ? 'small' : 'medium'} /> : <slot name="start" />}
  <slot />
  <slot name="end" />
</Tag>
