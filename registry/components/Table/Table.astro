---
/**
 * Table — a styled, horizontally-scrollable table. Write a plain
 * `<thead>`/`<tbody>` with `<tr>`/`<th>`/`<td>` inside; the styling is applied
 * via descendant selectors. Zero JS.
 *
 * @composable
 */
interface Props {
  class?: string
}

const { class: className, ...rest } = Astro.props
---

<div class="w-full overflow-x-auto">
  <table
    class:list={[
      'w-full border-collapse text-left text-sm tabular-nums',
      '[&_th]:px-3 [&_th]:py-2.5 [&_th]:font-medium [&_th]:text-muted-foreground',
      '[&_td]:border-t [&_td]:border-border [&_td]:px-3 [&_td]:py-2.5 [&_td]:text-foreground',
      '[&_thead_th]:border-b [&_thead_th]:border-border',
      '[&_tbody_tr:hover]:bg-muted/40',
      className,
    ]}
    {...rest}
  >
    <slot />
  </table>
</div>
