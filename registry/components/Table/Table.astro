---
/**
 * Table — a styled, horizontally-scrollable table. Write a plain
 * `<thead>`/`<tbody>` with `<tr>`/`<th>`/`<td>` inside; the styling is applied
 * via descendant selectors. Zero JS.
 *
 * @composable
 */
interface Props {
  class?: string
}

const { class: className, ...rest } = Astro.props
---

<div class="w-full overflow-x-auto">
  <table
    class:list={[
      'apogee-table w-full border-collapse text-start text-sm tabular-nums',
      '[&_th]:px-3 [&_th]:py-2.5 [&_th]:font-semibold [&_th]:text-foreground',
      '[&_td]:border-t [&_td]:border-border [&_td]:px-3 [&_td]:py-2.5 [&_td]:text-foreground',
      '[&_thead_th]:border-b [&_thead_th]:border-border',
      '[&_tbody_tr:hover]:bg-muted/40',
      className,
    ]}
    {...rest}
  >
    <slot />
  </table>
</div>

<style is:global>
  @layer components {
    /* Cells default to start-aligned — including th, which the browser centers.
       In @layer components so a `text-end` / `text-center` utility on any cell
       still wins (optional, per-cell). */
    .apogee-table :where(th, td) {
      text-align: start;
    }
  }
</style>
