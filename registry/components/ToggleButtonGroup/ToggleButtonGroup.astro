---
/**
 * ToggleButtonGroup — connects ToggleButtons into a segmented bar. `single`
 * makes them mutually exclusive (one or none pressed); `multiple` lets each
 * toggle independently. Put ToggleButtons in the slot. Roving tabindex: one tab
 * stop, arrows and Home/End move focus. Dispatches `apogee:toggle-group-change`
 * with `detail: { value: string[] }` — each pressed button's `value`, or its
 * index. A button's hidden input (`name` + `value`) follows its pressed state.
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'
interface Props extends Omit<HTMLAttributes<'fieldset'>, 'type'> {
  type?: 'single' | 'multiple'
  /** Disables every button inside (native fieldset behaviour, no JS). */
  disabled?: boolean
  'aria-label'?: string
  class?: string
}

const { type = 'multiple', disabled = false, class: className, ...rest } = Astro.props
---

<fieldset
  role="group"
  data-type={type}
  disabled={disabled || undefined}
  class:list={[
    'apogee-toggle-group m-0 min-w-0 [&_.apogee-toggle]:relative [&_.apogee-toggle:focus-visible]:z-10 inline-flex flex-wrap items-center gap-0.5 rounded-md border border-neutral bg-page p-0.5 [&_.apogee-toggle]:rounded-[calc(var(--radius-md)-0.125rem)]',
    className,
  ]}
  {...rest}
>
  <slot />
</fieldset>

<script>
  import { island } from '../utils/island.ts'
  import { rovingTabindex } from '../utils/roving.ts'

  island('.apogee-toggle-group', (g) => {
    const btns = [...g.querySelectorAll<HTMLButtonElement>('.apogee-toggle:not(:disabled)')]
    if (!btns.length) return
    const single = g.dataset.type === 'single'
    const press = (b: HTMLButtonElement, on: boolean) => {
      b.setAttribute('aria-pressed', String(on))
      for (const it of b.querySelectorAll<HTMLElement>('[data-apogee-icon-toggle]')) it.dataset.on = String(on)
      const hidden = b.nextElementSibling
      if (hidden instanceof HTMLInputElement && hidden.type === 'hidden') hidden.disabled = !on
    }
    const value = () =>
      btns.filter((o) => o.getAttribute('aria-pressed') === 'true').map((o) => o.value || String(btns.indexOf(o)))
    rovingTabindex(g, { selector: '.apogee-toggle' })

    for (const b of btns) {
      b.addEventListener('click', () => {
        if (single) for (const o of btns) if (o !== b) press(o, false)
        // After the button's own toggle (same tick, registered earlier) report the group's state.
        queueMicrotask(() =>
          g.dispatchEvent(new CustomEvent('apogee:toggle-group-change', { bubbles: true, detail: { value: value() } })),
        )
      })
    }
  })
</script>
