---
/**
 * ToggleButtonGroup — connects ToggleButtons into a segmented bar. `single`
 * makes them mutually exclusive (one or none pressed); `multiple` lets each
 * toggle independently. Put ToggleButtons in the slot. Roving tabindex: one tab
 * stop, arrows and Home/End move focus. Dispatches `apogee:toggle-group-change`
 * with `detail: { value: string[] }` — each pressed button's `value`, or its
 * index. A button's hidden input (`name` + `value`) follows its pressed state.
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'
interface Props extends Omit<HTMLAttributes<'div'>, 'type'> {
  type?: 'single' | 'multiple'
  'aria-label'?: string
  class?: string
}

const { type = 'multiple', class: className, ...rest } = Astro.props
---

<div
  role="group"
  data-type={type}
  class:list={[
    'apogee-toggle-group inline-flex flex-wrap items-center gap-0.5 rounded-md border border-neutral bg-page p-0.5 [&>.apogee-toggle]:rounded-[calc(var(--radius-md)-0.125rem)]',
    className,
  ]}
  {...rest}
>
  <slot />
</div>

<script>
  import { island } from '../utils/island.ts'
  import { stepIndex } from '../utils/roving.ts'

  island('.apogee-toggle-group', (g) => {
    const btns = [...g.querySelectorAll<HTMLButtonElement>('.apogee-toggle')]
    if (!btns.length) return
    const single = g.dataset.type === 'single'
    const press = (b: HTMLButtonElement, on: boolean) => {
      b.setAttribute('aria-pressed', String(on))
      const hidden = b.nextElementSibling
      if (hidden instanceof HTMLInputElement && hidden.type === 'hidden') hidden.disabled = !on
    }
    const value = () =>
      btns.filter((o) => o.getAttribute('aria-pressed') === 'true').map((o) => o.value || String(btns.indexOf(o)))
    const enabled = () => btns.filter((b) => !b.disabled)

    // Roving tabindex: one tab stop (the first pressed button, else the first), arrows move it.
    const rove = (target: HTMLButtonElement) => {
      for (const b of btns) b.tabIndex = b === target ? 0 : -1
    }
    rove(enabled().find((b) => b.getAttribute('aria-pressed') === 'true') ?? enabled()[0] ?? btns[0]!)
    g.addEventListener('keydown', (e) => {
      const list = enabled()
      const i = list.indexOf(document.activeElement as HTMLButtonElement)
      if (i < 0) return
      const n = stepIndex(e.key, i, list.length - 1, getComputedStyle(g).direction === 'rtl')
      if (n === null) return
      e.preventDefault()
      rove(list[n]!)
      list[n]!.focus()
    })

    for (const b of btns) {
      b.addEventListener('focus', () => rove(b))
      b.addEventListener('click', () => {
        if (single) for (const o of btns) if (o !== b) press(o, false)
        // After the button's own toggle (same tick, registered earlier) report the group's state.
        queueMicrotask(() =>
          g.dispatchEvent(new CustomEvent('apogee:toggle-group-change', { bubbles: true, detail: { value: value() } })),
        )
      })
    }
  })
</script>
