---
/**
 * ToggleButtonGroup — connects ToggleButtons into a segmented bar. `single`
 * makes them mutually exclusive (radio-like: one or none pressed); `multiple`
 * lets each toggle independently. Put ToggleButtons in the slot.
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'
interface Props extends Omit<HTMLAttributes<'div'>, 'type'> {
  type?: 'single' | 'multiple'
  'aria-label'?: string
  class?: string
}

const { type = 'multiple', class: className, ...rest } = Astro.props
---

<div
  role="group"
  data-type={type}
  class:list={[
    'apogee-toggle-group inline-flex flex-wrap items-center gap-0.5 rounded-md border border-neutral bg-page p-0.5 [&>.apogee-toggle]:rounded-[calc(var(--radius-md)-0.125rem)]',
    className,
  ]}
  {...rest}
>
  <slot />
</div>

<script>
  import { island } from '../utils/island.ts'

  // Single-select: clicking one un-presses its siblings (each button still
  // self-toggles, so clicking the active one clears the group).
  island('.apogee-toggle-group', (g) => {
    const btns = [...g.querySelectorAll<HTMLButtonElement>('.apogee-toggle')]
    const single = g.dataset.type === 'single'
    for (const b of btns) {
      b.addEventListener('click', () => {
        if (single) for (const o of btns) if (o !== b) o.setAttribute('aria-pressed', 'false')
        // After the button's own toggle (same tick, registered earlier) report the group's state.
        queueMicrotask(() => {
          const pressed = btns.filter((o) => o.getAttribute('aria-pressed') === 'true').map((o) => o.dataset.value ?? String(btns.indexOf(o)))
          g.dispatchEvent(new CustomEvent('apogee:toggle-group-change', { bubbles: true, detail: { pressed } }))
        })
      })
    }
  })
</script>
