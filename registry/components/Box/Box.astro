---
/**
 * Box — the layout primitive: flex direction, gap, padding, surface, border,
 * radius and shadow as props, each a token. Sections and app layouts compose
 * Boxes instead of ad-hoc wrapper divs. The flex props accept per-breakpoint
 * objects: `direction={{ base: 'column', md: 'row' }}`.
 */
import type { HTMLAttributes } from 'astro/types'
import { responsive, type Responsive } from '../utils/responsive.ts'
import { tables } from '../utils/responsive-tables.ts'

const pads = { 0: 'p-0', 1: 'p-1', 2: 'p-2', 3: 'p-3', 4: 'p-4', 5: 'p-5', 6: 'p-6', 8: 'p-8', 10: 'p-10', 12: 'p-12' } as const
const padsInline = { 0: 'px-0', 1: 'px-1', 2: 'px-2', 3: 'px-3', 4: 'px-4', 5: 'px-5', 6: 'px-6', 8: 'px-8', 10: 'px-10', 12: 'px-12' } as const
const padsBlock = { 0: 'py-0', 1: 'py-1', 2: 'py-2', 3: 'py-3', 4: 'py-4', 5: 'py-5', 6: 'py-6', 8: 'py-8', 10: 'py-10', 12: 'py-12' } as const
const bleeds = { 2: '-mx-2', 4: '-mx-4', 6: '-mx-6', 8: '-mx-8' } as const
const backgrounds = {
  page: 'bg-page', 'page-faded': 'bg-page-faded', neutral: 'bg-neutral', 'neutral-faded': 'bg-neutral-faded',
  primary: 'bg-primary text-on-primary', 'primary-faded': 'bg-primary-faded',
  critical: 'bg-critical text-on-critical', 'critical-faded': 'bg-critical-faded',
  positive: 'bg-positive text-on-positive', 'positive-faded': 'bg-positive-faded',
  warning: 'bg-warning text-on-warning', 'warning-faded': 'bg-warning-faded',
  'elevation-base': 'bg-elevation-base', 'elevation-raised': 'bg-elevation-raised', 'elevation-overlay': 'bg-elevation-overlay',
  inverted: 'bg-inverted text-on-inverted',
} as const
const borders = {
  neutral: 'border border-neutral', 'neutral-faded': 'border border-neutral-faded', primary: 'border border-primary',
  critical: 'border border-critical', positive: 'border border-positive', warning: 'border border-warning', transparent: 'border border-transparent',
} as const
const radii = { sm: 'rounded-sm', md: 'rounded-md', lg: 'rounded-lg', xl: 'rounded-xl', full: 'rounded-full' } as const
const shadows = { outline: 'shadow-outline', raised: 'shadow-raised', overlay: 'shadow-overlay' } as const

type Direction = keyof typeof tables.direction.base
type Gap = keyof typeof tables.gap.base
type Align = keyof typeof tables.align.base
type Justify = keyof typeof tables.justify.base

/** @composable */
interface Props extends Omit<HTMLAttributes<'div'>, 'align' | 'border' | 'width'> {
  as?: string
  /** @category layout */ direction?: Responsive<Direction>
  /** @category layout */ gap?: Responsive<Gap>
  /** @category layout */ align?: Responsive<Align>
  /** @category layout */ justify?: Responsive<Justify>
  /** @category layout */ wrap?: Responsive<boolean>
  /** Hairline between children, following `direction` at every breakpoint. @category layout */ divided?: boolean
  /** @category layout */ padding?: keyof typeof pads
  /** @category layout */ paddingInline?: keyof typeof padsInline
  /** @category layout */ paddingBlock?: keyof typeof padsBlock
  /** Negative inline margin, for edge-to-edge children inside a padded parent. @category layout */ bleed?: keyof typeof bleeds
  /** @category layout */ background?: keyof typeof backgrounds
  /** @category layout */ border?: keyof typeof borders
  /** @category layout */ radius?: keyof typeof radii
  /** @category layout */ shadow?: keyof typeof shadows
  /** @category layout */ width?: 'full' | 'auto'
  /** As a flex child: take the remaining space. @category layout */ grow?: boolean
  /** As a flex child: `false` keeps its size when space is short. @category layout */ shrink?: boolean
  class?: string
}
const {
  as = 'div', direction, gap, align, justify, wrap, divided = false, padding, paddingInline, paddingBlock, bleed, background, border, radius, shadow, width, grow = false, shrink,
  class: className, ...rest
} = Astro.props
const Tag = as
const flex = direction !== undefined || gap !== undefined || align !== undefined || justify !== undefined || wrap !== undefined
const wrapKey = wrap === undefined ? undefined : typeof wrap === 'object' ? Object.fromEntries(Object.entries(wrap).map(([k, v]) => [k, String(v)])) : String(wrap)
---

<Tag
  class:list={[
    flex && 'flex',
    flex && direction === undefined && 'flex-col',
    responsive(direction, tables.direction),
    responsive(gap, tables.gap),
    responsive(align, tables.align),
    responsive(justify, tables.justify),
    responsive(wrapKey as Responsive<'true' | 'false'> | undefined, tables.wrap),
    divided && '[&>*+*]:border-neutral',
    divided && responsive(direction ?? 'column', tables.divided),
    padding !== undefined && pads[padding],
    paddingInline !== undefined && padsInline[paddingInline],
    paddingBlock !== undefined && padsBlock[paddingBlock],
    bleed !== undefined && bleeds[bleed],
    background && backgrounds[background],
    border && borders[border],
    radius && radii[radius],
    shadow && shadows[shadow],
    width === 'full' && 'w-full',
    grow && 'grow',
    shrink === false && 'shrink-0',
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
