---
/**
 * Dialog — a native `<dialog>` opened/closed with invoker commands (zero JS core;
 * a tiny script + `closedby` handle backdrop-click). Three shapes:
 *
 *   variant="modal"      centered dialog (default)
 *   variant="panel"      edge drawer — position="left|right|top|bottom"
 *   variant="fullscreen" fills the viewport
 *
 *   <Button command="show-modal" commandfor="d">Open</Button>
 *   <Dialog id="d" variant="panel" position="right" title="…">…</Dialog>
 *
 * @composable
 */
import { X } from '@lucide/astro'

interface Props {
  id: string
  title?: string
  variant?: 'modal' | 'panel' | 'fullscreen'
  /** Drawer edge (panel variant only). */
  position?: 'left' | 'right' | 'top' | 'bottom'
  class?: string
  [key: string]: any
}

const { id, title, variant = 'modal', position = 'right', class: className, ...rest } = Astro.props
---

<dialog
  id={id}
  closedby="any"
  data-variant={variant}
  data-position={variant === 'panel' ? position : undefined}
  class:list={['apogee-dialog border border-border bg-surface p-0 text-surface-foreground', className]}
  {...rest}
>
  <div class="flex items-start justify-between gap-4 p-5 pb-2">
    {title && <h2 class="text-lg font-semibold text-foreground">{title}</h2>}
    <button
      type="button"
      command="close"
      commandfor={id}
      aria-label="Close"
      class="-mr-1 -mt-1 ml-auto grid size-8 shrink-0 place-items-center rounded-md text-muted-foreground hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
    >
      <X class="size-4" aria-hidden="true" />
    </button>
  </div>
  <div class="px-5 pb-5 text-sm text-muted-foreground">
    <slot />
  </div>
  {
    Astro.slots.has('footer') && (
      <div class="flex justify-end gap-2 border-t border-border px-5 py-4">
        <slot name="footer" />
      </div>
    )
  }
</dialog>

<style>
  .apogee-dialog {
    overflow-y: auto;
    opacity: 0;
    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      overlay 0.25s ease allow-discrete,
      display 0.25s ease allow-discrete;
  }

  /* --- layout per variant (state-independent) --- */
  .apogee-dialog {
    margin: auto;
    width: 100%;
    max-width: 32rem;
    max-height: 85dvh;
    border-radius: var(--radius-lg);
  }
  .apogee-dialog[data-variant='panel'] {
    margin: 0;
    max-width: 100%;
    max-height: 100dvh;
  }
  .apogee-dialog[data-position='right'] {
    inset: 0 0 0 auto;
    height: 100dvh;
    width: 24rem;
    border-radius: var(--radius-lg) 0 0 var(--radius-lg);
  }
  .apogee-dialog[data-position='left'] {
    inset: 0 auto 0 0;
    height: 100dvh;
    width: 24rem;
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
  }
  .apogee-dialog[data-position='top'] {
    inset: 0 0 auto 0;
    width: 100%;
    max-height: 85dvh;
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  }
  .apogee-dialog[data-position='bottom'] {
    inset: auto 0 0 0;
    width: 100%;
    max-height: 85dvh;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  }
  .apogee-dialog[data-variant='fullscreen'] {
    inset: 0;
    margin: 0;
    width: 100%;
    height: 100dvh;
    max-width: 100%;
    max-height: 100dvh;
    border-radius: 0;
  }

  /* --- enter/exit transforms (on the closed state) --- */
  .apogee-dialog:not([open]) {
    transform: scale(0.97) translateY(6px);
  }
  .apogee-dialog[data-position='right']:not([open]) {
    transform: translateX(100%);
  }
  .apogee-dialog[data-position='left']:not([open]) {
    transform: translateX(-100%);
  }
  .apogee-dialog[data-position='top']:not([open]) {
    transform: translateY(-100%);
  }
  .apogee-dialog[data-position='bottom']:not([open]) {
    transform: translateY(100%);
  }
  .apogee-dialog[data-variant='fullscreen']:not([open]) {
    transform: none;
  }

  .apogee-dialog[open] {
    opacity: 1;
    transform: none;
  }
  @starting-style {
    .apogee-dialog[open] {
      opacity: 0;
      transform: scale(0.97) translateY(6px);
    }
    .apogee-dialog[data-position='right'][open] {
      transform: translateX(100%);
    }
    .apogee-dialog[data-position='left'][open] {
      transform: translateX(-100%);
    }
    .apogee-dialog[data-position='top'][open] {
      transform: translateY(-100%);
    }
    .apogee-dialog[data-position='bottom'][open] {
      transform: translateY(100%);
    }
    .apogee-dialog[data-variant='fullscreen'][open] {
      transform: none;
    }
  }

  /* --- backdrop --- */
  .apogee-dialog::backdrop {
    background-color: rgb(0 0 0 / 0);
    transition:
      background-color 0.25s ease,
      overlay 0.25s ease allow-discrete,
      display 0.25s ease allow-discrete;
  }
  .apogee-dialog[open]::backdrop {
    background-color: rgb(0 0 0 / 0.5);
  }
  @starting-style {
    .apogee-dialog[open]::backdrop {
      background-color: rgb(0 0 0 / 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .apogee-dialog,
    .apogee-dialog::backdrop {
      transition: none;
    }
  }
</style>

<script>
  // Backdrop click closes it (fallback for browsers without `closedby`).
  for (const dialog of document.querySelectorAll<HTMLDialogElement>('dialog.apogee-dialog')) {
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close()
    })
  }
</script>
