---
/**
 * Dialog — a native `<dialog>` opened/closed with invoker commands (zero JS core;
 * a tiny script + `closedby` handle backdrop-click). Three shapes:
 *
 *   position="center"      centered dialog (default)
 *   position="start|end"   side drawer (logical: end is the right in LTR)
 *   position="top|bottom"  edge sheet
 *   position="full-screen" fills the viewport
 *
 *   <Button command="show-modal" commandfor="d">Open</Button>
 *   <Dialog id="d" position="end" title="…">…</Dialog>
 */
import type { HTMLAttributes } from 'astro/types'
import { X } from '@lucide/astro'

/** @composable */
interface Props extends HTMLAttributes<'dialog'> {
  id: string
  title?: string
  /** Where the dialog sits. `start`/`end` are logical: `end` is the right in LTR, the left in RTL. @category layout */
  position?: 'center' | 'start' | 'end' | 'top' | 'bottom' | 'full-screen'
  /** Click on the backdrop closes it. Set false for a confirm the user must answer. */
  dismissOnBackdrop?: boolean
  class?: string
}

const { id, title, position = 'center', dismissOnBackdrop = true, class: className, ...rest } = Astro.props
---

<dialog
  id={id}
  closedby={dismissOnBackdrop ? 'any' : 'closerequest'}
  data-position={position}
  data-dismiss-on-backdrop={String(dismissOnBackdrop)}
  aria-labelledby={title ? `${id}-title` : undefined}
  class:list={['apogee-dialog bg-elevation-raised p-0 text-neutral', position === 'center' ? 'border border-neutral' : 'border-0', className]}
  {...rest}
>
  <div class="flex items-start justify-between gap-4 p-5 pb-2">
    {title && <h2 id={`${id}-title`} class="text-lg font-semibold text-neutral">{title}</h2>}
    <button
      type="button"
      command="close"
      commandfor={id}
      aria-label="Close"
      class="-me-1 -mt-1 ms-auto grid size-8 shrink-0 place-items-center rounded-md text-neutral-faded hover:bg-neutral-faded-highlighted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
    >
      <X class="size-4" aria-hidden="true" />
    </button>
  </div>
  <div class="px-5 pb-5 text-sm text-neutral-faded">
    <slot />
  </div>
  {
    Astro.slots.has('footer') && (
      <div class="flex justify-end gap-2 border-t border-neutral px-5 py-4">
        <slot name="footer" />
      </div>
    )
  }
</dialog>

<style>
  .apogee-dialog {
    overflow-y: auto;
    opacity: 0;
    transition:
      opacity var(--duration-slow) var(--ease-standard),
      transform var(--duration-slow) var(--ease-standard),
      overlay var(--duration-slow) var(--ease-standard) allow-discrete,
      display var(--duration-slow) var(--ease-standard) allow-discrete;
  }

  /* --- layout per position (state-independent) --- */
  .apogee-dialog {
    margin: auto;
    width: 100%;
    max-width: 32rem;
    max-height: 85dvh;
    border-radius: var(--radius-lg);
  }
  .apogee-dialog:is([data-position='start'], [data-position='end'], [data-position='top'], [data-position='bottom']) {
    margin: 0;
    max-width: 100%;
    max-height: 100dvh;
  }
  .apogee-dialog[data-position='end'] {
    inset-block: 0;
    inset-inline: auto 0;
    height: 100dvh;
    width: 24rem;
    border-start-start-radius: var(--radius-lg);
    border-end-start-radius: var(--radius-lg);
  }
  .apogee-dialog[data-position='start'] {
    inset-block: 0;
    inset-inline: 0 auto;
    height: 100dvh;
    width: 24rem;
    border-start-end-radius: var(--radius-lg);
    border-end-end-radius: var(--radius-lg);
  }
  .apogee-dialog[data-position='top'] {
    inset: 0 0 auto 0;
    width: 100%;
    max-height: 85dvh;
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  }
  .apogee-dialog[data-position='bottom'] {
    inset: auto 0 0 0;
    width: 100%;
    max-height: 85dvh;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  }
  .apogee-dialog[data-position='full-screen'] {
    inset: 0;
    margin: 0;
    width: 100%;
    height: 100dvh;
    max-width: 100%;
    max-height: 100dvh;
    border-radius: 0;
  }

  /* --- enter/exit transforms (on the closed state) --- */
  .apogee-dialog:not([open]) {
    transform: scale(0.97) translateY(6px);
  }
  /* Slide from the edge it's docked to. :dir(rtl) mirrors the sign. */
  .apogee-dialog[data-position='end']:not([open]) {
    transform: translateX(100%);
  }
  .apogee-dialog[data-position='start']:not([open]) {
    transform: translateX(-100%);
  }
  .apogee-dialog[data-position='end']:dir(rtl):not([open]) {
    transform: translateX(-100%);
  }
  .apogee-dialog[data-position='start']:dir(rtl):not([open]) {
    transform: translateX(100%);
  }
  .apogee-dialog[data-position='top']:not([open]) {
    transform: translateY(-100%);
  }
  .apogee-dialog[data-position='bottom']:not([open]) {
    transform: translateY(100%);
  }
  .apogee-dialog[data-position='full-screen']:not([open]) {
    transform: none;
  }

  .apogee-dialog[open] {
    opacity: 1;
    transform: none;
  }
  @starting-style {
    .apogee-dialog[open] {
      opacity: 0;
      transform: scale(0.97) translateY(6px);
    }
    .apogee-dialog[data-position='end'][open] {
      transform: translateX(100%);
    }
    .apogee-dialog[data-position='start'][open] {
      transform: translateX(-100%);
    }
    .apogee-dialog[data-position='end'][open]:dir(rtl) {
      transform: translateX(-100%);
    }
    .apogee-dialog[data-position='start'][open]:dir(rtl) {
      transform: translateX(100%);
    }
    .apogee-dialog[data-position='top'][open] {
      transform: translateY(-100%);
    }
    .apogee-dialog[data-position='bottom'][open] {
      transform: translateY(100%);
    }
    .apogee-dialog[data-position='full-screen'][open] {
      transform: none;
    }
  }

  /* --- backdrop --- */
  .apogee-dialog::backdrop {
    background-color: transparent;
    transition:
      background-color var(--duration-slow) var(--ease-standard),
      overlay var(--duration-slow) var(--ease-standard) allow-discrete,
      display var(--duration-slow) var(--ease-standard) allow-discrete;
  }
  .apogee-dialog[open]::backdrop {
    background-color: var(--overlay);
  }
  @starting-style {
    .apogee-dialog[open]::backdrop {
      background-color: transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .apogee-dialog,
    .apogee-dialog::backdrop {
      transition: none;
    }
  }
</style>

<script>
  import { island } from '../utils/island.ts'

  // Backdrop click closes it (fallback for browsers without `closedby`).
  island<HTMLDialogElement>('dialog.apogee-dialog', (dialog) => {
    if (dialog.dataset.dismissOnBackdrop === 'false') return
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close()
    })
  })
</script>
