---
/**
 * Dialog — a native `<dialog>` opened/closed with invoker commands (zero JS core;
 * a tiny script + `closedby` handle backdrop-click). Positions, per breakpoint:
 *
 *   position="center"      centred dialog (default)
 *   position="start|end"   side drawer (logical: end is the right in LTR)
 *   position="top|bottom"  edge sheet
 *   position="full-screen" fills the viewport
 *   position={{ base: 'bottom', md: 'center' }}   sheet on phones, dialog from md
 *
 *   <Button command="show-modal" commandfor="d">Open</Button>
 *   <Dialog id="d" position="end" title="…" subtitle="…">…</Dialog>
 *
 * `size` is the width (centre, drawers) or the max height (sheets). The page
 * behind a dim or blurred overlay cannot scroll; a transparent overlay leaves
 * scrolling alone but the dialog is still modal, so the page stays inert.
 */
import type { HTMLAttributes } from 'astro/types'
import { X } from '@lucide/astro'
import { responsive, type Responsive } from '../utils/responsive.ts'
import { tables } from '../utils/responsive-tables.ts'

type Position = keyof typeof tables.dialogPosition.base
const paddings = {
  0: '0px',
  2: 'calc(var(--spacing) * 2)',
  3: 'calc(var(--spacing) * 3)',
  4: 'calc(var(--spacing) * 4)',
  5: 'calc(var(--spacing) * 5)',
  6: 'calc(var(--spacing) * 6)',
} as const

/** @composable */
interface Props extends HTMLAttributes<'dialog'> {
  id: string
  title?: string
  /** One line under the title; wired as the dialog's description. */
  subtitle?: string
  /** Where the dialog sits, per breakpoint. `start`/`end` are logical. @category layout */
  position?: Responsive<Position>
  /** CSS length: width for centre and drawers, max height for sheets. @category layout */
  size?: string
  /** Inner padding in spacing steps. @category layout */
  padding?: keyof typeof paddings
  /** Backdrop: dimmed (default), blurred, or none. @category layout */
  overlay?: 'dim' | 'blurred' | 'transparent'
  /** Click on the backdrop closes it. Set false for a confirm the user must answer. */
  dismissOnBackdrop?: boolean
  class?: string
}

const {
  id,
  title,
  subtitle,
  position = 'center',
  size,
  padding = 5,
  overlay = 'dim',
  dismissOnBackdrop = true,
  class: className,
  ...rest
} = Astro.props
const vars = [size && `--apogee-dialog-size: ${size}`, `--apogee-dialog-pad: ${paddings[padding]}`].filter(Boolean).join('; ')
---

<dialog
  id={id}
  closedby={dismissOnBackdrop ? 'any' : 'closerequest'}
  data-dismiss-on-backdrop={String(dismissOnBackdrop)}
  data-overlay={overlay}
  aria-labelledby={title ? `${id}-title` : undefined}
  aria-describedby={subtitle ? `${id}-subtitle` : undefined}
  style={vars}
  class:list={['apogee-dialog bg-elevation-raised p-0 text-neutral', responsive(position, tables.dialogPosition), className]}
  {...rest}
>
  <div class="flex items-start justify-between gap-4 p-(--apogee-dialog-pad) pb-2">
    {
      (title || subtitle) && (
        <div class="min-w-0">
          {title && (
            <h2 id={`${id}-title`} class="text-lg font-semibold text-neutral">
              {title}
            </h2>
          )}
          {subtitle && (
            <p id={`${id}-subtitle`} class="mt-0.5 text-sm text-neutral-faded">
              {subtitle}
            </p>
          )}
        </div>
      )
    }
    <button
      type="button"
      command="close"
      commandfor={id}
      aria-label="Close"
      class:list={[
        'ms-auto grid size-8 shrink-0 place-items-center rounded-md text-neutral-faded hover:bg-neutral-faded-highlighted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary',
        padding > 0 && '-me-1 -mt-1',
      ]}
    >
      <X class="size-4" aria-hidden="true" />
    </button>
  </div>
  <div class="px-(--apogee-dialog-pad) pb-(--apogee-dialog-pad) text-sm text-neutral-faded">
    <slot />
  </div>
  {
    Astro.slots.has('footer') && (
      <div class="flex justify-end gap-2 border-t border-neutral px-(--apogee-dialog-pad) py-4">
        <slot name="footer" />
      </div>
    )
  }
</dialog>

<style>
  /* Layout per position comes from the responsive table (utilities on the
     element). This block owns the enter/exit motion and the backdrop. */
  .apogee-dialog {
    overflow-y: auto;
    opacity: 0;
    transition:
      opacity var(--duration-slow) var(--ease-standard),
      translate var(--duration-slow) var(--ease-standard),
      scale var(--duration-slow) var(--ease-standard),
      overlay var(--duration-slow) var(--ease-standard) allow-discrete,
      display var(--duration-slow) var(--ease-standard) allow-discrete;
  }
  .apogee-dialog:not([open]) {
    translate: var(--apogee-dx) var(--apogee-dy);
    scale: var(--apogee-scale);
  }
  .apogee-dialog:dir(rtl):not([open]) {
    translate: calc(-1 * var(--apogee-dx)) var(--apogee-dy);
  }
  .apogee-dialog[open] {
    opacity: 1;
    translate: 0 0;
    scale: 1;
  }
  @starting-style {
    .apogee-dialog[open] {
      opacity: 0;
      translate: var(--apogee-dx) var(--apogee-dy);
      scale: var(--apogee-scale);
    }
    .apogee-dialog[open]:dir(rtl) {
      translate: calc(-1 * var(--apogee-dx)) var(--apogee-dy);
    }
  }

  .apogee-dialog::backdrop {
    background-color: transparent;
    transition:
      background-color var(--duration-slow) var(--ease-standard),
      overlay var(--duration-slow) var(--ease-standard) allow-discrete,
      display var(--duration-slow) var(--ease-standard) allow-discrete;
  }
  .apogee-dialog[open]::backdrop {
    background-color: var(--overlay);
  }
  .apogee-dialog[data-overlay='blurred'][open]::backdrop {
    backdrop-filter: blur(4px);
  }
  .apogee-dialog[data-overlay='transparent'][open]::backdrop {
    background-color: transparent;
  }
  @starting-style {
    .apogee-dialog[open]::backdrop {
      background-color: transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .apogee-dialog,
    .apogee-dialog::backdrop {
      transition: none;
    }
  }
</style>

<script>
  import { island } from '../utils/island.ts'

  // Backdrop click closes it (fallback for browsers without `closedby`). The
  // backdrop and the dialog's own empty area both report the dialog as the
  // target, so the click point must also fall outside the card.
  island<HTMLDialogElement>('dialog.apogee-dialog', (dialog) => {
    if (dialog.dataset.dismissOnBackdrop === 'false') return
    dialog.addEventListener('click', (event) => {
      if (event.target !== dialog) return
      const r = dialog.getBoundingClientRect()
      const inside =
        event.clientX >= r.left && event.clientX <= r.right && event.clientY >= r.top && event.clientY <= r.bottom
      if (!inside) dialog.close()
    })
  })
</script>
