---
/**
 * TagInput — type and press Enter (or comma) to add removable tags; Backspace on
 * an empty field removes the last. JS island; without JS it degrades to the
 * initial tags plus a plain text field that also submits (both under `name`), so
 * typed text is never lost. Tags submit as repeated `name` fields.
 */
import type { HTMLAttributes } from 'astro/types'
import Field from '../Field/Field.astro'
import CloseButton from '../CloseButton/CloseButton.astro'
import { uid } from '../utils/uid.ts'
import { fieldVariants, type FieldSize, type FieldVariant } from '../utils/field.ts'

// The box wraps, so it has a minimum height instead of the fixed field height.
const boxSizes = {
  small: 'min-h-7 px-1.5 py-1 text-xs',
  medium: 'min-h-9 px-2 py-1.5 text-sm',
  large: 'min-h-12 px-3 py-2 text-base',
  xlarge: 'min-h-14 px-4 py-2.5 text-lg',
} as const

/** @composable */
interface Props extends Omit<HTMLAttributes<'div'>, 'value'> {
  id?: string
  name: string
  /** Initial tags. */
  value?: string[]
  placeholder?: string
  /** @category content */
  label?: string
  /** @category content */
  hint?: string
  /** @category content */
  error?: string
  required?: boolean
  /** @category layout */
  size?: FieldSize
  /** @category layout */
  variant?: FieldVariant
  /** Marks the field invalid. */
  hasError?: boolean
  /** Stops accepting tags at this count until one is removed. */
  maxTags?: number
  /** Accept a tag that already exists (the check is case-insensitive). */
  allowDuplicates?: boolean
  class?: string
}

const {
  id: idProp,
  name,
  value = [],
  placeholder = 'Add tag…',
  label,
  hint,
  error,
  required = false,
  size = 'medium',
  variant = 'outline',
  hasError = false,
  maxTags,
  allowDuplicates = false,
  class: className,
  ...rest
} = Astro.props
const id = idProp ?? uid(Astro.locals)
const invalid = Boolean(error) || hasError
const describedby = [hint && `${id}-hint`, error && `${id}-error`].filter(Boolean).join(' ') || undefined
---

<Field id={id} label={label} size={size} hint={hint} error={error} required={required} class={className}>
<div
  class:list={[
    'apogee-taginput flex flex-wrap items-center gap-1.5 rounded-md transition-colors focus-within:border-primary focus-within:shadow-[inset_0_0_0_1.5px_var(--border-primary)] aria-[invalid=true]:border-critical',
    fieldVariants[variant],
    boxSizes[size],
  ]}
  aria-invalid={invalid ? 'true' : undefined}
  data-name={name}
  data-max={maxTags}
  data-required={required ? '' : undefined}
  data-allow-duplicates={allowDuplicates ? '' : undefined}
  {...rest}
>
  {
    value.map((tag) => (
      <span class="apogee-tag inline-flex items-center gap-1 rounded bg-neutral-faded px-2 py-0.5 text-sm text-neutral">
        <span class="apogee-tag-label">{tag}</span>
        <input type="hidden" name={name} value={tag} />
        <CloseButton size="xsmall" theme="inherit" label={`Remove ${tag}`} class="apogee-tag-remove no-js:hidden" />
      </span>
    ))
  }
  <input
    id={id}
    type="text"
    name={name}
    required={required && value.length === 0 ? true : undefined}
    aria-describedby={describedby}
    aria-invalid={invalid ? 'true' : undefined}
    class="apogee-taginput-field min-w-24 flex-1 bg-transparent max-md:text-base pointer-coarse:text-base text-neutral outline-none read-only:cursor-not-allowed placeholder:text-neutral-faded"
    placeholder={placeholder}
    data-placeholder={placeholder}
    autocomplete="off"
  />
  <template class="apogee-tag-template">
  <span class="apogee-tag inline-flex items-center gap-1 rounded bg-neutral-faded px-2 py-0.5 text-sm text-neutral">
    <span class="apogee-tag-label"></span>
    <input type="hidden" />
    <CloseButton size="xsmall" theme="inherit" label="Remove" class="apogee-tag-remove" />
  </span>
</template>
</div>
</Field>

<script>
  import { island } from '../utils/island.ts'

  island('.apogee-taginput', (root) => {
    const field = root.querySelector<HTMLInputElement>('.apogee-taginput-field')
    const tpl = root.querySelector<HTMLTemplateElement>('.apogee-tag-template')
    const name = root.dataset.name || 'tags'
    if (!field || !tpl) return

    // With JS, tags submit via their own hidden inputs — the live field is just
    // for typing, so drop its name (it carries the no-JS fallback value).
    field.removeAttribute('name')

    const max = Number(root.dataset.max) || Infinity
    const allowDuplicates = root.dataset.allowDuplicates !== undefined
    const values = () => [...root.querySelectorAll<HTMLInputElement>('input[type="hidden"]')].map((i) => i.value)
    // At the limit the field goes read-only until a tag is removed.
    const required = root.dataset.required !== undefined
    const limit = () => {
      const full = values().length >= max
      // Native required applies to the typing field only while there is no tag.
      field.required = required && values().length === 0
      field.readOnly = full
      field.placeholder = full ? 'Limit reached' : (field.dataset.placeholder ?? '')
    }
    const changed = () => {
      limit()
      root.dispatchEvent(new CustomEvent('apogee:tag-input-change', { bubbles: true, detail: { values: values() } }))
    }
    const removeTag = (tag: Element) => {
      tag.remove()
      changed()
    }
    limit()

    const addTag = (raw: string) => {
      const label = raw.trim().replace(/,$/, '').trim()
      if (!label || values().length >= max) return
      if (!allowDuplicates && values().some((v) => v.toLowerCase() === label.toLowerCase())) {
        field.value = ''
        return
      }
      const node = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement
      node.querySelector('.apogee-tag-label')!.textContent = label
      const hidden = node.querySelector<HTMLInputElement>('input[type="hidden"]')!
      hidden.name = name
      hidden.value = label
      const btn = node.querySelector<HTMLButtonElement>('.apogee-tag-remove')!
      btn.setAttribute('aria-label', `Remove ${label}`)
      btn.addEventListener('click', () => removeTag(node))
      root.insertBefore(node, field)
      field.value = ''
      changed()
    }

    field.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ',') {
        e.preventDefault()
        addTag(field.value)
      } else if (e.key === 'Backspace' && field.value === '') {
        const tags = root.querySelectorAll('.apogee-tag')
        const last = tags[tags.length - 1]
        if (last) removeTag(last)
      }
    })

    // Wire the server-rendered tags' remove buttons.
    for (const btn of root.querySelectorAll<HTMLButtonElement>('.apogee-tag-remove')) {
      btn.addEventListener('click', () => { const t = btn.closest('.apogee-tag'); if (t) removeTag(t) })
    }
  })
</script>
