---
/**
 * Collapsible — a single show/hide region on native `<details>`. Zero JS,
 * animated open/close (a grid row from 0fr to 1fr, so WebKit animates too). For grouped
 * single-open sections use Accordion.
 * Slots: `trigger` (summary label), default (revealed content).
 */
import type { HTMLAttributes } from 'astro/types'
import { ChevronDown } from '@lucide/astro'

/** @composable */
interface Props extends HTMLAttributes<'div'> {
  open?: boolean
  class?: string
}

const { open = false, class: className, ...rest } = Astro.props
---

<details class:list={['apogee-collapsible', className]} open={open} {...rest}>
  <summary
    class="press flex cursor-pointer items-center gap-2 rounded-sm text-sm font-medium text-neutral focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus [&::-webkit-details-marker]:hidden"
  >
    <ChevronDown class="apogee-collapsible-icon size-4 shrink-0 text-neutral-faded" aria-hidden="true" />
    <slot name="trigger">Details</slot>
  </summary>
  <div class="apogee-collapsible-panel grid">
    <div class="min-h-0 overflow-hidden">
      <div class="apogee-collapsible-content pt-2 text-sm text-neutral-faded">
        <slot />
      </div>
    </div>
  </div>
</details>

<style>
  .apogee-collapsible-icon {
    transition: rotate var(--duration-medium) var(--ease-standard);
  }
  .apogee-collapsible[open] .apogee-collapsible-icon {
    rotate: 180deg;
  }
  /* Open and close animate a grid row from 0fr to 1fr (every engine animates it; height to
     `auto` needs interpolate-size, which WebKit lacks). The content stays rendered so the row
     can animate; `visibility` keeps a closed panel out of the tab order and screen readers.
     Without ::details-content support the panel simply shows and hides. */
  .apogee-collapsible::details-content {
    content-visibility: visible;
  }
  .apogee-collapsible-panel {
    grid-template-rows: 0fr;
    visibility: hidden;
    transition:
      grid-template-rows var(--duration-slow) var(--ease-standard),
      visibility var(--duration-slow) var(--ease-standard);
  }
  .apogee-collapsible[open] > .apogee-collapsible-panel {
    grid-template-rows: 1fr;
    visibility: visible;
  }
  @media (prefers-reduced-motion: reduce) {
    .apogee-collapsible-panel,
    .apogee-collapsible-icon {
      transition: none;
    }
  }
</style>
