---
/**
 * Collapsible — a single show/hide region on native `<details>`. Zero JS,
 * animated open/close (`::details-content` + `interpolate-size`). For grouped
 * single-open sections use Accordion.
 * Slots: `trigger` (summary label), default (revealed content).
 *
 * @composable
 */
import { ChevronDown } from '@lucide/astro'

interface Props {
  open?: boolean
  class?: string
}

const { open = false, class: className, ...rest } = Astro.props
---

<details class:list={['apogee-collapsible', className]} open={open} {...rest}>
  <summary
    class="flex cursor-pointer items-center gap-2 text-sm font-medium text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring [&::-webkit-details-marker]:hidden"
  >
    <ChevronDown class="apogee-collapsible-icon size-4 shrink-0 text-muted-foreground" aria-hidden="true" />
    <slot name="trigger">Details</slot>
  </summary>
  <div class="apogee-collapsible-content pt-2 text-sm text-muted-foreground">
    <slot />
  </div>
</details>

<style>
  .apogee-collapsible {
    interpolate-size: allow-keywords;
  }
  .apogee-collapsible-icon {
    transition: rotate var(--duration-base) var(--ease-smooth);
  }
  .apogee-collapsible[open] .apogee-collapsible-icon {
    rotate: 180deg;
  }
  .apogee-collapsible::details-content {
    block-size: 0;
    overflow: hidden;
    content-visibility: hidden;
    transition:
      block-size var(--duration-slow) var(--ease-smooth),
      content-visibility var(--duration-slow) var(--ease-smooth) allow-discrete;
  }
  .apogee-collapsible[open]::details-content {
    block-size: auto;
    content-visibility: visible;
  }
  @media (prefers-reduced-motion: reduce) {
    .apogee-collapsible::details-content,
    .apogee-collapsible-icon {
      transition: none;
    }
  }
</style>
