---
/**
 * Navbar — a responsive site header. Links (default slot) show inline on desktop
 * and collapse into a toggled panel on mobile (one small island for the toggle).
 * Without JS the toggle is hidden and the links stay expanded (`no-js:`), so the
 * nav is never a dead control. Slots: `brand` (logo), default (nav links),
 * `actions` (buttons at the end). The actions render inline on desktop and
 * again inside the mobile panel, so they stay reachable at every width — don't
 * put elements with ids in that slot, or they'd be duplicated. `secondary`
 * is a second row under the header (tabs or pills for the active section);
 * `centered` puts the links in the middle with brand and actions either side.
 */
import type { HTMLAttributes } from 'astro/types'
import { uid } from '../utils/uid.ts'
import { Menu } from '@lucide/astro'

/** @composable */
interface Props extends HTMLAttributes<'header'> {
  /** Links in the middle, brand and actions at the edges. @category layout */
  centered?: boolean
  /** Name of the phone menu button. @category content */
  menuLabel?: string
  /** Name of the `secondary` nav row. @category content */
  secondaryLabel?: string
  class?: string
}

const { centered = false, menuLabel = 'Toggle menu', secondaryLabel = 'Section', class: className, ...rest } = Astro.props
const hasSecondary = Astro.slots.has('secondary')
const menuId = uid(Astro.locals, 'apogee-nav')
const actions = Astro.slots.has('actions') ? await Astro.slots.render('actions') : ''
---

<header
  class:list={['sticky top-0 z-30 border-b border-neutral bg-page/85 backdrop-blur', className]}
  {...rest}
>
  <nav class="relative mx-auto flex h-16 max-w-7xl items-center gap-4 px-4 sm:px-6">
    <div class:list={['flex items-center', centered ? 'flex-1' : 'md:me-2']}>
      <slot name="brand" />
    </div>
    <div
      id={menuId}
      class:list={[
        'apogee-navbar-menu absolute inset-x-0 top-full hidden flex-col gap-0.5 border-b border-neutral bg-page p-4 no-js:flex data-[open=true]:flex md:static md:flex md:flex-row md:items-center md:gap-1 md:border-0 md:bg-transparent md:p-0',
        centered ? 'md:justify-center' : 'md:me-auto',
      ]}
    >
      <slot />
      {actions && <div class="mt-2 flex items-center gap-2 border-t border-neutral pt-3 md:hidden" set:html={actions} />}
    </div>
    <div class:list={['flex items-center justify-end gap-2', centered ? 'flex-1' : 'ms-auto']}>
      {actions && <div class="hidden items-center gap-2 md:flex" set:html={actions} />}
      <button
        type="button"
        class="apogee-navbar-toggle press grid size-9 place-items-center rounded-md text-neutral transition-colors hover:bg-neutral-faded-highlighted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus no-js:hidden md:hidden"
        aria-controls={menuId}
        aria-expanded="false"
        aria-label={menuLabel}
      >
        <Menu class="size-5" aria-hidden="true" />
      </button>
    </div>
  </nav>
  {
    hasSecondary && (
      <div class="apogee-navbar-secondary border-t border-neutral">
        <nav class="mx-auto flex max-w-7xl items-center gap-1 overflow-x-auto px-4 sm:px-6" aria-label={secondaryLabel}>
          <slot name="secondary" />
        </nav>
      </div>
    )
  }
</header>

<script>
  import { island } from '../utils/island.ts'

  island('.apogee-navbar-toggle', (toggle) => {
    const id = toggle.getAttribute('aria-controls')
    const menu = id ? document.getElementById(id) : null
    if (!menu) return
    toggle.addEventListener('click', () => {
      const open = menu.dataset.open !== 'true'
      menu.dataset.open = String(open)
      toggle.setAttribute('aria-expanded', String(open))
    })
  })
</script>
