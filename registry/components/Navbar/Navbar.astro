---
/**
 * Navbar — a responsive site header. Links (default slot) show inline on desktop
 * and collapse into a toggled panel on mobile (one small island for the toggle).
 * Without JS the toggle is hidden and the links stay expanded (`no-js:`), so the
 * nav is never a dead control. Slots: `brand` (logo), default (nav links),
 * `actions` (buttons at the end). The actions render inline on desktop and
 * again inside the mobile panel, so they stay reachable at every width — don't
 * put elements with ids in that slot, or they'd be duplicated.
 */
import type { HTMLAttributes } from 'astro/types'
import { uid } from '../utils/uid.ts'
import { Menu } from '@lucide/astro'

/** @composable */
interface Props extends HTMLAttributes<'header'> {
  class?: string
}

const { class: className, ...rest } = Astro.props
const menuId = uid(Astro.locals, 'apogee-nav')
const actions = Astro.slots.has('actions') ? await Astro.slots.render('actions') : ''
---

<header
  class:list={['sticky top-0 z-30 border-b border-neutral bg-page/85 backdrop-blur', className]}
  {...rest}
>
  <nav class="relative mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6">
    <div class="flex items-center gap-6">
      <slot name="brand" />
      <div
        id={menuId}
        class="apogee-navbar-menu absolute inset-x-0 top-full hidden flex-col gap-0.5 border-b border-neutral bg-page p-4 no-js:flex data-[open=true]:flex md:static md:flex md:flex-row md:items-center md:gap-1 md:border-0 md:bg-transparent md:p-0"
      >
        <slot />
        {actions && <div class="mt-2 flex items-center gap-2 border-t border-neutral pt-3 md:hidden" set:html={actions} />}
      </div>
    </div>
    <div class="flex items-center gap-2">
      {actions && <div class="hidden items-center gap-2 md:flex" set:html={actions} />}
      <button
        type="button"
        class="apogee-navbar-toggle grid size-9 place-items-center rounded-md text-neutral transition-colors hover:bg-neutral-faded-highlighted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary no-js:hidden md:hidden"
        aria-controls={menuId}
        aria-expanded="false"
        aria-label="Toggle menu"
      >
        <Menu class="size-5" aria-hidden="true" />
      </button>
    </div>
  </nav>
</header>

<script>
  import { island } from '../utils/island.ts'

  island('.apogee-navbar-toggle', (toggle) => {
    const id = toggle.getAttribute('aria-controls')
    const menu = id ? document.getElementById(id) : null
    if (!menu) return
    toggle.addEventListener('click', () => {
      const open = menu.dataset.open !== 'true'
      menu.dataset.open = String(open)
      toggle.setAttribute('aria-expanded', String(open))
    })
  })
</script>
