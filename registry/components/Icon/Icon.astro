---
/**
 * Icon — renders a Lucide (or Lucide-shaped) icon and forwards its props, or a
 * raw <svg> passed as a slot. Library-agnostic wrapper: it adds accessibility
 * and a consistent seam, but every Lucide prop (`size`, `strokeWidth`, `color`,
 * `absoluteStrokeWidth`, `class`, …) passes straight through, so you tweak the
 * icon where you use it.
 *
 * Meaningful icon → give a `label` (role="img"). Decorative → omit it (hidden
 * from assistive tech).
 *
 *   import { Camera } from '@lucide/astro'
 *   <Icon icon={Camera} label="Take photo" strokeWidth={2.5} class="text-primary" />
 *   <Icon icon={ChevronDown} />              // decorative
 *   <Icon><svg …/></Icon>                    // raw SVG fallback
 */
import type { HTMLAttributes } from 'astro/types'
import type { IconComponent as IconType } from '../utils/icon.ts'
const tones = {
  primary: 'text-primary',
  neutral: 'text-neutral',
  'neutral-faded': 'text-neutral-faded',
  critical: 'text-critical',
  positive: 'text-positive',
  warning: 'text-warning',
  inherit: 'text-current',
} as const
/** @composable */
interface Props extends Omit<HTMLAttributes<'svg'>, 'size'> {
  /** A Lucide icon component. Omit to pass a raw <svg> as the slot. */
  icon?: IconType
  /** Accessible label. Omit for decorative icons. */
  label?: string
  /** Lucide size (px). Prefer a Tailwind `size-*` class for consistency. */
  size?: number | string
  strokeWidth?: number | string
  absoluteStrokeWidth?: boolean
  /** A token name maps to its text colour; any other string passes to the SVG as-is. */
  color?: 'primary' | 'neutral' | 'neutral-faded' | 'critical' | 'positive' | 'warning' | 'inherit' | (string & {})
  /** Let the glyph keep its own aspect ratio instead of a square box. @category layout */
  autoWidth?: boolean
  class?: string
}

const { icon: IconComponent, label, color, autoWidth = false, class: className, ...iconProps } = Astro.props
const tone = color && color in tones ? tones[color as keyof typeof tones] : undefined
const rawColor = tone ? undefined : color

const a11y = label ? ({ role: 'img', 'aria-label': label } as const) : ({ 'aria-hidden': 'true' } as const)
---

{
  IconComponent ? (
    <IconComponent class:list={['shrink-0', tone, autoWidth && 'w-auto', className]} color={rawColor} {...iconProps} {...a11y} />
  ) : (
    <span class:list={['inline-flex shrink-0 [&>svg]:size-full', tone, autoWidth && '[&>svg]:w-auto', className]} {...a11y}>
      <slot />
    </span>
  )
}
