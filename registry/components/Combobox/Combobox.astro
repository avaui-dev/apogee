---
/**
 * Combobox — a text input with a styled, filterable dropdown of suggestions.
 * A real editable ARIA combobox (the platform can't style a `<datalist>` popup),
 * so it's a JS island: without JS the input still works as a plain text field.
 * The listbox is a `popover="manual"` panel anchored under the input (top
 * layer, as wide as the input, scrolls past 15rem).
 *
 * Typing filters the list and highlights the closest match (prefers a prefix
 * match); Enter or click commits its label into the input. Free-typing is
 * allowed. Options are strings or `{ value, label?, description?, disabled? }`.
 * Renders a full accessible field (label + hint/error) via Field, like Input.
 */
import type { HTMLAttributes } from 'astro/types'
import { uid } from '../utils/uid.ts'
import Field from '../Field/Field.astro'
import { fieldSizes, fieldVariants, fieldBase, type FieldSize, type FieldVariant } from '../utils/field.ts'
import { panelStyle, panelClass, panelSurface, menuClass, itemBase, itemSizes, itemColors } from '../utils/panel.ts'
import { ChevronDown } from '@lucide/astro'
import Avatar from '../Avatar/Avatar.astro'
import CloseButton from '../CloseButton/CloseButton.astro'

export interface ComboboxOption {
  value: string
  /** Shown in the list and written into the input; defaults to `value`. */
  label?: string
  description?: string
  disabled?: boolean
  /** A Lucide component shown before the label. */
  icon?: (props: Record<string, unknown>) => unknown
  /** Image URL shown as a 24px avatar before the label; wins over `icon`. */
  avatar?: string
  avatarName?: string
}

/** @composable */
interface Props extends Omit<HTMLAttributes<'input'>, 'size'> {
  id?: string
  label?: string
  hint?: string
  error?: string
  /** Suggestions shown in the dropdown. */
  options: (string | ComboboxOption)[]
  /** Marks the field invalid without a message. */
  hasError?: boolean
  /** @category layout */
  size?: FieldSize
  /** @category layout */
  variant?: FieldVariant
  required?: boolean
  /** Show the chevron caret. Set false to hide it. */
  caret?: boolean
  /** Picks become chips inside the field; each posts `name=value`. */
  multiple?: boolean
  /** Form field name (required with `multiple`). */
  name?: string
  /** Initial text (single) or initial chips as option values (`multiple`). */
  value?: string | string[]
  /** Stop accepting picks at this count. */
  maxItems?: number
  class?: string
}

const {
  id: idProp,
  label,
  hint,
  error,
  options,
  hasError = false,
  size = 'medium',
  variant = 'outline',
  required = false,
  caret = true,
  multiple = false,
  name,
  value: valueProp,
  maxItems,
  class: className,
  ...rest
} = Astro.props
const id = idProp ?? uid(Astro.locals)
const listId = `${id}-list`
const anchor = `--${id}`
const describedby = [hint && `${id}-hint`, error && `${id}-error`].filter(Boolean).join(' ') || undefined
const items = options.map((o) => (typeof o === 'string' ? { value: o, label: o } : { ...o, label: o.label ?? o.value }))
const optionSize = { small: 'small', medium: 'medium', large: 'medium', xlarge: 'large' } as const
// Multiple: a wrapping box holds the chips and the typing input.
const boxSizes = {
  small: 'min-h-7 px-1.5 py-1 text-xs',
  medium: 'min-h-9 px-2 py-1.5 text-sm',
  large: 'min-h-12 px-3 py-2 text-base',
  xlarge: 'min-h-14 px-4 py-2.5 text-lg',
} as const
const value = Array.isArray(valueProp) ? valueProp : []
const singleValue = typeof valueProp === 'string' ? valueProp : undefined
const chips = multiple ? items.filter((o) => value.includes(o.value)) : []
const listMaxHeight = { small: '14rem', medium: '15rem', large: '16rem', xlarge: '20rem' } as const
---

<Field id={id} label={label} size={size} hint={hint} error={error} required={required} class={className}>
  <div
    class="apogee-combobox relative"
    data-open="false"
    data-multiple={multiple ? '' : undefined}
    data-name={multiple ? name : undefined}
    data-max={maxItems}
    data-required={multiple && required ? '' : undefined}
    style={`anchor-name: ${anchor}`}
  >
    {
      multiple ? (
        <div
          class:list={[
            'apogee-combobox-box flex flex-wrap items-center gap-1.5 rounded-md transition-colors focus-within:border-primary focus-within:shadow-[inset_0_0_0_1.5px_var(--border-primary)] aria-[invalid=true]:border-critical',
            fieldVariants[variant],
            boxSizes[size],
            caret && 'pe-9',
          ]}
          aria-invalid={error || hasError ? 'true' : undefined}
        >
          {chips.map((o) => (
            <span class="apogee-combobox-chip inline-flex h-6 items-center gap-1 rounded bg-neutral-faded px-2 text-sm text-neutral" data-value={o.value}>
              <span class="apogee-combobox-chip-label">{o.label}</span>
              <input type="hidden" name={name} value={o.value} />
              <CloseButton size="xsmall" theme="inherit" label={`Remove ${o.label}`} data-chip-remove class="no-js:hidden" />
            </span>
          ))}
          <input
            id={id}
            type="text"
            name={name}
            role="combobox"
            aria-expanded="false"
            aria-controls={listId}
            aria-autocomplete="list"
            autocomplete="off"
            required={required && chips.length === 0 ? true : undefined}
            aria-describedby={describedby}
            aria-invalid={error || hasError ? 'true' : undefined}
            class="min-w-24 flex-1 bg-transparent text-neutral outline-none max-md:text-base read-only:cursor-not-allowed placeholder:text-neutral-faded"
            {...rest}
          />
          <template class="apogee-combobox-chip-template">
            <span class="apogee-combobox-chip inline-flex h-6 items-center gap-1 rounded bg-neutral-faded px-2 text-sm text-neutral">
              <span class="apogee-combobox-chip-label"></span>
              <input type="hidden" />
              <CloseButton size="xsmall" theme="inherit" label="Remove" data-chip-remove />
            </span>
          </template>
        </div>
      ) : (
        <input
          id={id}
          type="text"
          name={name}
          role="combobox"
          aria-expanded="false"
          aria-controls={listId}
          aria-autocomplete="list"
          autocomplete="off"
          required={required}
          value={singleValue}
          aria-describedby={describedby}
          aria-invalid={error || hasError ? 'true' : undefined}
          class:list={[fieldBase, fieldVariants[variant], fieldSizes[size], caret && 'pe-9']}
          {...rest}
        />
      )
    }
    {
      caret && (
        <ChevronDown
          class="pointer-events-none absolute top-1/2 end-3 size-4 -translate-y-1/2 text-neutral-faded"
          aria-hidden="true"
        />
      )
    }
    <ul
      id={listId}
      popover="manual"
      role="listbox"
      data-placement="bottom-start"
      style={panelStyle({ anchor, placement: 'bottom-start', gap: 1, width: 'trigger', maxHeight: listMaxHeight[size] })}
      class:list={[panelClass, panelSurface.overlay, menuClass, 'overflow-auto']}
    >
      {
        items.map((o, i) => (
          <li
            id={`${listId}-${i}`}
            role="option"
            aria-selected="false"
            aria-disabled={o.disabled ? 'true' : undefined}
            data-value={o.value}
            data-label={o.label}
            data-chosen={multiple && value.includes(o.value) ? '' : undefined}
            hidden={multiple && value.includes(o.value) ? true : undefined}
            class:list={['cursor-pointer', itemBase, itemSizes[optionSize[size]], itemColors.neutral, 'aria-selected:bg-neutral-faded']}
          >
            {o.avatar && <Avatar src={o.avatar} name={o.avatarName ?? o.label} size="xsmall" class="shrink-0" />}
            {!o.avatar && o.icon && <span class="inline-flex shrink-0 text-neutral-faded [&>svg]:size-4"><o.icon aria-hidden="true" /></span>}
            <span class="flex-1">
              {o.label}
              {o.description && <span class="block text-xs text-neutral-faded">{o.description}</span>}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</Field>

<script>
  import { island } from '../utils/island.ts'

  island('.apogee-combobox', (cb) => {
    const input = cb.querySelector<HTMLInputElement>('input[role="combobox"]')
    const list = cb.querySelector<HTMLElement>('[role="listbox"]')
    const options = [...cb.querySelectorAll<HTMLElement>('[role="option"]')]
    if (!input || !list || !options.length) return

    let active = -1
    const isOpen = () => list.matches(':popover-open')
    // Multiple: picks become chips; the chosen options leave the list until removed.
    const multiple = cb.dataset.multiple !== undefined
    const box = cb.querySelector<HTMLElement>('.apogee-combobox-box')
    const tpl = cb.querySelector<HTMLTemplateElement>('.apogee-combobox-chip-template')
    const max = Number(cb.dataset.max) || Infinity
    const chipsOf = () => [...cb.querySelectorAll<HTMLElement>('.apogee-combobox-chip')]
    const valuesOf = () => chipsOf().map((c) => c.dataset.value ?? '')
    const limit = () => {
      if (!multiple) return
      input.readOnly = chipsOf().length >= max
      input.required = cb.dataset.required !== undefined && chipsOf().length === 0
    }
    const changed = () => {
      limit()
      cb.dispatchEvent(new CustomEvent('apogee:combobox-change', { bubbles: true, detail: { values: valuesOf() } }))
    }
    const removeChip = (chip: HTMLElement) => {
      const o = options.find((x) => x.dataset.value === chip.dataset.value)
      if (o) {
        delete o.dataset.chosen
        o.hidden = false
      }
      chip.remove()
      changed()
      input.focus()
    }
    const addChip = (o: HTMLElement) => {
      if (!tpl || !box || chipsOf().length >= max) return
      const node = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement
      node.dataset.value = o.dataset.value ?? ''
      node.querySelector('.apogee-combobox-chip-label')!.textContent = labelOf(o)
      const hidden = node.querySelector<HTMLInputElement>('input[type="hidden"]')!
      hidden.name = cb.dataset.name ?? ''
      hidden.value = o.dataset.value ?? ''
      const btn = node.querySelector<HTMLButtonElement>('[data-chip-remove]')!
      btn.setAttribute('aria-label', `Remove ${labelOf(o)}`)
      btn.addEventListener('click', () => removeChip(node))
      input.before(node)
      o.dataset.chosen = ''
      o.hidden = true
      changed()
    }
    if (multiple) {
      input.removeAttribute('name') // chips post through their hidden inputs
      for (const btn of cb.querySelectorAll<HTMLButtonElement>('[data-chip-remove]')) {
        btn.addEventListener('click', () => { const c = btn.closest<HTMLElement>('.apogee-combobox-chip'); if (c) removeChip(c) })
      }
      limit()
    }
    // Navigable options: shown by the filter and not disabled.
    const visible = () => options.filter((o) => !o.hidden && o.getAttribute('aria-disabled') !== 'true')
    const labelOf = (o: HTMLElement) => o.dataset.label ?? ''

    const open = () => {
      if (!isOpen()) list.showPopover()
      input.setAttribute('aria-expanded', 'true')
      cb.dataset.open = 'true'
    }
    const close = () => {
      if (isOpen()) list.hidePopover()
      input.setAttribute('aria-expanded', 'false')
      cb.dataset.open = 'false'
      setActive(-1)
    }
    const setActive = (i: number) => {
      const vis = visible()
      options.forEach((o) => o.setAttribute('aria-selected', 'false'))
      active = i
      const el = i >= 0 ? vis[i] : undefined
      if (el) {
        el.setAttribute('aria-selected', 'true')
        input.setAttribute('aria-activedescendant', el.id)
        el.scrollIntoView({ block: 'nearest' })
      } else {
        input.removeAttribute('aria-activedescendant')
      }
    }
    const showAll = () => options.forEach((o) => (o.hidden = o.dataset.chosen !== undefined))
    // The option nearest the current text: a prefix match wins, else first.
    const matchIndex = () => {
      const q = input.value.trim().toLowerCase()
      const vis = visible()
      if (!q) return vis.length ? 0 : -1
      const pre = vis.findIndex((o) => labelOf(o).toLowerCase().startsWith(q))
      return pre >= 0 ? pre : vis.length ? 0 : -1
    }
    const filter = () => {
      const q = input.value.trim().toLowerCase()
      for (const o of options) o.hidden = o.dataset.chosen !== undefined || (q !== '' && !labelOf(o).toLowerCase().includes(q))
      setActive(matchIndex())
    }
    const commit = (o: HTMLElement) => {
      const value = o.dataset.value ?? ''
      const label = labelOf(o)
      if (multiple) {
        // Keep picking: the list stays open with the chosen option gone.
        addChip(o)
        input.value = ''
        showAll()
        setActive(matchIndex())
        input.focus()
        cb.dispatchEvent(new CustomEvent('apogee:combobox-select', { bubbles: true, detail: { value, label } }))
        return
      }
      input.value = label
      close()
      input.dispatchEvent(new Event('input', { bubbles: true }))
      input.dispatchEvent(new Event('change', { bubbles: true }))
      cb.dispatchEvent(new CustomEvent('apogee:combobox-select', { bubbles: true, detail: { value, label } }))
    }

    input.addEventListener('focus', () => {
      open()
      showAll()
      setActive(matchIndex())
    })
    // A click on the already-focused input reopens a closed list.
    input.addEventListener('click', () => {
      if (isOpen()) return
      open()
      showAll()
      setActive(matchIndex())
    })
    input.addEventListener('input', (e) => {
      if (!e.isTrusted) return // our own commit event, not typing
      open()
      filter()
    })
    input.addEventListener('keydown', (e) => {
      const vis = visible()
      if (e.key === 'ArrowDown') {
        e.preventDefault()
        // Opening resets the list, so count and highlight after the reset.
        if (!isOpen()) {
          open()
          showAll()
          setActive(matchIndex())
        } else if (vis.length) setActive((active + 1) % vis.length)
      } else if (e.key === 'ArrowUp') {
        e.preventDefault()
        if (vis.length) setActive((active - 1 + vis.length) % vis.length)
      } else if (e.key === 'Enter') {
        const v = active >= 0 ? vis[active] : undefined
        if (isOpen() && v) {
          e.preventDefault()
          commit(v)
        }
      } else if (e.key === 'Escape') {
        close()
      } else if (e.key === 'Backspace' && multiple && input.value === '') {
        const last = chipsOf().at(-1)
        if (last) removeChip(last)
      }
    })

    // Keep focus on the input when clicking an option (so it doesn't close first).
    list.addEventListener('mousedown', (e) => e.preventDefault())
    options.forEach((o) =>
      o.addEventListener('click', () => {
        if (o.getAttribute('aria-disabled') === 'true') return
        commit(o)
        input.focus()
      }),
    )

    // Close when focus leaves the whole widget (Tab away, click elsewhere).
    cb.addEventListener('focusout', (e) => {
      if (!cb.contains(e.relatedTarget as Node)) close()
    })
  })
</script>
