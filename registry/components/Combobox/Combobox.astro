---
/**
 * Combobox — a text input with a styled, filterable dropdown of suggestions.
 * A real editable ARIA combobox (the platform can't style a `<datalist>` popup),
 * so it's a JS island: without JS the input still works as a plain text field.
 * The listbox is a `popover="manual"` panel anchored under the input (top
 * layer, as wide as the input, scrolls past 15rem).
 *
 * Typing filters the list and highlights the closest match (prefers a prefix
 * match); Enter or click commits its label into the input. Free-typing is
 * allowed. Options are strings or `{ value, label?, description?, disabled? }`.
 * Renders a full accessible field (label + hint/error) via Field, like Input.
 */
import type { HTMLAttributes } from 'astro/types'
import { uid } from '../utils/uid.ts'
import Field from '../Field/Field.astro'
import { fieldSizes, fieldVariants, fieldBase, type FieldSize, type FieldVariant } from '../utils/field.ts'
import { panelStyle, panelClass, panelSurface, menuClass, itemBase, itemSizes, itemColors } from '../utils/panel.ts'
import { ChevronDown } from '@lucide/astro'

export interface ComboboxOption {
  value: string
  /** Shown in the list and written into the input; defaults to `value`. */
  label?: string
  description?: string
  disabled?: boolean
}

/** @composable */
interface Props extends Omit<HTMLAttributes<'input'>, 'size'> {
  id?: string
  label?: string
  hint?: string
  error?: string
  /** Suggestions shown in the dropdown. */
  options: (string | ComboboxOption)[]
  /** Marks the field invalid without a message. */
  hasError?: boolean
  /** @category layout */
  size?: FieldSize
  /** @category layout */
  variant?: FieldVariant
  required?: boolean
  /** Show the chevron caret. Set false to hide it. */
  caret?: boolean
  class?: string
}

const {
  id: idProp,
  label,
  hint,
  error,
  options,
  hasError = false,
  size = 'medium',
  variant = 'outline',
  required = false,
  caret = true,
  class: className,
  ...rest
} = Astro.props
const id = idProp ?? uid(Astro.locals)
const listId = `${id}-list`
const anchor = `--${id}`
const describedby = error ? `${id}-error` : hint ? `${id}-hint` : undefined
const items = options.map((o) => (typeof o === 'string' ? { value: o, label: o } : { ...o, label: o.label ?? o.value }))
const optionSize = { small: 'small', medium: 'medium', large: 'medium', xlarge: 'large' } as const
---

<Field id={id} label={label} hint={hint} error={error} required={required} class={className}>
  <div class="apogee-combobox relative" data-open="false" style={`anchor-name: ${anchor}`}>
    <input
      id={id}
      type="text"
      role="combobox"
      aria-expanded="false"
      aria-controls={listId}
      aria-autocomplete="list"
      autocomplete="off"
      required={required}
      aria-describedby={describedby}
      aria-invalid={error || hasError ? 'true' : undefined}
      class:list={[fieldBase, fieldVariants[variant], fieldSizes[size], caret && 'pe-9']}
      {...rest}
    />
    {
      caret && (
        <ChevronDown
          class="pointer-events-none absolute top-1/2 end-3 size-4 -translate-y-1/2 text-neutral-faded"
          aria-hidden="true"
        />
      )
    }
    <ul
      id={listId}
      popover="manual"
      role="listbox"
      style={panelStyle({ anchor, placement: 'bottom-start', gap: 1, width: 'trigger', maxHeight: '15rem' })}
      class:list={[panelClass, panelSurface.overlay, menuClass, 'overflow-auto']}
    >
      {
        items.map((o, i) => (
          <li
            id={`${listId}-${i}`}
            role="option"
            aria-selected="false"
            aria-disabled={o.disabled ? 'true' : undefined}
            data-value={o.value}
            data-label={o.label}
            class:list={['cursor-pointer', itemBase, itemSizes[optionSize[size]], itemColors.neutral, 'aria-selected:bg-neutral-faded']}
          >
            <span class="flex-1">
              {o.label}
              {o.description && <span class="block text-xs text-neutral-faded">{o.description}</span>}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</Field>

<script>
  import { island } from '../utils/island.ts'

  island('.apogee-combobox', (cb) => {
    const input = cb.querySelector<HTMLInputElement>('input[role="combobox"]')
    const list = cb.querySelector<HTMLElement>('[role="listbox"]')
    const options = [...cb.querySelectorAll<HTMLElement>('[role="option"]')]
    if (!input || !list || !options.length) return

    let active = -1
    const isOpen = () => list.matches(':popover-open')
    // Navigable options: shown by the filter and not disabled.
    const visible = () => options.filter((o) => !o.hidden && o.getAttribute('aria-disabled') !== 'true')
    const labelOf = (o: HTMLElement) => o.dataset.label ?? ''

    const open = () => {
      if (!isOpen()) list.showPopover()
      input.setAttribute('aria-expanded', 'true')
      cb.dataset.open = 'true'
    }
    const close = () => {
      if (isOpen()) list.hidePopover()
      input.setAttribute('aria-expanded', 'false')
      cb.dataset.open = 'false'
      setActive(-1)
    }
    const setActive = (i: number) => {
      const vis = visible()
      options.forEach((o) => o.setAttribute('aria-selected', 'false'))
      active = i
      const el = i >= 0 ? vis[i] : undefined
      if (el) {
        el.setAttribute('aria-selected', 'true')
        input.setAttribute('aria-activedescendant', el.id)
        el.scrollIntoView({ block: 'nearest' })
      } else {
        input.removeAttribute('aria-activedescendant')
      }
    }
    const showAll = () => options.forEach((o) => (o.hidden = false))
    // The option nearest the current text: a prefix match wins, else first.
    const matchIndex = () => {
      const q = input.value.trim().toLowerCase()
      const vis = visible()
      if (!q) return vis.length ? 0 : -1
      const pre = vis.findIndex((o) => labelOf(o).toLowerCase().startsWith(q))
      return pre >= 0 ? pre : vis.length ? 0 : -1
    }
    const filter = () => {
      const q = input.value.trim().toLowerCase()
      for (const o of options) o.hidden = q !== '' && !labelOf(o).toLowerCase().includes(q)
      setActive(matchIndex())
    }
    const commit = (o: HTMLElement) => {
      const value = o.dataset.value ?? ''
      const label = labelOf(o)
      input.value = label
      close()
      input.dispatchEvent(new Event('input', { bubbles: true }))
      input.dispatchEvent(new Event('change', { bubbles: true }))
      cb.dispatchEvent(new CustomEvent('apogee:combobox-select', { bubbles: true, detail: { value, label } }))
    }

    input.addEventListener('focus', () => {
      open()
      showAll()
      setActive(matchIndex())
    })
    input.addEventListener('input', (e) => {
      if (!e.isTrusted) return // our own commit event, not typing
      open()
      filter()
    })
    input.addEventListener('keydown', (e) => {
      const vis = visible()
      if (e.key === 'ArrowDown') {
        e.preventDefault()
        if (!isOpen()) {
          open()
          showAll()
        }
        if (vis.length) setActive((active + 1) % vis.length)
      } else if (e.key === 'ArrowUp') {
        e.preventDefault()
        if (vis.length) setActive((active - 1 + vis.length) % vis.length)
      } else if (e.key === 'Enter') {
        const v = active >= 0 ? vis[active] : undefined
        if (isOpen() && v) {
          e.preventDefault()
          commit(v)
        }
      } else if (e.key === 'Escape') {
        close()
      }
    })

    // Keep focus on the input when clicking an option (so it doesn't close first).
    list.addEventListener('mousedown', (e) => e.preventDefault())
    options.forEach((o) =>
      o.addEventListener('click', () => {
        if (o.getAttribute('aria-disabled') === 'true') return
        commit(o)
        input.focus()
      }),
    )

    // Close when focus leaves the whole widget (Tab away, click elsewhere).
    cb.addEventListener('focusout', (e) => {
      if (!cb.contains(e.relatedTarget as Node)) close()
    })
  })
</script>
