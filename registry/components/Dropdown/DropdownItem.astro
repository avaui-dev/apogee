---
/**
 * DropdownItem — a menu item. A link when `href` is set, otherwise a button.
 * Slots: `start` (icon), default (label), `end` (shortcut, badge).
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'
import { itemBase, itemSizes, itemColors, itemSelected, type ItemSize, type ItemColor } from '../utils/panel.ts'
interface Props extends HTMLAttributes<'button'> {
  href?: string
  color?: ItemColor
  /** @category layout */
  size?: ItemSize
  /** The chosen item (`aria-current`). */
  selected?: boolean
  disabled?: boolean
  class?: string
}

const { href, color = 'neutral', size = 'medium', selected = false, disabled = false, class: className, ...rest } = Astro.props
const Tag = href ? 'a' : 'button'
---

<Tag
  href={disabled ? undefined : href}
  type={href ? undefined : 'button'}
  role="menuitem"
  disabled={!href && disabled ? true : undefined}
  aria-disabled={href && disabled ? 'true' : undefined}
  tabindex={href && disabled ? -1 : undefined}
  aria-current={selected ? 'true' : undefined}
  class:list={[itemBase, itemSizes[size], itemColors[color], selected && itemSelected[color], className]}
  {...rest}
>
  {Astro.slots.has('start') && <span class="inline-flex shrink-0 text-neutral-faded"><slot name="start" /></span>}
  <slot />
  {Astro.slots.has('end') && <span class="ms-auto inline-flex shrink-0 ps-4 text-xs text-neutral-faded"><slot name="end" /></span>}
</Tag>
