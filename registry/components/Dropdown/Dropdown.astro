---
/**
 * Dropdown — a menu on the native Popover API: open/close and light dismiss
 * are native (zero JS); the island adds the menu keyboard pattern, close on
 * item activation, and submenu hover. Put `DropdownItem`s, `DropdownSection`s
 * and `DropdownSub`s in the slot. Slots: `anchor` (your own trigger with
 * `popovertarget={id}`), default (menu).
 */
import type { HTMLAttributes } from 'astro/types'
import { ChevronDown } from '@lucide/astro'
import { uid } from '../utils/uid.ts'
import { panelStyle, panelClass, panelSurface, menuClass, type Placement } from '../utils/panel.ts'

/** @composable */
interface Props extends HTMLAttributes<'div'> {
  label: string
  /** Menu id; set it when an `anchor` slot element needs `popovertarget`. */
  id?: string
  /** @category layout */
  placement?: Placement
  /** `'trigger'` matches the trigger's width; any CSS length otherwise. */
  width?: 'trigger' | string
  /** Scrolls the menu past this height. */
  maxHeight?: string
  class?: string
}

const { label, id: idProp, placement = 'bottom-start', width, maxHeight, class: className, ...rest } = Astro.props
const id = idProp ?? uid(Astro.locals, 'apogee-dd')
const anchor = `--${id}`
---

<div class:list={['apogee-dropdown inline-block', className]} {...rest}>
  {
    Astro.slots.has('anchor') ? (
      <span class="inline-flex" style={`anchor-name: ${anchor}`}>
        <slot name="anchor" />
      </span>
    ) : (
      <button
        type="button"
        popovertarget={id}
        aria-haspopup="menu"
        style={`anchor-name: ${anchor}`}
        class="apogee-dropdown-trigger inline-flex h-10 items-center gap-2 rounded-md border border-neutral bg-page px-3 text-sm font-medium text-neutral hover:bg-neutral-faded-highlighted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >
        {label}
        <ChevronDown class="size-4 text-neutral-faded transition-transform" aria-hidden="true" />
      </button>
    )
  }
  <div
    id={id}
    popover
    role="menu"
    aria-label={label}
    style={panelStyle({ anchor, placement, gap: 1.5, width, maxHeight })}
    class:list={[panelClass, panelSurface.overlay, menuClass, 'min-w-48', maxHeight && 'overflow-auto']}
  >
    <slot />
  </div>
</div>

<style>
  .apogee-dropdown-trigger:has(+ :popover-open) svg {
    rotate: 180deg;
  }
</style>

<script>
  import { island } from '../utils/island.ts'
  import { menuKeydown, menuItems, restoreFocus } from '../utils/menu.ts'

  island('.apogee-dropdown', (root) => {
    const menu = root.querySelector<HTMLElement>(':scope > [role="menu"]')
    const trigger = root.querySelector<HTMLElement>(':scope > button, :scope > span > *')
    if (!menu) return
    if (trigger) restoreFocus(menu, trigger)

    menu.addEventListener('toggle', (e) => {
      const open = (e as ToggleEvent).newState === 'open'
      root.dispatchEvent(new CustomEvent(open ? 'apogee:dropdown-open' : 'apogee:dropdown-close', { bubbles: true }))
    })

    root.addEventListener('keydown', (e) => {
      const active = document.activeElement as HTMLElement | null
      // ArrowDown on the closed trigger opens the menu and lands on the first item.
      if (active === trigger && e.key === 'ArrowDown' && !menu.matches(':popover-open')) {
        e.preventDefault()
        menu.showPopover()
        menuItems(menu)[0]?.focus()
        return
      }
      const current = active?.closest<HTMLElement>('[role="menu"]')
      if (!current || !root.contains(current)) return
      if (e.key === 'ArrowRight' && active?.hasAttribute('popovertarget')) {
        e.preventDefault()
        const panel = active.closest('.apogee-dropdown-sub')?.querySelector<HTMLElement>(':scope > [role="menu"]')
        if (!panel) return
        if (!panel.matches(':popover-open')) panel.showPopover()
        menuItems(panel)[0]?.focus()
      } else if (e.key === 'ArrowLeft' && current !== menu) {
        e.preventDefault()
        current.hidePopover()
        current.closest('.apogee-dropdown-sub')?.querySelector<HTMLElement>(':scope > [role="menuitem"]')?.focus()
      } else menuKeydown(e, current)
    })

    // Activating an item closes the whole chain (links navigate as well).
    root.addEventListener('click', (e) => {
      const item = (e.target as Element).closest('[role="menuitem"]')
      if (item && !item.hasAttribute('popovertarget') && menu.matches(':popover-open')) menu.hidePopover()
    })

    // Submenus open on hover with a short delay; leaving trigger and panel closes them.
    for (const sub of root.querySelectorAll<HTMLElement>('.apogee-dropdown-sub')) {
      const panel = sub.querySelector<HTMLElement>(':scope > [role="menu"]')
      const subTrigger = sub.querySelector<HTMLElement>(':scope > [role="menuitem"]')
      if (!panel || !subTrigger) continue
      restoreFocus(panel, subTrigger)
      let t: ReturnType<typeof setTimeout> | undefined
      sub.addEventListener('pointerenter', () => {
        clearTimeout(t)
        // Only while the root menu is still open: a click that closed the chain must not reopen the sub.
        t = setTimeout(() => menu.matches(':popover-open') && !panel.matches(':popover-open') && panel.showPopover(), 100)
      })
      sub.addEventListener('pointerleave', () => {
        clearTimeout(t)
        t = setTimeout(() => panel.matches(':popover-open') && panel.hidePopover(), 150)
      })
    }
  })
</script>
