---
/**
 * Dropdown — a menu on native `<details>`. Open/close is native; a small island
 * adds the expected close-on-outside-click and Escape (progressive enhancement —
 * it works without JS, just doesn't auto-close). Put `DropdownItem`s in the slot.
 *
 * @composable
 */
import { ChevronDown } from '@lucide/astro'

interface Props {
  label: string
  /** Which edge the menu aligns to. */
  align?: 'start' | 'end'
  class?: string
}

const { label, align = 'start', class: className, ...rest } = Astro.props
---

<details class:list={['apogee-dropdown group relative inline-block', className]} {...rest}>
  <summary
    class="inline-flex h-10 cursor-pointer list-none items-center gap-2 rounded-md border border-border bg-background px-3 text-sm font-medium text-foreground hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring [&::-webkit-details-marker]:hidden"
  >
    {label}
    <ChevronDown class="size-4 text-muted-foreground transition-transform group-open:rotate-180" aria-hidden="true" />
  </summary>
  <div
    role="menu"
    class:list={[
      'apogee-dropdown-menu absolute z-20 flex min-w-48 flex-col gap-0.5 rounded-md border border-border bg-surface p-1 shadow-lg',
      align === 'end' ? 'end-0' : 'start-0',
    ]}
  >
    <slot />
  </div>
</details>

<style>
  .apogee-dropdown-menu {
    top: 100%;
    margin-top: 0.375rem;
    transform-origin: top;
  }
  /* Flipped above the trigger when there isn't room below (set by the island). */
  .apogee-dropdown--up .apogee-dropdown-menu {
    top: auto;
    bottom: 100%;
    margin-top: 0;
    margin-bottom: 0.375rem;
    transform-origin: bottom;
  }
  .apogee-dropdown[open] .apogee-dropdown-menu {
    animation: apogee-dropdown-in var(--duration-fast) var(--ease-smooth);
  }
  @keyframes apogee-dropdown-in {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .apogee-dropdown[open] .apogee-dropdown-menu {
      animation: none;
    }
  }
</style>

<script>
  // Flip the menu above the trigger when there isn't room below the viewport.
  for (const d of document.querySelectorAll<HTMLDetailsElement>('details.apogee-dropdown')) {
    d.addEventListener('toggle', () => {
      if (!d.open) return
      const menu = d.querySelector<HTMLElement>('.apogee-dropdown-menu')
      if (!menu) return
      const rect = d.getBoundingClientRect()
      const below = window.innerHeight - rect.bottom
      const above = rect.top
      const needed = menu.offsetHeight + 8
      d.classList.toggle('apogee-dropdown--up', below < needed && above > below)
    })
  }

  // Progressive enhancement: close on outside-click and Escape.
  document.addEventListener('click', (event) => {
    for (const d of document.querySelectorAll<HTMLDetailsElement>('details.apogee-dropdown[open]')) {
      if (!d.contains(event.target as Node)) d.open = false
    }
  })
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return
    for (const d of document.querySelectorAll<HTMLDetailsElement>('details.apogee-dropdown[open]')) {
      d.open = false
      d.querySelector<HTMLElement>('summary')?.focus()
    }
  })
</script>
