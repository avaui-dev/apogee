---
/**
 * Slider — a styled native range input with a live percentage badge.
 * The input works with zero JS; the badge is a small island (progressive
 * enhancement — `no-js:hidden`, since the range is fully usable without it).
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'

const colors = {
  primary: 'var(--background-primary)',
  neutral: 'var(--background-neutral)',
  critical: 'var(--background-critical)',
  positive: 'var(--background-positive)',
  warning: 'var(--background-warning)',
} as const

interface Props extends HTMLAttributes<'div'> {
  name?: string
  min?: number
  max?: number
  step?: number
  value?: number
  disabled?: boolean
  /** Hue of the filled track and thumb. @category layout */
  color?: keyof typeof colors
  /** Where the live % badge sits relative to the track. */
  labelPosition?: 'top' | 'bottom'
  'aria-label'?: string
  class?: string
}

const {
  min = 0,
  max = 100,
  step = 1,
  value,
  color = 'primary',
  labelPosition = 'top',
  class: className,
  ...rest
} = Astro.props

// Initial fill, so the coloured track is correct before (and without) JS.
// A range with no `value` sits at its midpoint.
const current = value ?? (min + max) / 2
const fill = max > min ? ((current - min) / (max - min)) * 100 : 0
---

<div class:list={['apogee-slider-field relative', className]} data-label-position={labelPosition}>
  <input
    type="range"
    class="apogee-slider w-full"
    min={min}
    max={max}
    step={step}
    value={value}
    style={`--apogee-fill: ${fill}%; --apogee-color: ${colors[color]}`}
    {...rest}
  />
  <span
    class="apogee-slider-badge pointer-events-none absolute -translate-x-1/2 rtl:translate-x-1/2 rounded-md bg-inverted px-1.5 py-0.5 text-xs font-medium text-on-inverted tabular-nums no-js:hidden"
    aria-hidden="true">0%</span>
</div>

<style>
  /* Custom track + thumb. Native range styling needs vendor pseudo-elements —
     the one place Tailwind can't reach, so scoped CSS reads the tokens directly.
     Thumb is sized for touch (1.5rem). */
  .apogee-slider {
    -webkit-appearance: none;
    appearance: none;
    height: 1.5rem;
    background: transparent;
    cursor: pointer;
  }
  .apogee-slider:dir(rtl) {
    --apogee-dir: to left;
  }
  .apogee-slider:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  /* Filled portion (the `color` hue) up to the thumb, neutral after — driven by
     --apogee-fill (set server-side, updated live by the island). */
  .apogee-slider::-webkit-slider-runnable-track {
    height: 0.5rem;
    border-radius: 9999px;
    background: linear-gradient(
      var(--apogee-dir, to right),
      var(--apogee-color) 0 var(--apogee-fill, 0%),
      var(--background-neutral) var(--apogee-fill, 0%) 100%
    );
  }
  .apogee-slider::-moz-range-track {
    height: 0.5rem;
    border-radius: 9999px;
    background: linear-gradient(
      var(--apogee-dir, to right),
      var(--apogee-color) 0 var(--apogee-fill, 0%),
      var(--background-neutral) var(--apogee-fill, 0%) 100%
    );
  }

  .apogee-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    margin-top: -0.5rem;
    height: 1.5rem;
    width: 1.5rem;
    border-radius: 9999px;
    background: var(--apogee-color);
    border: 2px solid var(--background-page);
    box-shadow: 0 0 0 2px var(--apogee-color);
  }
  .apogee-slider::-moz-range-thumb {
    height: 1.5rem;
    width: 1.5rem;
    border-radius: 9999px;
    background: var(--apogee-color);
    border: 2px solid var(--background-page);
    box-shadow: 0 0 0 2px var(--apogee-color);
  }

  .apogee-slider:focus-visible::-webkit-slider-thumb {
    outline: 2px solid var(--border-primary);
    outline-offset: 2px;
  }
  .apogee-slider:focus-visible::-moz-range-thumb {
    outline: 2px solid var(--border-primary);
    outline-offset: 2px;
  }

  /* Badge sits above (default) or below the track. Anchored to the track's
     centre (50%) and pushed clear of the 1.5rem thumb, so it never covers it. */
  .apogee-slider-field[data-label-position='top'] .apogee-slider-badge {
    bottom: 50%;
    margin-bottom: 1.25rem;
  }
  .apogee-slider-field[data-label-position='bottom'] .apogee-slider-badge {
    top: 50%;
    margin-top: 1.25rem;
  }
</style>

<script>
  import { island } from '../utils/island.ts'

  const THUMB = 24 // px — keep in sync with the thumb size above
  island('.apogee-slider-field', (field) => {
    const input = field.querySelector<HTMLInputElement>('.apogee-slider')
    const badge = field.querySelector<HTMLElement>('.apogee-slider-badge')
    if (!input || !badge) return
    const update = () => {
      const min = Number(input.min || 0)
      const max = Number(input.max || 100)
      const fraction = max > min ? (Number(input.value) - min) / (max - min) : 0
      const percent = fraction * 100
      badge.textContent = `${Math.round(percent)}%`
      input.style.setProperty('--apogee-fill', `${percent}%`)
      // Center the badge over the thumb, correcting for the thumb's own width.
      badge.style.insetInlineStart = `calc(${percent}% + ${(0.5 - fraction) * THUMB}px)`
    }
    update()
    input.addEventListener('input', update)
  })
</script>
