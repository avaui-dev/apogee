---
/**
 * Badge — a small status label.
 *
 * @composable
 */
interface Props {
  variant?: 'neutral' | 'accent' | 'danger' | 'outline'
  class?: string
}

const { variant = 'neutral', class: className, ...rest } = Astro.props

const variants = {
  neutral: 'bg-muted text-muted-foreground',
  accent: 'bg-accent text-accent-foreground',
  danger: 'bg-danger text-danger-foreground',
  outline: 'border border-border text-foreground',
}
---

<span
  class:list={['inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium', variants[variant], className]}
  {...rest}
>
  <slot />
</span>
