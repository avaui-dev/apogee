---
/**
 * Badge — a small status label. `color` is the hue, `variant` the fill style.
 * Icons go in the `start` / `end` slots.
 */
import type { HTMLAttributes } from 'astro/types'

const styles = {
  solid: {
    primary: 'bg-primary text-on-primary',
    neutral: 'bg-neutral text-on-neutral',
    critical: 'bg-critical text-on-critical',
    positive: 'bg-positive text-on-positive',
    warning: 'bg-warning text-on-warning',
  },
  faded: {
    primary: 'bg-primary-faded text-primary',
    neutral: 'bg-neutral-faded text-neutral',
    critical: 'bg-critical-faded text-critical',
    positive: 'bg-positive-faded text-positive',
    warning: 'bg-warning-faded text-warning',
  },
  outline: {
    primary: 'border border-primary text-primary',
    neutral: 'border border-neutral text-neutral',
    critical: 'border border-critical text-critical',
    positive: 'border border-positive text-positive',
    warning: 'border border-warning text-warning',
  },
} as const
// The side that holds an icon pads less, so the glyph sits optically inside the pill.
const sizes = {
  small: 'h-5 px-1.5 text-[11px] gap-1 has-[>[data-slot=start]]:ps-1 has-[>[data-slot=end]]:pe-1',
  medium: 'h-6 px-2 text-xs gap-1 has-[>[data-slot=start]]:ps-1.5 has-[>[data-slot=end]]:pe-1.5',
  large: 'h-7 px-2.5 text-sm gap-1.5 has-[>[data-slot=start]]:ps-2 has-[>[data-slot=end]]:pe-2',
} as const

/** @composable */
interface Props extends HTMLAttributes<'span'> {
  /** Hue. @category layout */
  color?: keyof typeof styles.solid
  /** Fill style. @category layout */
  variant?: keyof typeof styles
  /** @category layout */
  size?: keyof typeof sizes
  /** Fully round ends. @category layout */
  rounded?: boolean
  /** Stronger fill for an active filter or a selected state. @category layout */
  highlighted?: boolean
  /** Clamp long labels with an ellipsis. @category layout */
  truncate?: boolean
  class?: string
}

const highlights = {
  solid: {
    primary: 'bg-primary-highlighted',
    neutral: 'bg-neutral-highlighted',
    critical: 'bg-critical-highlighted',
    positive: 'bg-positive-highlighted',
    warning: 'bg-warning-highlighted',
  },
  faded: {
    primary: 'bg-primary-faded-highlighted',
    neutral: 'bg-neutral-faded-highlighted',
    critical: 'bg-critical-faded-highlighted',
    positive: 'bg-positive-faded-highlighted',
    warning: 'bg-warning-faded-highlighted',
  },
  outline: {
    primary: 'bg-primary-faded',
    neutral: 'bg-neutral-faded',
    critical: 'bg-critical-faded',
    positive: 'bg-positive-faded',
    warning: 'bg-warning-faded',
  },
} as const

const { color = 'neutral', variant = 'faded', size = 'medium', rounded = false, highlighted = false, truncate = false, class: className, ...rest } = Astro.props
// No content at all: render a dot indicator instead of an empty pill.
const empty = !Astro.slots.has('default') && !Astro.slots.has('start') && !Astro.slots.has('end')
---

{
  empty ? (
    <span class:list={['inline-block size-2 rounded-full', styles.solid[color], className]} aria-hidden="true" {...rest} />
  ) : (
    <span
      class:list={[
        'inline-flex items-center whitespace-nowrap font-medium tabular-nums [&_svg]:size-3.5',
        rounded ? 'rounded-full' : 'rounded-sm',
        styles[variant][color],
        highlighted && highlights[variant][color],
        truncate && 'max-w-40',
        sizes[size],
        className,
      ]}
      {...rest}
    >
      {Astro.slots.has('start') && <span data-slot="start" class="inline-flex"><slot name="start" /></span>}
      {truncate ? <span class="truncate"><slot /></span> : <slot />}
      {Astro.slots.has('end') && <span data-slot="end" class="inline-flex"><slot name="end" /></span>}
    </span>
  )
}
