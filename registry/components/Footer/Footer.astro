---
/**
 * Footer — a site footer shell. Put your columns (a Grid of link lists) in the
 * default slot, and a copyright / bottom row in the `bottom` slot. Zero JS.
 */
import type { HTMLAttributes } from 'astro/types'
/** @composable */
interface Props extends HTMLAttributes<'footer'> {
  class?: string | undefined
}

const { class: className, ...rest } = Astro.props
const hasBottom = Astro.slots.has('bottom')
---

<footer class:list={['border-t border-neutral', className]} {...rest}>
  <div class="mx-auto max-w-7xl px-gutter py-12">
    <slot />
    {
      hasBottom && (
        <div class="mt-10 flex flex-col gap-2 border-t border-neutral pt-6 text-sm text-neutral-faded sm:flex-row sm:items-center sm:justify-between">
          <slot name="bottom" />
        </div>
      )
    }
  </div>
</footer>
