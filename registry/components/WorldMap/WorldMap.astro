---
/**
 * WorldMap — a dotted world map with pins for your offices. `region` shows
 * one continent on its own grid: only that continent's land, framed tightly,
 * with dots the same size as every other region's; where land runs on past the
 * frame (Russia beyond Europe), it fades out. Each pin is a link to that place on a full map, with a tooltip
 * naming it and its address on hover or focus. The dots are decoration; the pins carry the meaning. Pins
 * sit by latitude and longitude (84°N to 60°S). Zero JS of its own (the
 * tooltips use Tooltip's small island, and work without it).
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'
import Tooltip from '../Tooltip/Tooltip.astro'
import { maps } from './land.ts'

type Pin = { label: string; lat: number; lon: number; detail?: string | undefined; href?: string | undefined }
type Region = keyof typeof maps

/** @composable */
interface Props extends HTMLAttributes<'div'> {
  /** @shape { label: string, lat: number, lon: number, detail?: string, href?: string }[] @category content */
  pins: Pin[]
  /** Names the map for screen readers. @category content */
  label?: string
  /** The whole world or one continent. @category layout */
  region?: Region
  class?: string
}

const { pins, label = 'Our offices', region = 'world', class: className, ...rest } = Astro.props
// Each region is its own grid of dots, in cell units; pins sit by its bounds.
const { west, east, north, south, cols, rows, fade, d } = maps[region]
// Where land runs on past the frame, its dots fade out instead of stopping at a hard edge.
const across = fade.west || fade.east ? `linear-gradient(to right, ${fade.west ? 'transparent, black 15%' : 'black'}, ${fade.east ? 'black 85%, transparent' : 'black'})` : ''
const down = fade.north || fade.south ? `linear-gradient(to bottom, ${fade.north ? 'transparent, black 15%' : 'black'}, ${fade.south ? 'black 85%, transparent' : 'black'})` : ''
const masks = [across, down].filter(Boolean)
const maskStyle = masks.length ? `mask-image: ${masks.join(', ')}; mask-composite: intersect` : undefined
const x = (lon: number) => ((lon - west) / (east - west)) * 100
const y = (lat: number) => ((north - lat) / (north - south)) * 100
const mapHref = (p: Pin) => p.href ?? `https://www.openstreetmap.org/?mlat=${p.lat}&mlon=${p.lon}#map=12/${p.lat}/${p.lon}`
---

<div role="group" aria-label={label} class:list={['apogee-world-map relative w-full', className]} style={`aspect-ratio: ${cols} / ${rows}`} data-region={region} {...rest}>
  <svg viewBox={`0 0 ${cols} ${rows}`} class="absolute inset-0 size-full overflow-hidden text-neutral-faded" style={maskStyle} aria-hidden="true" focusable="false">
    <path d={d} fill="none" stroke="currentColor" stroke-width="0.6" stroke-dasharray="0 1" stroke-linecap="round" opacity="0.5" />
  </svg>
  <ul class="m-0 list-none p-0">
    {
      pins.map((p) => (
        <li class="absolute -translate-x-1/2 -translate-y-1/2" style={`left: ${x(p.lon).toFixed(2)}%; top: ${y(p.lat).toFixed(2)}%`}>
          <Tooltip text={p.label} description={p.detail} placement="top">
            <a
              href={mapHref(p)}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${p.label}${p.detail ? `, ${p.detail}` : ''} (opens a map in a new tab)`}
              class="grid size-6 place-items-center rounded-full bg-primary/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
            >
              <span class="size-2.5 rounded-full bg-primary shadow-[0_0_0_2px_var(--background-page)]" />
            </a>
          </Tooltip>
        </li>
      ))
    }
  </ul>
</div>
