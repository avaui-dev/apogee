---
/**
 * Tooltip — a hint shown on hover / focus. Zero JS (CSS only). Wrap a focusable
 * trigger (button/link) so keyboard users get it too.
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'
import { uid } from '../utils/uid.ts'
interface Props extends HTMLAttributes<'span'> {
  text: string
  class?: string
}

const { text, class: className, ...rest } = Astro.props
const id = uid(Astro.locals, 'apogee-tt')
---

{
  !text ? (
    <slot />
  ) : (
<span class:list={['group relative inline-flex', className]} {...rest}>
  <span class="inline-flex" aria-describedby={id}>
    <slot />
  </span>
  <span
    role="tooltip"
    id={id}
    class="pointer-events-none absolute bottom-full left-1/2 mb-1.5 w-max max-w-80 -translate-x-1/2 translate-y-1 text-center whitespace-normal rounded-md bg-inverted px-2 py-1 text-xs text-on-inverted opacity-0 transition group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:translate-y-0 group-focus-within:opacity-100"
  >
    {text}
  </span>
</span>
  )
}
