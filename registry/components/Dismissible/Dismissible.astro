---
/**
 * Dismissible — wraps any content with a close button. Clicking it dispatches a
 * cancelable, bubbling `apogee:dismiss` event on the root and, unless cancelled,
 * removes the element. `timeout` auto-dismisses after N ms (a small island).
 * Without JS the button is hidden and the content simply stays.

 */
import type { HTMLAttributes } from 'astro/types'
import { X } from '@lucide/astro'

/** @composable */
interface Props extends HTMLAttributes<'div'> {
  /** Auto-dismiss after this many milliseconds. */
  timeout?: number
  /** Accessible label for the close button. @category content */
  closeLabel?: string
  class?: string
}

const { timeout, closeLabel = 'Dismiss', class: className, ...rest } = Astro.props
---

<div class:list={['relative', className]} data-apogee-dismissible data-timeout={timeout} {...rest}>
  <slot />
  <button
    type="button"
    aria-label={closeLabel}
    data-dismiss
    class="absolute end-2 top-2 grid size-7 place-items-center rounded-md text-neutral-faded transition-colors hover:bg-neutral-faded-highlighted hover:text-neutral focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary no-js:hidden"
  >
    <X class="size-4" aria-hidden="true" />
  </button>
</div>

<script>
  import { island } from '../utils/island.ts'

  const dismiss = (root: HTMLElement) => {
    const notCancelled = root.dispatchEvent(new CustomEvent('apogee:dismiss', { bubbles: true, cancelable: true }))
    if (notCancelled) root.remove()
  }

  // Delegated once (Astro dedupes this module); the island only arms timeouts.
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return
    const root = event.target.closest('[data-dismiss]')?.closest<HTMLElement>('[data-apogee-dismissible]')
    if (root) dismiss(root)
  })

  island('[data-apogee-dismissible][data-timeout]', (root) => {
    const ms = Number(root.dataset.timeout)
    if (ms > 0) setTimeout(() => root.isConnected && dismiss(root), ms)
  })
</script>
