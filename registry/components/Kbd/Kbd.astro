---
/**
 * Kbd — a keyboard key. Zero JS.
 *
 *   Press <Kbd>⌘</Kbd> <Kbd>K</Kbd>
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'
interface Props extends HTMLAttributes<'span'> {
  class?: string
}

const { class: className, ...rest } = Astro.props
---

<kbd
  class:list={[
    'inline-flex h-5 min-w-5 items-center justify-center rounded border border-neutral bg-neutral-faded px-1.5 font-sans text-xs font-medium text-neutral-faded',
    className,
  ]}
  {...rest}
>
  <slot />
</kbd>
