---
/**
 * Eyebrow — a small label above a heading.
 */
import type { HTMLAttributes } from 'astro/types'

const colors = {
  primary: 'text-primary',
  neutral: 'text-neutral',
  'neutral-faded': 'text-neutral-faded',
  critical: 'text-critical',
  positive: 'text-positive',
  warning: 'text-warning',
  inherit: 'text-inherit',
} as const satisfies Record<NonNullable<Props['color']>, string>

const sizes = { small: 'text-xs', medium: 'text-sm', large: 'text-base' } as const satisfies Record<NonNullable<Props['size']>, string>
const weights = { regular: 'font-normal', medium: 'font-medium', semibold: 'font-semibold' } as const satisfies Record<NonNullable<Props['weight']>, string>

/** @composable */
interface Props extends Omit<HTMLAttributes<'span'>, 'as'> {
  as?: 'p' | 'span' | 'div'
  /** @category layout */
  color?: 'primary' | 'neutral' | 'neutral-faded' | 'critical' | 'positive' | 'warning' | 'inherit'
  /** @category layout */
  size?: 'small' | 'medium' | 'large'
  /** @category layout */
  weight?: 'regular' | 'medium' | 'semibold'
  /** All caps with letter-spacing; false keeps the text as written. @category layout */
  uppercase?: boolean
  class?: string
}

const { as = 'p', color = 'primary', size = 'medium', weight = 'medium', uppercase = true, class: className, ...rest } = Astro.props
const Tag = as
---

<Tag class:list={[sizes[size], weights[weight], uppercase ? 'uppercase tracking-wide' : 'normal-case tracking-normal', colors[color], className]} {...rest}>
  <slot />
</Tag>
