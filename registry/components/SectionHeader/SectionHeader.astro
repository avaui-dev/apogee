---
/**
 * SectionHeader — eyebrow, heading and description at the top of a section,
 * with the heading level, alignment and colours every section shares.
 * Pass the `id` the section's `aria-labelledby` points at.
 *
 * `size="small"` is the in-app form (a card top, a settings page); the
 * `actions` slot puts buttons beside the text (under it on phones);
 * `divider` closes the header with a rule.
 */
import type { HTMLAttributes } from 'astro/types'
import Eyebrow from '../Eyebrow/Eyebrow.astro'
import Heading from '../Heading/Heading.astro'
import Text from '../Text/Text.astro'

const eyebrows = { page: 'primary', 'neutral-faded': 'primary', 'primary-faded': 'primary', primary: 'inherit', inverted: 'inherit' } as const satisfies Record<NonNullable<Props['background']>, string>
const descriptions = { page: 'text-neutral-faded', 'neutral-faded': 'text-neutral-faded', 'primary-faded': 'text-neutral-faded', primary: 'opacity-85', inverted: 'opacity-85' } as const
const levels = { 1: 'h1', 2: 'h2', 3: 'h3', 4: 'h4' } as const

/** @composable */
interface Props extends HTMLAttributes<'div'> {
  /** @category content */
  eyebrow?: string | undefined
  /** @category content */
  heading: string
  /** @category content */
  description?: string | undefined
  /** Semantic heading level. @category layout */
  headingLevel?: 1 | 2 | 3 | 4 | undefined
  /** @category layout */
  align?: 'start' | 'center' | undefined
  /** The section background, to pick readable colours. @category layout */
  background?: 'page' | 'neutral-faded' | 'primary-faded' | 'primary' | 'inverted' | undefined
  /** `small` is the in-app size; `large` uses the display size (Hero). @category layout */
  size?: 'small' | 'medium' | 'large' | undefined
  /** A rule under the header. @category layout */
  divider?: boolean | undefined
  /** Id for the heading, for `aria-labelledby`. */
  id?: string | undefined
  class?: string | undefined
}

const {
  eyebrow,
  heading,
  description,
  headingLevel = 2,
  align = 'start',
  background = 'page',
  size = 'medium',
  divider = false,
  id,
  class: className,
  ...rest
} = Astro.props
const as = levels[headingLevel]
const visual =
  size === 'small' ? 'h4' : size === 'large' ? (headingLevel === 1 ? 'display' : 'h1') : headingLevel === 1 ? 'h1' : 'h2'
const textSize = size === 'large' ? 'large' : size === 'small' ? 'small' : 'medium'
const hasActions = Astro.slots.has('actions')
const centered = align === 'center'
---

<div
  class:list={[
    'apogee-section-header flex flex-col',
    hasActions ? 'gap-4 md:flex-row md:items-start md:justify-between' : '',
    centered && 'items-center text-center',
    hasActions && centered && 'md:flex-col md:items-center',
    divider && 'border-b border-neutral pb-5',
    className,
  ]}
  {...rest}
>
  <div
    class:list={[
      'flex min-w-0 max-w-prose flex-col',
      size === 'small' ? 'gap-1' : 'gap-3',
      hasActions && !centered && 'flex-1',
      centered && 'mx-auto items-center',
    ]}
  >
    {eyebrow && <Eyebrow as="p" color={eyebrows[background]}>{eyebrow}</Eyebrow>}
    <Heading as={as} size={visual} id={id}>{heading}</Heading>
    {description && <Text size={textSize} class={descriptions[background]}>{description}</Text>}
  </div>
  {
    hasActions && (
      <div class:list={['apogee-section-header-actions flex shrink-0 flex-wrap items-center gap-3', centered && 'justify-center']}>
        <slot name="actions" />
      </div>
    )
  }
</div>
