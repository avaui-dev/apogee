---
/**
 * Pagination — page links with prev/next and ellipses. Links only, zero JS.
 * `getHref` builds each page's URL (default `?page=<n>`). Below `md` the page
 * numbers give way to a "Page x of y" summary between the arrows.
 */
import type { HTMLAttributes } from 'astro/types'
import { ChevronLeft, ChevronRight } from '@lucide/astro'

/** @composable */
interface Props extends HTMLAttributes<'div'> {
  currentPage: number
  totalPages: number
  getHref?: (page: number) => string
  /** @category content */
  previousLabel?: string
  /** @category content */
  nextLabel?: string
  /** Show the previous / next labels beside the arrows (from `md`; screen-reader text below). @category layout */
  labels?: boolean
  /** Phone summary between the arrows; `{current}` and `{total}` are replaced. @category content */
  summary?: string
  /** Round page cells. @category layout */
  rounded?: boolean
  class?: string
}

const {
  currentPage,
  totalPages,
  getHref = (p: number) => `?page=${p}`,
  previousLabel = 'Previous page',
  nextLabel = 'Next page',
  labels = false,
  rounded = false,
  summary = 'Page {current} of {total}',
  class: className,
  ...rest
} = Astro.props

// Seven cells whenever totalPages ≥ 7: first, last, a three-page run around the
// current page, and an ellipsis or the neighbour on each side. The width never
// jumps as the user pages through.
const pages: (number | '…')[] = (() => {
  const n = totalPages
  if (n <= 7) return Array.from({ length: n }, (_, i) => i + 1)
  if (currentPage <= 4) return [1, 2, 3, 4, 5, '…', n]
  if (currentPage >= n - 3) return [1, '…', n - 4, n - 3, n - 2, n - 1, n]
  return [1, '…', currentPage - 1, currentPage, currentPage + 1, '…', n]
})()

const cell = [
  'inline-flex h-9 min-w-9 items-center justify-center gap-1.5 px-2 text-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus',
  rounded ? 'rounded-full' : 'rounded-md',
].join(' ')
// Page numbers and ellipses step aside on phones for the summary.
const numberCell = `${cell} max-md:hidden`
---

<nav aria-label="Pagination" class:list={['flex items-center gap-1 tabular-nums', className]} {...rest}>
  {
    currentPage > 1 ? (
      <a href={getHref(currentPage - 1)} rel="prev" aria-label={labels ? undefined : previousLabel} class:list={[cell, 'text-neutral hover:bg-neutral-faded-highlighted']}>
        <ChevronLeft class="size-4 rtl:-scale-x-100" aria-hidden="true" />
        {labels && <span class="max-md:sr-only">{previousLabel}</span>}
      </a>
    ) : (
      <span aria-disabled="true" class:list={[cell, 'text-neutral-faded opacity-50']}>
        <ChevronLeft class="size-4 rtl:-scale-x-100" aria-hidden="true" />
      </span>
    )
  }
  {
    pages.map((p) =>
      p === '…' ? (
        <span class:list={[numberCell, 'text-neutral-faded']}>…</span>
      ) : (
        <a
          href={getHref(p)}
          aria-current={p === currentPage ? 'page' : undefined}
          class:list={[numberCell, p === currentPage ? 'bg-primary text-on-primary' : 'text-neutral hover:bg-neutral-faded-highlighted']}
        >
          {p}
        </a>
      ),
    )
  }
  <span class="apogee-pagination-summary px-2 text-sm text-neutral-faded md:hidden">
    {summary.replace('{current}', String(currentPage)).replace('{total}', String(totalPages))}
  </span>
  {
    currentPage < totalPages ? (
      <a href={getHref(currentPage + 1)} rel="next" aria-label={labels ? undefined : nextLabel} class:list={[cell, 'text-neutral hover:bg-neutral-faded-highlighted']}>
        {labels && <span class="max-md:sr-only">{nextLabel}</span>}
        <ChevronRight class="size-4 rtl:-scale-x-100" aria-hidden="true" />
      </a>
    ) : (
      <span aria-disabled="true" class:list={[cell, 'text-neutral-faded opacity-50']}>
        <ChevronRight class="size-4 rtl:-scale-x-100" aria-hidden="true" />
      </span>
    )
  }
</nav>
