---
/**
 * AvatarGroup — overlapping avatars with an optional +N overflow chip.
 * Pass `items` (and `max`) for the +N to compute, or drop <Avatar> children in
 * the default slot for manual control (overlap + ring applied either way).
 */
import type { HTMLAttributes } from 'astro/types'
import Avatar from '../Avatar/Avatar.astro'

/**
 * @composable
 * @children Avatar
 */
interface Props extends Omit<HTMLAttributes<'div'>, 'size'> {
  items?: { src?: string; name?: string; alt?: string }[]
  /** Show at most this many, then a +N chip. Omit to show all. */
  max?: number
  /** @category layout */
  size?: 'xsmall' | 'small' | 'medium' | 'large' | 'xlarge'
  class?: string
}

const { items, max, size = 'medium', class: className, ...rest } = Astro.props

const shown = items ? (max ? items.slice(0, max) : items) : []
const overflow = items && max ? Math.max(0, items.length - max) : 0

const sizeMap = {
  xsmall: 'size-6 text-[10px]',
  xlarge: 'size-16 text-lg',
  small: 'size-8 text-xs',
  medium: 'size-10 text-sm',
  large: 'size-12 text-base',
}
---

<div
  class:list={['flex -space-x-2 [&>*]:ring-2 [&>*]:ring-page', className]}
  {...rest}
>
  {items ? shown.map((a) => <Avatar {...a} size={size} />) : <slot />}
  {
    overflow > 0 && (
      <span
        class:list={[
          'inline-flex items-center justify-center rounded-full bg-neutral font-medium text-neutral select-none ring-2 ring-page',
          sizeMap[size],
        ]}
      >
        +{overflow}
      </span>
    )
  }
</div>
