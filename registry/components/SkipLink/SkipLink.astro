---
/**
 * SkipLink — a "skip to content" link. Hidden until focused (first Tab), then it
 * jumps keyboard users past the nav. Put it first in `<body>`; point `href` at
 * your main content's id. Zero JS.
 *
 * @composable
 */
interface Props {
  href?: string
  class?: string
}

const { href = '#main', class: className, ...rest } = Astro.props
---

<a
  href={href}
  class:list={[
    'sr-only focus:not-sr-only focus:absolute focus:start-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-accent-foreground focus:outline-2 focus:outline-offset-2 focus:outline-ring',
    className,
  ]}
  {...rest}
>
  <slot>Skip to content</slot>
</a>
