---
/**
 * Tag — a chip. Optionally a link (`href`) or removable. `color` is the hue,
 * `variant` the fill style.
 *
 * `removable` renders a remove button that emits a cancelable, bubbling
 * `apogee:tag-remove` event (`detail: { value, tag }`). Handle it to update
 * your state — a tag usually reflects data your app owns, so removing it is a
 * state change, not just a DOM edit. For a purely cosmetic list with no backing
 * state, set `dismissOnClick` to also remove the element from the DOM.
 */
import type { HTMLAttributes } from 'astro/types'
import CloseButton from '../CloseButton/CloseButton.astro'
import { Check, Plus } from '@lucide/astro'

const styles = {
  solid: {
    primary: 'bg-primary text-on-primary',
    neutral: 'bg-neutral text-on-neutral',
    critical: 'bg-critical text-on-critical',
    positive: 'bg-positive text-on-positive',
    warning: 'bg-warning text-on-warning',
  },
  faded: {
    primary: 'bg-primary-faded text-primary',
    neutral: 'bg-neutral-faded text-neutral',
    critical: 'bg-critical-faded text-critical',
    positive: 'bg-positive-faded text-positive',
    warning: 'bg-warning-faded text-warning',
  },
  outline: {
    primary: 'border border-primary text-primary',
    neutral: 'border border-neutral bg-elevation-raised text-neutral',
    critical: 'border border-critical text-critical',
    positive: 'border border-positive text-positive',
    warning: 'border border-warning text-warning',
  },
} as const satisfies Record<NonNullable<Props['variant']>, Record<NonNullable<Props['color']>, string>>
// The side that holds an icon or the remove button pads less.
const sizes = {
  small: 'h-6 px-1.5 text-xs gap-1 has-[>[data-slot=start]]:ps-1 has-[>[data-slot=end]]:pe-1',
  medium: 'h-7 px-2 text-sm gap-1 has-[>[data-slot=start]]:ps-1.5 has-[>[data-slot=end]]:pe-1.5',
  large: 'h-8 px-2.5 text-sm gap-1.5 has-[>[data-slot=start]]:ps-2 has-[>[data-slot=end]]:pe-2',
} as const satisfies Record<NonNullable<Props['size']>, string>

// `selectable`: the chip is a label around a native checkbox; checked takes the hue's faded fill.
const selectedStyles = {
  primary: 'has-[:checked]:border-primary has-[:checked]:bg-primary-faded has-[:checked]:text-primary',
  neutral: 'has-[:checked]:border-neutral has-[:checked]:bg-neutral-faded has-[:checked]:text-neutral',
  critical: 'has-[:checked]:border-critical has-[:checked]:bg-critical-faded has-[:checked]:text-critical',
  positive: 'has-[:checked]:border-positive has-[:checked]:bg-positive-faded has-[:checked]:text-positive',
  warning: 'has-[:checked]:border-warning has-[:checked]:bg-warning-faded has-[:checked]:text-warning',
} as const

/** @composable */
interface Props extends HTMLAttributes<'span'> {
  /** Hue. @category layout */
  color?: 'primary' | 'neutral' | 'critical' | 'positive' | 'warning'
  /** Fill style. @category layout */
  variant?: 'solid' | 'faded' | 'outline'
  /** @category layout */
  size?: 'small' | 'medium' | 'large'
  /** Fully round ends. @category layout */
  rounded?: boolean
  /** Makes the label a link. @category content */
  href?: string
  removable?: boolean
  /** A count pill after the label. @category content */
  count?: number
  /** A native checkbox inside the chip: toggles with click or Space and posts `name=value`. Ignored with `href`. */
  selectable?: boolean
  /** Initial state of a selectable tag. */
  checked?: boolean
  /** Form field name of a selectable tag. */
  name?: string
  /** Identifies this tag in the remove event's `detail`, and is the posted value when selectable. */
  value?: string
  /** Also remove the element on click — cosmetic lists with no backing state. */
  dismissOnClick?: boolean
  /** Accessible label for the remove button. */
  removeLabel?: string
  class?: string
}

const {
  color = 'neutral',
  variant = 'outline',
  size = 'medium',
  rounded = false,
  href,
  removable = false,
  count,
  selectable = false,
  checked = false,
  name,
  value,
  dismissOnClick = false,
  removeLabel = 'Remove',
  class: className,
  ...rest
} = Astro.props
const Label = href ? 'a' : 'span'
const isSelectable = selectable && !href
const Root = isSelectable ? 'label' : 'span'
---

<Root
  class:list={[
    'inline-flex items-center whitespace-nowrap [&_svg]:size-3.5',
    rounded ? 'rounded-full' : 'rounded-md',
    styles[variant][color],
    sizes[size],
    isSelectable &&
      'group/tag press cursor-pointer transition-colors has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-focus has-[:disabled]:cursor-not-allowed has-[:disabled]:bg-disabled has-[:disabled]:text-disabled has-[:disabled]:border-disabled',
    isSelectable && selectedStyles[color],
    className,
  ]}
  data-apogee-tag
  data-value={value}
  data-dismiss-on-click={dismissOnClick ? '' : undefined}
  {...rest}
>
  {isSelectable && <input type="checkbox" class="peer sr-only" name={name} value={value} checked={checked || undefined} />}
  {/* A plus hints that the chip can be picked; it turns into a check once picked. */}
  {isSelectable && (
    <span data-slot="start" class="inline-grid [&>svg]:[grid-area:1/1]">
      <Plus class="apogee-tag-plus opacity-60 group-has-[:checked]/tag:hidden" aria-hidden="true" />
      <Check class="apogee-tag-check hidden group-has-[:checked]/tag:block" aria-hidden="true" />
    </span>
  )}
  {Astro.slots.has('start') && <span data-slot="start" class="inline-flex"><slot name="start" /></span>}
  <Label href={href} class="inline-flex items-center gap-[inherit] rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">
    <slot />
  </Label>
  {count !== undefined && (
    <span data-slot="end" class:list={['rounded-sm px-1 text-[0.85em] font-medium tabular-nums', variant === 'solid' ? 'bg-page/25' : 'bg-neutral-faded']}>{count}</span>
  )}
  {
    removable && !isSelectable && (
      <CloseButton size="xsmall" theme="inherit" label={removeLabel} data-tag-remove data-slot="end" class="no-js:hidden" />
    )
  }
</Root>

<script>
  // Delegated once per page (Astro dedupes this module). The app owns removal:
  // emit a cancelable event and let state drive the re-render. `dismissOnClick`
  // opts a cosmetic tag into removing its own element.
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return
    const button = event.target.closest('[data-tag-remove]')
    if (!button) return
    const tag = button.closest<HTMLElement>('[data-apogee-tag]')
    if (!tag) return

    const notCancelled = tag.dispatchEvent(
      new CustomEvent('apogee:tag-remove', {
        bubbles: true,
        cancelable: true,
        detail: { value: tag.dataset.value, tag },
      }),
    )
    if (notCancelled && tag.hasAttribute('data-dismiss-on-click')) tag.remove()
  })
</script>
