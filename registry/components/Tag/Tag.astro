---
/**
 * Tag — a chip. Optionally a link (`href`) or removable. `color` is the hue,
 * `variant` the fill style.
 *
 * `removable` renders a remove button that emits a cancelable, bubbling
 * `apogee:tag-remove` event (`detail: { value, tag }`). Handle it to update
 * your state — a tag usually reflects data your app owns, so removing it is a
 * state change, not just a DOM edit. For a purely cosmetic list with no backing
 * state, set `dismissOnClick` to also remove the element from the DOM.
 */
import type { HTMLAttributes } from 'astro/types'
import CloseButton from '../CloseButton/CloseButton.astro'

const styles = {
  solid: {
    primary: 'bg-primary text-on-primary',
    neutral: 'bg-neutral text-on-neutral',
    critical: 'bg-critical text-on-critical',
    positive: 'bg-positive text-on-positive',
    warning: 'bg-warning text-on-warning',
  },
  faded: {
    primary: 'bg-primary-faded text-primary',
    neutral: 'bg-neutral-faded text-neutral',
    critical: 'bg-critical-faded text-critical',
    positive: 'bg-positive-faded text-positive',
    warning: 'bg-warning-faded text-warning',
  },
  outline: {
    primary: 'border border-primary text-primary',
    neutral: 'border border-neutral bg-elevation-raised text-neutral',
    critical: 'border border-critical text-critical',
    positive: 'border border-positive text-positive',
    warning: 'border border-warning text-warning',
  },
} as const
// The side that holds an icon or the remove button pads less.
const sizes = {
  small: 'h-6 px-1.5 text-xs gap-1 has-[>[data-slot=start]]:ps-1 has-[>[data-slot=end]]:pe-1',
  medium: 'h-7 px-2 text-sm gap-1 has-[>[data-slot=start]]:ps-1.5 has-[>[data-slot=end]]:pe-1.5',
  large: 'h-8 px-2.5 text-sm gap-1.5 has-[>[data-slot=start]]:ps-2 has-[>[data-slot=end]]:pe-2',
} as const

/** @composable */
interface Props extends HTMLAttributes<'span'> {
  /** Hue. @category layout */
  color?: keyof typeof styles.solid
  /** Fill style. @category layout */
  variant?: keyof typeof styles
  /** @category layout */
  size?: keyof typeof sizes
  /** Fully round ends. @category layout */
  rounded?: boolean
  /** Makes the label a link. @category content */
  href?: string
  removable?: boolean
  /** Identifies this tag in the remove event's `detail`. */
  value?: string
  /** Also remove the element on click — cosmetic lists with no backing state. */
  dismissOnClick?: boolean
  /** Accessible label for the remove button. */
  removeLabel?: string
  class?: string
}

const {
  color = 'neutral',
  variant = 'outline',
  size = 'medium',
  rounded = false,
  href,
  removable = false,
  value,
  dismissOnClick = false,
  removeLabel = 'Remove',
  class: className,
  ...rest
} = Astro.props
const Label = href ? 'a' : 'span'
---

<span
  class:list={[
    'inline-flex items-center whitespace-nowrap [&_svg]:size-3.5',
    rounded ? 'rounded-full' : 'rounded-md',
    styles[variant][color],
    sizes[size],
    className,
  ]}
  data-apogee-tag
  data-value={value}
  data-dismiss-on-click={dismissOnClick ? '' : undefined}
  {...rest}
>
  {Astro.slots.has('start') && <span data-slot="start" class="inline-flex"><slot name="start" /></span>}
  <Label href={href} class="inline-flex items-center gap-[inherit] rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">
    <slot />
  </Label>
  {
    removable && (
      <CloseButton size="xsmall" theme="inherit" label={removeLabel} data-tag-remove data-slot="end" class="no-js:hidden" />
    )
  }
</span>

<script>
  // Delegated once per page (Astro dedupes this module). The app owns removal:
  // emit a cancelable event and let state drive the re-render. `dismissOnClick`
  // opts a cosmetic tag into removing its own element.
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return
    const button = event.target.closest('[data-tag-remove]')
    if (!button) return
    const tag = button.closest<HTMLElement>('[data-apogee-tag]')
    if (!tag) return

    const notCancelled = tag.dispatchEvent(
      new CustomEvent('apogee:tag-remove', {
        bubbles: true,
        cancelable: true,
        detail: { value: tag.dataset.value, tag },
      }),
    )
    if (notCancelled && tag.hasAttribute('data-dismiss-on-click')) tag.remove()
  })
</script>
