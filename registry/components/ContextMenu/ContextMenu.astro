---
/**
 * ContextMenu — a right-click menu (browsers dropped the native styleable one),
 * so it's a JS island: opens at the cursor over the target, closes on
 * outside-click / Escape / scroll. Wrap the target in the default slot and put
 * `DropdownItem`s in the `menu` slot. Without JS the target's normal right-click
 * menu is left untouched.
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'
import { uid } from '../utils/uid.ts'
interface Props extends HTMLAttributes<'div'> {
  class?: string
}

const { class: className, ...rest } = Astro.props
const id = uid(Astro.locals, 'apogee-ctx')
---

<div class:list={['apogee-contextmenu', className]} data-menu={id} {...rest}>
  <slot />
  <div
    id={id}
    role="menu"
    class="apogee-contextmenu-panel fixed z-50 flex min-w-44 flex-col gap-0.5 rounded-md border border-neutral bg-elevation-raised p-1 shadow-lg no-js:hidden"
    hidden
  >
    <slot name="menu" />
  </div>
</div>

<style>
  /* Fade + scale in when the menu opens at the cursor. */
  .apogee-contextmenu-panel:not([hidden]) {
    animation: apogee-contextmenu-in var(--duration-fast) var(--ease-standard);
  }
  @keyframes apogee-contextmenu-in {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .apogee-contextmenu-panel {
      animation: none;
    }
  }
</style>

<script>
  import { island } from '../utils/island.ts'

  island('.apogee-contextmenu', (root) => {
    const panel = root.querySelector<HTMLElement>('.apogee-contextmenu-panel')
    if (!panel) return

    const close = () => {
      if (panel.hidden) return
      panel.hidden = true
      panel.dispatchEvent(new CustomEvent('apogee:contextmenu-close', { bubbles: true }))
    }
    const openAt = (x: number, y: number) => {
      panel.hidden = false
      panel.dispatchEvent(new CustomEvent('apogee:contextmenu-open', { bubbles: true, detail: { x, y } }))
      // Clamp inside the viewport now that we can measure it.
      const { offsetWidth: w, offsetHeight: h } = panel
      panel.style.left = `${Math.min(x, window.innerWidth - w - 8)}px`
      panel.style.top = `${Math.min(y, window.innerHeight - h - 8)}px`
      panel.querySelector<HTMLElement>('[role="menuitem"]')?.focus()
    }

    // Arrow-key navigation between items (WAI-ARIA menu pattern).
    panel.addEventListener('keydown', (e) => {
      const items = [...panel.querySelectorAll<HTMLElement>('[role="menuitem"]:not([disabled])')]
      if (!items.length) return
      const idx = items.indexOf(document.activeElement as HTMLElement)
      if (e.key === 'ArrowDown') {
        e.preventDefault()
        items[idx < items.length - 1 ? idx + 1 : 0]?.focus()
      } else if (e.key === 'ArrowUp') {
        e.preventDefault()
        items[idx > 0 ? idx - 1 : items.length - 1]?.focus()
      } else if (e.key === 'Home') {
        e.preventDefault()
        items[0]?.focus()
      } else if (e.key === 'End') {
        e.preventDefault()
        items[items.length - 1]?.focus()
      }
    })

    root.addEventListener('contextmenu', (e) => {
      if (panel.contains(e.target as Node)) return
      e.preventDefault()
      openAt(e.clientX, e.clientY)
    })
    // Activating an item closes the menu.
    panel.addEventListener('click', () => close())
  })

  // Dismissal is global, bound once for every menu on the page.
  const openPanels = () => document.querySelectorAll<HTMLElement>('.apogee-contextmenu-panel:not([hidden])')
  const closeAll = () => openPanels().forEach((p) => (p.hidden = true))
  document.addEventListener('click', (e) => {
    for (const p of openPanels()) if (!p.contains(e.target as Node)) p.hidden = true
  })
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAll()
  })
  window.addEventListener('scroll', closeAll, true)
  window.addEventListener('resize', closeAll)
</script>
