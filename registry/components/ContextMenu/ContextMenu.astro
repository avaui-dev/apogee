---
/**
 * ContextMenu — a right-click menu (browsers dropped the native styleable one),
 * so it's a JS island: opens a native popover at the cursor over the target,
 * in the top layer. Outside click and Escape are native light dismiss; scroll
 * and resize close it. Wrap the target in the default slot and put
 * `DropdownItem`s in the `menu` slot. Without JS the target's normal
 * right-click menu is left untouched.
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'
import { uid } from '../utils/uid.ts'
import { panelClass, panelSurface, menuClass } from '../utils/panel.ts'
interface Props extends HTMLAttributes<'div'> {
  class?: string
}

const { class: className, ...rest } = Astro.props
const id = uid(Astro.locals, 'apogee-ctx')
---

<div class:list={['apogee-contextmenu', className]} data-menu={id} {...rest}>
  <slot />
  <div id={id} popover role="menu" style="inset: auto" class:list={[panelClass, panelSurface.overlay, menuClass, 'fixed']}>
    <slot name="menu" />
  </div>
</div>

<script>
  import { island } from '../utils/island.ts'
  import { menuKeydown, menuItems } from '../utils/menu.ts'

  island('.apogee-contextmenu', (root) => {
    const panel = root.querySelector<HTMLElement>(':scope > [role="menu"]')
    if (!panel) return

    panel.addEventListener('toggle', (e) => {
      const open = (e as ToggleEvent).newState === 'open'
      panel.dispatchEvent(
        new CustomEvent(open ? 'apogee:contextmenu-open' : 'apogee:contextmenu-close', {
          bubbles: true,
          detail: open ? { x: panel.offsetLeft, y: panel.offsetTop } : undefined,
        }),
      )
    })

    root.addEventListener('contextmenu', (e) => {
      if (panel.contains(e.target as Node)) return
      e.preventDefault()
      if (!panel.matches(':popover-open')) panel.showPopover()
      // Clamp inside the viewport now that it has a size.
      panel.style.left = `${Math.min(e.clientX, window.innerWidth - panel.offsetWidth - 8)}px`
      panel.style.top = `${Math.min(e.clientY, window.innerHeight - panel.offsetHeight - 8)}px`
      menuItems(panel)[0]?.focus()
    })
    panel.addEventListener('keydown', (e) => menuKeydown(e, panel))
    // Activating an item closes the menu.
    panel.addEventListener('click', (e) => {
      if ((e.target as Element).closest('[role^="menuitem"]')) panel.hidePopover()
    })
  })

  // Scrolling or resizing closes every open menu (its anchor point moved).
  const closeAll = () =>
    document.querySelectorAll<HTMLElement>('.apogee-contextmenu > [role="menu"]:popover-open').forEach((p) => p.hidePopover())
  window.addEventListener('scroll', closeAll, true)
  window.addEventListener('resize', closeAll)
</script>
