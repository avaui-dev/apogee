---
/**
 * Steps — a progress list (onboarding, checkout, wizards). Zero JS.
 * `current` is the 1-based active step; earlier steps render as done, and an
 * item's `status` overrides that for out-of-order flows. `orientation` is
 * responsive: `{ base: 'vertical', md: 'horizontal' }` stacks on phones and
 * runs across from `md` in one render. `marker` picks numbers, dots or icons.
 */
import type { HTMLAttributes } from 'astro/types'
import type { IconComponent } from '../utils/icon.ts'
import { Check } from '@lucide/astro'
import { responsive, type Responsive } from '../utils/responsive.ts'
import { tables } from '../utils/responsive-tables.ts'

type State = 'done' | 'current' | 'upcoming'
const sizes = {
  small: { m: '[--steps-m:1.5rem]', marker: 'size-6 text-xs [&>svg]:size-3.5', title: 'text-sm', desc: 'text-xs', pb: '[--steps-gap-y:1.5rem]' },
  medium: { m: '[--steps-m:2rem]', marker: 'size-8 text-sm [&>svg]:size-4', title: 'text-sm', desc: 'text-sm', pb: '[--steps-gap-y:2rem]' },
} as const satisfies Record<NonNullable<Props['size']>, unknown>

/** @composable */
interface Props extends HTMLAttributes<'div'> {
  items: { title: string; description?: string; status?: State; icon?: IconComponent }[]
  /** 1-based index of the active step. */
  current?: number
  /** @category layout */
  orientation?: Responsive<'vertical' | 'horizontal'>
  /** Numbers, small dots, or each item's `icon`. @category layout */
  marker?: 'number' | 'dot' | 'icon'
  /** @category layout */
  size?: 'small' | 'medium'
  class?: string
}

const { items, current = 1, orientation = 'vertical', marker = 'number', size = 'medium', class: className, ...rest } = Astro.props
const s = sizes[size]
const states: State[] = items.map((step, i) => step.status ?? (i + 1 < current ? 'done' : i + 1 === current ? 'current' : 'upcoming'))
---

<ol class:list={['apogee-steps flex', s.m, s.pb, responsive(typeof orientation === 'string' ? orientation : { base: 'vertical', ...orientation }, tables.stepsOrientation), className]} {...rest}>
  {
    items.map((step, i) => {
      const n = i + 1
      const state = states[i]!
      const last = i === items.length - 1
      const Icon = step.icon
      return (
        <li
          aria-current={state === 'current' ? 'step' : undefined}
          class:list={[
            'relative flex gap-(--steps-gap) [flex-direction:var(--steps-li)] [align-items:var(--steps-align)] [text-align:var(--steps-text)] [flex:var(--steps-flex)] pb-(--steps-pb) last:pb-0',
          ]}
        >
          {!last && (
            <span
              class:list={[
                'absolute [inline-size:var(--steps-cw)] [block-size:var(--steps-ch)] [inset-block-start:var(--steps-ct)] [inset-inline-start:var(--steps-cs)]',
                state === 'done' ? 'bg-primary' : 'bg-neutral',
              ]}
              aria-hidden="true"
            />
          )}
          <span
            data-state={state}
            class:list={[
              'relative z-10 grid shrink-0 place-items-center rounded-full border font-medium tabular-nums',
              s.marker,
              state === 'done' && 'border-primary bg-primary text-on-primary',
              state === 'current' && 'border-primary bg-page text-primary',
              state === 'upcoming' && 'border-neutral bg-page text-neutral-faded',
            ]}
          >
            {state === 'done' ? (
              <Check aria-hidden="true" />
            ) : marker === 'icon' && Icon ? (
              <Icon aria-hidden="true" />
            ) : marker === 'dot' ? (
              <span class:list={['apogee-steps-dot size-2.5 rounded-full', state === 'current' ? 'bg-primary' : 'bg-neutral']} />
            ) : (
              n
            )}
          </span>
          {/* Centres the title's first line (1.25rem) on the marker, however many lines follow. */}
          <div class="pt-[calc((var(--steps-m)-1.25rem)/2)]">
            <p class:list={['font-medium', s.title, state === 'upcoming' ? 'text-neutral-faded' : 'text-neutral']}>
              {step.title}
              {state === 'done' && <span class="sr-only"> (done)</span>}
            </p>
            {step.description && <p class:list={['mt-0.5 text-neutral-faded', s.desc]}>{step.description}</p>}
          </div>
        </li>
      )
    })
  }
</ol>
