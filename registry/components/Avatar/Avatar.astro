---
/**
 * Avatar — a user image, with an initials fallback from `name`.
 *
 * @composable
 */
interface Props {
  /** Image URL. */
  src?: string
  /** Alt text for the image (falls back to `name`). */
  alt?: string
  /** Name — used for the initials fallback and the label. */
  name?: string
  size?: 'sm' | 'md' | 'lg'
  class?: string
}

const { src, alt, name, size = 'md', class: className, ...rest } = Astro.props

const sizeMap = {
  sm: 'size-8 text-xs',
  md: 'size-10 text-sm',
  lg: 'size-12 text-base',
}

const initials = name
  ? name
      .trim()
      .split(/\s+/)
      .slice(0, 2)
      .map((w) => w[0]?.toUpperCase() ?? '')
      .join('')
  : ''
---

<span
  class:list={[
    'inline-flex items-center justify-center overflow-hidden rounded-full bg-muted font-medium text-muted-foreground select-none',
    sizeMap[size],
    className,
  ]}
  {...rest}
>
  {
    src ? (
      <img src={src} alt={alt ?? name ?? ''} class="size-full object-cover" />
    ) : (
      <span role={name ? 'img' : undefined} aria-label={name}>
        {initials}
      </span>
    )
  }
</span>
