---
/**
 * Avatar — a user image, with an initials fallback from `name`. If the image
 * fails to load (404, offline), a tiny island swaps it for the initials fallback
 * instead of leaving a broken-image icon. With neither `src` nor `name`, a
 * generic person glyph stands in rather than an empty circle.
 */
import type { HTMLAttributes } from 'astro/types'
import { User } from '@lucide/astro'

const fills = {
  faded: {
    neutral: 'bg-neutral-faded text-neutral',
    primary: 'bg-primary-faded text-primary',
    critical: 'bg-critical-faded text-critical',
    positive: 'bg-positive-faded text-positive',
    warning: 'bg-warning-faded text-warning',
  },
  solid: {
    neutral: 'bg-neutral text-on-neutral',
    primary: 'bg-primary text-on-primary',
    critical: 'bg-critical text-on-critical',
    positive: 'bg-positive text-on-positive',
    warning: 'bg-warning text-on-warning',
  },
} as const

/** @composable */
interface Props extends Omit<HTMLAttributes<'span'>, 'size'> {
  /** Image URL. */
  src?: string | undefined
  /** Alt text for the image (falls back to `name`). */
  alt?: string | undefined
  /** Name — used for the initials fallback and the label. */
  name?: string | undefined
  /** @category layout */
  size?: 'xsmall' | 'small' | 'medium' | 'large' | 'xlarge' | undefined
  /** Presence dot at the bottom end corner; read with the name ("Ana Lima, online"). @category layout */
  status?: 'online' | 'offline' | undefined
  /** A ring around the avatar, offset from it. @category layout */
  border?: boolean | undefined
  /** Fallback hue. @category layout */
  color?: keyof typeof fills.faded | undefined
  /** Fallback fill style. @category layout */
  variant?: keyof typeof fills | undefined
  /** Rounded square instead of a circle. @category layout */
  squared?: boolean | undefined
  class?: string | undefined
}

const { src, alt, name, size = 'medium', status, border = false, color = 'neutral', variant = 'faded', squared = false, class: className, ...rest } = Astro.props

const sizeMap = {
  xsmall: 'size-6 text-[10px]',
  small: 'size-8 text-xs',
  medium: 'size-10 text-sm',
  large: 'size-12 text-base',
  xlarge: 'size-16 text-lg',
}
const dotSizes = { xsmall: 'size-2', small: 'size-2', medium: 'size-2.5', large: 'size-3', xlarge: 'size-4' } as const
const dotColors = { online: 'bg-positive', offline: 'bg-neutral-faded' } as const
const label = name ? (status ? `${name}, ${status}` : name) : undefined

const initials = name
  ? name
      .trim()
      .split(/\s+/)
      .slice(0, 2)
      .map((w) => w[0]?.toUpperCase() ?? '')
      .join('')
  : ''
---

<span
  class:list={[
    'apogee-avatar relative inline-flex items-center justify-center bg-page font-medium select-none',
    // The status dot overhangs the edge, so clipping moves to the image and the fallback.
    !status && 'overflow-hidden',
    squared ? 'rounded-md' : 'rounded-full',
    border && 'ring-2 ring-(--border-neutral-faded) ring-offset-2 ring-offset-page',
    sizeMap[size],
    className,
  ]}
  {...rest}
>
  {src && <img src={src} alt={alt ?? label ?? ''} class="apogee-avatar-img size-full rounded-[inherit] object-cover ring-1 ring-(--border-neutral-faded) ring-inset" />}
  <span
    class:list={['apogee-avatar-fallback inline-flex size-full items-center justify-center rounded-[inherit]', fills[variant][color]]}
    role={name ? 'img' : undefined}
    aria-label={label}
  >
    {initials || <User class="size-1/2" aria-hidden="true" />}
  </span>
  {status && <span class:list={['apogee-avatar-status absolute end-0 bottom-0 rounded-full ring-2 ring-page', dotSizes[size], dotColors[status]]} aria-hidden="true" />}
</span>

<style>
  /* While the image is present (loading or loaded), the fallback is hidden. The
     island removes the <img> on error, which reveals the fallback. */
  .apogee-avatar-img + .apogee-avatar-fallback {
    display: none;
  }
</style>

<script>
  import { island } from '../utils/island.ts'

  island<HTMLImageElement>('.apogee-avatar-img', (img) => {
    const fail = () => img.remove()
    // Catch images that already errored before this script ran.
    if (img.complete && img.naturalWidth === 0) fail()
    else img.addEventListener('error', fail)
  })
</script>
