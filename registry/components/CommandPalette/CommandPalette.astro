---
/**
 * CommandPalette — a ⌘K / Ctrl+K searchable command menu in a native `<dialog>`
 * (modal, backdrop and Esc-to-close come free). JS island for the shortcut,
 * filtering and arrow-key navigation. Open it from any element with
 * `data-command-open="<id>"`, or with the keyboard shortcut.
 *
 * Activating a command navigates to its `href`, or dispatches an
 * `apogee:command` event (`detail: { id, label }`) on `document` for the app to
 * handle. Without JS the dialog and shortcut don't run — pair the trigger with a
 * real link/menu as a fallback.
 *
 * Commands take an `icon` (Lucide component) or `avatar`, a `description`
 * (inline, or on its own line with `stacked`) and a `shortcut` such as
 * `['alt', 'shift', 'n']`: it renders as key caps and runs the command from
 * anywhere on the page. Slots: `empty` (no results), `footer` (key hints).
 * Search ignores accents ("resume" finds "Résumé").
 */
import type { HTMLAttributes } from 'astro/types'
import type { IconComponent } from '../utils/icon.ts'
import { Search } from '@lucide/astro'
import Avatar from '../Avatar/Avatar.astro'
import Kbd from '../Kbd/Kbd.astro'

interface Command {
  label: string
  href?: string
  group?: string
  keywords?: string
  id?: string
  /** A Lucide (or any Astro) icon component. */
  icon?: IconComponent
  avatar?: { src?: string; name?: string }
  description?: string
  /** Keys pressed together, e.g. ['alt', 'shift', 'n']: modifiers are `mod` (⌘ on macOS, Ctrl elsewhere), `shift` and `alt`. */
  shortcut?: string[]
  /** Description on its own line under the label. */
  stacked?: boolean
}
// Server renders macOS glyphs; the island swaps them where `mod` is Ctrl.
const keyGlyph: Record<string, string> = { mod: '⌘', shift: '⇧', alt: '⌥' }

/** @composable */
interface Props extends HTMLAttributes<'div'> {
  id?: string
  commands: Command[]
  placeholder?: string
  /** Key pressed with ⌘/Ctrl to open. */
  shortcut?: string
  class?: string
}

const {
  id = 'apogee-command',
  commands,
  placeholder = 'Type a command or search…',
  shortcut = 'k',
  class: className,
} = Astro.props

// Group the commands, preserving first-seen order.
const groups: { name: string; items: Command[] }[] = []
for (const c of commands) {
  const g = c.group ?? ''
  let entry = groups.find((x) => x.name === g)
  if (!entry) {
    entry = { name: g, items: [] }
    groups.push(entry)
  }
  entry.items.push(c)
}
---

<dialog
  id={id}
  class:list={[
    'apogee-command m-auto w-[calc(100%-2rem)] max-w-xl rounded-xl border border-neutral bg-page p-0 shadow-2xl backdrop:bg-overlay',
    className,
  ]}
  data-shortcut={shortcut}
  closedby="any"
>
  <div class="flex items-center gap-2 border-b border-neutral px-3">
    <Search class="size-4 shrink-0 text-neutral-faded" aria-hidden="true" />
    <input
      type="text"
      class="apogee-command-input h-12 w-full bg-transparent text-sm text-neutral outline-none placeholder:text-neutral-faded max-md:text-base pointer-coarse:text-base"
      placeholder={placeholder}
      role="combobox"
      aria-expanded="true"
      aria-controls={`${id}-list`}
      aria-autocomplete="list"
      autocomplete="off"
    />
  </div>

  <div id={`${id}-list`} role="listbox" class="apogee-command-list max-h-80 overflow-auto p-2">
    {
      groups.map((g) => (
        <div class="apogee-command-section [&~&]:mt-2 [&~&]:border-t [&~&]:border-neutral [&~&]:pt-2">
          {g.name && (
            <p class="px-2 pt-1.5 pb-1.5 text-[0.6875rem] font-semibold tracking-wider text-neutral uppercase">
              {g.name}
            </p>
          )}
          <div class="flex flex-col gap-0.5">
            {g.items.map((c) => (
              <button
                type="button"
                role="option"
                aria-selected="false"
                class="apogee-command-item flex w-full items-center gap-2 rounded px-2 py-2 text-start text-sm text-neutral hover:bg-neutral-faded-highlighted aria-selected:bg-neutral-faded-highlighted [&>svg]:size-4 [&>svg]:shrink-0 [&>svg]:text-neutral-faded"
                data-label={c.label}
                data-keywords={c.keywords ?? ''}
                data-description={c.description ?? ''}
                data-href={c.href ?? ''}
                data-id={c.id ?? ''}
                data-shortcut={c.shortcut?.join('+')}
              >
                {c.icon && <c.icon aria-hidden="true" />}
                {c.avatar && <Avatar size={c.stacked ? 'small' : 'xsmall'} {...c.avatar} name={c.avatar.name ?? c.label} alt="" />}
                <span class:list={['min-w-0 flex-1', c.stacked ? 'flex flex-col' : 'truncate']}>
                  {c.label}
                  {c.description && (
                    <span class:list={['text-neutral-faded', !c.stacked && 'ms-1.5']}>
                      {!c.stacked && <span aria-hidden="true">· </span>}
                      {c.description}
                    </span>
                  )}
                </span>
                {c.shortcut && (
                  <span class="ms-auto flex shrink-0 gap-1" aria-hidden="true">
                    {c.shortcut.map((k) => (
                      <Kbd data-key={k}>{keyGlyph[k] ?? k.toUpperCase()}</Kbd>
                    ))}
                  </span>
                )}
              </button>
            ))}
          </div>
        </div>
      ))
    }
    <div class="apogee-command-empty px-2 py-6 text-center text-sm text-neutral-faded" hidden>
      <slot name="empty">No results.</slot>
    </div>
  </div>
  {
    Astro.slots.has('footer') && (
      <div class="apogee-command-footer hidden items-center gap-4 border-t border-neutral px-3 py-2 text-xs text-neutral-faded md:flex">
        <slot name="footer" />
      </div>
    )
  }
</dialog>

<style>
  .apogee-command,
  .apogee-command::backdrop {
    transition:
      opacity var(--duration-fast) var(--ease-standard),
      overlay var(--duration-fast) allow-discrete,
      display var(--duration-fast) allow-discrete;
    opacity: 0;
  }
  .apogee-command[open],
  .apogee-command[open]::backdrop {
    opacity: 1;
  }
  @starting-style {
    .apogee-command[open],
    .apogee-command[open]::backdrop {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .apogee-command,
    .apogee-command::backdrop {
      transition: none;
    }
  }
</style>

<script>
  import { island } from '../utils/island.ts'
  import { hotkey, detectMac } from '../utils/hotkey.ts'

  // Accent- and case-insensitive text for matching.
  const fold = (s: string) => s.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase()
  const words: Record<string, string> = { mod: 'Ctrl', shift: 'Shift', alt: 'Alt' }

  island<HTMLDialogElement>('.apogee-command', (dialog) => {
    const input = dialog.querySelector<HTMLInputElement>('.apogee-command-input')
    const items = [...dialog.querySelectorAll<HTMLElement>('.apogee-command-item')]
    const sections = [...dialog.querySelectorAll<HTMLElement>('.apogee-command-section')]
    const empty = dialog.querySelector<HTMLElement>('.apogee-command-empty')
    if (!input) return

    let active = -1
    const visible = () => items.filter((i) => !i.hidden)
    // Options need ids so the input can point at the highlighted one.
    items.forEach((it, i) => (it.id ||= `${input.getAttribute('aria-controls')}-${i}`))

    const setActive = (idx: number) => {
      const vis = visible()
      items.forEach((i) => i.setAttribute('aria-selected', 'false'))
      active = idx
      const el = idx >= 0 ? vis[idx] : undefined
      if (el) {
        el.setAttribute('aria-selected', 'true')
        el.scrollIntoView({ block: 'nearest' })
        input.setAttribute('aria-activedescendant', el.id)
      } else input.removeAttribute('aria-activedescendant')
    }
    const filter = () => {
      const q = fold(input.value.trim())
      for (const it of items) {
        const hay = fold(`${it.dataset.label} ${it.dataset.keywords} ${it.dataset.description}`)
        it.hidden = q !== '' && !hay.includes(q)
      }
      for (const s of sections) {
        s.hidden = !s.querySelector<HTMLElement>('.apogee-command-item:not([hidden])')
      }
      const vis = visible()
      if (empty) empty.hidden = vis.length > 0
      setActive(vis.length ? 0 : -1)
    }
    const activate = (el: HTMLElement) => {
      if (dialog.open) dialog.close()
      if (el.dataset.href) {
        window.location.href = el.dataset.href
      } else {
        document.dispatchEvent(
          new CustomEvent('apogee:command', {
            detail: { id: el.dataset.id, label: el.dataset.label },
          }),
        )
      }
    }
    const open = () => {
      input.value = ''
      filter()
      dialog.showModal()
      input.focus()
    }

    // Shortcut (mod + key) and any trigger with data-command-open.
    const openCombo = `mod+${dialog.dataset.shortcut ?? 'k'}`
    const unbinds = [hotkey(openCombo, open, { ignoreInputs: false })]
    const aria: Record<string, string> = { mod: detectMac() ? 'Meta' : 'Control', shift: 'Shift', alt: 'Alt' }
    // Per-command shortcuts run from anywhere except while typing in a field.
    for (const it of items) {
      if (!it.dataset.shortcut) continue
      // The key caps are hidden from assistive tech; the shortcut is announced from here instead.
      it.setAttribute('aria-keyshortcuts', it.dataset.shortcut.split('+').map((k) => aria[k] ?? k.toUpperCase()).join('+'))
      if (it.dataset.shortcut.toLowerCase() === openCombo) {
        console.warn(`CommandPalette: "${it.dataset.label}" uses the palette's own shortcut (${openCombo}); not bound.`)
        continue
      }
      unbinds.push(
        hotkey(it.dataset.shortcut, () => {
          // Another open modal owns the keyboard; don't act behind it.
          const modal = document.querySelector('dialog:modal')
          if (modal && modal !== dialog) return
          activate(it)
        }),
      )
    }
    document.addEventListener('astro:before-swap', () => unbinds.forEach((u) => u()), { once: true })
    if (!detectMac()) for (const k of dialog.querySelectorAll<HTMLElement>('kbd[data-key]')) {
      const w = words[k.dataset.key ?? '']
      if (w) k.textContent = w
    }
    for (const trigger of document.querySelectorAll(`[data-command-open="${dialog.id}"]`)) {
      trigger.addEventListener('click', open)
    }

    input.addEventListener('input', filter)
    input.addEventListener('keydown', (e) => {
      const vis = visible()
      if (e.key === 'ArrowDown') {
        e.preventDefault()
        setActive(Math.min(active + 1, vis.length - 1))
      } else if (e.key === 'ArrowUp') {
        e.preventDefault()
        setActive(Math.max(active - 1, 0))
      } else if (e.key === 'Enter') {
        if (active >= 0 && vis[active]) {
          e.preventDefault()
          { const v = vis[active]; if (v) activate(v) }
        }
      }
    })
    for (const it of items) it.addEventListener('click', () => activate(it))

    // Close on backdrop click (fallback for browsers without `closedby="any"`).
    // The content fills the dialog box, so a click on the dialog itself is the
    // backdrop.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close()
    })
  })
</script>
