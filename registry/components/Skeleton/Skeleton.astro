---
/**
 * Skeleton — a content placeholder while data loads. Size it with classes
 * (`h-4 w-48`, `size-12 rounded-full`, …).
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'
interface Props extends HTMLAttributes<'div'> {
  class?: string
}

const { class: className, ...rest } = Astro.props
---

<div class:list={['apogee-skeleton min-h-5 rounded-md bg-neutral-faded', className]} aria-hidden="true" {...rest}></div>

<style>
  /* Fades between today's shade and a much lighter one; static under reduced motion. */
  .apogee-skeleton {
    animation: apogee-skeleton 1.4s var(--ease-standard) infinite alternate;
  }
  @keyframes apogee-skeleton {
    from {
      background-color: var(--background-neutral-faded);
    }
    to {
      background-color: color-mix(in oklch, var(--background-neutral-faded) 30%, var(--background-page));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .apogee-skeleton {
      animation: none;
    }
  }
</style>
