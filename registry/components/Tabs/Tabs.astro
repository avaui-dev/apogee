---
/**
 * Tabs — an accessible tabbed panel. The island wires the `role="tablist"`
 * keyboard pattern (arrows / Home / End), roving tabindex, panel visibility,
 * edge fades when the list overflows, and scrolls the chosen tab into view.
 * Without JS every panel shows (stacked), so no content is lost.
 *
 *   <Tabs tabs={['Account', { label: 'Billing', value: 'billing' }, { label: 'Help', href: '/help' }]} value="billing">
 *     <div slot="panel-0">…</div>
 *     <div slot="panel-billing">…</div>
 *   </Tabs>
 *
 * A tab's panel slot is `panel-<value>`; `value` defaults to the index. A tab
 * with `href` is a link (no panel). `disabled` tabs are skipped by the arrows.
 * Items take an `icon` (Lucide component) and a `badge` (count or text).
 * `orientation="vertical"` stacks the list beside the panels (Up/Down move);
 * `activation="manual"` moves focus with the arrows and selects on Enter/Space.
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'
import { uid } from '../utils/uid.ts'
import { innerRadius } from '../utils/radius.ts'
import Badge from '../Badge/Badge.astro'

const lists = {
  bordered: 'gap-1 border-b border-neutral',
  borderless: 'gap-1',
  pills: 'gap-1',
  'pills-raised': 'gap-0.5 rounded-md bg-neutral-faded p-0.5',
  primary: 'gap-1',
} as const
const tabStyles = {
  bordered: 'border-b-2 border-transparent aria-selected:border-primary aria-selected:text-neutral',
  borderless: 'border-b-2 border-transparent aria-selected:border-primary aria-selected:text-neutral',
  pills: 'rounded-md aria-selected:bg-neutral-faded aria-selected:text-neutral',
  'pills-raised': `${innerRadius['md-0.5']} aria-selected:bg-page aria-selected:text-neutral aria-selected:shadow-outline dark:aria-selected:bg-neutral`,
  primary: 'rounded-md aria-selected:bg-primary-faded aria-selected:text-primary',
} as const
// Vertical underline variants draw the line on the start edge.
const verticalTabStyles = {
  bordered: 'border-s-2 border-transparent aria-selected:border-primary aria-selected:text-neutral',
  borderless: 'border-s-2 border-transparent aria-selected:border-primary aria-selected:text-neutral',
} as const
const verticalLists = { bordered: 'border-s border-neutral', borderless: '' } as const
const sizes = {
  small: 'px-2.5 py-1.5 text-xs',
  medium: 'px-3 py-2 text-sm',
  large: 'px-4 py-2.5 text-base',
} as const

export interface TabItem {
  label: string
  value?: string
  href?: string
  disabled?: boolean
  /** A Lucide (or any Astro) icon component, shown before the label. */
  icon?: any
  /** A count or short text shown after the label, from `md`. */
  badge?: string | number
}
interface Props extends Omit<HTMLAttributes<'div'>, 'size'> {
  tabs: (string | TabItem)[]
  /** Value of the tab shown first. Defaults to the first enabled tab. */
  value?: string
  /** @category layout */
  variant?: keyof typeof lists
  /** @category layout */
  size?: keyof typeof sizes
  /** @category layout */
  orientation?: 'horizontal' | 'vertical'
  /** Tabs share the list width equally. @category layout */
  fullWidth?: boolean
  /** `manual`: arrows move focus, Enter or Space selects. */
  activation?: 'automatic' | 'manual'
  class?: string
}

const {
  tabs,
  value,
  variant = 'bordered',
  size = 'medium',
  orientation = 'horizontal',
  fullWidth = false,
  activation = 'automatic',
  class: className,
  ...rest
} = Astro.props
const vertical = orientation === 'vertical'
const underline = variant === 'bordered' || variant === 'borderless'
// The selected fill slides between tabs (tokens file, CSS anchor positioning).
// Vertical underline tabs keep their own start border.
const slides = !(vertical && underline)
const slideLooks = {
  bordered: 'bg-primary',
  borderless: 'bg-primary',
  pills: 'rounded-md bg-neutral-faded',
  'pills-raised': `${innerRadius['md-0.5']} bg-page shadow-outline dark:bg-neutral`,
  primary: 'rounded-md bg-primary-faded',
} as const
const items = tabs.map((t, i) => {
  const o: TabItem = typeof t === 'string' ? { label: t } : t
  return { ...o, value: o.value ?? String(i) }
})
const found = items.findIndex((t) => t.value === value && !t.disabled && !t.href)
const initial = found >= 0 ? found : Math.max(0, items.findIndex((t) => !t.disabled && !t.href))
const id = uid(Astro.locals)
const tabClass =
  'press inline-flex shrink-0 cursor-pointer items-center gap-2 whitespace-nowrap font-medium text-neutral-faded transition-colors hover:text-neutral focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-focus aria-disabled:pointer-events-none aria-disabled:opacity-50'
---

<div
  class:list={['apogee-tabs', vertical && 'flex gap-6 no-js:flex-col', className]}
  data-orientation={orientation}
  data-activation={activation}
  {...rest}
>
  <div
    role="tablist"
    data-apogee-slide={slides ? '' : undefined}
    aria-orientation={vertical ? 'vertical' : undefined}
    class:list={[
      'apogee-tabs-list flex [scrollbar-width:none]',
      vertical
        ? ['shrink-0 flex-col items-stretch overflow-y-auto', underline ? `gap-1 ${verticalLists[variant]}` : lists[variant]]
        : ['overflow-x-auto data-[fade~=left]:mask-l-from-85% data-[fade~=right]:mask-r-from-85%', lists[variant]],
      fullWidth && !vertical && 'w-full',
    ]}
  >
    {slides && <span class:list={['apogee-slide', slideLooks[variant]]} data-shape={underline ? 'line' : undefined} aria-hidden="true" />}
    {
      items.map((t, i) => {
        const Tag = t.href ? 'a' : 'button'
        const hasPanel = !t.href && Astro.slots.has(`panel-${t.value}`)
        const on = i === initial
        const Icon = t.icon
        return (
          <Tag
            type={t.href ? undefined : 'button'}
            href={t.href}
            role="tab"
            id={`${id}-tab-${i}`}
            data-value={t.value}
            aria-controls={hasPanel ? `${id}-panel-${i}` : undefined}
            aria-selected={on ? 'true' : 'false'}
            aria-disabled={t.disabled ? 'true' : undefined}
            tabindex={on ? 0 : -1}
            class:list={[
              tabClass,
              vertical && underline ? [verticalTabStyles[variant], '-ms-px'] : tabStyles[variant],
              sizes[size],
              vertical && 'justify-start text-start',
              fullWidth && !vertical && 'flex-1 justify-center',
            ]}
          >
            {Icon && <Icon class="size-4 shrink-0" aria-hidden="true" />}
            {t.label}
            {t.badge !== undefined && (
              <Badge
                size="small"
                variant="faded"
                color="neutral"
                class="apogee-tabs-badge tabular-nums max-md:hidden in-aria-selected:bg-primary-faded in-aria-selected:text-primary"
              >
                {t.badge}
              </Badge>
            )}
          </Tag>
        )
      })
    }
  </div>
  {
    items.map(
      (t, i) =>
        !t.href &&
        Astro.slots.has(`panel-${t.value}`) && (
          <div
            role="tabpanel"
            id={`${id}-panel-${i}`}
            aria-labelledby={`${id}-tab-${i}`}
            hidden={i !== initial}
            tabindex="0"
            class:list={[
              vertical ? 'min-w-0 flex-1 text-sm' : 'pt-4 text-sm',
              'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus',
              i !== initial && 'no-js:block',
            ]}
          >
            <slot name={`panel-${t.value}`} />
          </div>
        ),
    )
  }
</div>

<style>
  .apogee-tabs [role='tabpanel']:not([hidden]) {
    animation: apogee-tab-in var(--duration-medium) var(--ease-standard);
  }
  @keyframes apogee-tab-in {
    from {
      opacity: 0;
      transform: translateY(2px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .apogee-tabs [role='tabpanel']:not([hidden]) {
      animation: none;
    }
  }
</style>

<script>
  import { island } from '../utils/island.ts'
  import { stepIndex } from '../utils/roving.ts'
  import { edgeFade } from '../utils/fade.ts'

  island('.apogee-tabs', (root) => {
    const list = root.querySelector<HTMLElement>('.apogee-tabs-list')!
    const tabs = [...list.querySelectorAll<HTMLElement>('[role="tab"]')]
    const panelOf = (t: HTMLElement) => {
      const c = t.getAttribute('aria-controls')
      return c ? root.querySelector<HTMLElement>('#' + c) : null
    }
    const enabled = () => tabs.filter((t) => t.getAttribute('aria-disabled') !== 'true')
    const manual = root.dataset.activation === 'manual'
    const orientation = root.dataset.orientation === 'vertical' ? 'vertical' : 'horizontal'

    const select = (index: number) => {
      tabs.forEach((t, i) => {
        const on = i === index
        t.setAttribute('aria-selected', String(on))
        t.tabIndex = on ? 0 : -1
        panelOf(t)?.toggleAttribute('hidden', !on)
      })
      tabs[index]?.scrollIntoView({ block: 'nearest', inline: 'nearest' })
      root.dispatchEvent(
        new CustomEvent('apogee:tabs-change', { bubbles: true, detail: { index, value: tabs[index]?.dataset.value } }),
      )
    }

    edgeFade(list)

    tabs.forEach((tab, i) => {
      if (!tab.hasAttribute('href')) tab.addEventListener('click', () => select(i))
      tab.addEventListener('keydown', (e) => {
        if (manual && (e.key === 'Enter' || e.key === ' ') && !tab.hasAttribute('href')) {
          e.preventDefault()
          select(i)
          return
        }
        const row = enabled()
        const n = stepIndex(e.key, row.indexOf(tab), row.length - 1, getComputedStyle(root).direction === 'rtl', orientation)
        if (n === null) return
        e.preventDefault()
        const next = row[n]!
        next.focus()
        if (manual) {
          for (const t of tabs) t.tabIndex = t === next ? 0 : -1
        } else if (!next.hasAttribute('href')) select(tabs.indexOf(next))
      })
    })
  })
</script>
