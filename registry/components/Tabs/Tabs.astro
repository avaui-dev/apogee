---
/**
 * Tabs — an accessible tabbed panel. The island wires the `role="tablist"`
 * keyboard pattern (arrows / Home / End), roving tabindex, panel visibility,
 * edge fades when the list overflows, and scrolls the chosen tab into view.
 * Without JS every panel shows (stacked), so no content is lost.
 *
 *   <Tabs tabs={['Account', { label: 'Billing', value: 'billing' }, { label: 'Help', href: '/help' }]} value="billing">
 *     <div slot="panel-0">…</div>
 *     <div slot="panel-billing">…</div>
 *   </Tabs>
 *
 * A tab's panel slot is `panel-<value>`; `value` defaults to the index. A tab
 * with `href` is a link (no panel). `disabled` tabs are skipped by the arrows.
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'
import { uid } from '../utils/uid.ts'
import { innerRadius } from '../utils/radius.ts'

const lists = {
  bordered: 'gap-1 border-b border-neutral',
  borderless: 'gap-1',
  pills: 'gap-1',
  'pills-raised': 'gap-0.5 rounded-md bg-neutral-faded p-0.5',
} as const
const tabStyles = {
  bordered: 'border-b-2 border-transparent aria-selected:border-primary aria-selected:text-neutral',
  borderless: 'border-b-2 border-transparent aria-selected:border-primary aria-selected:text-neutral',
  pills: 'rounded-md aria-selected:bg-neutral-faded aria-selected:text-neutral',
  'pills-raised': `${innerRadius['md-0.5']} aria-selected:bg-page aria-selected:text-neutral aria-selected:shadow-outline dark:aria-selected:bg-neutral`,
} as const
const sizes = {
  small: 'px-2.5 py-1.5 text-xs',
  medium: 'px-3 py-2 text-sm',
  large: 'px-4 py-2.5 text-base',
} as const

export interface TabItem {
  label: string
  value?: string
  href?: string
  disabled?: boolean
}
interface Props extends Omit<HTMLAttributes<'div'>, 'size'> {
  tabs: (string | TabItem)[]
  /** Value of the tab shown first. Defaults to the first enabled tab. */
  value?: string
  /** @category layout */
  variant?: keyof typeof lists
  /** @category layout */
  size?: keyof typeof sizes
  class?: string
}

const { tabs, value, variant = 'bordered', size = 'medium', class: className, ...rest } = Astro.props
const items = tabs.map((t, i) => {
  const o: TabItem = typeof t === 'string' ? { label: t } : t
  return { ...o, value: o.value ?? String(i) }
})
const found = items.findIndex((t) => t.value === value && !t.disabled && !t.href)
const initial = found >= 0 ? found : Math.max(0, items.findIndex((t) => !t.disabled && !t.href))
const id = uid(Astro.locals)
const tabClass =
  'shrink-0 cursor-pointer whitespace-nowrap font-medium text-neutral-faded transition-colors hover:text-neutral focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-focus aria-disabled:pointer-events-none aria-disabled:opacity-50'
---

<div class:list={['apogee-tabs', className]} {...rest}>
  <div
    role="tablist"
    class:list={[
      'apogee-tabs-list flex overflow-x-auto [scrollbar-width:none] data-[fade~=left]:mask-l-from-85% data-[fade~=right]:mask-r-from-85%',
      lists[variant],
    ]}
  >
    {
      items.map((t, i) => {
        const Tag = t.href ? 'a' : 'button'
        const hasPanel = !t.href && Astro.slots.has(`panel-${t.value}`)
        const on = i === initial
        return (
          <Tag
            type={t.href ? undefined : 'button'}
            href={t.href}
            role="tab"
            id={`${id}-tab-${i}`}
            data-value={t.value}
            aria-controls={hasPanel ? `${id}-panel-${i}` : undefined}
            aria-selected={on ? 'true' : 'false'}
            aria-disabled={t.disabled ? 'true' : undefined}
            tabindex={on ? 0 : -1}
            class:list={[tabClass, tabStyles[variant], sizes[size]]}
          >
            {t.label}
          </Tag>
        )
      })
    }
  </div>
  {
    items.map(
      (t, i) =>
        !t.href &&
        Astro.slots.has(`panel-${t.value}`) && (
          <div
            role="tabpanel"
            id={`${id}-panel-${i}`}
            aria-labelledby={`${id}-tab-${i}`}
            hidden={i !== initial}
            tabindex="0"
            class:list={[
              'pt-4 text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus',
              i !== initial && 'no-js:block',
            ]}
          >
            <slot name={`panel-${t.value}`} />
          </div>
        ),
    )
  }
</div>

<style>
  .apogee-tabs [role='tabpanel']:not([hidden]) {
    animation: apogee-tab-in var(--duration-medium) var(--ease-standard);
  }
  @keyframes apogee-tab-in {
    from {
      opacity: 0;
      transform: translateY(2px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .apogee-tabs [role='tabpanel']:not([hidden]) {
      animation: none;
    }
  }
</style>

<script>
  import { island } from '../utils/island.ts'
  import { stepIndex } from '../utils/roving.ts'
  import { edgeFade } from '../utils/fade.ts'

  island('.apogee-tabs', (root) => {
    const list = root.querySelector<HTMLElement>('.apogee-tabs-list')!
    const tabs = [...list.querySelectorAll<HTMLElement>('[role="tab"]')]
    const panelOf = (t: HTMLElement) => {
      const c = t.getAttribute('aria-controls')
      return c ? root.querySelector<HTMLElement>('#' + c) : null
    }
    const enabled = () => tabs.filter((t) => t.getAttribute('aria-disabled') !== 'true')

    const select = (index: number) => {
      tabs.forEach((t, i) => {
        const on = i === index
        t.setAttribute('aria-selected', String(on))
        t.tabIndex = on ? 0 : -1
        panelOf(t)?.toggleAttribute('hidden', !on)
      })
      tabs[index]?.scrollIntoView({ block: 'nearest', inline: 'nearest' })
      root.dispatchEvent(
        new CustomEvent('apogee:tabs-change', { bubbles: true, detail: { index, value: tabs[index]?.dataset.value } }),
      )
    }

    edgeFade(list)

    tabs.forEach((tab, i) => {
      if (!tab.hasAttribute('href')) tab.addEventListener('click', () => select(i))
      tab.addEventListener('keydown', (e) => {
        const row = enabled()
        const n = stepIndex(e.key, row.indexOf(tab), row.length - 1, getComputedStyle(root).direction === 'rtl')
        if (n === null) return
        e.preventDefault()
        const next = row[n]!
        next.focus()
        if (!next.hasAttribute('href')) select(tabs.indexOf(next))
      })
    })
  })
</script>
