---
/**
 * Popover — rich content on click with the native Popover API: top layer +
 * light dismiss (click-away / Esc) for free, zero JS. Positioned with CSS
 * anchor positioning; where that's unsupported the panel centers on screen
 * (still fully usable). Slots: `trigger` (button label), default (panel).
 */
import type { HTMLAttributes } from 'astro/types'
import { uid } from '../utils/uid.ts'
const id = uid(Astro.locals, 'apogee-pop')
const anchor = `--${id}`

/** @composable */
interface Props extends HTMLAttributes<'div'> {
  placement?: 'bottom' | 'top'
  class?: string
}

const { placement = 'bottom', class: className, ...rest } = Astro.props
---

<button
  type="button"
  popovertarget={id}
  style={`anchor-name: ${anchor}`}
  class:list={[
    'inline-flex items-center gap-1 rounded-md border border-neutral bg-page px-3 py-1.5 text-sm font-medium text-neutral hover:bg-neutral-faded-highlighted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary',
    className,
  ]}
  {...rest}
>
  <slot name="trigger">Open</slot>
</button>

<div
  id={id}
  popover
  data-placement={placement}
  style={`position-anchor: ${anchor}`}
  class="apogee-popover w-64 rounded-lg border border-neutral bg-page p-4 text-sm text-neutral shadow-lg"
>
  <slot />
</div>

<style>
  .apogee-popover {
    margin: 0;
    opacity: 0;
    transform: translateY(-0.25rem);
    transition:
      opacity var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard),
      overlay var(--duration-fast) allow-discrete,
      display var(--duration-fast) allow-discrete;
  }
  .apogee-popover:popover-open {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .apogee-popover {
      transition: none;
      transform: none;
    }
  }
  @starting-style {
    .apogee-popover:popover-open {
      opacity: 0;
      transform: translateY(-0.25rem);
    }
  }

  /* Anchor to the trigger where supported (Chromium-first); otherwise the
     popover's default centering applies. `flip-block` is the native equivalent
     of the Dropdown's flip — the panel swaps above the trigger when there's no
     room below, no JS. */
  @supports (anchor-name: --x) {
    .apogee-popover {
      position: fixed;
      inset: auto;
      position-try-fallbacks: flip-block;
    }
    .apogee-popover[data-placement='bottom'] {
      top: anchor(bottom);
      left: anchor(left);
      margin-top: 0.5rem;
    }
    .apogee-popover[data-placement='top'] {
      bottom: anchor(top);
      left: anchor(left);
      margin-bottom: 0.5rem;
    }
  }
</style>
