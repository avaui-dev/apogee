---
/**
 * Popover — rich content on click with the native Popover API: top layer and
 * light dismiss (click-away / Esc) for free, zero JS. Anchored to its trigger
 * with CSS anchor positioning (12 placements, flips when out of room); where
 * unsupported the panel centres on screen and stays usable.
 * Slots: `trigger` (label of the built-in button), `anchor` (your own element —
 * give it `popovertarget={id}`), default (panel).
 */
import type { HTMLAttributes } from 'astro/types'
import { uid } from '../utils/uid.ts'
import { panelStyle, panelClass, panelSurface, panelPadding, type Placement } from '../utils/panel.ts'

/** @composable */
interface Props extends HTMLAttributes<'div'> {
  /** Panel id; set it when an `anchor` slot element needs `popovertarget`. */
  id?: string
  /** @category layout */
  placement?: Placement
  /** Space between trigger and panel, in spacing steps. */
  gap?: number
  /** `'trigger'` matches the trigger's width; any CSS length otherwise. */
  width?: 'trigger' | string
  /** Scrolls the panel content past this height. */
  maxHeight?: string
  padding?: keyof typeof panelPadding
  elevation?: keyof typeof panelSurface
  /** Extra classes on the panel. */
  panelClass?: string
  /** Extra classes on the trigger (built-in button or anchor wrapper). */
  class?: string
}

const {
  id: idProp,
  placement = 'bottom',
  gap = 2,
  width,
  maxHeight,
  padding = 4,
  elevation = 'overlay',
  panelClass: panelClassName,
  class: className,
  ...rest
} = Astro.props
const id = idProp ?? uid(Astro.locals, 'apogee-pop')
const anchor = `--${id}`
const triggerClass =
  'inline-flex items-center gap-1 rounded-md border border-neutral bg-page px-3 py-1.5 text-sm font-medium text-neutral hover:bg-neutral-faded-highlighted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary'
---

{
  Astro.slots.has('anchor') ? (
    <span class:list={['inline-flex', className]} style={`anchor-name: ${anchor}`} {...rest}>
      <slot name="anchor" />
    </span>
  ) : (
    <button type="button" popovertarget={id} style={`anchor-name: ${anchor}`} class:list={[triggerClass, className]} {...rest}>
      <slot name="trigger">Open</slot>
    </button>
  )
}

<div
  id={id}
  popover
  style={panelStyle({ anchor, placement, gap, width, maxHeight })}
  class:list={[
    panelClass,
    panelSurface[elevation],
    panelPadding[padding],
    maxHeight && 'overflow-auto',
    panelClassName,
  ]}
>
  <slot />
</div>
