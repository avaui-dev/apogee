---
/**
 * Textarea — a labeled multiline input. Same field wiring as Input.
 */
import type { HTMLAttributes } from 'astro/types'
import { uid } from '../utils/uid.ts'
import Field from '../Field/Field.astro'
import { fieldSizes, fieldVariants, fieldBase, type FieldSize, type FieldVariant } from '../utils/field.ts'

/** @composable */
interface Props extends Omit<HTMLAttributes<'textarea'>, 'size'> {
  id?: string
  label?: string
  hint?: string
  error?: string
  rows?: number
  /** Initial text (a textarea carries its value as content, not an attribute). */
  value?: string
  /** Marks the field invalid without a message. */
  hasError?: boolean
  /** @category layout */
  size?: FieldSize
  /** @category layout */
  variant?: FieldVariant
  required?: boolean
  class?: string
}

const {
  id: idProp,
  label,
  hint,
  value,
  error,
  rows = 4,
  hasError = false,
  size = 'medium',
  variant = 'outline',
  required = false,
  class: className,
  ...rest
} = Astro.props
const id = idProp ?? uid(Astro.locals)
const invalid = Boolean(error) || hasError
const describedby = error ? `${id}-error` : hint ? `${id}-hint` : undefined
// A textarea grows with rows: keep the size's padding/text, drop its fixed height.
const sizeClasses = fieldSizes[size].replace(/\bh-\S+/, 'py-2')
---

<Field id={id} label={label} hint={hint} error={error} required={required} class={className}>
  <textarea
    id={id}
    rows={rows}
    required={required}
    aria-describedby={describedby}
    aria-invalid={invalid ? 'true' : undefined}
    class:list={['resize-y', fieldBase, fieldVariants[variant], sizeClasses]}
    {...rest}>{value ?? <slot />}</textarea>
</Field>
