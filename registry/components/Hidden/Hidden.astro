---
/**
 * Hidden — hides its children below or above a breakpoint, or visually only
 * (`sr-only`, still read by assistive tech). Zero JS; pure CSS media queries.

 */
import type { HTMLAttributes } from 'astro/types'

const below = { sm: 'max-sm:hidden', md: 'max-md:hidden', lg: 'max-lg:hidden', xl: 'max-xl:hidden' } as const satisfies Record<NonNullable<Props['below']>, string>
const above = { sm: 'sm:hidden', md: 'md:hidden', lg: 'lg:hidden', xl: 'xl:hidden' } as const satisfies Record<NonNullable<Props['above']>, string>

/** @composable */
interface Props extends HTMLAttributes<'div'> {
  /** @category layout */
  as?: 'div' | 'span'
  /** Hidden on viewports narrower than this breakpoint. @category layout */
  below?: 'sm' | 'md' | 'lg' | 'xl'
  /** Hidden on viewports at or wider than this breakpoint. @category layout */
  above?: 'sm' | 'md' | 'lg' | 'xl'
  /** Visually hidden, still announced. @category layout */
  visually?: boolean
  class?: string
}

const { as = 'div', below: b, above: a, visually = false, class: className, ...rest } = Astro.props
const Tag = as
---

<Tag class:list={[b && below[b], a && above[a], visually && 'sr-only', className]} {...rest}>
  <slot />
</Tag>
