---
/**
 * Stack — lays children out in a column or row with a token gap. The workhorse
 * for spacing groups of elements. `direction`, `gap`, `align`, `justify` and
 * `wrap` accept a value or a per-breakpoint object: `{ base: 'column', md: 'row' }`.
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'
import { responsive, type Responsive } from '../utils/responsive.ts'
import { tables } from '../utils/responsive-tables.ts'

type Direction = keyof typeof tables.direction.base
type Gap = keyof typeof tables.gap.base
type Align = keyof typeof tables.align.base
type Justify = keyof typeof tables.justify.base

/** @composable */
interface Props extends Omit<HTMLAttributes<'div'>, 'align'> {
  as?: string
  /** @category layout */
  direction?: Responsive<Direction>
  /** @category layout */
  gap?: Responsive<Gap>
  /** @category layout */
  align?: Responsive<Align>
  /** @category layout */
  justify?: Responsive<Justify>
  /** @category layout */
  wrap?: Responsive<boolean>
  class?: string
}

const { as = 'div', direction = 'column', gap = 4, align, justify, wrap, class: className, ...rest } = Astro.props
const Tag = as
// Booleans are keyed 'true' / 'false' in the generated table.
const wrapKey = wrap === undefined ? undefined : typeof wrap === 'object' ? Object.fromEntries(Object.entries(wrap).map(([k, v]) => [k, String(v)])) : String(wrap)
---

<Tag
  class:list={[
    'flex',
    responsive(direction, tables.direction),
    responsive(gap, tables.gap),
    responsive(align, tables.align),
    responsive(justify, tables.justify),
    responsive(wrapKey as Responsive<'true' | 'false'> | undefined, tables.wrap),
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
