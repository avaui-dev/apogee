---
/**
 * Switch — a toggle. A real `<input type="checkbox" role="switch">` (visually
 * hidden) drives a CSS track + thumb, so it's zero-JS and fully accessible.
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'
import { uid } from '../utils/uid.ts'
interface Props extends HTMLAttributes<'input'> {
  id?: string
  label?: string
  /** Supporting text under the label, read as the control's description. @category content */
  hint?: string
  /** @category layout */
  size?: 'small' | 'medium' | 'large'
  /** Marks the control invalid. */
  hasError?: boolean
  /** Label first, switch last. @category layout */
  reversed?: boolean
  /** `slim`: a thin faded track with a bordered knob that overhangs it. @category layout */
  variant?: 'default' | 'slim'
  class?: string
}

const { id: idProp, label, hint, size = 'medium', hasError = false, reversed = false, variant = 'default', class: className, ...rest } = Astro.props
const hasLabel = Boolean(label) || Astro.slots.has('default')
// Track and knob per variant and size. Every string is a literal so Tailwind sees it.
const looks = {
  default: 'bg-neutral peer-checked:bg-primary after:start-0.5 after:top-0.5 after:bg-white after:shadow-outline',
  slim: 'bg-neutral-faded peer-checked:bg-primary-faded after:start-0 after:-top-0.5 after:border after:border-neutral after:bg-page after:shadow-raised peer-checked:after:border-primary',
} as const
const tracks = {
  default: {
    small: 'h-4 w-7 after:size-3 peer-checked:after:translate-x-3 rtl:peer-checked:after:-translate-x-3',
    medium: 'h-5 w-9 after:size-4 peer-checked:after:translate-x-4 rtl:peer-checked:after:-translate-x-4',
    large: 'h-6 w-11 after:size-5 peer-checked:after:translate-x-5 rtl:peer-checked:after:-translate-x-5',
  },
  slim: {
    small: 'h-3 w-7 after:size-4 peer-checked:after:translate-x-3 rtl:peer-checked:after:-translate-x-3',
    medium: 'h-4 w-9 after:size-5 peer-checked:after:translate-x-4 rtl:peer-checked:after:-translate-x-4',
    large: 'h-5 w-11 after:size-6 peer-checked:after:translate-x-5 rtl:peer-checked:after:-translate-x-5',
  },
} as const
const labelSizes = { small: 'text-xs', medium: 'text-sm', large: 'text-base' } as const
const id = idProp ?? uid(Astro.locals)
---

<label for={id} class:list={['inline-flex gap-2', hint ? 'items-start' : 'items-center', reversed && 'flex-row-reverse', className]}>
  <input
    id={id}
    type="checkbox"
    role="switch"
    class="peer sr-only"
    aria-invalid={hasError ? 'true' : undefined}
    aria-describedby={hint ? `${id}-hint` : undefined}
    {...rest}
  />
  <span
    class:list={[
      "relative shrink-0 rounded-full transition-colors motion-reduce:transition-none motion-reduce:after:transition-none peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-focus peer-disabled:bg-disabled peer-aria-[invalid=true]:shadow-[0_0_0_1.5px_var(--border-critical)] after:absolute after:rounded-full after:transition-transform after:content-['']",
      looks[variant],
      tracks[variant][size],
    ]}
  ></span>
  {
    hasLabel && (
      <span class="flex flex-col gap-0.5">
        <span class:list={[labelSizes[size], 'text-neutral', hint && 'font-medium']}>{label ?? <slot />}</span>
        {hint && <span id={`${id}-hint`} class:list={[labelSizes[size], 'text-neutral-faded']}>{hint}</span>}
      </span>
    )
  }
</label>
