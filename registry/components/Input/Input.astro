---
/**
 * Input — a labeled text input. Renders a full accessible field (label + input
 * + hint/error) via Field, wiring `for` / `aria-describedby` / `aria-invalid`.
 *
 * `size` and `variant` come from the shared field tables, so every text-like
 * control matches. `labelPosition="floating"` animates the label from
 * placeholder position to the top border on focus / when filled (pure CSS).
 * Icons or prefixes go in the `start` / `end` slots, inside the control box.
 */
import type { HTMLAttributes } from 'astro/types'
import Field from '../Field/Field.astro'
import { uid } from '../utils/uid.ts'
import { fieldSizes, fieldVariants, fieldBase, type FieldSize, type FieldVariant } from '../utils/field.ts'
import { Eye, EyeOff } from '@lucide/astro'

/** @composable */
interface Props extends Omit<HTMLAttributes<'input'>, 'size'> {
  id?: string
  /** @category content */
  label?: string
  /** @category content */
  hint?: string
  /** @category content */
  error?: string
  /** Marks the field invalid without a message. */
  hasError?: boolean
  type?: 'text' | 'email' | 'password' | 'number' | 'tel' | 'url' | 'search' | 'date' | 'time' | 'datetime-local' | 'month' | 'week'
  /** @category layout */
  size?: FieldSize
  /** @category layout */
  variant?: FieldVariant
  /** Floating label animates from placeholder position to the top border (CSS only). @category layout */
  labelPosition?: 'top' | 'floating'
  /** Text before the value (currency sign, protocol). Replaces the `start` slot. @category content */
  prefix?: string
  /** Text after the value (unit). Replaces the `end` slot. @category content */
  suffix?: string
  required?: boolean
  /** Inside an InputGroup: no label, hint or error of its own (the group owns them). */
  grouped?: boolean
  /** With `type="password"`: an eye button in the end slot that shows or hides the value (small island). */
  revealable?: boolean
  class?: string
}

const {
  id: idProp,
  label,
  hint,
  error,
  hasError = false,
  type = 'text',
  size = 'medium',
  variant = 'outline',
  labelPosition = 'top',
  prefix,
  suffix,
  required = false,
  grouped = false,
  revealable = false,
  class: className,
  ...rest
} = Astro.props
const id = idProp ?? uid(Astro.locals)
const invalid = Boolean(error) || hasError
// Grouped: the group renders `${id}-hint` / `${id}-error`; pass `aria-describedby` yourself to name them.
const describedby = [hint && `${id}-hint`, error && `${id}-error`].filter(Boolean).join(' ') || undefined
const hasStart = Boolean(prefix) || Astro.slots.has('start')
const reveal = revealable && type === 'password'
const hasEnd = Boolean(suffix) || Astro.slots.has('end') || reveal
const floating = labelPosition === 'floating'
const labelInset = { small: 'start-2', medium: 'start-3', large: 'start-4', xlarge: 'start-5' } as const
---

<Field id={id} label={floating ? undefined : label} size={size} hint={hint} error={error} required={required} bare={grouped} class={className}>
  <div class:list={['relative flex items-center', grouped && 'min-w-0 flex-1 focus-within:z-10']}>
    {
      hasStart && (
        <span class="pointer-events-none absolute start-3 text-sm text-neutral-faded [&_svg]:size-4">
          {prefix ?? <slot name="start" />}
        </span>
      )
    }
    <input
      id={id}
      type={type}
      required={required}
      aria-describedby={describedby}
      aria-invalid={invalid ? 'true' : undefined}
      class:list={[fieldBase, fieldVariants[variant], fieldSizes[size], hasStart && 'ps-9', hasEnd && 'pe-9', floating && 'peer']}
      placeholder={floating ? ' ' : undefined}
      {...rest}
    />
    {
      hasEnd && (
        <span class="pointer-events-none absolute end-3 flex items-center text-sm text-neutral-faded [&_svg]:size-4 [&_button]:pointer-events-auto">
          {
            reveal ? (
              <button
                type="button"
                class="apogee-reveal grid size-6 place-items-center rounded text-neutral-faded transition-colors hover:text-neutral focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus no-js:hidden"
                aria-label="Show password"
                aria-pressed="false"
              >
                <Eye class="apogee-reveal-show" aria-hidden="true" />
                <EyeOff class="apogee-reveal-hide" aria-hidden="true" />
              </button>
            ) : (
              suffix ?? <slot name="end" />
            )
          }
        </span>
      )
    }
    {
      floating && (
        <label
          for={id}
          class:list={[
            'pointer-events-none absolute top-1/2 -translate-y-1/2 bg-page px-1 text-sm text-neutral-faded transition-all motion-reduce:transition-none',
            'peer-focus:-top-0.5 peer-focus:text-xs peer-focus:font-medium peer-focus:text-primary',
            'peer-[:not(:placeholder-shown)]:-top-0.5 peer-[:not(:placeholder-shown)]:text-xs peer-[:not(:placeholder-shown)]:font-medium',
            'peer-disabled:text-disabled',
            labelInset[size],
          ]}
        >
          {label}
          {required && <span class="text-critical" aria-hidden="true"> *</span>}
        </label>
      )
    }
  </div>
</Field>

<style>
  /* Date and time fields: the parts the browser exposes take the tokens. The
     picker popup itself is browser UI; it follows color-scheme and, in
     Chromium, accent-color. */
  input:is([type='date'], [type='time'], [type='datetime-local'], [type='month'], [type='week']) {
    accent-color: var(--background-primary);
  }
  input::-webkit-calendar-picker-indicator {
    cursor: pointer;
    opacity: 0.6;
    border-radius: 0.25rem;
    padding: 0.125rem;
    transition: opacity var(--duration-fast) var(--ease-standard);
  }
  input:hover::-webkit-calendar-picker-indicator,
  input:focus-visible::-webkit-calendar-picker-indicator {
    opacity: 1;
  }
  input::-webkit-datetime-edit-day-field:focus,
  input::-webkit-datetime-edit-month-field:focus,
  input::-webkit-datetime-edit-year-field:focus,
  input::-webkit-datetime-edit-hour-field:focus,
  input::-webkit-datetime-edit-minute-field:focus,
  input::-webkit-datetime-edit-ampm-field:focus,
  input::-webkit-datetime-edit-week-field:focus {
    background-color: var(--background-primary-faded);
    color: var(--foreground-primary);
    border-radius: 0.2rem;
  }
  input::-webkit-datetime-edit-text {
    color: var(--foreground-neutral-faded);
  }
  @media (prefers-reduced-motion: reduce) {
    input::-webkit-calendar-picker-indicator {
      transition: none;
    }
  }
  /* The eye swaps with the pressed state. */
  .apogee-reveal-hide,
  .apogee-reveal[aria-pressed='true'] .apogee-reveal-show {
    display: none;
  }
  .apogee-reveal[aria-pressed='true'] .apogee-reveal-hide {
    display: block;
  }
</style>

<script>
  import { island } from '../utils/island.ts'

  // Reveal: flip the input between password and text; the label follows.
  island<HTMLButtonElement>('.apogee-reveal', (btn) => {
    const input = btn.closest('div')?.querySelector<HTMLInputElement>('input')
    if (!input) return
    btn.addEventListener('click', () => {
      const show = input.type === 'password'
      input.type = show ? 'text' : 'password'
      btn.setAttribute('aria-pressed', String(show))
      input.focus()
    })
  })
</script>
