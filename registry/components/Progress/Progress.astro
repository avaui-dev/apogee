---
/**
 * Progress — a determinate or indeterminate progress bar. Zero JS.
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'
interface Props extends HTMLAttributes<'div'> {
  value?: number
  max?: number
  label?: string
  indeterminate?: boolean
  /** Bar hue. @category layout */
  color?: 'primary' | 'neutral' | 'critical' | 'positive' | 'warning'
  /** Bar thickness. @category layout */
  size?: 'small' | 'medium'
  class?: string
}
const heights = { small: 'h-1', medium: 'h-2' } as const
const fills = { primary: 'bg-primary', neutral: 'bg-neutral', critical: 'bg-critical', positive: 'bg-positive', warning: 'bg-warning' } as const

const { value = 0, max = 100, label, indeterminate = false, color = 'primary', size = 'medium', class: className, ...rest } = Astro.props
const pct = Math.max(0, Math.min(100, (value / max) * 100))
---

<div
  role="progressbar"
  aria-label={label}
  aria-valuemin={indeterminate ? undefined : 0}
  aria-valuemax={indeterminate ? undefined : max}
  aria-valuenow={indeterminate ? undefined : value}
  class:list={['w-full overflow-hidden rounded-full bg-neutral-faded', heights[size], className]}
  {...rest}
>
  <div
    class:list={['h-full rounded-full', fills[color], indeterminate ? 'apogee-progress-indeterminate' : 'transition-[width] duration-[var(--duration-slow)] ease-smooth']}
    style={indeterminate ? undefined : `width: ${pct}%`}
  >
  </div>
</div>

<style>
  .apogee-progress-indeterminate {
    width: 40%;
    animation: apogee-progress-slide 1.2s ease-in-out infinite;
  }
  @keyframes apogee-progress-slide {
    0% {
      transform: translateX(-110%);
    }
    100% {
      transform: translateX(360%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .apogee-progress-indeterminate {
      animation-duration: 3s;
    }
  }
</style>
