---
/**
 * SSO first: Single sign-on leads; email is the fallback under an "or" divider.
 *
 * @page log-in
 */
import { Orbit, KeyRound } from '@lucide/astro'
import AuthShell from '../../sections/AuthShell/AuthShell.astro'
import FeaturedIcon from '../../components/FeaturedIcon/FeaturedIcon.astro'
import Input from '../../components/Input/Input.astro'
import Button from '../../components/Button/Button.astro'
import Divider from '../../components/Divider/Divider.astro'
import Link from '../../components/Link/Link.astro'
---

<AuthShell heading="Log in to your account" description="Welcome back! Choose how you sign in." pattern="grid">
  <FeaturedIcon slot="brand" theme="solid" color="primary" size="large"><Orbit /></FeaturedIcon>

  <div class="flex flex-col gap-6">
    <Button href="#" variant="outline" color="neutral" size="large" fullWidth>
      <KeyRound slot="start" aria-hidden="true" />
      Continue with SSO
    </Button>
    <Divider>or</Divider>
    <form method="post" class="flex flex-col gap-4">
      <Input label="Email" type="email" name="email" placeholder="Enter your email" autocomplete="email" required />
      <Button type="submit" size="large" fullWidth>Continue with email</Button>
    </form>
  </div>

  <p slot="footer" class="text-neutral-faded">
    Don't have an account? <Link href="#" underline="hover" class="font-semibold">Sign up</Link>
  </p>
</AuthShell>
