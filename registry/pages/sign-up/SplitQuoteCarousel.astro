---
/**
 * Split with quote carousel: Customer quotes rotate in the panel, with dots and arrows underneath.
 *
 * @page sign-up
 */
import { Orbit, KeyRound } from '@lucide/astro'
import AuthShell from '../../sections/AuthShell/AuthShell.astro'
import FeaturedIcon from '../../components/FeaturedIcon/FeaturedIcon.astro'
import Input from '../../components/Input/Input.astro'
import Button from '../../components/Button/Button.astro'
import Link from '../../components/Link/Link.astro'
import Carousel from '../../components/Carousel/Carousel.astro'
import Avatar from '../../components/Avatar/Avatar.astro'
import Rating from '../../components/Rating/Rating.astro'

const reviews = [
  { quote: 'We set up the whole team before lunch. The onboarding just gets out of the way.', name: 'Mara Okafor', role: 'Head of Operations, Oakmere', avatar: 'https://i.pravatar.cc/96?img=47' },
  { quote: 'Single sign-on took ten minutes. Our security review took longer to schedule.', name: 'Jonas Weber', role: 'IT Lead, Fernhill', avatar: 'https://i.pravatar.cc/96?img=12' },
  { quote: 'The trial had everything we needed to decide. No sales call, no surprises.', name: 'Ana Lima', role: 'Founder, Brightwell', avatar: 'https://i.pravatar.cc/96?img=32' },
]
---

<AuthShell layout="split" heading="Sign up" description="Start your 30-day free trial." panelSide="start">
  <a slot="brand" href="#" class="flex items-center gap-2 font-semibold">
    <FeaturedIcon theme="solid" color="primary" size="small"><Orbit /></FeaturedIcon>
    Example
  </a>

  <form method="post" class="flex flex-col gap-6">
    <div class="flex flex-col gap-5">
      <Input label="Name" name="name" placeholder="Enter your name" autocomplete="name" required />
      <Input label="Email" type="email" name="email" placeholder="Enter your email" autocomplete="email" required />
      <Input label="Password" type="password" name="password" placeholder="Create a password" autocomplete="new-password" minlength="8" hint="Must be at least 8 characters." required />
    </div>
    <div class="flex flex-col gap-4">
      <Button type="submit" size="large" fullWidth>Get started</Button>
      <Button href="#" variant="outline" color="neutral" size="large" fullWidth>
        <KeyRound slot="start" aria-hidden="true" />
        Sign up with SSO
      </Button>
    </div>
  </form>

  <p slot="footer" class="text-neutral-faded">
    Already have an account? <Link href="#" underline="hover" class="font-semibold">Log in</Link>
  </p>

  <p slot="legal">© Example 2026</p>

  <div slot="panel" class="flex w-full items-center justify-center px-16 py-16">
    <Carousel itemWidth="100%" dots controlsPosition="below" label="Customer reviews" class="w-full max-w-xl">
      {reviews.map((r) => (
        <figure class="flex flex-col gap-8">
          <Rating readonly value={5} aria-label="Rated 5 out of 5" />
          <blockquote class="text-3xl font-medium text-balance">{r.quote}</blockquote>
          <figcaption class="flex items-center gap-4">
            <Avatar src={r.avatar} name={r.name} size="large" />
            <div>
              <p class="font-semibold">{r.name}</p>
              <p class="text-sm text-neutral-faded">{r.role}</p>
            </div>
          </figcaption>
        </figure>
      ))}
    </Carousel>
  </div>
</AuthShell>
