---
/**
 * Split with image: The status, heading and buttons beside a photo.
 *
 * @page not-found
 */
import NotFound from '../../sections/NotFound/NotFound.astro'
import Image from '../../components/Image/Image.astro'
---

<NotFound fullHeight back="Go back" layout="split" code="404 error" heading="Page not found" description="Sorry, the page you are looking for doesn't exist or has been moved." primaryAction={{ label: 'Take me home', href: '/' }}>
  <Image slot="media" src="https://picsum.photos/seed/apogee-404-2/1200/1000" alt="" width={1200} height={1000} fit="cover" radius="xl" class="aspect-[6/5] w-full" />
</NotFound>
