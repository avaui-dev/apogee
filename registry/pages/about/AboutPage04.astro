---
/**
 * About page 04: A centred eyebrow, heading and line. Then the team, figures, customer quotes, a call to action on grey and a footer on dark.
 *
 * @page about
 */
import Divider from '../../components/Divider/Divider.astro'
import Navigation from '../../blocks/header-navigation/FloatingFourColSlimWithFooter.astro'
import Header from '../../blocks/header/Centered.astro'
import Team from '../../blocks/team/ImageGlass01.astro'
import Metrics from '../../blocks/metrics/ImageWithCards01.astro'
import Testimonials from '../../blocks/testimonials/SimpleCentered01.astro'
import CallToAction from '../../blocks/cta/SimpleCentered.astro'
import Footer from '../../blocks/footers/Large03.astro'
---

<Navigation />
<main>
  <Header eyebrow="About us" heading="About the company" description="Learn more about the company and the team behind it." />
  <div class="mx-auto max-w-7xl px-gutter"><Divider /></div>
  <Team />
  <div class="mx-auto max-w-7xl px-gutter"><Divider /></div>
  <Metrics />
  <div class="mx-auto max-w-7xl px-gutter"><Divider /></div>
  <Testimonials />
  <div class="bg-neutral-faded"><CallToAction /></div>
</main>
<div data-theme="dark" class="bg-page text-neutral"><Footer /></div>
