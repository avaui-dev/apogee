---
/**
 * BlogList — post cards in a grid, or one featured post above the grid.
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Grid from '../../components/Grid/Grid.astro'
import Image from '../../components/Image/Image.astro'
import Avatar from '../../components/Avatar/Avatar.astro'
import Heading from '../../components/Heading/Heading.astro'
import { uid } from '../../components/utils/uid.ts'
import type { Align, Background, Media, Spacing } from '../_shared/spine.ts'
import { formatDate } from '../_shared/date.ts'

type Post = { title: string; excerpt: string; href: string; image?: Media; date: string; author?: { name: string; avatar?: string } }

/** @composable */
interface Props extends Omit<HTMLAttributes<'section'>, 'id'> {
  /** @category content */ eyebrow?: string
  /** @category content */ heading?: string
  /** @category content */ description?: string
  /** Landmark name when there is no heading. @category content */ label?: string
  /** Posts. `date` is an ISO date string. @shape { title: string, excerpt: string, href: string, image?: { src, alt }, date: string, author?: { name: string, avatar?: string } } @category content */
  items: Post[]
  /** Date locale; defaults to the page locale. @category content */ locale?: string
  /** `featured` shows the first post full width. @category layout */ layout?: 'grid' | 'featured'
  /** @category layout */ align?: Align
  /** @category layout */ background?: Background
  /** @category layout */ spacing?: Spacing
  /** @category layout */ headingLevel?: 1 | 2 | 3 | 4
  id?: string
  class?: string
}

const { eyebrow, heading, description, label, items, locale: localeProp, layout = 'grid', align = 'start', background = 'page', spacing = 'large', headingLevel = 2, id: idProp, class: className, ...rest } = Astro.props
const id = idProp ?? uid(Astro.locals, 'blog')
const headingId = `${id}-heading`
const solid = background === 'primary' || background === 'inverted'
const faded = solid ? 'opacity-85' : 'text-neutral-faded'
const cardTag = `h${heading ? Math.min(headingLevel + 1, 6) : headingLevel}` as 'h2' | 'h3' | 'h4' | 'h5'
const [first, ...others] = items
const rest_ = layout === 'featured' && first ? others : items
const locale = localeProp ?? Astro.currentLocale ?? 'en'
const fmt = (iso: string) => formatDate(iso, locale, 'short')
---

<Section as="section" id={id} aria-labelledby={heading ? headingId : undefined} aria-label={heading ? undefined : label ?? 'Posts'} background={background} spacing={spacing} class={className} {...rest}>
  {heading && <SectionHeader id={headingId} eyebrow={eyebrow} heading={heading} description={description} headingLevel={headingLevel} align={align} background={background} class="mb-12" />}
  {layout === 'featured' && first && (
    <article class="relative mb-12 grid gap-8 md:grid-cols-2 md:items-center">
      {first.image && <Image src={first.image.src} alt={first.image.alt} width={first.image.width ?? 1200} height={first.image.height ?? 675} radius="lg" fit="cover" class="aspect-video w-full" />}
      <div class="flex flex-col gap-3">
        <time datetime={first.date} class:list={['text-sm', faded]}>{fmt(first.date)}</time>
        <Heading as={cardTag} size="h3"><a href={first.href} class="after:absolute after:inset-0 hover:underline underline-offset-4">{first.title}</a></Heading>
        <p class:list={faded}>{first.excerpt}</p>
        {first.author && <span class="flex items-center gap-2 text-sm"><Avatar src={first.author.avatar} name={first.author.name} size="small" />{first.author.name}</span>}
      </div>
    </article>
  )}
  <Grid as="ul" cols={{ base: 1, sm: 2, lg: 3 }} gap={8} class="list-none p-0">
    {rest_.map((p) => (
      <li>
        <article class="relative flex h-full flex-col gap-3">
          {p.image && <Image src={p.image.src} alt={p.image.alt} width={p.image.width ?? 800} height={p.image.height ?? 450} radius="lg" fit="cover" class="aspect-video w-full" />}
          <time datetime={p.date} class:list={['text-sm', faded]}>{fmt(p.date)}</time>
          <Heading as={cardTag} size="h5"><a href={p.href} class="after:absolute after:inset-0 hover:underline underline-offset-4">{p.title}</a></Heading>
          <p class:list={['text-sm', faded]}>{p.excerpt}</p>
          {p.author && <span class="mt-auto flex items-center gap-2 pt-2 text-sm"><Avatar src={p.author.avatar} name={p.author.name} size="small" />{p.author.name}</span>}
        </article>
      </li>
    ))}
  </Grid>
</Section>
