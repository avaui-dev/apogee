---
/**
 * PostHeader — the top of an article: category, title, standfirst, byline,
 * date, reading time and an optional cover image.
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Image from '../../components/Image/Image.astro'
import Avatar from '../../components/Avatar/Avatar.astro'
import { uid } from '../../components/utils/uid.ts'
import type { Background, Media, Spacing } from '../_shared/spine.ts'
import { formatDate } from '../_shared/date.ts'

/** @composable */
interface Props extends Omit<HTMLAttributes<'header'>, 'id'> {
  /** Category or kicker. @category content */ eyebrow?: string | undefined
  /** @category content */ heading: string
  /** @category content */ description?: string | undefined
  /** @shape { name: string, avatar?: string, role?: string } @category content */ author?: { name: string; avatar?: string; role?: string } | undefined
  /** ISO date string. @category content */ date: string
  /** e.g. "6 min read". @category content */ readingTime?: string | undefined
  /** Date locale; defaults to the page locale. @category content */ locale?: string
  /** Cover image below the text (`centered`) or beside it (`split`). @category content */ media?: Media | undefined
  /** @category layout */ layout?: 'centered' | 'split'
  /** @category layout */ background?: Background
  /** @category layout */ spacing?: Spacing
  /** @category layout */ headingLevel?: 1 | 2 | 3 | 4
  id?: string
  class?: string
}

const { eyebrow, heading, description, author, date, readingTime, media, locale: localeProp, layout = 'centered', background = 'page', spacing = 'medium', headingLevel = 1, id: idProp, class: className, ...rest } = Astro.props
const id = idProp ?? uid(Astro.locals, 'post')
const headingId = `${id}-heading`
const solid = background === 'primary' || background === 'inverted'
const faded = solid ? 'opacity-85' : 'text-neutral-faded'
const centred = layout === 'centered'
const fmt = formatDate(date, localeProp ?? Astro.currentLocale ?? 'en')
---

<Section as="header" id={id} aria-labelledby={headingId} background={background} spacing={spacing} class={className} {...rest}>
  <div class:list={centred ? 'flex flex-col items-center text-center' : 'grid gap-10 md:grid-cols-2 md:items-center'}>
    <div class:list={['flex flex-col', centred && 'items-center']}>
      <SectionHeader id={headingId} eyebrow={eyebrow} heading={heading} description={description} headingLevel={headingLevel} align={centred ? 'center' : 'start'} background={background} size="large" class="max-w-3xl" />
      {/* Author, then date and reading time on their own line. Centred, the avatar sits above the name. */}
      <div class:list={['mt-6 flex flex-col gap-3 text-sm', centred && 'items-center']}>
        {author && (
          <span class:list={['flex gap-2', centred ? 'flex-col items-center' : 'items-center']}>
            <Avatar src={author.avatar} name={author.name} size={centred ? 'medium' : 'small'} />
            <span class="flex flex-col leading-tight"><span class="font-medium">{author.name}</span>{author.role && <span class:list={['text-xs', faded]}>{author.role}</span>}</span>
          </span>
        )}
        <p class:list={['flex flex-wrap items-center gap-x-2', faded, centred && 'justify-center']}>
          <time datetime={date}>{fmt}</time>
          {readingTime && <><span aria-hidden="true">•</span><span>{readingTime}</span></>}
        </p>
      </div>
    </div>
    {media && (
      <Image src={media.src} alt={media.alt} width={media.width ?? 1600} height={media.height ?? 900} radius="xl" fit="cover" class:list={['w-full', centred ? 'mt-12 max-w-5xl aspect-video' : 'aspect-[4/3]']} loading="eager" />
    )}
  </div>
</Section>
