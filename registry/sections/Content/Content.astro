---
/**
 * Content — a text block beside media (`split`), or long-form prose (`prose`).
 * Put the body in the default slot.
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Grid from '../../components/Grid/Grid.astro'
import GridItem from '../../components/Grid/GridItem.astro'
import Image from '../../components/Image/Image.astro'
import Prose from '../../components/Prose/Prose.astro'
import Button from '../../components/Button/Button.astro'
import { uid } from '../../components/utils/uid.ts'
import { onBackground, type Action, type Background, type Media, type Spacing } from '../_shared/spine.ts'

/** @composable */
interface Props extends Omit<HTMLAttributes<'section'>, 'id'> {
  /** @category content */ eyebrow?: string
  /** @category content */ heading?: string
  /** @category content */ description?: string
  /** Landmark name when there is no heading. @category content */ label?: string
  /** @category content */ primaryAction?: Action
  /** Image for `split`; or the `media` slot. @category content */ media?: Media
  /** Media on the start side instead of the end. @category layout */ mediaFirst?: boolean
  /** @category layout */ layout?: 'split' | 'prose'
  /** @category layout */ background?: Background
  /** @category layout */ spacing?: Spacing
  /** @category layout */ headingLevel?: 1 | 2 | 3 | 4
  id?: string
  class?: string
}

const { eyebrow, heading, description, label, primaryAction, media, mediaFirst = false, layout = 'split', background = 'page', spacing = 'large', headingLevel = 2, id: idProp, class: className, ...rest } = Astro.props
const id = idProp ?? uid(Astro.locals, 'content')
const headingId = `${id}-heading`
const colours = onBackground[background]
const hasMedia = Boolean(media) || Astro.slots.has('media')
---

<Section as="section" id={id} aria-labelledby={heading ? headingId : undefined} aria-label={heading ? undefined : label ?? 'Content'} background={background} spacing={spacing} class={className} {...rest}>
  {layout === 'split' ? (
    <Grid cols={{ base: 1, md: hasMedia ? 2 : 1 }} gap={10} align="center">
      <GridItem class:list={[mediaFirst && 'md:order-last']}>
        {heading && <SectionHeader id={headingId} eyebrow={eyebrow} heading={heading} description={description} headingLevel={headingLevel} background={background} />}
        <div class="mt-4 max-w-prose [&>p]:mt-3"><slot /></div>
        {primaryAction && <Button href={primaryAction.href} class="mt-6" {...colours.primary}>{primaryAction.label}</Button>}
      </GridItem>
      {hasMedia && (
        <GridItem>
          {media ? <Image src={media.src} alt={media.alt} width={media.width ?? 1200} height={media.height ?? 900} radius="lg" class="w-full" /> : <slot name="media" />}
        </GridItem>
      )}
    </Grid>
  ) : (
    <div class="mx-auto max-w-prose">
      {heading && <SectionHeader id={headingId} eyebrow={eyebrow} heading={heading} description={description} headingLevel={headingLevel} background={background} class="mb-8" />}
      <Prose><slot /></Prose>
      {primaryAction && <Button href={primaryAction.href} class="mt-8" {...colours.primary}>{primaryAction.label}</Button>}
    </div>
  )}
</Section>
