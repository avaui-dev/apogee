---
/**
 * Stats — a row or cards of headline numbers.
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Grid from '../../components/Grid/Grid.astro'
import { uid } from '../../components/utils/uid.ts'
import type { Align, Background, Spacing } from '../_shared/spine.ts'
import type { MetricItem } from '../_shared/metrics.ts'

/** @composable */
interface Props extends Omit<HTMLAttributes<'section'>, 'id'> {
  /** @category content */ eyebrow?: string
  /** @category content */ heading?: string
  /** @category content */ description?: string
  /** Landmark name when there is no heading. @category content */ label?: string
  /** Numbers. @shape { value: string, label: string, description?: string } @category content */
  items: MetricItem[]
  /** @category layout */ layout?: 'row' | 'cards'
  /** @category layout */ align?: Align
  /** @category layout */ background?: Background
  /** @category layout */ spacing?: Spacing
  /** @category layout */ headingLevel?: 1 | 2 | 3 | 4
  id?: string
  class?: string
}

const { eyebrow, heading, description, label, items, layout = 'row', align = 'start', background = 'page', spacing = 'medium', id: idProp, headingLevel = 2, class: className, ...rest } = Astro.props
const id = idProp ?? uid(Astro.locals, 'stats')
const headingId = `${id}-heading`
const solid = background === 'primary' || background === 'inverted'
const card = layout === 'cards' ? (solid ? 'rounded-lg bg-page/10 p-6' : 'rounded-lg border border-neutral bg-elevation-raised p-6') : ''
const faded = solid ? 'opacity-85' : 'text-neutral-faded'
---

<Section as="section" id={id} aria-labelledby={heading ? headingId : undefined} aria-label={heading ? undefined : label ?? 'Key figures'} background={background} spacing={spacing} class={className} {...rest}>
  {heading && <SectionHeader id={headingId} eyebrow={eyebrow} heading={heading} description={description} headingLevel={headingLevel} align={align} background={background} class="mb-10" />}
  <Grid cols={{ base: 1, sm: 2, lg: Math.min(items.length, 4) as 1 | 2 | 3 | 4 }} gap={layout === 'cards' ? 4 : 8}>
    {items.map((s) => (
      <div class:list={['flex flex-col gap-1', card, align === 'center' && 'items-center text-center']}>
        <span class="text-4xl font-semibold tracking-tight tabular-nums">{s.value}</span>
        <span class="text-sm font-medium">{s.label}</span>
        {s.description && <span class:list={['text-sm', faded]}>{s.description}</span>}
      </div>
    ))}
  </Grid>
</Section>
