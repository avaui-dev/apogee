---
/**
 * FAQ — questions and answers as an accordion (one open at a time) or a
 * two-column list. Zero JS.
 *
 * @composable
 */
import type { HTMLAttributes } from 'astro/types'
import Section from '../../components/Section/Section.astro'
import SectionHeader from '../../components/SectionHeader/SectionHeader.astro'
import Accordion from '../../components/Accordion/Accordion.astro'
import AccordionItem from '../../components/Accordion/AccordionItem.astro'
import Grid from '../../components/Grid/Grid.astro'
import Heading from '../../components/Heading/Heading.astro'
import Text from '../../components/Text/Text.astro'
import { uid } from '../../components/utils/uid.ts'
import type { Align, Background, Spacing } from '../_shared/spine.ts'
import type { FAQItem } from '../_shared/faq.ts'

/** @composable */
interface Props extends Omit<HTMLAttributes<'section'>, 'id'> {
  /** @category content */ eyebrow?: string
  /** @category content */ heading?: string
  /** @category content */ description?: string
  /** Landmark name when there is no heading. @category content */ label?: string
  /** Questions. @shape { question: string, answer: string } @category content */
  items: FAQItem[]
  /** @category layout */ layout?: 'accordion' | 'two-column'
  /** @category layout */ align?: Align
  /** @category layout */ background?: Background
  /** @category layout */ spacing?: Spacing
  /** @category layout */ headingLevel?: 1 | 2 | 3 | 4
  id?: string
  class?: string
}

const { eyebrow, heading, description, label, items, layout = 'accordion', align = 'start', background = 'page', spacing = 'large', headingLevel = 2, id: idProp, class: className, ...rest } = Astro.props
const id = idProp ?? uid(Astro.locals, 'faq')
const headingId = `${id}-heading`
const itemAs = `h${heading ? Math.min(headingLevel + 1, 6) : headingLevel}` as 'h2' | 'h3' | 'h4' | 'h5' | 'h6'
const solid = background === 'primary' || background === 'inverted'
---

<Section as="section" id={id} aria-labelledby={heading ? headingId : undefined} aria-label={heading ? undefined : label ?? 'Frequently asked questions'} background={background} spacing={spacing} class={className} {...rest}>
  {heading && <SectionHeader id={headingId} eyebrow={eyebrow} heading={heading} description={description} headingLevel={headingLevel} align={align} background={background} class="mb-10" />}
  {layout === 'accordion' ? (
    <Accordion class:list={['mx-auto max-w-3xl', solid && 'bg-page text-neutral']}>
      {items.map((q) => (
        <AccordionItem title={q.question} group={id}>
          <p>{q.answer}</p>
        </AccordionItem>
      ))}
    </Accordion>
  ) : (
    <Grid cols={{ base: 1, md: 2 }} gap={10}>
      {items.map((q) => (
        <div class="flex flex-col gap-2">
          <Heading as={itemAs} size="h5">{q.question}</Heading>
          <Text class={solid ? 'opacity-85' : 'text-neutral-faded'}>{q.answer}</Text>
        </div>
      ))}
    </Grid>
  )}
</Section>
